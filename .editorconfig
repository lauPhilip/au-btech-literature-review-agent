# Editor settings shared by everyone working on TraceableAI.
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space

[*.{cs,razor}]
indent_size = 4

[*.{json,js,mjs,css,yml,yaml,csproj,props}]
indent_size = 2

[*.cs]
# The code is grouped in folders by pipeline stage, but uses the single namespace AuBtechReviewAgent
# (see ARCHITECTURE.md), so moving a file never changes how it is referenced.
dotnet_style_namespace_match_folder = false
dotnet_diagnostic.IDE0130.severity = none
