@page "/mlr"
@page "/mlr/{RunId:guid}"
@rendermode InteractiveServer
@inject AuBtechReviewAgent.ReviewModulesOptions ModuleOptions
@inject AuBtechReviewAgent.RunStore Runs
@inject AuBtechReviewAgent.MultivocalPlanner Planner
@inject AuBtechReviewAgent.MultivocalSearcher Searcher
@inject AuBtechReviewAgent.MultivocalPages Pages
@inject AuBtechReviewAgent.MultivocalScreener Screener
@inject AuBtechReviewAgent.MultivocalQualityAssessor Quality
@inject AuBtechReviewAgent.MultivocalMapper Mapper
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<MultivocalStart> Logger

@* The multivocal review's planning form (MLR block C), laid out like the systematic review's dashboard: the steps
   on the left with one primary action at the bottom, and on the right what the review will do and its protocol.
   The steps themselves follow the Garousi et al. (2019) guidelines, not PRISMA. While the module is being built it
   is a preview: visible only where ReviewModules:Preview lists "multivocal" (Development), "not found" elsewhere.
   /mlr/{id} shows a planned run and its protocol. *@

<SeoHead Title="@(GreyOnly ? "Grey literature review (preview)" : "Multivocal literature review (preview)")" Path="/mlr" NoIndex="true"
         Description="Preview of the multivocal literature review, following the Garousi et al. (2019) guidelines." />

<SiteHeader Active="dashboard" DashboardHref="@(planned != null ? $"/mlr/{planned.RunId}" : "/mlr")" />

<main id="main" tabindex="-1" class="flex-1 min-h-0 overflow-y-auto">
<div class="max-w-7xl w-full mx-auto p-4 lg:p-6 space-y-4">

    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <h1 class="ui-h2">@(planned != null ? "Your review" : "New review")</h1>
            <p class="text-sm text-gray-500 mt-1">
                A @(GreyOnly ? "grey literature" : "multivocal") review following
                <a href="@Method.StandardUrl" target="_blank" rel="noopener" class="underline decoration-dotted underline-offset-2" title="@Method.StandardReference">Garousi et al. (2019)</a>,
                in which every citation will be checked against its source. <a href="/glossary" class="text-brand underline underline-offset-2">Glossary</a>
            </p>
        </div>
        <span class="bg-amber-50 border-amber-200 text-amber-800 border px-2.5 py-1 text-[11px] flex items-center gap-1.5" title="Visible only in Development while it is being built">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Preview · not available yet
        </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">

        <section class="lg:col-span-5 space-y-4 min-w-0" aria-label="Review settings">
            @if (planned != null)
            {
                <div class="bg-white border border-gray-200 shadow-sm p-4 space-y-3">
                    <div>
                        <h2 class="text-sm font-semibold text-gray-900">Review settings</h2>
                        <p class="text-xs font-medium text-brand">@StageLine()</p>
                    </div>
                    <dl class="text-xs space-y-2">
                        @SettingRow("Topic", planned.Plan.Topic)
                        @SettingRow("Goal", planned.Plan.Goal)
                        @SettingRow("Audience", AudienceLabel(planned.Plan.Audience))
                        @SettingRow("Questions", string.Join(" ", planned.Plan.Numbered().Select(q => q.Number)))
                        @SettingRow("Searches", string.Join(", ", planned.Plan.GreySearches.Select(AuBtechReviewAgent.MultivocalGuidelines.SearchLabel)))
                        @SettingRow("Strings", string.Join("; ", planned.Plan.EffectiveGreySearchStrings))
                        @SettingRow("Threshold", $"{planned.Plan.QualityThreshold} of {AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax} points")
                        @if (ledger != null)
                        {
                            @SettingRow("Found", $"{ledger.Sources.Count} grey source{(ledger.Sources.Count == 1 ? "" : "s")} from {ledger.Searches.Count} search{(ledger.Searches.Count == 1 ? "" : "es")}")
                        }
                        @if (screening != null)
                        {
                            @SettingRow("Screened", ScreeningLine(screening))
                        }
                        @if (quality != null)
                        {
                            @SettingRow("Quality", QualityLine(quality))
                        }
                        @if (map != null)
                        {
                            @SettingRow("Map", $"{map.Latest.Attributes.Count} attributes, version {map.Latest.Number}{(map.FixedVersion != null ? ", fixed" : ", not fixed yet")}")
                        }
                    </dl>
                    @if (quality != null && map == null && stage == AuBtechReviewAgent.MultivocalQualityAssessor.StageAssessed)
                    {
                        <div class="border-t border-gray-100 pt-3 space-y-2">
                            @if (mapping || AuBtechReviewAgent.MultivocalMapper.IsRunning(planned.RunId))
                            {
                                <p class="text-xs text-gray-700" role="status" aria-live="polite">Proposing the map…</p>
                            }
                            else if (canEdit && quality.Count("Passed") > 0)
                            {
                                <p class="text-xs text-gray-600">Propose the systematic map (G12): the attributes to record for every source, from your research questions, with values generalised over the @quality.Count("Passed") sources that passed. You can edit it before it is fixed.</p>
                                <button type="button" class="ui-btn-primary ui-btn-sm" @onclick="ProposeMapAsync">Propose the map</button>
                            }
                            else if (canEdit)
                            {
                                <p class="text-xs text-gray-600">No source passed the quality check, so there is nothing to map.</p>
                            }
                            @if (mapError != null)
                            {
                                <p class="bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@mapError</p>
                            }
                        </div>
                    }
                    @if (screening != null && quality == null && stage is AuBtechReviewAgent.MultivocalScreener.StageScreened or AuBtechReviewAgent.MultivocalQualityAssessor.StageAssessing)
                    {
                        <div class="border-t border-gray-100 pt-3 space-y-2">
                            @if (assessing || AuBtechReviewAgent.MultivocalQualityAssessor.IsRunning(planned.RunId))
                            {
                                <p class="text-xs text-gray-700" role="status" aria-live="polite">Scoring… @qualityProgress</p>
                                <p class="text-[11px] text-gray-500">Each page is fetched first, one request a second per site. Closing the page does not stop it.</p>
                            }
                            else if (canEdit)
                            {
                                <p class="text-xs text-gray-600">Score the @screening.Count("Included") included sources on the 20 items of the quality checklist (Table 7). Each page is kept first; every point the model gives must rest on a quote from it. Below @planned.Plan.QualityThreshold points a source is left out.</p>
                                <button type="button" class="ui-btn-primary ui-btn-sm" @onclick="AssessAsync">Score the quality</button>
                            }
                            else
                            {
                                <p class="text-xs text-gray-600">Only the browser that planned this run can score it.</p>
                            }
                            @if (qualityError != null)
                            {
                                <p class="bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@qualityError</p>
                            }
                        </div>
                    }
                    @if (ledger != null && screening == null && stage is AuBtechReviewAgent.MultivocalSearcher.StageSearched or AuBtechReviewAgent.MultivocalScreener.StageScreening)
                    {
                        <div class="border-t border-gray-100 pt-3 space-y-2">
                            @if (!planned.Plan.HasCriteria)
                            {
                                <p class="text-xs text-gray-600">This plan was made before the form asked for inclusion criteria, so its sources cannot be screened. Plan a new run to screen.</p>
                            }
                            else if (screeningNow || AuBtechReviewAgent.MultivocalScreener.IsRunning(planned.RunId))
                            {
                                <p class="text-xs text-gray-700" role="status" aria-live="polite">Screening… @screenProgress</p>
                                <p class="text-[11px] text-gray-500">This takes a while. Closing the page does not stop it; open the run again later.</p>
                            }
                            else if (canEdit)
                            {
                                int toScreen = ledger.Sources.Count;
                                <p class="text-xs text-gray-600">Screen every found source twice against the plan's criteria, as the systematic review does. About @((2 * toScreen).ToString("N0")) model calls; decisions made before come from the cache.</p>
                                <button type="button" class="ui-btn-primary ui-btn-sm" @onclick="ScreenAsync">Screen the sources</button>
                            }
                            else
                            {
                                <p class="text-xs text-gray-600">Only the browser that planned this run can screen it.</p>
                            }
                            @if (screenError != null)
                            {
                                <p class="bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@screenError</p>
                            }
                        </div>
                    }
                    @if (ledger == null && stage == AuBtechReviewAgent.MultivocalPlanner.StagePlanned)
                    {
                        <div class="border-t border-gray-100 pt-3 space-y-2">
                            @if (canEdit)
                            {
                                <p class="text-xs text-gray-600">Run the grey literature searches of this plan. Their raw answers are saved with fingerprints; nothing is screened yet.</p>
                                <button type="button" class="ui-btn-primary ui-btn-sm" disabled="@searching" @onclick="SearchAsync">@(searching ? "Searching…" : "Search now")</button>
                                @if (searchProgress != null)
                                {
                                    <p class="text-[11px] text-gray-500" role="status" aria-live="polite">@searchProgress</p>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-gray-600">Only the browser that planned this run can start its search.</p>
                            }
                            @if (searchError != null)
                            {
                                <p class="bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@searchError</p>
                            }
                        </div>
                    }
                    <p class="text-[11px] text-gray-500 leading-snug border-t border-gray-100 pt-2">
                        Link to this run: <a class="text-brand underline break-all" href="@($"/mlr/{planned.RunId}")">@($"/mlr/{planned.RunId}")</a>.
                        Protocol fingerprint (SHA-256): <span class="font-mono break-all">@planned.ProtocolSha256</span>
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <a href="@($"/api/workspace/{planned.RunId:N}/protocol.md")" class="ui-btn-secondary ui-btn-sm">Download the protocol</a>
                        <a href="@($"/mlr?card={planned.Plan.Card}")" class="ui-btn-primary ui-btn-sm">New review</a>
                    </div>
                </div>
            }
            else if (RunId != null)
            {
                <div class="bg-white border border-gray-200 shadow-sm p-4 text-sm text-gray-700">This run could not be found. It may have expired and been deleted.</div>
            }
            else
            {
                <div class="bg-white border border-gray-200 shadow-sm">
                    <nav class="flex border-b border-gray-200 overflow-x-auto" aria-label="Steps">
                        @for (int i = 0; i < Steps.Length; i++)
                        {
                            int number = i;
                            bool active = step == number;
                            bool done = StepProblem(number) == null;
                            <button type="button" @onclick="() => GoTo(number)" aria-current="@(active ? "step" : null)" title="@Steps[number].Guideline"
                                    class="flex-1 flex items-center justify-center gap-1.5 px-2 py-3 text-xs whitespace-nowrap border-b-2 -mb-px transition-colors @(active ? "border-brand text-brand font-semibold" : "border-transparent text-gray-500 hover:text-gray-800")">
                                @if (done && !active)
                                {
                                    <svg class="w-3.5 h-3.5 text-green-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                                }
                                else
                                {
                                    <span class="w-4 h-4 rounded-full text-[10px] flex items-center justify-center @(active ? "bg-brand text-white" : "bg-gray-200 text-gray-600")">@(number + 1)</span>
                                }
                                @Steps[number].Title
                            </button>
                        }
                    </nav>

                    <div class="p-4 space-y-4">
                        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-600">
                            <span class="ui-chip border-brand-100 bg-brand-50 text-brand">@(GreyOnly ? "Grey Literature Review" : "Multivocal Literature Review")</span>
                            <span>follows @Method.Standard</span>
                            <a href="/start" class="text-brand font-medium hover:underline">Change review type</a>
                        </p>

                        <div class="flex items-center justify-between gap-2">
                            <h2 id="step-title" class="text-sm text-gray-600" tabindex="-1">@Steps[step].Question <span class="text-gray-500">(@Steps[step].Guideline)</span></h2>
                            @if (step == 0)
                            {
                                <button type="button" @onclick="FillExample" class="text-xs text-brand font-medium hover:underline whitespace-nowrap">Try an example</button>
                            }
                        </div>

                        @if (step == 0)
                        {
                            <div>
                                <label for="p-topic" class="ui-label">Topic <span class="font-normal text-gray-500">(required)</span></label>
                                <input id="p-topic" class="ui-input" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="plan.Topic" @bind:event="oninput" placeholder="e.g. context engineering for LLM agents" aria-describedby="h-topic" />
                                <p id="h-topic" class="text-xs text-gray-600 mt-1">What the review is about, in a few words.</p>
                            </div>
                            <div>
                                <label for="p-goal" class="ui-label">Goal <span class="font-normal text-gray-500">(required)</span></label>
                                <textarea id="p-goal" rows="3" class="ui-input resize-y" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="plan.Goal" @bind:event="oninput" aria-describedby="h-goal"
                                          placeholder="e.g. Map the practices developers use to decide what goes into an agent's context window."></textarea>
                                <p id="h-goal" class="text-xs text-gray-600 mt-1">What the review is for. It guides the research questions.</p>
                            </div>
                            <div>
                                <label for="p-existing" class="ui-label">Existing reviews</label>
                                <textarea id="p-existing" rows="2" class="ui-input resize-y" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="plan.ExistingReviews" @bind:event="oninput" aria-describedby="h-existing"></textarea>
                                <p id="h-existing" class="text-xs text-gray-600 mt-1">Name the reviews you found and what this one adds. Leave empty if you found none.</p>
                            </div>
                            <fieldset>
                                <legend class="ui-label">Who is the review for? <span class="font-normal text-gray-500">(required)</span></legend>
                                <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-gray-800">
                                    @foreach (var audience in Enum.GetValues<AuBtechReviewAgent.ReviewAudience>())
                                    {
                                        var a = audience;
                                        <label class="inline-flex items-center gap-2 cursor-pointer">
                                            <input type="radio" name="audience" class="w-4 h-4 accent-brand" checked="@(plan.Audience == a)" @onchange="() => plan.Audience = a" />
                                            @AudienceLabel(a)
                                        </label>
                                    }
                                </div>
                            </fieldset>
                        }
                        else if (step == 1)
                        {
                            <p class="text-xs text-gray-600">One or more "yes" answers suggest including grey literature (Table 4).</p>
                            <ol class="space-y-3">
                                @for (int i = 0; i < AuBtechReviewAgent.MultivocalGuidelines.IncludeGreyQuestions.Count; i++)
                                {
                                    int q = i;
                                    <li>
                                        <fieldset class="flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-4">
                                            <legend class="sr-only">Question @(q + 1)</legend>
                                            <span class="text-sm text-gray-800 flex-1"><span class="text-gray-500">@(q + 1).</span> @AuBtechReviewAgent.MultivocalGuidelines.IncludeGreyQuestions[q]</span>
                                            <span class="flex gap-4 text-sm flex-none">
                                                <label class="inline-flex items-center gap-1.5 cursor-pointer"><input type="radio" name="@($"g3-{q}")" class="w-4 h-4 accent-brand" checked="@(plan.IncludeGrey[q] == true)" @onchange="() => plan.IncludeGrey[q] = true" /> Yes</label>
                                                <label class="inline-flex items-center gap-1.5 cursor-pointer"><input type="radio" name="@($"g3-{q}")" class="w-4 h-4 accent-brand" checked="@(plan.IncludeGrey[q] == false)" @onchange="() => plan.IncludeGrey[q] = false" /> No</label>
                                            </span>
                                        </fieldset>
                                    </li>
                                }
                            </ol>
                            @if (plan.IncludeGrey.All(a => a == false))
                            {
                                <p class="bg-amber-50 border border-amber-200 text-amber-900 p-2 text-xs" role="status">Every answer is "no": by the guidelines, a systematic review may be enough. You can still go on.</p>
                            }
                        }
                        else if (step == 2)
                        {
                            <p class="text-xs text-gray-600">Tie each question to the goal and the audience, and give it a type from Table 6.</p>
                            <ol class="space-y-4">
                                @foreach (var (number, question) in plan.Numbered())
                                {
                                    var q = question;
                                    int index = plan.Questions.IndexOf(q);
                                    var type = AuBtechReviewAgent.MultivocalGuidelines.FindType(q.Type);
                                    <li class="@(q.Parent != null ? "ml-5 pl-3 border-l-2 border-gray-200" : "")">
                                        <label for="@($"rq-{index}")" class="ui-label">@number</label>
                                        <textarea id="@($"rq-{index}")" rows="2" class="ui-input resize-y" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="q.Text" @bind:event="oninput"></textarea>
                                        <label for="@($"rqt-{index}")" class="sr-only">Type of @number</label>
                                        <select id="@($"rqt-{index}")" class="ui-input mt-2" @bind="q.Type">
                                            <option value="">Choose a type</option>
                                            @foreach (var t in AuBtechReviewAgent.MultivocalGuidelines.QuestionTypes)
                                            {
                                                <option value="@t.Key">@t.Name: @t.Pattern</option>
                                            }
                                        </select>
                                        @if (type is { HardForSources: true })
                                        {
                                            <p class="text-[11px] text-amber-800 mt-1">Sources may not allow a question of this type to be answered (p. 110).</p>
                                        }
                                        <div class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1 text-xs">
                                            @if (q.Parent == null && plan.Questions.Count < AuBtechReviewAgent.MultivocalPlan.MaxQuestions)
                                            {
                                                <button type="button" class="text-brand font-medium hover:underline" @onclick="() => plan.AddQuestion(index)">Add a sub-question</button>
                                            }
                                            @if (plan.Questions.Count > 1)
                                            {
                                                <button type="button" class="text-gray-600 hover:text-red-700 hover:underline" @onclick="() => plan.RemoveQuestion(index)">Remove @number</button>
                                            }
                                        </div>
                                    </li>
                                }
                            </ol>
                            @if (plan.Questions.Count < AuBtechReviewAgent.MultivocalPlan.MaxQuestions)
                            {
                                <button type="button" class="text-xs text-brand font-medium hover:underline" @onclick="() => plan.AddQuestion(null)">Add a research question</button>
                            }
                        }
                        else if (step == 3)
                        {
                            <fieldset>
                                <legend class="ui-label">Kinds of grey literature <span class="font-normal text-gray-500">(at least one)</span></legend>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-1.5">
                                    @foreach (var (key, label) in AuBtechReviewAgent.MultivocalGuidelines.GreyTypes)
                                    {
                                        var k = key;
                                        <label class="flex items-start gap-2 text-sm text-gray-800 cursor-pointer select-none"><input type="checkbox" class="w-4 h-4 mt-0.5 accent-brand" checked="@plan.GreyTypes.Contains(k)" @onchange="e => plan.GreyTypes = Toggle(plan.GreyTypes, k, e, AuBtechReviewAgent.MultivocalGuidelines.GreyTypes.Select(t => t.Key))" /> <span>@label</span></label>
                                    }
                                </div>
                            </fieldset>
                            <fieldset>
                                <legend class="ui-label">Where to search <span class="font-normal text-gray-500">(at least one)</span></legend>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-1.5">
                                    @foreach (var search in AuBtechReviewAgent.MultivocalGuidelines.GreySearches)
                                    {
                                        var s = search;
                                        <label class="flex items-start gap-2 text-sm text-gray-800 cursor-pointer select-none"><input type="checkbox" class="w-4 h-4 mt-0.5 accent-brand" checked="@plan.GreySearches.Contains(s.Key)" @onchange="e => plan.GreySearches = Toggle(plan.GreySearches, s.Key, e, AuBtechReviewAgent.MultivocalGuidelines.GreySearches.Select(t => t.Key))" /> <span>@s.Label</span></label>
                                    }
                                </div>
                                <p class="text-xs text-gray-600 mt-1.5">No general web search engine is used: none is free and allows its results to be kept. Practitioners and authors are not contacted.</p>
                            </fieldset>
                            <fieldset>
                                <legend class="ui-label">Search strings for grey literature</legend>
                                <p class="text-xs text-gray-600 mb-1.5">Practitioners use their own words; try the terms they use. Each string is sent to every search. Empty means the topic is used.</p>
                                <ol class="space-y-1.5">
                                    @for (int i = 0; i < plan.GreySearchStrings.Count; i++)
                                    {
                                        int index = i;
                                        <li class="flex items-center gap-2">
                                            <span class="w-4 text-right text-xs text-gray-500">@(index + 1)</span>
                                            <input type="text" aria-label="@($"Search string {index + 1}")" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxSearchStringLength"
                                                   value="@plan.GreySearchStrings[index]" @onchange="e => plan.GreySearchStrings[index] = e.Value?.ToString() ?? string.Empty" class="ui-input py-1" />
                                            <button type="button" @onclick="() => plan.GreySearchStrings.RemoveAt(index)" class="ui-btn ui-btn-sm px-2 text-gray-600 hover:text-red-700" aria-label="@($"Remove search string {index + 1}")">✕</button>
                                        </li>
                                    }
                                </ol>
                                @if (plan.GreySearchStrings.Count < AuBtechReviewAgent.MultivocalPlan.MaxSearchStrings)
                                {
                                    <button type="button" class="text-xs text-brand font-medium hover:underline mt-1.5" @onclick="AddSearchString">Add a search string</button>
                                }
                            </fieldset>
                            <fieldset class="space-y-2">
                                <legend class="ui-label">What to include (G9)</legend>
                                <p class="text-xs text-gray-600">Every source found is screened against these, twice. Formal and grey sources get the same criteria (G10), so write them about the subject, not about where a source was published.</p>
                                <div>
                                    <label for="p-include" class="text-sm text-gray-800">A source is included when it is about</label>
                                    <textarea id="p-include" rows="3" class="ui-input resize-y mt-1" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="plan.InclusionCriteria" @bind:event="oninput"></textarea>
                                </div>
                                <div>
                                    <label for="p-exclude" class="text-sm text-gray-800">A source is excluded when <span class="text-gray-500">(optional)</span></label>
                                    <textarea id="p-exclude" rows="2" class="ui-input resize-y mt-1" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="plan.ExclusionCriteria" @bind:event="oninput"></textarea>
                                </div>
                            </fieldset>
                            <details class="group border border-gray-200" open>
                                <summary class="cursor-pointer select-none px-3 py-2 text-sm text-gray-800 flex items-center justify-between">
                                    <span>Stopping rule and quality</span>
                                    <span class="text-[11px] text-gray-500">@StoppingSummary() · threshold @plan.QualityThreshold/@AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax</span>
                                </summary>
                                <div class="px-3 pb-3 space-y-3 border-t border-gray-100 pt-3">
                                    <fieldset>
                                        <legend class="text-sm text-gray-800">When to stop searching (G8)</legend>
                                        <div class="space-y-1 mt-1 text-sm text-gray-800">
                                            @foreach (var (key, label) in AuBtechReviewAgent.MultivocalGuidelines.StoppingRules)
                                            {
                                                var k = key;
                                                <label class="flex items-start gap-2 cursor-pointer"><input type="radio" name="stopping" class="w-4 h-4 mt-0.5 accent-brand" checked="@(plan.StoppingRule == k)" @onchange="() => plan.StoppingRule = k" /> <span>@label</span></label>
                                            }
                                        </div>
                                    </fieldset>
                                    @if (plan.StoppingRule == "effort")
                                    {
                                        <div class="flex items-center justify-between gap-3">
                                            <label for="p-top" class="text-sm text-gray-800">Top hits per search string<span class="block text-xs text-gray-500">The paper looks at the first 100.</span></label>
                                            <input id="p-top" type="number" min="10" max="500" class="ui-input w-20 text-center" @bind="plan.TopHits" />
                                        </div>
                                    }
                                    <div class="flex items-center justify-between gap-3">
                                        <label for="p-threshold" class="text-sm text-gray-800">Quality threshold, of @AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax points (G11)<span class="block text-xs text-gray-500">A grey source scoring below this is excluded. The paper's example uses 10.</span></label>
                                        <input id="p-threshold" type="number" min="1" max="@AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax" class="ui-input w-20 text-center" @bind="plan.QualityThreshold" />
                                    </div>
                                </div>
                            </details>
                        }
                        else
                        {
                            <p class="text-xs text-gray-600">The protocol on the right is written from your answers. It is fixed, with a fingerprint, before anything is searched.</p>
                            @if (Problems.Count > 0)
                            {
                                <div class="bg-amber-50 border border-amber-200 text-amber-900 p-2 text-xs space-y-0.5" role="alert">
                                    <p class="font-semibold">Before the protocol can be written:</p>
                                    <ul class="list-disc pl-4 space-y-0.5">
                                        @foreach (var item in Problems)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="bg-green-50 border border-green-200 text-green-800 p-2 text-xs">Everything is filled in. Check the protocol, then write it.</p>
                            }
                        }
                    </div>

                    @if (error != null)
                    {
                        <div class="mx-4 mb-3 bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@error</div>
                    }

                    <div class="sticky bottom-0 bg-white/95 backdrop-blur border-t border-gray-200 px-4 py-3 space-y-2">
                        <p class="text-[11px] text-gray-500 truncate" title="@SettingsLine()">@SettingsLine()</p>
                        @if (FirstProblem() is { } problem)
                        {
                            <button type="button" @onclick="() => GoTo(problem.Step)" class="block text-left text-xs text-amber-800 underline decoration-dotted underline-offset-2 hover:text-amber-900">@problem.Text</button>
                        }
                        <div class="flex items-center gap-2">
                            @if (step > 0)
                            {
                                <button type="button" @onclick="() => GoTo(step - 1)" class="ui-btn-ghost">Back</button>
                            }
                            <span class="flex-1"></span>
                            @if (step < Steps.Length - 1)
                            {
                                <button type="button" @onclick="() => GoTo(step + 1)" class="ui-btn-primary">Next: @Steps[step + 1].NextLabel</button>
                            }
                            else
                            {
                                <button type="button" class="ui-btn-primary" disabled="@(Problems.Count > 0 || saving)" @onclick="WriteProtocolAsync">Write the protocol</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </section>

        <section class="lg:col-span-7 lg:sticky lg:top-4 min-w-0 bg-white border border-gray-200 shadow-sm overflow-hidden flex flex-col lg:max-h-[calc(100vh-8rem)]" aria-labelledby="panel-title">
            <h2 id="panel-title" class="sr-only">@(panelTab == "protocol" ? "Protocol" : "What this review will do")</h2>
            <div class="flex items-center justify-between border-b border-gray-200 px-3 flex-none">
                <div class="flex" role="group" aria-label="Show">
                    <button type="button" aria-pressed="@(panelTab == "plan" ? "true" : "false")" @onclick="@(() => panelTab = "plan")"
                            class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "plan" ? "border-brand text-brand font-semibold" : "border-transparent text-gray-500 hover:text-gray-800")">Preview</button>
                    <button type="button" aria-pressed="@(panelTab == "protocol" ? "true" : "false")" @onclick="@(() => panelTab = "protocol")"
                            class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "protocol" ? "border-brand text-brand font-semibold" : "border-transparent text-gray-500 hover:text-gray-800")">Protocol</button>
                    @if (ledger != null)
                    {
                        <button type="button" aria-pressed="@(panelTab == "sources" ? "true" : "false")" @onclick="@(() => panelTab = "sources")"
                                class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "sources" ? "border-brand text-brand font-semibold" : "border-transparent text-gray-500 hover:text-gray-800")">Sources found (@ledger.Sources.Count)</button>
                    }
                    @if (map != null)
                    {
                        <button type="button" aria-pressed="@(panelTab == "map" ? "true" : "false")" @onclick="@(() => panelTab = "map")"
                                class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "map" ? "border-brand text-brand font-semibold" : "border-transparent text-gray-500 hover:text-gray-800")">Map</button>
                    }
                </div>
                <span class="text-[10px] text-gray-500 font-mono">Garousi et al. 2019</span>
            </div>

            @if (panelTab == "map" && map != null && planned != null)
            {
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-4 text-left">
                    <div>
                        <h3 class="text-base font-semibold text-gray-900">Systematic map</h3>
                        <p class="text-xs text-gray-600 mt-0.5">
                            The attributes recorded for every source (G12, Table 10). Version 1 was proposed by the model from your research questions, with values generalised over @map.SourcesSeen sources that passed.
                            @(map.FixedVersion is int fixedNumber ? $"Version {fixedNumber} is fixed and is used for the extraction." : "Edit it, save, and fix it when it fits; every saved version is kept.")
                        </p>
                    </div>
                    <ol class="text-[11px] text-gray-500 space-y-0.5">
                        @foreach (var version in map.Versions)
                        {
                            <li>Version @version.Number · @(version.By == "model" ? "proposed by the model" : "edited by you") · @version.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @version.Attributes.Count attributes@(map.FixedVersion == version.Number ? " · fixed" : "")</li>
                        }
                    </ol>
                    @if (mapDraft != null)
                    {
                        @for (int i = 0; i < mapDraft.Count; i++)
                        {
                            var mapAttribute = mapDraft[i];
                            int index = i;
                            <fieldset class="border border-gray-200 p-3 space-y-2">
                                <legend class="px-1 text-xs font-medium text-gray-700">Attribute @(index + 1)</legend>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                    <label class="text-[11px] text-gray-600 sm:col-span-2">Name
                                        <input type="text" class="ui-input py-1 text-xs mt-0.5" maxlength="@AuBtechReviewAgent.MultivocalMapper.MaxText" @bind="mapAttribute.Name" />
                                    </label>
                                    <label class="text-[11px] text-gray-600">For
                                        <select class="ui-input py-1 text-xs mt-0.5" @bind="mapAttribute.Question">
                                            @foreach (var (number, _) in planned.Plan.Numbered())
                                            {
                                                <option value="@number">@number</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <label class="block text-[11px] text-gray-600">What it records
                                    <input type="text" class="ui-input py-1 text-xs mt-0.5" maxlength="@AuBtechReviewAgent.MultivocalMapper.MaxText" @bind="mapAttribute.Description" />
                                </label>
                                @if (!mapAttribute.Open)
                                {
                                    <label class="block text-[11px] text-gray-600">Values, one per line
                                        <textarea rows="@Math.Max(3, mapAttribute.Values.Count + 1)" class="ui-input py-1 text-xs mt-0.5 resize-y"
                                                  value="@string.Join("\n", mapAttribute.Values)" @onchange="e => mapAttribute.Values = (e.Value?.ToString() ?? string.Empty).Split('\n').Select(v => v.Trim()).Where(v => v.Length > 0).ToList()"></textarea>
                                    </label>
                                }
                                <div class="flex flex-wrap items-center gap-4 text-[11px] text-gray-700">
                                    <label class="flex items-center gap-1.5"><input type="checkbox" class="w-3.5 h-3.5 accent-brand" @bind="mapAttribute.Multiple" /> A source can have several values</label>
                                    <label class="flex items-center gap-1.5"><input type="checkbox" class="w-3.5 h-3.5 accent-brand" @bind="mapAttribute.Open" /> Open text (values cannot be listed)</label>
                                    <button type="button" class="ml-auto text-red-700 hover:underline" @onclick="() => mapDraft.RemoveAt(index)">Remove</button>
                                </div>
                            </fieldset>
                        }
                        <button type="button" class="text-xs text-brand font-medium hover:underline" @onclick="AddAttribute">Add an attribute</button>
                        @if (mapError != null)
                        {
                            <p class="bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@mapError</p>
                        }
                        <div class="flex flex-wrap gap-2">
                            <button type="button" class="ui-btn-secondary ui-btn-sm" disabled="@mapping" @onclick="SaveMapAsync">Save as version @(map.Versions.Count + 1)</button>
                            <button type="button" class="ui-btn-primary ui-btn-sm" disabled="@mapping" @onclick="FixMapAsync">Fix the map</button>
                        </div>
                        <p class="text-[11px] text-gray-500">Fixing keeps your current edits as a new version first. After that the map does not change, so every source is extracted against the same attributes.</p>
                    }
                    else
                    {
                        var shown = map.FixedVersion is int f ? map.Versions.First(v => v.Number == f) : map.Latest;
                        <table class="w-full text-xs">
                            <caption class="sr-only">The attributes of the map</caption>
                            <thead class="text-left text-gray-500"><tr><th class="py-1 pr-2 font-medium">Attribute</th><th class="py-1 pr-2 font-medium">For</th><th class="py-1 font-medium">Values</th></tr></thead>
                            <tbody>
                                @foreach (var mapAttribute in shown.Attributes)
                                {
                                    <tr class="border-t border-gray-100 align-top">
                                        <td class="py-1 pr-2"><span class="font-medium text-gray-900">@mapAttribute.Name</span><span class="block text-gray-500">@mapAttribute.Description</span></td>
                                        <td class="py-1 pr-2">@mapAttribute.Question</td>
                                        <td class="py-1">@(mapAttribute.Open ? "open text" : string.Join(", ", mapAttribute.Values))@(mapAttribute.Multiple ? " (several)" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
            else if (panelTab == "sources" && ledger != null)
            {
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-5 text-left">
                    <div>
                        <h3 class="text-base font-semibold text-gray-900">Grey sources found</h3>
                        <p class="text-xs text-gray-600 mt-0.5">@ledger.StoppingApplied @(screening == null ? "Not screened yet." : $"Screened twice with the plan's criteria ({screening.Model}); the quality check comes next.")</p>
                    </div>
                    <table class="w-full text-xs">
                        <caption class="sr-only">Searches and what they returned</caption>
                        <thead class="text-left text-gray-500"><tr><th class="py-1 pr-2 font-medium">Search</th><th class="py-1 pr-2 font-medium">String</th><th class="py-1 pr-2 font-medium text-right">Hits</th><th class="py-1 font-medium text-right">New</th></tr></thead>
                        <tbody>
                            @foreach (var search in ledger.Searches)
                            {
                                <tr class="border-t border-gray-100">
                                    <td class="py-1 pr-2">@SearchLabel(search.Source)</td>
                                    <td class="py-1 pr-2 text-gray-700">@search.SearchString</td>
                                    @if (search.Error != null)
                                    {
                                        <td class="py-1 text-red-700" colspan="2" title="@search.Error">failed</td>
                                    }
                                    else
                                    {
                                        <td class="py-1 pr-2 text-right">@search.Returned</td>
                                        <td class="py-1 text-right">@search.New</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (ledger.Skipped.Count > 0)
                    {
                        <p class="text-[11px] text-gray-500">Not run: @string.Join("; ", ledger.Skipped.Select(x => $"{SearchLabel(x.Source)} ({x.Reason.TrimEnd('.').ToLowerInvariant()})")).</p>
                    }
                    @if (canEdit)
                    {
                        <p class="text-[11px] text-gray-500">"Keep page text" fetches the page once, if the site's robots.txt allows it, and keeps its text with this run so quotes can be checked against it. Only the address, date and fingerprint go into the archive.</p>
                    }
                    @if (keepError != null)
                    {
                        <p class="bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@keepError</p>
                    }
                    @if (screening != null && (screenError ?? (quality != null ? qualityError : null)) is { } tabError)
                    {
                        <p class="bg-red-50 border border-red-200 text-red-800 p-2 text-xs" role="alert">@tabError</p>
                    }
                    @if (canEdit && screening != null && stage == AuBtechReviewAgent.MultivocalScreener.StageScreened)
                    {
                        <p class="text-[11px] text-gray-500">Look at the flagged decisions before scoring the quality: keep or change each one, with a note if you like. The model's decision stays on file next to yours.</p>
                    }
                    @if (screening != null)
                    {
                        <div class="flex items-center justify-between gap-3">
                            <label for="source-filter" class="text-xs text-gray-700">Show</label>
                            <select id="source-filter" class="ui-input py-1 text-xs w-auto" @bind="sourceFilter">
                                @if (quality != null)
                                {
                                    <option value="passed">Passed the quality check (@quality.Count("Passed"))</option>
                                    <option value="below">Below the threshold (@quality.Count("Below threshold"))</option>
                                    <option value="unassessed">Not assessed (@quality.Count("Not assessed"))</option>
                                }
                                <option value="included">Included (@screening.Count("Included"))</option>
                                <option value="look">To look at (@screening.Sources.Count(x => x.NeedsLook))</option>
                                <option value="excluded">Excluded (@screening.Count("Excluded"))</option>
                                <option value="duplicates">Duplicates (@screening.Count("Duplicate"))</option>
                                <option value="all">All (@ledger.Sources.Count)</option>
                            </select>
                        </div>
                    }
                    <ol class="space-y-3">
                        @foreach (var found in ShownSources())
                        {
                            var r = found.Record;
                            var decision = DecisionOf(r.Url);
                            <li class="border-t border-gray-100 pt-3">
                                @if (decision != null)
                                {
                                    <p class="flex flex-wrap items-center gap-1.5 mb-1">
                                        <span class="@DecisionChip(decision.Decision) text-[10px]">@DecisionLabel(decision)</span>
                                        @if (decision.NeedsLook && decision.Decision != "Error")
                                        {
                                            <span class="ui-chip border-amber-200 bg-amber-50 text-amber-800 text-[10px]">look at this</span>
                                        }
                                        @if (decision.Reviewed)
                                        {
                                            <span class="ui-chip border-blue-200 bg-blue-50 text-blue-800 text-[10px]">@(decision.ModelDecision == decision.Decision ? "confirmed by you" : "changed by you")</span>
                                        }
                                    </p>
                                }
                                <a href="@r.Url" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-brand hover:underline">@r.Title</a>
                                <p class="text-[11px] text-gray-500 mt-0.5">
                                    @r.Site · @KindLabel(r.Kind)@(r.Producer.Length > 0 ? $" · {r.Producer}" : "")@(r.Published is DateTime d ? $" · {d:yyyy-MM-dd}" : "")@(r.Signals.Count > 0 ? " · " + string.Join(", ", r.Signals.Select(x => $"{x.Key} {x.Value}")) : "")
                                </p>
                                @if (r.Summary.Length > 0)
                                {
                                    <p class="text-xs text-gray-700 mt-1 line-clamp-3">@r.Summary</p>
                                }
                                @{ var score = QualityOf(r.Url); }
                                @if (score != null)
                                {
                                    <details class="mt-1 text-[11px] text-gray-700">
                                        <summary class="cursor-pointer select-none">
                                            <span class="@QualityChip(score.Outcome) text-[10px]">@(score.Outcome == "Not assessed" ? "Quality not assessed" : $"Quality {score.Points:0.#} of {AuBtechReviewAgent.GreyQualityChecklist.MaxPoints}")</span>
                                        </summary>
                                        @if (score.NotAssessed != null)
                                        {
                                            <p class="mt-1">Not assessed: @score.NotAssessed.</p>
                                            @if (canEdit && stage == AuBtechReviewAgent.MultivocalQualityAssessor.StageAssessed)
                                            {
                                                string address = score.Address;
                                                <button type="button" class="ui-btn-secondary ui-btn-sm mt-1" disabled="@(retrying == address)" @onclick="() => RetryAsync(address)">@(retrying == address ? "Assessing…" : "Try again")</button>
                                            }
                                        }
                                        else
                                        {
                                            <table class="w-full mt-1">
                                                <caption class="sr-only">@($"Quality checklist answers for {r.Title}")</caption>
                                                <tbody>
                                                    @foreach (var item in AuBtechReviewAgent.GreyQualityChecklist.Items)
                                                    {
                                                        var answer = score.Answers.FirstOrDefault(x => x.Id == item.Id);
                                                        <tr class="border-t border-gray-100 align-top">
                                                            <th scope="row" class="py-1 pr-2 font-normal text-gray-500 w-8">@item.Id</th>
                                                            <td class="py-1 pr-2">
                                                                <span class="text-gray-800">@item.Question</span>
                                                                @if (answer != null)
                                                                {
                                                                    <span class="block text-gray-600">@answer.Reason</span>
                                                                    @if (answer.Quote != null && answer.Basis == "model")
                                                                    {
                                                                        <q class="block text-gray-500 italic">@answer.Quote</q>
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="py-1 text-right font-medium whitespace-nowrap">@(answer?.Score.ToString("0.#") ?? "–")@(answer?.Basis == "code" ? " (code)" : "")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            @if (score.Argument is { } argument)
                                            {
                                                <div class="mt-2 border-t border-gray-100 pt-2">
                                                    <p class="font-medium text-gray-800">Opinion piece: its claim and the critical questions (G13)</p>
                                                    <q class="block italic text-gray-600 mt-0.5">@argument.Claim</q>
                                                    @if (!argument.ClaimFound)
                                                    {
                                                        <p class="text-amber-800">This claim was not found word for word in the page.</p>
                                                    }
                                                    <dl class="mt-1 space-y-1">
                                                        @foreach (var question in argument.Questions)
                                                        {
                                                            <div>
                                                                <dt class="text-gray-800">@question.Question</dt>
                                                                <dd class="text-gray-600">@question.Answer</dd>
                                                                @if (question.Quote != null && question.Basis == "model")
                                                                {
                                                                    <dd><q class="italic text-gray-500">@question.Quote</q></dd>
                                                                }
                                                            </div>
                                                        }
                                                    </dl>
                                                </div>
                                            }
                                        }
                                    </details>
                                }
                                @if (decision != null && decision.Reasoning.Length > 0)
                                {
                                    <details class="mt-1 text-[11px] text-gray-600">
                                        <summary class="cursor-pointer select-none text-gray-500">Why</summary>
                                        <p class="mt-1">@decision.Reasoning</p>
                                        @if (decision.Second != null && decision.First != null && decision.First.Decision != decision.Second.Decision)
                                        {
                                            <p class="mt-1">Second screening: @decision.Second.Reasoning</p>
                                        }
                                        @if (decision.Reviewed)
                                        {
                                            <p class="mt-1">You decided: @decision.Decision@(decision.ReviewerNote != null ? $" ({decision.ReviewerNote})" : "")@(decision.ModelDecision != decision.Decision ? $"; the model had decided {decision.ModelDecision}" : "").</p>
                                        }
                                    </details>
                                }
                                @if (canEdit && decision != null && decision.Decision != "Duplicate" && stage == AuBtechReviewAgent.MultivocalScreener.StageScreened)
                                {
                                    string address = decision.Address;
                                    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                                        <label class="sr-only" for="@($"note-{address.GetHashCode():x}")">@($"Your note on {r.Title}")</label>
                                        <input id="@($"note-{address.GetHashCode():x}")" type="text" maxlength="300" placeholder="Note (optional)" class="ui-input py-0.5 text-[11px] w-40"
                                               value="@(reviewNotes.GetValueOrDefault(address) ?? "")" @onchange="e => reviewNotes[address] = e.Value?.ToString() ?? string.Empty" />
                                        @if (decision.Decision != "Included" || decision.NeedsLook)
                                        {
                                            <button type="button" class="ui-btn-secondary ui-btn-sm py-0.5" disabled="@(reviewing == address)" @onclick="() => ReviewAsync(address, true)">@(decision.Decision == "Included" ? "Keep it" : "Include")</button>
                                        }
                                        @if (decision.Decision != "Excluded" || decision.NeedsLook)
                                        {
                                            <button type="button" class="ui-btn-secondary ui-btn-sm py-0.5" disabled="@(reviewing == address)" @onclick="() => ReviewAsync(address, false)">@(decision.Decision == "Excluded" ? "Keep it out" : "Exclude")</button>
                                        }
                                    </div>
                                }
                                @{ var snapshot = SnapshotOf(r.Url); }
                                @if (snapshot is { NotKept: null })
                                {
                                    <p class="text-[11px] text-gray-600 mt-1">
                                        Page text kept @snapshot.AccessedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @snapshot.Characters.ToString("N0") characters · SHA-256 @snapshot.TextSha256[..12]… ·
                                        <a href="@snapshot.WaybackUrl" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline">Wayback Machine</a>
                                    </p>
                                }
                                else if (snapshot != null)
                                {
                                    <p class="text-[11px] text-amber-800 mt-1">Page text not kept: @snapshot.NotKept.</p>
                                }
                                @if (canEdit && (snapshot == null || snapshot.NotKept != null))
                                {
                                    bool busy = keeping.Contains(r.Url);
                                    <button type="button" class="ui-btn-secondary ui-btn-sm mt-1.5" disabled="@busy" @onclick="() => KeepPageAsync(r.Url)"
                                            aria-label="@($"Keep the page text of {r.Title}")">@(busy ? "Fetching…" : snapshot == null ? "Keep page text" : "Try again")</button>
                                }
                            </li>
                        }
                    </ol>
                </div>
            }
            else if (panelTab == "protocol")
            {
                <pre class="flex-1 min-h-[20rem] overflow-y-auto p-5 text-xs leading-relaxed text-gray-800 whitespace-pre-wrap break-words font-mono" tabindex="0" aria-label="Protocol">@(planned != null ? protocolText : ProtocolPreview)</pre>
            }
            else
            {
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-5 text-left font-sans">
                    <div>
                        <h3 class="text-base font-semibold text-gray-900">What this review will do</h3>
                        <p class="text-xs text-gray-600 mt-0.5">With your current answers. The steps marked as built work in this preview; the others follow one block at a time.</p>
                    </div>
                    <ol class="space-y-3">
                        @for (int i = 0; i < PlanSteps.Count; i++)
                        {
                            var s = PlanSteps[i];
                            <li class="flex gap-3">
                                <span class="flex-none w-6 h-6 rounded-full bg-brand/10 text-brand text-[11px] font-semibold flex items-center justify-center">@(i + 1)</span>
                                <span class="text-xs leading-snug flex-1">
                                    <span class="font-semibold text-gray-900">@s.Title</span>
                                    <span class="text-gray-600"> · @s.Text</span>
                                </span>
                                <span class="@(s.Built ? "ui-chip border-green-200 bg-green-50 text-green-800" : "ui-chip border-gray-200 bg-gray-50 text-gray-600") text-[10px] self-start whitespace-nowrap">@(s.Built ? "built" : "not built yet")</span>
                            </li>
                        }
                    </ol>
                    <div class="border-t border-gray-100 pt-4">
                        <h3 class="text-xs font-semibold text-gray-900 mb-2">What you will get</h3>
                        <div class="grid grid-cols-2 gap-2 text-[11px] text-gray-700">
                            <div class="border border-gray-200 p-2"><span class="font-semibold block text-gray-900">Review report</span>structured by the guidelines, every citation clickable to its quote</div>
                            <div class="border border-gray-200 p-2"><span class="font-semibold block text-gray-900">Practitioner summary</span>a short version for the people who use the results</div>
                            <div class="border border-gray-200 p-2"><span class="font-semibold block text-gray-900">Systematic map</span>the sources classified, grey and formal side by side</div>
                            <div class="border border-gray-200 p-2"><span class="font-semibold block text-gray-900">Verifiable archive</span>protocol, sources' fingerprints and every model call</div>
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>
</main>

@code {
    [Parameter] public Guid? RunId { get; set; }

    /// <summary>"grey" when started from the Grey Literature Review card.</summary>
    [SupplyParameterFromQuery(Name = "card")] public string? CardKey { get; set; }

    private static readonly AuBtechReviewAgent.ReviewMethod Method = AuBtechReviewAgent.ReviewMethods.Find("multivocal")!;

    private sealed record Step(string Title, string Question, string Guideline, string NextLabel);

    private static readonly Step[] Steps =
    {
        new("Need", "What is the review for, and who reads it?", "G2", "Need and audience"),
        new("Grey", "Is grey literature needed?", "G3", "Grey literature"),
        new("Questions", "What should the review answer?", "G4–G5", "Questions"),
        new("Search", "What to search, where, how much, and what to include?", "G6–G9, G11", "Search"),
        new("Protocol", "Check the plan before anything is searched.", "G1", "Protocol"),
    };

    private AuBtechReviewAgent.MultivocalPlan plan = new();
    private AuBtechReviewAgent.PlannedRun? planned;
    private string protocolText = "";
    private AuBtechReviewAgent.MultivocalLedger? ledger;
    private string stage = "";
    private bool canEdit;
    private string? editKey;
    private bool searching;
    private AuBtechReviewAgent.MultivocalScreeningFile? screening;
    private Dictionary<string, AuBtechReviewAgent.GreyScreening> decisions = new();
    private bool screeningNow;
    private string? screenProgress;
    private string? screenError;
    private string sourceFilter = "all";
    private AuBtechReviewAgent.MultivocalQualityFile? quality;
    private Dictionary<string, AuBtechReviewAgent.GreyQuality> qualities = new();
    private bool assessing;
    private string? qualityProgress;
    private string? qualityError;
    private readonly Dictionary<string, string> reviewNotes = new();
    private AuBtechReviewAgent.MultivocalMapFile? map;
    private List<AuBtechReviewAgent.MapAttribute>? mapDraft;
    private bool mapping;
    private string? mapError;
    private string? reviewing;
    private string? retrying;
    private Dictionary<string, AuBtechReviewAgent.PageSnapshot> snapshots = new();
    private readonly HashSet<string> keeping = new();
    private string? keepError;
    private string? searchProgress;
    private string? searchError;
    private int step;
    private string panelTab = "plan";
    private bool saving;
    private string? error;

    private bool GreyOnly => planned?.Plan.IsGreyOnly ?? plan.IsGreyOnly;
    private AuBtechReviewAgent.MultivocalPlan Shown => planned?.Plan ?? plan;
    private IReadOnlyList<string> Problems => plan.Problems();
    private string ProtocolPreview =>
        AuBtechReviewAgent.MultivocalProtocol.Write(plan, Guid.Empty, DateTime.UtcNow).Replace(Guid.Empty.ToString(), "assigned when the protocol is written");

    protected override void OnParametersSet()
    {
        var module = AuBtechReviewAgent.ReviewModules.Find("multivocal")!;
        if (!ModuleOptions.CanOpen(module)) { Nav.NotFound(); return; }

        if (RunId is Guid id)
        {
            // A systematic run opened here goes to its own page.
            if (AuBtechReviewAgent.ReviewModules.ElsewhereFor(Runs.LoadHeader(id), module.Key) is string elsewhere)
            {
                Nav.NavigateTo(elsewhere, replace: true);
                return;
            }
            planned = Planner.Load(id);
            protocolText = Runs.ReadProtocol(id) ?? "";
            ledger = Searcher.LoadLedger(id);
            snapshots = Pages.Load(id).Pages.ToDictionary(p => AuBtechReviewAgent.MultivocalSearcher.AddressKey(p.Url));
            SetScreening(Screener.Load(id));
            SetQuality(Quality.Load(id));
            SetMap(Mapper.Load(id));
            if (quality != null) sourceFilter = "passed";
            else if (screening != null) sourceFilter = "included";
            stage = Runs.LoadHeader(id)?.Stage ?? "";
            panelTab = ledger != null ? "sources" : "protocol";
            return;
        }
        plan.Card = CardKey == "grey" ? "grey" : "multivocal";
    }

    /// <summary>What the review will do, with the current answers, and which of its steps are built.</summary>
    private IReadOnlyList<(string Title, string Text, bool Built)> PlanSteps
    {
        get
        {
            var p = Shown;
            int searches = p.GreySearches.Count;
            int questions = p.Numbered().Count;
            string stop = p.StoppingRule switch
            {
                "effort" => $"the top {p.TopHits} hits of each search string",
                "saturation" => "until new sources add nothing new",
                _ => "every hit of every search string",
            };
            return new List<(string, string, bool)>
            {
                ("Protocol", "Your plan is written down before anything is searched, with a fingerprint.", true),
                ("Search", p.IsGreyOnly
                    ? $"{searches} grey literature search{(searches == 1 ? "" : "es")}, {stop}."
                    : $"{searches} grey literature search{(searches == 1 ? "" : "es")} and the academic databases, {stop}.", true),
                ("Selection", p.IsGreyOnly ? "Every source is screened twice against your criteria." : "Grey and academic sources are screened twice, with the same criteria and the same care.", true),
                ("Quality", $"Each grey source is scored on Table 7; below {p.QualityThreshold} of {AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax} points it is left out. Every score rests on a quote.", true),
                ("Map and extraction", "The sources are classified in a systematic map; every extracted item links to its place in the source.", false),
                ("Synthesis", $"The findings are coded and written up to answer {questions} research question{(questions == 1 ? "" : "s")}.", false),
                ("Checking", "Every citation is compared with its source; weak ones get a second check and are repaired.", false),
            };
        }
    }

    /// <summary>The first thing missing in a step, worded for the link above the buttons; null when the step is complete.</summary>
    private string? StepProblem(int index)
    {
        switch (index)
        {
            case 0:
                if (string.IsNullOrWhiteSpace(plan.Topic)) return "Add the topic (step 1).";
                if (string.IsNullOrWhiteSpace(plan.Goal)) return "Add the goal (step 1).";
                if (plan.Audience == null) return "Choose who the review is for (step 1).";
                return null;
            case 1:
                return plan.IncludeGrey.Any(a => a == null) ? "Answer all seven questions on grey literature (step 2)." : null;
            case 2:
                if (plan.Questions.Any(q => string.IsNullOrWhiteSpace(q.Text))) return "Fill in or remove empty research questions (step 3).";
                if (plan.Questions.Any(q => AuBtechReviewAgent.MultivocalGuidelines.FindType(q.Type) == null)) return "Choose a type for every research question (step 3).";
                return null;
            case 3:
                if (plan.GreyTypes.Count == 0) return "Choose at least one kind of grey literature (step 4).";
                if (plan.GreySearches.Count == 0) return "Choose at least one place to search (step 4).";
                if (!plan.HasCriteria) return "Say what a source must be about to be included (step 4).";
                if (plan.QualityThreshold is < 1 or > AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax) return "Set the quality threshold between 1 and 20 points (step 4).";
                if (plan.StoppingRule == "effort" && plan.TopHits is < 10 or > 500) return "Look at between 10 and 500 top hits per search string (step 4).";
                return null;
            default:
                return Problems.Count > 0 ? Problems[0] : null;
        }
    }

    private (int Step, string Text)? FirstProblem()
    {
        for (int i = 0; i < Steps.Length; i++)
            if (StepProblem(i) is { } text) return (i, text);
        return null;
    }

    private string SettingsLine()
    {
        int questions = plan.Numbered().Count;
        return $"{(plan.IsGreyOnly ? "Grey only" : "Grey and academic")} · {questions} research question{(questions == 1 ? "" : "s")} · {plan.GreySearches.Count} search{(plan.GreySearches.Count == 1 ? "" : "es")} · {StoppingSummary()} · threshold {plan.QualityThreshold}/{AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax}";
    }

    private string StoppingSummary() => plan.StoppingRule switch
    {
        "effort" => $"top {plan.TopHits} hits",
        "saturation" => "until saturation",
        _ => "every hit",
    };

    private RenderFragment SettingRow(string label, string value) =>
        @<div class="flex gap-2"><dt class="w-20 flex-none text-gray-500">@label</dt><dd class="text-gray-800 min-w-0 break-words">@value</dd></div>;

    private async Task GoTo(int index)
    {
        step = Math.Clamp(index, 0, Steps.Length - 1);
        error = null;
        if (step == Steps.Length - 1) panelTab = "protocol";
        try { await JS.InvokeVoidAsync("traceableReview.focus", "step-title"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not move focus to the step title: {Message}", ex.Message);
        }
    }

    // Ticks or unticks one key, keeping the guidelines' order so the protocol lists them the same way every time.
    private static List<string> Toggle(List<string> list, string key, ChangeEventArgs e, IEnumerable<string> order)
    {
        bool on = e.Value is bool b && b;
        var chosen = list.Where(k => k != key).Concat(on ? new[] { key } : Array.Empty<string>()).ToHashSet();
        return order.Where(chosen.Contains).ToList();
    }

    // Fills every step with a complete example (preview only), so the form and the protocol can be tried quickly.
    private void FillExample()
    {
        plan = AuBtechReviewAgent.MultivocalPlan.Example(plan.Card);
        error = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The edit key lives only in the browser that planned the run.
        if (!firstRender || planned == null) return;
        try { editKey = await JS.InvokeAsync<string?>("traceableReview.getEditKey", planned.RunId.ToString()); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not read the edit key: {Message}", ex.Message);
        }
        canEdit = Runs.CanEdit(planned.RunId, editKey);
        SetMap(map); // the map is editable only in this browser
        StateHasChanged();
    }

    private async Task SearchAsync()
    {
        if (planned == null || searching) return;
        searching = true;
        searchError = null;
        var progress = new Progress<string>(line => { searchProgress = line; _ = InvokeAsync(StateHasChanged); });
        try
        {
            ledger = await Searcher.SearchAsync(planned.RunId, editKey, progress);
            stage = AuBtechReviewAgent.MultivocalSearcher.StageSearched;
            panelTab = "sources";
        }
        catch (InvalidOperationException ex)
        {
            searchError = ex.Message;
        }
        finally
        {
            searching = false;
            searchProgress = null;
        }
    }

    private void SetScreening(AuBtechReviewAgent.MultivocalScreeningFile? file)
    {
        screening = file;
        decisions = new();
        if (file == null) return;
        foreach (var s in file.Sources) decisions.TryAdd(s.Address, s);
    }

    private async Task ScreenAsync()
    {
        if (planned == null || screeningNow) return;
        screeningNow = true;
        screenError = null;
        var progress = new Progress<string>(line => { screenProgress = line; _ = InvokeAsync(StateHasChanged); });
        try
        {
            SetScreening(await Screener.ScreenAsync(planned.RunId, editKey, progress));
            stage = AuBtechReviewAgent.MultivocalScreener.StageScreened;
            sourceFilter = "included";
        }
        catch (InvalidOperationException ex)
        {
            screenError = ex.Message;
        }
        finally
        {
            screeningNow = false;
            screenProgress = null;
        }
    }

    private void SetQuality(AuBtechReviewAgent.MultivocalQualityFile? file)
    {
        quality = file;
        qualities = new();
        if (file == null) return;
        foreach (var q in file.Sources) qualities.TryAdd(q.Address, q);
    }

    private async Task AssessAsync()
    {
        if (planned == null || assessing) return;
        assessing = true;
        qualityError = null;
        var progress = new Progress<string>(line => { qualityProgress = line; _ = InvokeAsync(StateHasChanged); });
        try
        {
            SetQuality(await Quality.AssessAsync(planned.RunId, editKey, progress));
            snapshots = Pages.Load(planned.RunId).Pages.ToDictionary(p => AuBtechReviewAgent.MultivocalSearcher.AddressKey(p.Url));
            stage = AuBtechReviewAgent.MultivocalQualityAssessor.StageAssessed;
            sourceFilter = "passed";
        }
        catch (InvalidOperationException ex)
        {
            qualityError = ex.Message;
        }
        finally
        {
            assessing = false;
            qualityProgress = null;
        }
    }

    private void SetMap(AuBtechReviewAgent.MultivocalMapFile? file)
    {
        map = file;
        // An editable copy while the map is not fixed; the page shows the fixed version otherwise.
        mapDraft = file is { FixedVersion: null } && stage == AuBtechReviewAgent.MultivocalMapper.StageMapping && canEdit
            ? AuBtechReviewAgent.MultivocalMapper.Clean(file.Latest.Attributes)
            : null;
    }

    private void AddAttribute()
    {
        if (mapDraft == null || planned == null) return;
        mapDraft.Add(new AuBtechReviewAgent.MapAttribute { Question = planned.Plan.Numbered().First().Number, Values = new() { "", "" } });
    }

    private async Task ProposeMapAsync()
    {
        if (planned == null || mapping) return;
        mapping = true;
        mapError = null;
        try
        {
            var file = await Mapper.ProposeAsync(planned.RunId, editKey);
            stage = AuBtechReviewAgent.MultivocalMapper.StageMapping;
            SetMap(file);
            panelTab = "map";
        }
        catch (Exception ex) when (ex is InvalidOperationException or AuBtechReviewAgent.LlmOutputException or HttpRequestException)
        {
            mapError = ex.Message;
        }
        finally
        {
            mapping = false;
        }
    }

    private async Task SaveMapAsync()
    {
        if (planned == null || mapDraft == null || mapping) return;
        mapping = true;
        mapError = null;
        try { SetMap(await Mapper.SaveAsync(planned.RunId, editKey, mapDraft)); }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException) { mapError = ex.Message; }
        finally { mapping = false; }
    }

    private async Task FixMapAsync()
    {
        if (planned == null || map == null || mapDraft == null || mapping) return;
        mapping = true;
        mapError = null;
        try
        {
            // Unsaved edits are kept as a version first, so the fixed map is always one of the saved versions.
            var cleaned = AuBtechReviewAgent.MultivocalMapper.Clean(mapDraft);
            bool changed = System.Text.Json.JsonSerializer.Serialize(cleaned) != System.Text.Json.JsonSerializer.Serialize(map.Latest.Attributes);
            if (changed) await Mapper.SaveAsync(planned.RunId, editKey, cleaned);
            var file = await Mapper.FixAsync(planned.RunId, editKey);
            stage = AuBtechReviewAgent.MultivocalMapper.StageMapped;
            SetMap(file);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException) { mapError = ex.Message; }
        finally { mapping = false; }
    }

    private async Task ReviewAsync(string address, bool include)
    {
        if (planned == null || screening == null || reviewing != null) return;
        reviewing = address;
        screenError = null;
        try
        {
            var entry = await Screener.ReviewAsync(planned.RunId, editKey, address, include, reviewNotes.GetValueOrDefault(address));
            int index = screening.Sources.FindIndex(s => s.Address == address);
            if (index >= 0) screening.Sources[index] = entry;
            decisions[address] = entry;
        }
        catch (InvalidOperationException ex)
        {
            screenError = ex.Message;
        }
        finally
        {
            reviewing = null;
        }
    }

    private async Task RetryAsync(string address)
    {
        if (planned == null || quality == null || retrying != null) return;
        retrying = address;
        qualityError = null;
        try
        {
            var again = await Quality.RetryAsync(planned.RunId, editKey, address);
            int index = quality.Sources.FindIndex(q => q.Address == address);
            if (index >= 0) quality.Sources[index] = again;
            qualities[address] = again;
            snapshots = Pages.Load(planned.RunId).Pages.ToDictionary(p => AuBtechReviewAgent.MultivocalSearcher.AddressKey(p.Url));
        }
        catch (InvalidOperationException ex)
        {
            qualityError = ex.Message;
        }
        finally
        {
            retrying = null;
        }
    }

    private AuBtechReviewAgent.GreyQuality? QualityOf(string url) =>
        qualities.TryGetValue(AuBtechReviewAgent.MultivocalSearcher.AddressKey(url), out var q) ? q : null;

    private static string QualityLine(AuBtechReviewAgent.MultivocalQualityFile f) =>
        $"{f.Count("Passed")} passed, {f.Count("Below threshold")} below {f.Threshold} points" +
        (f.Count("Not assessed") > 0 ? $", {f.Count("Not assessed")} not assessed (no readable page)" : "");

    private static string QualityChip(string outcome) => outcome switch
    {
        "Passed" => "ui-chip border-green-200 bg-green-50 text-green-800",
        "Below threshold" => "ui-chip border-amber-200 bg-amber-50 text-amber-800",
        _ => "ui-chip border-gray-200 bg-gray-50 text-gray-600",
    };

    private AuBtechReviewAgent.GreyScreening? DecisionOf(string url) =>
        decisions.TryGetValue(AuBtechReviewAgent.MultivocalSearcher.AddressKey(url), out var d) ? d : null;

    private IEnumerable<AuBtechReviewAgent.FoundGreySource> ShownSources() => sourceFilter switch
    {
        "passed" => ledger!.Sources.Where(f => QualityOf(f.Record.Url)?.Outcome == "Passed"),
        "below" => ledger!.Sources.Where(f => QualityOf(f.Record.Url)?.Outcome == "Below threshold"),
        "unassessed" => ledger!.Sources.Where(f => QualityOf(f.Record.Url)?.Outcome == "Not assessed"),
        "included" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url)?.Decision == "Included"),
        "excluded" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url)?.Decision == "Excluded"),
        "look" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url) is { NeedsLook: true }),
        "duplicates" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url)?.Decision == "Duplicate"),
        _ => ledger!.Sources,
    };

    private static string ScreeningLine(AuBtechReviewAgent.MultivocalScreeningFile f)
    {
        int look = f.Sources.Count(s => s.NeedsLook);
        int reviewed = f.Sources.Count(s => s.Reviewed);
        string line = $"{f.Count("Included")} included, {f.Count("Excluded")} excluded, {f.Count("Duplicate")} duplicates";
        if (f.Count("Error") > 0) line += $", {f.Count("Error")} not screened";
        if (look > 0) line += $"; {look} to look at";
        if (reviewed > 0) line += $"; {reviewed} looked at by you";
        return f.Kappa is double k ? $"{line}; agreement κ = {k:0.00}" : line;
    }

    private static string DecisionLabel(AuBtechReviewAgent.GreyScreening d) => d.Decision switch
    {
        "Included" => "Included",
        "Excluded" => d.ExclusionReason is { } reason ? $"Excluded: {reason.Replace('-', ' ')}" : "Excluded",
        "Duplicate" => "Duplicate",
        _ => "Not screened",
    };

    private static string DecisionChip(string decision) => decision switch
    {
        "Included" => "ui-chip border-green-200 bg-green-50 text-green-800",
        "Excluded" => "ui-chip border-gray-200 bg-gray-50 text-gray-600",
        "Duplicate" => "ui-chip border-gray-200 bg-white text-gray-500",
        _ => "ui-chip border-red-200 bg-red-50 text-red-800",
    };

    private AuBtechReviewAgent.PageSnapshot? SnapshotOf(string url) =>
        snapshots.TryGetValue(AuBtechReviewAgent.MultivocalSearcher.AddressKey(url), out var snapshot) ? snapshot : null;

    private async Task KeepPageAsync(string url)
    {
        if (planned == null || !keeping.Add(url)) return;
        keepError = null;
        try
        {
            var snapshot = await Pages.KeepAsync(planned.RunId, editKey, url);
            snapshots[AuBtechReviewAgent.MultivocalSearcher.AddressKey(url)] = snapshot;
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            keepError = ex.Message;
            Logger.LogInformation("Keeping a page failed: {Message}", ex.Message.Replace("\r", " ").Replace("\n", " "));
        }
        finally
        {
            keeping.Remove(url);
        }
    }

    private string StageLine() => stage switch
    {
        AuBtechReviewAgent.MultivocalMapper.StageMapped => "Mapped: the systematic map is fixed; the extraction is the next part to be built",
        AuBtechReviewAgent.MultivocalMapper.StageMapping => "Mapping: edit the map and fix it",
        AuBtechReviewAgent.MultivocalQualityAssessor.StageAssessed => "Assessed: the included sources are scored for quality and can be mapped",
        AuBtechReviewAgent.MultivocalQualityAssessor.StageAssessing => "Scoring the quality…",
        AuBtechReviewAgent.MultivocalScreener.StageScreened => "Screened: the grey sources are selected and can be scored for quality",
        AuBtechReviewAgent.MultivocalScreener.StageScreening => "Screening…",
        AuBtechReviewAgent.MultivocalSearcher.StageSearched => "Searched: the grey sources are found and can be screened",
        AuBtechReviewAgent.MultivocalSearcher.StageSearching => "Searching…",
        _ => "Planned: the protocol is written; the search can start",
    };

    private void AddSearchString()
    {
        // The first string starts as the topic, so the reviewer edits it instead of typing it again.
        plan.GreySearchStrings.Add(plan.GreySearchStrings.Count == 0 ? plan.Topic.Trim() : "");
    }

    private static string SearchLabel(string key) =>
        AuBtechReviewAgent.GreySourceCatalog.Create(key)?.Name ?? AuBtechReviewAgent.MultivocalGuidelines.SearchLabel(key);

    private static string KindLabel(string key) =>
        AuBtechReviewAgent.MultivocalGuidelines.GreyTypes.FirstOrDefault(t => t.Key == key).Label ?? key;

    private static string AudienceLabel(AuBtechReviewAgent.ReviewAudience? audience) => audience switch
    {
        AuBtechReviewAgent.ReviewAudience.Researchers => "Researchers",
        AuBtechReviewAgent.ReviewAudience.Practitioners => "Practitioners",
        AuBtechReviewAgent.ReviewAudience.Both => "Both",
        _ => "not set",
    };

    private async Task WriteProtocolAsync()
    {
        if (saving) return;
        saving = true;
        error = null;
        try
        {
            var (newRunId, newEditKey) = await Planner.CreateAsync(plan);
            // Only this browser keeps the run's edit key, as for a systematic review.
            try { await JS.InvokeVoidAsync("traceableReview.saveEditKey", newRunId.ToString(), newEditKey); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
            {
                // The run is written either way; without the key this browser cannot change it later, as for a systematic review.
                Logger.LogDebug("Could not keep the edit key in this browser: {Message}", ex.Message);
            }
            Nav.NavigateTo($"/mlr/{newRunId}");
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
