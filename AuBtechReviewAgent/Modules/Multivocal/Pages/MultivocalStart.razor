@page "/mlr"
@page "/mlr/{RunId:guid}"
@layout AppLayout
@rendermode InteractiveServer
@inject AuBtechReviewAgent.ReviewModulesOptions ModuleOptions
@inject AuBtechReviewAgent.RunStore Runs
@inject AuBtechReviewAgent.MultivocalPlanner Planner
@inject AuBtechReviewAgent.MultivocalSearcher Searcher
@inject AuBtechReviewAgent.MultivocalPages Pages
@inject AuBtechReviewAgent.MultivocalScreener Screener
@inject AuBtechReviewAgent.MultivocalQualityAssessor Quality
@inject AuBtechReviewAgent.MultivocalMapper Mapper
@inject AuBtechReviewAgent.MultivocalExtractor Extractor
@inject AuBtechReviewAgent.MultivocalSynthesiser Synthesiser
@inject AuBtechReviewAgent.MultivocalRunner Runner
@inject AuBtechReviewAgent.MultivocalWriter Writer
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<MultivocalStart> Logger
@implements IDisposable

@* The multivocal review's planning form (MLR block C), laid out like the systematic review's dashboard: the steps
   on the left with one primary action at the bottom, and on the right what the review will do and its protocol.
   The steps themselves follow the Garousi et al. (2019) guidelines, not PRISMA. The Grey Literature Review card is
   on; the multivocal card is shown only where ReviewModules:Preview lists "multivocal" (Development), and until its
   card is on every review planned here is a grey literature review.
   /mlr/{id} shows a planned run and its protocol. *@

<SeoHead Title="@((GreyOnly ? "Grey literature review" : "Multivocal literature review") + (CardOn ? "" : " (preview)"))" Path="/mlr" NoIndex="true"
         Description="Plan a grey literature review following the Garousi et al. (2019) guidelines, with every citation checked against its source." />

<div class="max-w-7xl w-full mx-auto p-4 lg:p-6 space-y-4">

    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <h1 class="font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">@(planned != null ? "Your review" : "New review")</h1>
            <p class="text-sm text-muted mt-1">
                A @(GreyOnly ? "grey literature" : "multivocal") review following
                <a href="@Method.StandardUrl" target="_blank" rel="noopener" class="underline decoration-dotted underline-offset-2" title="@Method.StandardReference">Garousi et al. (2019)</a>,
                in which every citation will be checked against its source. <a href="/glossary" class="text-heading underline underline-offset-2">Glossary</a>
            </p>
        </div>
        @if (!CardOn)
        {
            <span class="bg-partly-fill border-partly-border text-partly border px-2.5 py-1 text-[11px] flex items-center gap-1.5" title="Visible only in Development while it is being built">
                <span class="w-1.5 h-1.5 rounded-full bg-partly-chart"></span>Preview · not available yet
            </span>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">

        <section class="lg:col-span-5 space-y-4 min-w-0" aria-label="Review settings">
            @if (planned != null)
            {
                <div class="bg-page border border-line shadow-sm p-4 space-y-3">
                    <div>
                        <h2 class="text-sm font-semibold text-heading">Review settings</h2>
                        <p class="text-xs font-medium text-heading">@StageLine()</p>
                    </div>
                    <dl class="text-xs space-y-2">
                        @SettingRow("Topic", planned.Plan.Topic)
                        @SettingRow("Goal", planned.Plan.Goal)
                        @SettingRow("Audience", AudienceLabel(planned.Plan.Audience))
                        @SettingRow("Questions", string.Join(" ", planned.Plan.Numbered().Select(q => q.Number)))
                        @SettingRow("Searches", string.Join(", ", planned.Plan.GreySearches.Select(AuBtechReviewAgent.MultivocalGuidelines.SearchLabel)))
                        @SettingRow("Strings", string.Join("; ", planned.Plan.EffectiveGreySearchStrings))
                        @if (planned.Plan.UsesFormalPool)
                        {
                            @SettingRow("Databases", string.Join(", ", planned.Plan.FormalDatabases.Select(AuBtechReviewAgent.SourceCatalog.DisplayNameFor)))
                            @SettingRow("Academic", string.Join("; ", planned.Plan.EffectiveFormalSearchStrings))
                        }
                        @SettingRow("Threshold", $"{planned.Plan.QualityThreshold} of {AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax} points")
                    </dl>
                    <p class="text-[11px] text-muted leading-snug border-t border-line pt-2">
                        Link to this run: <a class="text-heading underline break-all" href="@($"/mlr/{planned.RunId}")">@($"/mlr/{planned.RunId}")</a>.
                        Protocol fingerprint (SHA-256): <span class="font-mono break-all">@planned.ProtocolSha256</span>
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <a href="@($"/api/workspace/{planned.RunId:N}/protocol.md")" class="ui-btn-secondary ui-btn-sm">Download the protocol</a>
                        <a href="@($"/mlr?card={planned.Plan.Card}")" class="ui-btn-primary ui-btn-sm">New review</a>
                    </div>
                </div>
            }
            else if (RunId != null)
            {
                <div class="bg-page border border-line shadow-sm p-4 text-sm text-ink">This run could not be found. It may have expired and been deleted.</div>
            }
            else
            {
                <div class="bg-page border border-line shadow-sm">
                    <nav class="flex border-b border-line overflow-x-auto" aria-label="Steps">
                        @for (int i = 0; i < Steps.Length; i++)
                        {
                            int number = i;
                            bool active = step == number;
                            bool done = StepProblem(number) == null;
                            <button type="button" @onclick="() => GoTo(number)" aria-current="@(active ? "step" : null)" title="@Steps[number].Guideline"
                                    class="flex-1 flex items-center justify-center gap-1.5 px-2 py-3 text-xs whitespace-nowrap border-b-2 -mb-px transition-colors @(active ? "border-heading text-heading font-semibold" : "border-transparent text-muted hover:text-heading")">
                                @if (done && !active)
                                {
                                    <svg class="w-3.5 h-3.5 text-supported" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                                }
                                else
                                {
                                    <span class="w-4 h-4 rounded-full text-[10px] flex items-center justify-center @(active ? "bg-primary text-primary-on" : "bg-active text-muted")">@(number + 1)</span>
                                }
                                @Steps[number].Title
                            </button>
                        }
                    </nav>

                    <div class="p-4 space-y-4">
                        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
                            <span class="ui-chip border-line-field bg-active text-heading">@(GreyOnly ? "Grey Literature Review" : "Multivocal Literature Review")</span>
                            <span>follows @Method.Standard</span>
                            <a href="/start" class="text-heading font-medium hover:underline">Change review type</a>
                        </p>

                        <div class="flex items-center justify-between gap-2">
                            <h2 id="step-title" class="text-sm text-muted" tabindex="-1">@Steps[step].Question <span class="text-muted">(@Steps[step].Guideline)</span></h2>
                            @if (step == 0)
                            {
                                <button type="button" @onclick="FillExample" class="text-xs text-heading font-medium hover:underline whitespace-nowrap">Try an example</button>
                            }
                        </div>

                        @if (step is 0 or 1)
                        {
                            <MultivocalNeedStep Page="this" />
                        }
                        else if (step == 2)
                        {
                            <MultivocalQuestionsStep Page="this" />
                        }
                        else if (step == 3)
                        {
                            <MultivocalSearchStep Page="this" />
                        }
                        else
                        {
                            <p class="text-xs text-muted">The protocol on the right is written from your answers. It is fixed, with a fingerprint, before anything is searched.</p>
                            @if (Problems.Count > 0)
                            {
                                <div class="bg-partly-fill border border-partly-border text-partly p-2 text-xs space-y-0.5" role="alert">
                                    <p class="font-semibold">Before the protocol can be written:</p>
                                    <ul class="list-disc pl-4 space-y-0.5">
                                        @foreach (var item in Problems)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="bg-supported-fill border border-supported-border text-supported p-2 text-xs">Everything is filled in. Check the protocol, then write it.</p>
                            }
                        }
                    </div>

                    @if (error != null)
                    {
                        <div class="mx-4 mb-3 bg-not-supported-fill border border-not-supported-border text-not-supported p-2 text-xs" role="alert">@error</div>
                    }

                    <div class="sticky bottom-0 bg-page/95 backdrop-blur border-t border-line px-4 py-3 space-y-2">
                        <p class="text-[11px] text-muted truncate" title="@SettingsLine()">@SettingsLine()</p>
                        @if (FirstProblem() is { } problem)
                        {
                            <button type="button" @onclick="() => GoTo(problem.Step)" class="block text-left text-xs text-partly underline decoration-dotted underline-offset-2 hover:text-partly">@problem.Text</button>
                        }
                        <div class="flex items-center gap-2">
                            @if (step > 0)
                            {
                                <button type="button" @onclick="() => GoTo(step - 1)" class="ui-btn-ghost">Back</button>
                            }
                            <span class="flex-1"></span>
                            @if (step < Steps.Length - 1)
                            {
                                <button type="button" @onclick="() => GoTo(step + 1)" class="ui-btn-primary">Next: @Steps[step + 1].NextLabel</button>
                            }
                            else
                            {
                                <button type="button" class="ui-btn-primary" disabled="@(Problems.Count > 0 || saving)" @onclick="WriteProtocolAsync">Start the review</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </section>

        <section class="lg:col-span-7 lg:sticky lg:top-4 min-w-0 bg-page border border-line shadow-sm overflow-hidden flex flex-col lg:max-h-[calc(100vh-8rem)]" aria-labelledby="panel-title">
            <h2 id="panel-title" class="sr-only">@(panelTab switch { "protocol" => "Protocol", "progress" => "Progress", "sources" => "Sources found", "map" => "Systematic map", "themes" => "Themes", _ => "What this review will do" })</h2>
            <div class="flex items-center justify-between border-b border-line px-3 flex-none">
                <div class="flex" role="group" aria-label="Show">
                    @if (planned != null)
                    {
                        <button type="button" aria-pressed="@(panelTab == "progress" ? "true" : "false")" @onclick="@(() => ChooseTab("progress"))"
                                class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "progress" ? "border-heading text-heading font-semibold" : "border-transparent text-muted hover:text-heading")">Progress</button>
                    }
                    else
                    {
                        <button type="button" aria-pressed="@(panelTab == "plan" ? "true" : "false")" @onclick="@(() => ChooseTab("plan"))"
                                class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "plan" ? "border-heading text-heading font-semibold" : "border-transparent text-muted hover:text-heading")">Preview</button>
                    }
                    <button type="button" aria-pressed="@(panelTab == "protocol" ? "true" : "false")" @onclick="@(() => ChooseTab("protocol"))"
                            class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "protocol" ? "border-heading text-heading font-semibold" : "border-transparent text-muted hover:text-heading")">Protocol</button>
                    @if (ledger != null)
                    {
                        <button type="button" aria-pressed="@(panelTab == "sources" ? "true" : "false")" @onclick="@(() => ChooseTab("sources"))"
                                class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "sources" ? "border-heading text-heading font-semibold" : "border-transparent text-muted hover:text-heading")">Sources found (@ledger.Sources.Count)</button>
                    }
                    @if (map != null)
                    {
                        <button type="button" aria-pressed="@(panelTab == "map" ? "true" : "false")" @onclick="@(() => ChooseTab("map"))"
                                class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "map" ? "border-heading text-heading font-semibold" : "border-transparent text-muted hover:text-heading")">Map</button>
                    }
                    @if (synthesis != null)
                    {
                        <button type="button" aria-pressed="@(panelTab == "themes" ? "true" : "false")" @onclick="@(() => ChooseTab("themes"))"
                                class="px-3 py-2.5 text-xs border-b-2 -mb-px @(panelTab == "themes" ? "border-heading text-heading font-semibold" : "border-transparent text-muted hover:text-heading")">Themes</button>
                    }
                </div>
                <span class="text-[10px] text-muted font-mono">Garousi et al. 2019</span>
            </div>

            @if (panelTab == "progress" && planned != null)
            {
                bool runRunning = Runner.IsRunning(planned.RunId);
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-4 text-left bg-soft/50">
                    @if (stage == AuBtechReviewAgent.MultivocalWriter.StageChecked)
                    {
                        <div class="bg-page border border-supported-border p-4 shadow-sm space-y-2">
                            <p class="text-sm font-semibold text-heading">Your review is ready</p>
                            <p class="text-xs text-muted">The paper is written and every citation is checked against the kept page of the source it cites. Open a citation to see what the check found; the paper page has main.tex, the references and the archive.</p>
                            <div class="flex flex-wrap gap-2">
                                <a href="@($"/mlr-paper/{planned.RunId}")" class="ui-btn-primary ui-btn-sm inline-block">Read the paper</a>
                                <a href="@($"/mlr-report/{planned.RunId}")" class="ui-btn-secondary ui-btn-sm inline-block" title="The run's report written in code: guidelines table, quotations and source repository">Data appendix</a>
                            </div>
                        </div>
                    }
                    else if (!runRunning && AuBtechReviewAgent.MultivocalRunner.HasStepsLeft(stage))
                    {
                        var status = Runner.StatusOf(planned.RunId);
                        <div class="bg-page border border-line p-4 shadow-sm space-y-2">
                            @if (status?.Error is { } runError)
                            {
                                <p class="bg-not-supported-fill border border-not-supported-border text-not-supported p-2 text-xs" role="alert">@runError</p>
                            }
                            @if (!planned.Plan.HasCriteria)
                            {
                                <p class="text-xs text-muted">This plan was made before the form asked for inclusion criteria, so its sources cannot be screened. Plan a new run to screen.</p>
                            }
                            else if (!canEdit)
                            {
                                <p class="text-xs text-muted">The review is not finished. Only the browser that planned this run can continue it.</p>
                            }
                            else if (status is not { Step: "Stopped" })
                            {
                                <p class="text-xs text-muted">@(status?.Error != null
                                    ? "Continue to try the step again; decisions already made come from the cache."
                                    : "The review stopped before it was finished, for example because the server restarted. It continues from where it stopped.")</p>
                                <button type="button" class="ui-btn-primary ui-btn-sm" @onclick="ContinueRun">Continue the review</button>
                            }
                        </div>
                    }
                    <MultivocalProgressPanel Stage="@stage" Status="Runner.StatusOf(planned.RunId)" Ledger="ledger" Screening="screening" Quality="quality"
                                             Map="map" Extraction="extraction" Synthesis="synthesis" Paper="paper" />
                    @if (runRunning && notifyPermission is "default" or "granted")
                    {
                        @* Runs take a while; people switch tabs. This asks the browser to say when the run is done, as on the systematic review's page. *@
                        <p class="text-xs text-muted flex items-center gap-2">
                            @if (notifyPermission == "granted")
                            {
                                <span>You will get a browser notification when the review is ready, if this tab is in the background.</span>
                            }
                            else
                            {
                                <button type="button" @onclick="AskForNotification" class="ui-btn-secondary ui-btn-sm">Notify me when it is ready</button>
                            }
                        </p>
                    }
                    <p class="text-[11px] text-muted">The other tabs fill as each step finishes: the sources with every decision and score, the map with what was extracted, and the themes.</p>
                </div>
            }
            else if (panelTab == "themes" && synthesis != null && planned != null)
            {
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-5 text-left">
                    <div>
                        <h3 class="text-base font-semibold text-heading">Themes</h3>
                        <p class="text-xs text-muted mt-0.5">The findings of each research question grouped into themes by the model (G13). What each theme rests on is counted in code from its sources; every quote was checked against the kept page text, not the live page.</p>
                        @foreach (var note in synthesis.Notes)
                        {
                            <p class="text-[11px] text-partly mt-1">@note</p>
                        }
                    </div>
                    @foreach (var (number, question) in planned.Plan.Numbered())
                    {
                        var themes = synthesis.Themes.Where(t => t.Question == number).ToList();
                        <section class="space-y-2">
                            <h4 class="text-sm font-semibold text-heading">@number <span class="font-normal text-ink">@question.Text</span></h4>
                            @if (themes.Count == 0)
                            {
                                <p class="text-xs text-muted">No finding answers this question in the extracted sources.</p>
                            }
                            @foreach (var theme in themes)
                            {
                                <div class="border border-line p-3 text-xs space-y-1.5">
                                    <p class="font-medium text-heading">@theme.Name</p>
                                    <p class="text-ink">@theme.Description</p>
                                    <p class="flex flex-wrap gap-1.5">
                                        <span class="ui-chip border-line bg-soft text-ink text-[10px]">@theme.Sources source@(theme.Sources == 1 ? "" : "s")</span>
                                        <span class="ui-chip border-line bg-soft text-ink text-[10px]">tiers 1st @theme.FirstTier · 2nd @theme.SecondTier · 3rd @theme.ThirdTier</span>
                                        <span class="ui-chip border-line bg-soft text-ink text-[10px]">mean quality @theme.MeanQuality.ToString("0.#") of @AuBtechReviewAgent.GreyQualityChecklist.MaxPoints</span>
                                        <span class="@(theme.EvidenceLabel.StartsWith("3rd") ? "ui-chip border-partly-border bg-partly-fill text-partly" : "ui-chip border-line bg-soft text-ink") text-[10px]">@theme.EvidenceLabel</span>
                                    </p>
                                    @if (theme.Tensions.Count > 0)
                                    {
                                        <ul class="text-ink list-disc pl-4">
                                            @foreach (var tension in theme.Tensions)
                                            {
                                                <li>Tension (@tension.FindingA, @tension.FindingB): @tension.Description</li>
                                            }
                                        </ul>
                                    }
                                    <details>
                                        <summary class="cursor-pointer select-none text-muted">@theme.Findings.Count finding@(theme.Findings.Count == 1 ? "" : "s")</summary>
                                        <ul class="mt-1 space-y-1">
                                            @foreach (var finding in synthesis.Findings.Where(f => theme.Findings.Contains(f.Id)))
                                            {
                                                <li>
                                                    <span class="font-medium">@finding.Id</span> @finding.Attribute: @finding.Value
                                                    <span class="text-muted">· @finding.Title · @KindLabel(finding.Kind), @(finding.Tier switch { 1 => "1st", 2 => "2nd", _ => "3rd" }) tier, @finding.QualityPoints.ToString("0.#") points</span>
                                                    <q class="block italic text-muted">@finding.Quote</q>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                </div>
                            }
                            @if (synthesis.SecondPlacements.FirstOrDefault(a => a.Question == number) is { Kappa: double placementKappa } placementAgreement)
                            {
                                <p class="text-[11px] text-muted">Second, independent placement of the values: Cohen's κ = @placementKappa.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) over @placementAgreement.CellsCompared value–theme decisions (@placementAgreement.Disagreements.Count disagreement@(placementAgreement.Disagreements.Count == 1 ? "" : "s")).</p>
                            }
                            @foreach (var other in synthesis.NotCoded.Where(n => n.Question == number))
                            {
                                var notCoded = other;
                                <div class="border border-dashed border-line-field p-3 text-xs space-y-1.5">
                                    <p class="font-medium text-heading">Not coded by the map: @notCoded.Attribute</p>
                                    <p class="text-ink">@notCoded.Findings.Count finding@(notCoded.Findings.Count == 1 ? "" : "s") from @notCoded.Sources source@(notCoded.Sources == 1 ? "" : "s") had the value "Other": the map had no value for them, so they are in no theme. The map may need a new value.</p>
                                    <details>
                                        <summary class="cursor-pointer select-none text-muted">@notCoded.Findings.Count finding@(notCoded.Findings.Count == 1 ? "" : "s")</summary>
                                        <ul class="mt-1 space-y-1">
                                            @foreach (var finding in synthesis.Findings.Where(f => notCoded.Findings.Contains(f.Id)))
                                            {
                                                <li>
                                                    <span class="font-medium">@finding.Id</span>
                                                    <span class="text-muted">@finding.Title · @KindLabel(finding.Kind), @(finding.Tier switch { 1 => "1st", 2 => "2nd", _ => "3rd" }) tier, @finding.QualityPoints.ToString("0.#") points</span>
                                                    <q class="block italic text-muted">@finding.Quote</q>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                </div>
                            }
                        </section>
                    }
                    @if (synthesis.Unsupported.Count > 0)
                    {
                        <section>
                            <h4 class="text-sm font-semibold text-heading">Values left out by the support check</h4>
                            <p class="text-xs text-muted mt-0.5">Their quote is on the source's page but does not say what the value claims.</p>
                            <ul class="text-xs text-ink list-disc pl-4 mt-1 space-y-1">
                                @foreach (var item in synthesis.Unsupported)
                                {
                                    <li><span class="font-medium">@item.Finding</span> @item.Attribute: @item.Value <q class="italic text-muted">@item.Quote</q> <span class="text-muted">@item.Reason</span></li>
                                }
                            </ul>
                        </section>
                    }
                    @if (synthesis.Unassigned.Count > 0)
                    {
                        <section>
                            <h4 class="text-sm font-semibold text-heading">Findings in no theme</h4>
                            <ul class="text-xs text-ink list-disc pl-4 mt-1">
                                @foreach (var item in synthesis.Unassigned)
                                {
                                    <li>@item.Finding: @item.Reason</li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
            else if (panelTab == "map" && map != null && planned != null)
            {
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-4 text-left">
                    <div>
                        <h3 class="text-base font-semibold text-heading">Systematic map</h3>
                        <p class="text-xs text-muted mt-0.5">
                            The attributes recorded for every source (G12, Table 10). Version 1 was proposed by the model from your research questions, with values generalised over @map.SourcesSeen sources that passed.
                            @(map.FixedVersion is int fixedNumber ? $"Version {fixedNumber} is fixed as proposed and is used for the extraction, so every source is extracted against the same attributes." : "It is fixed as proposed when the run continues.")
                        </p>
                    </div>
                    <ol class="text-[11px] text-muted space-y-0.5">
                        @foreach (var version in map.Versions)
                        {
                            <li>Version @version.Number · @(version.By == "model" ? "proposed by the model" : "edited by you") · @version.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @version.Attributes.Count attributes@(map.FixedVersion == version.Number ? " · fixed" : "")</li>
                        }
                    </ol>
                    @foreach (var note in map.Notes)
                    {
                        <p class="text-[11px] text-partly">@note</p>
                    }
                    <div class="border border-line bg-soft p-3 text-[11px] text-ink">
                        <p class="font-medium text-ink">Recorded by code for every source, not by the model</p>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var (factName, factDescription) in AuBtechReviewAgent.MultivocalMapper.KnownFacts)
                            {
                                <li><span class="font-medium">@factName</span>: @factDescription</li>
                            }
                        </ul>
                        <p class="mt-1">Every attribute can also be "not stated" for a source, so values such as "Not specified" are left out of the map.</p>
                    </div>
                    @{
                        var shown = map.FixedVersion is int f ? map.Versions.First(v => v.Number == f) : map.Latest;
                        <table class="w-full text-xs">
                            <caption class="sr-only">The attributes of the map</caption>
                            <thead class="text-left text-muted"><tr><th class="py-1 pr-2 font-medium">Attribute</th><th class="py-1 pr-2 font-medium">For</th><th class="py-1 font-medium">Values</th></tr></thead>
                            <tbody>
                                @foreach (var mapAttribute in shown.Attributes)
                                {
                                    <tr class="border-t border-line align-top">
                                        <td class="py-1 pr-2"><span class="font-medium text-heading">@mapAttribute.Name</span><span class="block text-muted">@mapAttribute.Description</span></td>
                                        <td class="py-1 pr-2">@mapAttribute.Question</td>
                                        <td class="py-1">@(mapAttribute.Open ? "open text" : string.Join(", ", mapAttribute.Values))@(mapAttribute.Multiple ? " (several)" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (extraction != null)
                        {
                            <div>
                                <h4 class="text-sm font-semibold text-heading">How many sources have each value</h4>
                                <p class="text-xs text-muted mt-0.5">From the @extraction.Sources.Count(x => x.Error == null) extracted sources; a source with several values counts once for each. Only values backed by a quote from the page count.</p>
                            </div>
                            @foreach (var mapAttribute in shown.Attributes)
                            {
                                var counts = extraction.Counts(mapAttribute.Name);
                                int most = Math.Max(1, counts.Select(c => c.Sources).DefaultIfEmpty(0).Max());
                                <table class="w-full text-xs">
                                    <caption class="text-left font-medium text-ink pb-1">@mapAttribute.Name <span class="font-normal text-muted">(@mapAttribute.Question)</span></caption>
                                    <tbody>
                                        @foreach (var (value, sources) in counts)
                                        {
                                            <tr class="border-t border-line">
                                                <th scope="row" class="py-0.5 pr-2 font-normal text-left @(value == "not stated" ? "text-muted" : "text-ink") w-1/2">@value</th>
                                                <td class="py-0.5 pr-2 w-1/3"><span class="block h-2 bg-primary/60" style="width:@((100 * sources / most).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></td>
                                                <td class="py-0.5 text-right">@sources</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    }
                </div>
            }
            else if (panelTab == "sources" && ledger != null)
            {
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-5 text-left">
                    <div>
                        <h3 class="text-base font-semibold text-heading">Grey sources found</h3>
                        <p class="text-xs text-muted mt-0.5">@ledger.StoppingApplied @(screening == null ? "Not screened yet." : $"Screened twice with the plan's criteria ({screening.Model}); the quality check comes next.")</p>
                    </div>
                    <table class="w-full text-xs">
                        <caption class="sr-only">Searches and what they returned</caption>
                        <thead class="text-left text-muted"><tr><th class="py-1 pr-2 font-medium">Search</th><th class="py-1 pr-2 font-medium">String</th><th class="py-1 pr-2 font-medium text-right">Hits</th><th class="py-1 font-medium text-right">New</th></tr></thead>
                        <tbody>
                            @foreach (var search in ledger.Searches)
                            {
                                <tr class="border-t border-line">
                                    <td class="py-1 pr-2">@SearchLabel(search.Source)</td>
                                    <td class="py-1 pr-2 text-ink">@search.SearchString</td>
                                    @if (search.Error != null)
                                    {
                                        <td class="py-1 text-not-supported" colspan="2" title="@search.Error">failed</td>
                                    }
                                    else
                                    {
                                        <td class="py-1 pr-2 text-right">@search.Returned</td>
                                        <td class="py-1 text-right">@search.New</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (ledger.Skipped.Count > 0)
                    {
                        <p class="text-[11px] text-muted">Not run: @string.Join("; ", ledger.Skipped.Select(x => $"{SearchLabel(x.Source)} ({x.Reason.TrimEnd('.').ToLowerInvariant()})")).</p>
                    }
                    @if (canEdit)
                    {
                        <p class="text-[11px] text-muted">"Keep page text" fetches the page once, if the site's robots.txt allows it, and keeps its text with this run so quotes can be checked against it. Only the address, date and fingerprint go into the archive.</p>
                    }
                    @if (keepError != null)
                    {
                        <p class="bg-not-supported-fill border border-not-supported-border text-not-supported p-2 text-xs" role="alert">@keepError</p>
                    }
                    @if (screening != null && (screenError ?? (quality != null ? qualityError : null)) is { } tabError)
                    {
                        <p class="bg-not-supported-fill border border-not-supported-border text-not-supported p-2 text-xs" role="alert">@tabError</p>
                    }
                    @if (canEdit && screening != null && stage == AuBtechReviewAgent.MultivocalScreener.StageScreened)
                    {
                        <p class="text-[11px] text-muted">Look at the flagged decisions before scoring the quality: keep or change each one, with a note if you like. The model's decision stays on file next to yours.</p>
                    }
                    @if (screening != null)
                    {
                        <div class="flex items-center justify-between gap-3">
                            <label for="source-filter" class="text-xs text-ink">Show</label>
                            <select id="source-filter" class="ui-input py-1 text-xs w-auto" @bind="sourceFilter">
                                @if (quality != null)
                                {
                                    <option value="passed">Passed the quality check (@quality.Count("Passed"))</option>
                                    <option value="below">Below the threshold (@quality.Count("Below threshold"))</option>
                                    <option value="unassessed">Not assessed (@quality.Count("Not assessed"))</option>
                                }
                                <option value="included">Included (@screening.Count("Included"))</option>
                                <option value="look">To look at (@screening.Sources.Count(x => x.NeedsLook))</option>
                                <option value="excluded">Excluded (@screening.Count("Excluded"))</option>
                                <option value="duplicates">Duplicates (@screening.Count("Duplicate"))</option>
                                <option value="all">All (@ledger.Sources.Count)</option>
                            </select>
                        </div>
                    }
                    <ol class="space-y-3">
                        @foreach (var found in ShownSources())
                        {
                            var r = found.Record;
                            var decision = DecisionOf(r.Url);
                            <li class="border-t border-line pt-3">
                                @if (decision != null)
                                {
                                    <p class="flex flex-wrap items-center gap-1.5 mb-1">
                                        <span class="@DecisionChip(decision.Decision) text-[10px]">@DecisionLabel(decision)</span>
                                        @if (decision.NeedsLook && decision.Decision != "Error")
                                        {
                                            <span class="ui-chip border-partly-border bg-partly-fill text-partly text-[10px]">look at this</span>
                                        }
                                        @if (decision.Reviewed)
                                        {
                                            <span class="ui-chip border-abstract-only-border bg-abstract-only-fill text-abstract-only text-[10px]">@(decision.ModelDecision == decision.Decision ? "confirmed by you" : "changed by you")</span>
                                        }
                                    </p>
                                }
                                <a href="@r.Url" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-heading hover:underline">@r.Title</a>
                                <p class="text-[11px] text-muted mt-0.5">
                                    @r.Site · @KindLabel(r.Kind)@(r.Producer.Length > 0 ? $" · {r.Producer}" : "")@(r.Published is DateTime d ? $" · {d:yyyy-MM-dd}" : "")@(r.Signals.Count > 0 ? " · " + string.Join(", ", r.Signals.Select(x => $"{x.Key} {x.Value}")) : "")
                                </p>
                                @if (r.Summary.Length > 0)
                                {
                                    <p class="text-xs text-ink mt-1 line-clamp-3">@r.Summary</p>
                                }
                                @{ var score = QualityOf(r.Url); }
                                @if (score != null)
                                {
                                    <details class="mt-1 text-[11px] text-ink">
                                        <summary class="cursor-pointer select-none">
                                            <span class="@QualityChip(score.Outcome) text-[10px]">@(score.Outcome == "Not assessed" ? "Quality not assessed" : $"Quality {score.Points:0.#} of {AuBtechReviewAgent.GreyQualityChecklist.MaxPoints}")</span>
                                        </summary>
                                        @if (score.NotAssessed != null)
                                        {
                                            <p class="mt-1">Not assessed: @score.NotAssessed.</p>
                                            @if (canEdit && stage == AuBtechReviewAgent.MultivocalQualityAssessor.StageAssessed && planned != null && !Runner.IsRunning(planned.RunId))
                                            {
                                                string address = score.Address;
                                                <button type="button" class="ui-btn-secondary ui-btn-sm mt-1" disabled="@(retrying == address)" @onclick="() => RetryAsync(address)">@(retrying == address ? "Assessing…" : "Try again")</button>
                                            }
                                        }
                                        else
                                        {
                                            <table class="w-full mt-1">
                                                <caption class="sr-only">@($"Quality checklist answers for {r.Title}")</caption>
                                                <tbody>
                                                    @foreach (var item in AuBtechReviewAgent.GreyQualityChecklist.Items)
                                                    {
                                                        var answer = score.Answers.FirstOrDefault(x => x.Id == item.Id);
                                                        <tr class="border-t border-line align-top">
                                                            <th scope="row" class="py-1 pr-2 font-normal text-muted w-8">@item.Id</th>
                                                            <td class="py-1 pr-2">
                                                                <span class="text-ink">@item.Question</span>
                                                                @if (answer != null)
                                                                {
                                                                    <span class="block text-muted">@answer.Reason</span>
                                                                    @if (answer.Quote != null && answer.Basis == "model")
                                                                    {
                                                                        <q class="block text-muted italic">@answer.Quote</q>
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="py-1 text-right font-medium whitespace-nowrap">@(answer?.Score.ToString("0.#") ?? "–")@(answer?.Basis == "code" ? " (code)" : "")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            @if (score.Argument is { } argument)
                                            {
                                                <div class="mt-2 border-t border-line pt-2">
                                                    <p class="font-medium text-ink">Opinion piece: its claim and the critical questions (G13)</p>
                                                    <q class="block italic text-muted mt-0.5">@argument.Claim</q>
                                                    @if (!argument.ClaimFound)
                                                    {
                                                        <p class="text-partly">This claim was not found word for word in the page.</p>
                                                    }
                                                    <dl class="mt-1 space-y-1">
                                                        @foreach (var question in argument.Questions)
                                                        {
                                                            <div>
                                                                <dt class="text-ink">@question.Question</dt>
                                                                <dd class="text-muted">@question.Answer</dd>
                                                                @if (question.Quote != null && question.Basis == "model")
                                                                {
                                                                    <dd><q class="italic text-muted">@question.Quote</q></dd>
                                                                }
                                                            </div>
                                                        }
                                                    </dl>
                                                </div>
                                            }
                                        }
                                    </details>
                                }
                                @{ var extracted = ExtractionOf(r.Url); }
                                @if (extracted != null)
                                {
                                    <details class="mt-1 text-[11px] text-ink">
                                        <summary class="cursor-pointer select-none"><span class="ui-chip border-heading/30 bg-page text-heading text-[10px]">@(extracted.Error != null ? "Not extracted" : $"Extracted · covers {(extracted.Coverage.Count > 0 ? string.Join(", ", extracted.Coverage) : "no question")}")</span></summary>
                                        @if (extracted.Error != null)
                                        {
                                            <p class="mt-1">@extracted.Error</p>
                                        }
                                        else
                                        {
                                            @if (extracted.Purpose != null)
                                            {
                                                <p class="mt-1"><span class="font-medium">Purpose:</span> @extracted.Purpose.Value <q class="italic text-muted">@extracted.Purpose.Quote</q></p>
                                            }
                                            <p class="mt-1 text-muted">@string.Join(" · ", extracted.Known.Select(k => $"{k.Name}: {k.Value}"))</p>
                                            <dl class="mt-1 space-y-1">
                                                @foreach (var item in extracted.Attributes)
                                                {
                                                    <div>
                                                        <dt class="font-medium text-ink">@item.Attribute</dt>
                                                        @if (item.NotStated)
                                                        {
                                                            <dd class="text-muted">not stated</dd>
                                                        }
                                                        @foreach (var value in item.Values)
                                                        {
                                                            <dd>@value.Value <q class="italic text-muted">@value.Quote</q></dd>
                                                        }
                                                        @if (item.Unsupported.Count > 0)
                                                        {
                                                            <dd class="text-partly">Left out, as the quote was not found in the page: @string.Join(", ", item.Unsupported.Select(u => u.Value))</dd>
                                                        }
                                                    </div>
                                                }
                                            </dl>
                                        }
                                    </details>
                                }
                                @if (decision != null && decision.Reasoning.Length > 0)
                                {
                                    <details class="mt-1 text-[11px] text-muted">
                                        <summary class="cursor-pointer select-none text-muted">Why</summary>
                                        <p class="mt-1">@decision.Reasoning</p>
                                        @if (decision.Second != null && decision.First != null && decision.First.Decision != decision.Second.Decision)
                                        {
                                            <p class="mt-1">Second screening: @decision.Second.Reasoning</p>
                                        }
                                        @if (decision.Reviewed)
                                        {
                                            <p class="mt-1">You decided: @decision.Decision@(decision.ReviewerNote != null ? $" ({decision.ReviewerNote})" : "")@(decision.ModelDecision != decision.Decision ? $"; the model had decided {decision.ModelDecision}" : "").</p>
                                        }
                                    </details>
                                }
                                @if (canEdit && decision != null && decision.Decision != "Duplicate" && stage == AuBtechReviewAgent.MultivocalScreener.StageScreened && planned != null && !Runner.IsRunning(planned.RunId))
                                {
                                    string address = decision.Address;
                                    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                                        <label class="sr-only" for="@($"note-{address.GetHashCode():x}")">@($"Your note on {r.Title}")</label>
                                        <input id="@($"note-{address.GetHashCode():x}")" type="text" maxlength="300" placeholder="Note (optional)" class="ui-input py-0.5 text-[11px] w-40"
                                               value="@(reviewNotes.GetValueOrDefault(address) ?? "")" @onchange="e => reviewNotes[address] = e.Value?.ToString() ?? string.Empty" />
                                        @if (decision.Decision != "Included" || decision.NeedsLook)
                                        {
                                            <button type="button" class="ui-btn-secondary ui-btn-sm py-0.5" disabled="@(reviewing == address)" @onclick="() => ReviewAsync(address, true)">@(decision.Decision == "Included" ? "Keep it" : "Include")</button>
                                        }
                                        @if (decision.Decision != "Excluded" || decision.NeedsLook)
                                        {
                                            <button type="button" class="ui-btn-secondary ui-btn-sm py-0.5" disabled="@(reviewing == address)" @onclick="() => ReviewAsync(address, false)">@(decision.Decision == "Excluded" ? "Keep it out" : "Exclude")</button>
                                        }
                                    </div>
                                }
                                @{ var snapshot = SnapshotOf(r.Url); }
                                @if (snapshot is { NotKept: null })
                                {
                                    <p class="text-[11px] text-muted mt-1">
                                        Page text kept @snapshot.AccessedUtc.ToString("yyyy-MM-dd HH:mm") UTC · @snapshot.Characters.ToString("N0") characters · SHA-256 @snapshot.TextSha256[..12]… ·
                                        <a href="@snapshot.WaybackUrl" target="_blank" rel="noopener noreferrer" class="text-heading hover:underline">Wayback Machine</a>
                                    </p>
                                }
                                else if (snapshot != null)
                                {
                                    <p class="text-[11px] text-partly mt-1">Page text not kept: @snapshot.NotKept.</p>
                                }
                                @if (canEdit && (snapshot == null || snapshot.NotKept != null))
                                {
                                    bool busy = keeping.Contains(r.Url);
                                    <button type="button" class="ui-btn-secondary ui-btn-sm mt-1.5" disabled="@busy" @onclick="() => KeepPageAsync(r.Url)"
                                            aria-label="@($"Keep the page text of {r.Title}")">@(busy ? "Fetching…" : snapshot == null ? "Keep page text" : "Try again")</button>
                                }
                            </li>
                        }
                    </ol>
                </div>
            }
            else if (panelTab == "protocol")
            {
                <pre class="flex-1 min-h-[20rem] overflow-y-auto p-5 text-xs leading-relaxed text-ink whitespace-pre-wrap break-words font-mono" tabindex="0" aria-label="Protocol">@(planned != null ? protocolText : ProtocolPreview)</pre>
            }
            else
            {
                <div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-5 text-left font-sans">
                    <div>
                        <h3 class="text-base font-semibold text-heading">What this review will do</h3>
                        <p class="text-xs text-muted mt-0.5">With your current answers.@(CardOn ? "" : " The steps marked as built work in this preview; the others follow one block at a time.")</p>
                    </div>
                    <ol class="space-y-3">
                        @for (int i = 0; i < PlanSteps.Count; i++)
                        {
                            var s = PlanSteps[i];
                            <li class="flex gap-3">
                                <span class="flex-none w-6 h-6 rounded-full bg-primary/10 text-heading text-[11px] font-semibold flex items-center justify-center">@(i + 1)</span>
                                <span class="text-xs leading-snug flex-1">
                                    <span class="font-semibold text-heading">@s.Title</span>
                                    <span class="text-muted"> · @s.Text</span>
                                </span>
                                <span class="@(s.Built ? "ui-chip border-supported-border bg-supported-fill text-supported" : "ui-chip border-line bg-soft text-muted") text-[10px] self-start whitespace-nowrap">@(s.Built ? "built" : "not built yet")</span>
                            </li>
                        }
                    </ol>
                    <div class="border-t border-line pt-4">
                        <h3 class="text-xs font-semibold text-heading mb-2">What you will get</h3>
                        <div class="grid grid-cols-2 gap-2 text-[11px] text-ink">
                            <div class="border border-line p-2"><span class="font-semibold block text-heading">Review paper</span>structured by the guidelines, with a summary for practitioners; every citation clickable to its quote</div>
                            <div class="border border-line p-2"><span class="font-semibold block text-heading">LaTeX manuscript</span>plus BibTeX and RIS for your reference manager</div>
                            <div class="border border-line p-2"><span class="font-semibold block text-heading">Systematic map</span>the sources classified by your research questions, each value with its quote</div>
                            <div class="border border-line p-2"><span class="font-semibold block text-heading">Verifiable archive</span>protocol, sources' fingerprints and every model call</div>
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    /// <summary>What the review will do, with the current answers, and which of its steps are built.</summary>
    private IReadOnlyList<(string Title, string Text, bool Built)> PlanSteps
    {
        get
        {
            var p = Shown;
            int searches = p.GreySearches.Count;
            int questions = p.Numbered().Count;
            string stop = p.StoppingRule switch
            {
                "effort" => $"the top {p.TopHits} hits of each search string",
                "saturation" => "until new sources add nothing new",
                _ => "every hit of every search string",
            };
            // The same stages as the systematic review's preview, in the guidelines' words; built ones are marked.
            return new List<(string, string, bool)>
            {
                ("Protocol", "Your plan is written down before anything is searched, with a fingerprint.", true),
                ("Search", p.UsesFormalPool
                    ? $"{searches} grey literature search{(searches == 1 ? "" : "es")} and {p.FormalDatabases.Count} academic database{(p.FormalDatabases.Count == 1 ? "" : "s")}, each with its own search strings, {stop}."
                    : $"{searches} grey literature search{(searches == 1 ? "" : "es")}, {stop}.", !p.UsesFormalPool), // the academic search comes in block I-2
                ("Selection", p.UsesFormalPool ? "Grey and academic sources are screened twice, with the same criteria and the same care." : "Every source is screened twice against your criteria; a source the two screenings disagree on is kept and marked for you to look at.", !p.UsesFormalPool), // academic screening comes in block I-3
                ("Quality", $"Each source is scored on Table 7; below {p.QualityThreshold} of {AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax} points it is left out. Every score rests on a quote.", true),
                ("Map and extraction", "The sources are classified in a systematic map proposed from your research questions; every extracted value rests on a quote from the source's page.", true),
                ("Synthesis", $"The findings are grouped into themes to answer {questions} research question{(questions == 1 ? "" : "s")}, each theme labelled with the kind and quality of the sources it rests on.", true),
                ("Writing", "The paper is written from the findings: an outline, one section per theme, the discussion, a summary for practitioners and an automated peer review; the title and abstract last.", false),
                ("Checking", "Every citation is compared with the kept text of the page it cites; weak ones get a second check and are repaired.", false),
            };
        }
    }

    private RenderFragment SettingRow(string label, string value) =>
        @<div class="flex gap-2"><dt class="w-20 flex-none text-muted">@label</dt><dd class="text-ink min-w-0 break-words">@value</dd></div>;

    private AuBtechReviewAgent.GreyExtraction? ExtractionOf(string url) =>
        extractions.TryGetValue(AuBtechReviewAgent.MultivocalSearcher.AddressKey(url), out var x) ? x : null;

    private async Task ReviewAsync(string address, bool include)
    {
        if (planned == null || screening == null || reviewing != null) return;
        reviewing = address;
        screenError = null;
        try
        {
            var entry = await Screener.ReviewAsync(planned.RunId, editKey, address, include, reviewNotes.GetValueOrDefault(address));
            int index = screening.Sources.FindIndex(s => s.Address == address);
            if (index >= 0) screening.Sources[index] = entry;
            decisions[address] = entry;
        }
        catch (InvalidOperationException ex)
        {
            screenError = ex.Message;
        }
        finally
        {
            reviewing = null;
        }
    }

    private async Task RetryAsync(string address)
    {
        if (planned == null || quality == null || retrying != null) return;
        retrying = address;
        qualityError = null;
        try
        {
            var again = await Quality.RetryAsync(planned.RunId, editKey, address);
            int index = quality.Sources.FindIndex(q => q.Address == address);
            if (index >= 0) quality.Sources[index] = again;
            qualities[address] = again;
            snapshots = Pages.Load(planned.RunId).Pages.ToDictionary(p => AuBtechReviewAgent.MultivocalSearcher.AddressKey(p.Url));
        }
        catch (InvalidOperationException ex)
        {
            qualityError = ex.Message;
        }
        finally
        {
            retrying = null;
        }
    }

    private AuBtechReviewAgent.GreyQuality? QualityOf(string url) =>
        qualities.TryGetValue(AuBtechReviewAgent.MultivocalSearcher.AddressKey(url), out var q) ? q : null;

    private static string QualityChip(string outcome) => outcome switch
    {
        "Passed" => "ui-chip border-supported-border bg-supported-fill text-supported",
        "Below threshold" => "ui-chip border-partly-border bg-partly-fill text-partly",
        _ => "ui-chip border-line bg-soft text-muted",
    };

    private AuBtechReviewAgent.GreyScreening? DecisionOf(string url) =>
        decisions.TryGetValue(AuBtechReviewAgent.MultivocalSearcher.AddressKey(url), out var d) ? d : null;

    private IEnumerable<AuBtechReviewAgent.FoundGreySource> ShownSources() => sourceFilter switch
    {
        "passed" => ledger!.Sources.Where(f => QualityOf(f.Record.Url)?.Outcome == "Passed"),
        "below" => ledger!.Sources.Where(f => QualityOf(f.Record.Url)?.Outcome == "Below threshold"),
        "unassessed" => ledger!.Sources.Where(f => QualityOf(f.Record.Url)?.Outcome == "Not assessed"),
        "included" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url)?.Decision == "Included"),
        "excluded" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url)?.Decision == "Excluded"),
        "look" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url) is { NeedsLook: true }),
        "duplicates" => ledger!.Sources.Where(f => DecisionOf(f.Record.Url)?.Decision == "Duplicate"),
        _ => ledger!.Sources,
    };

    private static string DecisionLabel(AuBtechReviewAgent.GreyScreening d) => d.Decision switch
    {
        "Included" => "Included",
        "Excluded" => d.ExclusionReason is { } reason ? $"Excluded: {reason.Replace('-', ' ')}" : "Excluded",
        "Duplicate" => "Duplicate",
        _ => "Not screened",
    };

    private static string DecisionChip(string decision) => decision switch
    {
        "Included" => "ui-chip border-supported-border bg-supported-fill text-supported",
        "Excluded" => "ui-chip border-line bg-soft text-muted",
        "Duplicate" => "ui-chip border-line bg-page text-muted",
        _ => "ui-chip border-not-supported-border bg-not-supported-fill text-not-supported",
    };

    private AuBtechReviewAgent.PageSnapshot? SnapshotOf(string url) =>
        snapshots.TryGetValue(AuBtechReviewAgent.MultivocalSearcher.AddressKey(url), out var snapshot) ? snapshot : null;

    private async Task KeepPageAsync(string url)
    {
        if (planned == null || !keeping.Add(url)) return;
        keepError = null;
        try
        {
            var snapshot = await Pages.KeepAsync(planned.RunId, editKey, url);
            snapshots[AuBtechReviewAgent.MultivocalSearcher.AddressKey(url)] = snapshot;
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            keepError = ex.Message;
            Logger.LogInformation("Keeping a page failed: {Message}", ex.Message.Replace("\r", " ").Replace("\n", " "));
        }
        finally
        {
            keeping.Remove(url);
        }
    }

    private static string SearchLabel(string key) =>
        AuBtechReviewAgent.GreySourceCatalog.Create(key)?.Name ?? AuBtechReviewAgent.MultivocalGuidelines.SearchLabel(key);

    private static string KindLabel(string key) =>
        AuBtechReviewAgent.MultivocalGuidelines.GreyTypes.FirstOrDefault(t => t.Key == key).Label ?? key;
}
