@page "/mlr-paper/{RunId:guid}"
@layout AppLayout
@rendermode InteractiveServer
@inject AuBtechReviewAgent.ReviewModulesOptions ModuleOptions
@inject AuBtechReviewAgent.RunStore Runs
@inject AuBtechReviewAgent.MultivocalReporter Reporter
@inject AuBtechReviewAgent.MultivocalWriter Writer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<MultivocalPaperPage> Logger

@* The paper of a checked multivocal run (MLR G-8), laid out like the systematic review's Review output page and
   built from the same shared parts (Components/Paper): every citation in the written text is a button that opens what
   the check found, and the bar at the top steps through the citations that need attention. The written parts come
   from mlr-paper.json; the method, the data, the answers in code, the notes, the declarations and the references are
   written in code from the run's files each time the page opens, as main.tex is. *@

<SeoHead Title="Grey literature review paper" Path="/mlr-paper" NoIndex="true"
         Description="The paper of a grey literature review following the Garousi et al. (2019) guidelines, with every citation checked." />

@if (input == null || paper == null || paper.CheckedUtc == null)
{
    <div class="mx-auto my-12 max-w-xl px-4">
        <div class="ui-card p-6 text-center">
            <h1 class="font-display text-lg font-semibold text-heading">No checked paper yet</h1>
            <p class="mt-1 text-sm text-muted">The paper is written and checked after the synthesis.</p>
            <a href="@($"/mlr/{RunId}")" class="ui-btn-primary mt-4 min-h-[44px]">Back to the review</a>
        </div>
    </div>
}
else
{
    string api = $"/api/workspace/{RunId}";
    var counts = AuBtechReviewAgent.VerdictTally.From(checks, audit?.RemovedCitations.Count ?? 0);
    <div class="mx-auto w-full max-w-[1600px] px-[clamp(16px,3vw,40px)] py-4 sm:py-8 print:max-w-none print:p-0">

        <div class="mb-4 flex flex-wrap items-center justify-between gap-2 print:hidden">
            <a href="@($"/mlr/{RunId}")" class="ui-btn-ghost min-h-[44px] px-2"><span aria-hidden="true">←</span> Back to the review</a>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" @onclick="PrintPaper" class="ui-btn-secondary min-h-[44px] max-sm:hidden" title="Print the paper, or choose Save as PDF in the print window">Print or save as PDF</button>
                <a href="@($"{api}/archive")" class="ui-btn-primary min-h-[44px]" title="Every file of the run, with a manifest of their fingerprints">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download archive
                </a>
                <details class="relative">
                    <summary class="ui-btn-secondary min-h-[44px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">More<span class="sr-only"> actions for this paper</span></summary>
                    <div class="absolute right-0 z-40 mt-2 w-[min(20rem,calc(100vw-2rem))] space-y-1 rounded-card border border-line bg-page p-2 shadow-lift">
                        <a href="@($"{api}/main.tex")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">The paper as LaTeX (main.tex)</a>
                        <a href="@($"{api}/references.bib")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">References as BibTeX</a>
                        <a href="@($"{api}/references.ris")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">References as RIS (Zotero, EndNote)</a>
                        <a href="@($"{api}/screened.ris")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active" title="Every screened source, tagged with its decision">Every screened source as RIS</a>
                        <a href="@($"/mlr-report/{RunId}")" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active" title="The run's report written in code: guidelines table, quotations and source repository">Data appendix</a>
                    </div>
                </details>
            </div>
        </div>

        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[220px_minmax(0,1fr)] xl:gap-8 min-[1500px]:grid-cols-[220px_minmax(0,1fr)_350px] print:block">
            <div class="max-lg:hidden print:hidden">
                <ReportContents Entries="Outline" PageHref="@($"/mlr-paper/{RunId}")" />
            </div>

            <div class="min-w-0">
                <CitationAttentionBar Attention="Attention" Index="attentionIndex" OnStep="StepAttention" HideFromLarge="true" />
                <article class="mx-auto w-full max-w-[880px] rounded-card border border-line bg-page px-5 py-6 text-[17px] leading-[1.7] text-ink shadow-card sm:px-10 sm:py-10 [&_blockquote]:max-w-[70ch] [&_h3]:max-w-[70ch] [&_p]:max-w-[70ch] print:max-w-none print:rounded-none print:border-0 print:p-0 print:text-[11pt] print:leading-normal print:shadow-none">

                    <header class="border-b border-line pb-6">
                        <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">@AuBtechReviewAgent.MultivocalPaper.KindLabel(input.Planned.Plan) · Garousi et al. (2019) · @paper.WrittenUtc.ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
                        <h1 class="mt-2 max-w-[24ch] font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">@paper.Title</h1>
                        <p class="mt-3 text-[15px] text-muted">@RunLine</p>
                        <p class="mt-1 text-xs text-muted">
                            Department of Business Development and Technology, Aarhus University ·
                            <span class="break-all font-mono">protocol @input.Planned.ProtocolSha256</span>
                        </p>
                        @if (counts.Total > 0)
                        {
                            <div class="mt-5 rounded-card border border-line bg-soft p-4 sm:p-5 print:hidden">
                                <h2 class="font-display text-base font-semibold text-heading">@counts.Total @(counts.Total == 1 ? "citation" : "citations") checked against the sources</h2>
                                <div class="mt-2"><VerdictBar Counts="counts" /></div>
                                <p class="mt-2 text-[15px] text-muted">
                                    Each number in the text is coloured by what the check found against the kept text of the cited page. Open one to see the passage it was checked against.
                                    @(counts.Flagged > 0 ? $"{counts.Flagged} {(counts.Flagged == 1 ? "citation is" : "citations are")} only partly or not supported; they stay in the paper, marked." : "")
                                </p>
                            </div>
                        }
                    </header>

                    <section id="@AuBtechReviewAgent.ReportOutline.AbstractId" data-report-section class="scroll-mt-20 pt-6">
                        <h2 class="font-display text-xl font-semibold tracking-tight text-heading">Abstract</h2>
                        <p class="mt-2">@paper.Abstract</p>
                    </section>

                    <div class="space-y-10 pt-8">
                        <section id="@AuBtechReviewAgent.ReportOutline.IntroductionId" data-report-section class="scroll-mt-20 space-y-5">
                            <h2 class="font-display text-xl font-semibold tracking-tight text-heading">1. Introduction</h2>
                            <div class="space-y-2">
                                <h3 class="font-display text-base font-semibold text-heading">1.1 Rationale</h3>
                                @Cited(AuBtechReviewAgent.MultivocalWriter.RationaleField, paper.Rationale)
                            </div>
                            <div class="space-y-2">
                                <h3 class="font-display text-base font-semibold text-heading">1.2 Objectives and research questions</h3>
                                <p>@AuBtechReviewAgent.MultivocalPaper.Objectives(input.Planned.Plan, paper.Objectives)</p>
                            </div>
                        </section>

                        <section id="@AuBtechReviewAgent.ReportOutline.MethodologyId" data-report-section class="scroll-mt-20 space-y-5">
                            <h2 class="font-display text-xl font-semibold tracking-tight text-heading">2. Method</h2>
                            <p class="text-[15px] text-muted">Written in code from the run's files, one part per phase of the Garousi et al. (2019) guidelines.</p>
                            @{ int methodNumber = 0; }
                            @foreach (var section in AuBtechReviewAgent.MultivocalReporter.MethodSections(input))
                            {
                                methodNumber++;
                                var current = section;
                                <div class="space-y-2">
                                    <h3 class="font-display text-base font-semibold text-heading">2.@methodNumber @AuBtechReviewAgent.MultivocalPaperParts.ToPaperSection(current).Heading</h3>
                                    @Blocks(current.Blocks)
                                </div>
                            }
                        </section>

                        <section id="@AuBtechReviewAgent.ReportOutline.StudiesId" data-report-section class="scroll-mt-20 space-y-5">
                            <h2 class="font-display text-xl font-semibold tracking-tight text-heading">3. Data and the flow of sources</h2>
                            <p>@AuBtechReviewAgent.MultivocalPaperParts.DataText(input)</p>
                            @{ var flow = AuBtechReviewAgent.MultivocalPaperParts.Flow(input); }
                            <ol class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-3" aria-label="Flow of sources">
                                @FlowStep("Found", flow.Found, $"from {flow.Searches} searches")
                                @FlowStep("Screened twice", flow.Screened, $"{flow.Duplicates} duplicates set aside")
                                @FlowStep("Included", flow.Included, $"{flow.Excluded} excluded")
                                @FlowStep("Passed the quality threshold", flow.Passed, $"{flow.BelowThreshold} below it, {flow.NotAssessed} not assessed")
                                @FlowStep("Extracted", flow.Extracted, flow.NotExtracted > 0 ? $"{flow.NotExtracted} could not be" : "against the fixed map")
                                @FlowStep("Synthesised", flow.Themes, $"themes from {flow.Findings} findings")
                            </ol>
                            @Table(new AuBtechReviewAgent.PaperTable("Extracted sources by kind of grey literature", new[] { "Kind", "Outlet tier", "Sources" },
                                AuBtechReviewAgent.MultivocalPaperParts.Kinds(input).Select(k => (IReadOnlyList<string>)new[] { k.Label, Ordinal(k.Tier), k.Sources.ToString() }).ToList()))
                            @Table(AuBtechReviewAgent.MultivocalPaperParts.MapCounts(input))
                        </section>

                        <section id="@AuBtechReviewAgent.ReportOutline.ResultsId" data-report-section class="scroll-mt-20 space-y-5">
                            <h2 class="font-display text-xl font-semibold tracking-tight text-heading">4. Results</h2>
                            <p>@AuBtechReviewAgent.MultivocalPaper.ResultsText(paper)</p>
                            @for (int k = 0; k < paper.Results.Count; k++)
                            {
                                var current = paper.Results[k];
                                int number = k + 1;
                                <div class="space-y-2">
                                    <h3 id="@AuBtechReviewAgent.ReportOutline.ResultId(k)" data-report-section class="font-display text-base font-semibold text-heading scroll-mt-20 pt-4">4.@number @AuBtechReviewAgent.ReportOutline.ResultHeading(current)</h3>
                                    @if (current.Kind == "theme")
                                    {
                                        @Cited(current.Field, current.Text)
                                        @if (!string.IsNullOrWhiteSpace(current.Note))
                                        {
                                            <p class="text-[15px] italic text-muted">@current.Note</p>
                                        }
                                    }
                                    else
                                    {
                                        var question = input.Planned.Plan.Numbered().FirstOrDefault(q => q.Number == current.Question).Question;
                                        @if (question != null && AuBtechReviewAgent.MultivocalPaperParts.AnsweredInCode(question.Type))
                                        {
                                            @* Written in code each time from the run's files, so the lead and the tables always match the map. *@
                                            <p>@AuBtechReviewAgent.MultivocalPaperParts.CodeAnswerLead(input, current.Question, question)</p>
                                            @foreach (var table in AuBtechReviewAgent.MultivocalPaperParts.CodeAnswerTables(input, current.Question))
                                            {
                                                @Table(table)
                                            }
                                        }
                                        else
                                        {
                                            <p>@current.Text</p>
                                        }
                                    }
                                </div>
                            }
                        </section>

                        <section id="@AuBtechReviewAgent.ReportOutline.DiscussionId" data-report-section class="scroll-mt-20 space-y-5">
                            <h2 class="font-display text-xl font-semibold tracking-tight text-heading">5. Discussion</h2>
                            @Cited(AuBtechReviewAgent.MultivocalWriter.DiscussionField, paper.Discussion)
                            @if (audit?.SupportSummary != null)
                            {
                                <div class="space-y-2">
                                    <h3 class="font-display text-base font-semibold text-heading">5.1 Automated citation check</h3>
                                    <p>@AuBtechReviewAgent.MultivocalPaper.CheckNote(audit)</p>
                                </div>
                            }
                        </section>

                        @if (paper.SummaryItems.Count > 0)
                        {
                            <section id="@AuBtechReviewAgent.ReportOutline.SummaryId" data-report-section class="scroll-mt-20 space-y-5">
                                <h2 class="font-display text-xl font-semibold tracking-tight text-heading">6. Summary for practitioners</h2>
                                @if (!string.IsNullOrWhiteSpace(paper.SummaryLead))
                                {
                                    <p>@paper.SummaryLead</p>
                                }
                                @Cited(AuBtechReviewAgent.MultivocalWriter.SummaryField, string.Join("\n\n", paper.SummaryItems))
                            </section>
                        }

                        <section id="@AuBtechReviewAgent.ReportOutline.DeclarationsId" data-report-section class="scroll-mt-20 space-y-5">
                            <h2 class="font-display text-xl font-semibold tracking-tight text-heading">@AuBtechReviewAgent.ReportOutline.DeclarationsNumber(paper). Declarations</h2>
                            @foreach (var declaration in AuBtechReviewAgent.MultivocalPaper.Declarations(input, paper))
                            {
                                var current = declaration;
                                <div class="space-y-2">
                                    <h3 class="font-display text-base font-semibold text-heading">@current.Heading</h3>
                                    <p class="break-words">@current.Text</p>
                                </div>
                            }
                        </section>
                    </div>

                    <section id="@AuBtechReviewAgent.ReportOutline.ReferencesId" data-report-section class="mt-10 scroll-mt-20 border-t border-line pt-8">
                        <h2 class="font-display text-xl font-semibold tracking-tight text-heading">References</h2>
                        <ol class="mt-4 space-y-2 text-[15px] leading-relaxed">
                            @foreach (var reference in references)
                            {
                                var current = reference;
                                <li id="@($"ref-{current.Number}")" class="break-words">[@current.Number] @ReferenceLine(current)</li>
                            }
                        </ol>
                    </section>
                </article>
            </div>

            <div class="hidden min-[1500px]:block print:hidden">
                <CitationCheckPanel Checks="checks" Filter="@checkFilter" OnFilter="SetCheckFilter" Position="checkIndex" OnNext="StepCheck"
                                    RunId="RunId" Multivocal="true" />
            </div>
        </div>
    </div>
}

@code {
    private RenderFragment Cited(string field, string text) =>
        @<CitedProse Field="@field" Text="@text" Checks="checks" Open="openCitation" SourceNoun="page"
                     OnToggle="@(c => ToggleCitation(c.Field, c.Sentence, c.Reference))" OnClose="CloseCitation"
                     SourceTitle="@(reference => references.FirstOrDefault(r => r.Number == reference)?.Title)" />;

    private static RenderFragment FlowStep(string label, int count, string note) =>
        @<li class="border border-line bg-soft p-3"><span class="block text-xs font-semibold uppercase tracking-wider text-muted">@label</span><span class="block font-mono text-lg font-semibold text-heading">@count</span><span class="block text-xs text-muted">@note</span></li>;

    private static RenderFragment Table(AuBtechReviewAgent.PaperTable table) =>
        @<div class="overflow-x-auto">
            <table class="w-full text-left text-sm leading-snug">
                <caption class="pb-2 text-left font-semibold text-heading">@table.Caption</caption>
                <thead class="border-b border-line text-muted"><tr>@foreach (var h in table.Headers) { <th scope="col" class="py-1.5 pr-3 font-semibold">@h</th> }</tr></thead>
                <tbody>
                    @foreach (var row in table.Rows)
                    {
                        <tr class="border-t border-line align-top">@foreach (var cell in row) { <td class="py-1.5 pr-3">@cell</td> }</tr>
                    }
                </tbody>
            </table>
            @if (!string.IsNullOrWhiteSpace(table.Note))
            {
                <p class="mt-1 text-xs italic text-muted">@table.Note</p>
            }
        </div>;

    private static RenderFragment Blocks(IReadOnlyList<AuBtechReviewAgent.ReportBlock> blocks) => __builder =>
    {
        foreach (var block in blocks)
        {
            var current = block;
            if (current.Kind == "table")
            {
                @Table(new AuBtechReviewAgent.PaperTable("", current.Headers, current.Rows))
            }
            else if (current.Kind == "list")
            {
                <ul class="list-disc space-y-1 pl-5">
                    @foreach (var item in current.Items)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
            else
            {
                <p>@current.Text</p>
            }
        }
    };
}
