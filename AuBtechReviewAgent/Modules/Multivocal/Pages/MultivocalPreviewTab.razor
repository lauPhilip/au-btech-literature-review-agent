@* The panel's first tab before a review is planned: what the review will do with the current answers, which of
   its steps are built, and what the reviewer gets. *@

<div class="flex-1 min-h-0 overflow-y-auto p-5 space-y-5 text-left font-sans">
    <div>
        <h3 class="text-base font-semibold text-heading">What this review will do</h3>
        <p class="text-xs text-muted mt-0.5">With your current answers.@(CardOn ? "" : " The steps marked as built work in this preview; the others follow one block at a time.")</p>
    </div>
    <ol class="space-y-3">
        @for (int i = 0; i < PlanSteps.Count; i++)
        {
            var s = PlanSteps[i];
            <li class="flex gap-3">
                <span class="flex-none w-6 h-6 bg-primary/10 text-heading text-[11px] font-semibold flex items-center justify-center">@(i + 1)</span>
                <span class="text-xs leading-snug flex-1">
                    <span class="font-semibold text-heading">@s.Title</span>
                    <span class="text-muted"> · @s.Text</span>
                </span>
                <span class="@(s.Built ? "ui-chip border-supported-border bg-supported-fill text-supported" : "ui-chip border-line bg-soft text-muted") text-[10px] self-start whitespace-nowrap">@(s.Built ? "built" : "not built yet")</span>
            </li>
        }
    </ol>
    <div class="border-t border-line pt-4">
        <h3 class="text-xs font-semibold text-heading mb-2">What you will get</h3>
        <div class="grid grid-cols-2 gap-2 text-[11px] text-ink">
            <div class="border border-line p-2"><span class="font-semibold block text-heading">Review paper</span>structured by the guidelines, with a summary for practitioners; every citation clickable to its quote</div>
            <div class="border border-line p-2"><span class="font-semibold block text-heading">LaTeX manuscript</span>plus BibTeX and RIS for your reference manager</div>
            <div class="border border-line p-2"><span class="font-semibold block text-heading">Systematic map</span>the sources classified by your research questions, each value with its quote</div>
            <div class="border border-line p-2"><span class="font-semibold block text-heading">Verifiable archive</span>protocol, sources' fingerprints and every model call</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AuBtechReviewAgent.MultivocalPlan Plan { get; set; } = default!;
    [Parameter] public bool CardOn { get; set; }

    // What the review will do, with the current answers, and which of its steps are built.
    private IReadOnlyList<(string Title, string Text, bool Built)> PlanSteps
    {
        get
        {
            var p = Plan;
            int searches = p.GreySearches.Count;
            int questions = p.Numbered().Count;
            string stop = p.StoppingRule switch
            {
                "effort" => $"the top {p.TopHits} hits of each search string",
                "saturation" => "until new sources add nothing new",
                _ => "every hit of every search string",
            };
            // The same stages as the systematic review's preview, in the guidelines' words; built ones are marked.
            return new List<(string, string, bool)>
            {
                ("Protocol", "Your plan is written down before anything is searched, with a fingerprint.", true),
                ("Search", p.UsesFormalPool
                    ? $"{searches} grey literature search{(searches == 1 ? "" : "es")} and {p.FormalDatabases.Count} academic database{(p.FormalDatabases.Count == 1 ? "" : "s")}, each with its own search strings, {stop}."
                    : $"{searches} grey literature search{(searches == 1 ? "" : "es")}, {stop}.", true),
                ("Selection", p.UsesFormalPool ? "Grey and academic sources are screened twice, with the same criteria and the same care." : "Every source is screened twice against your criteria; a source the two screenings disagree on is kept and marked for you to look at.", true),
                ("Quality", p.UsesFormalPool
                    ? $"Each grey source is scored on Table 7; below {p.QualityThreshold} of {MultivocalGuidelines.QualityPointsMax} points it is left out. Each academic source is appraised with MMAT, as in the systematic review, on its open full text or else its abstract. Every answer rests on a quote."
                    : $"Each source is scored on Table 7; below {p.QualityThreshold} of {MultivocalGuidelines.QualityPointsMax} points it is left out. Every score rests on a quote.", true),
                ("Map and extraction", p.UsesFormalPool
                    ? "Grey and academic sources are classified in one systematic map proposed from your research questions; every extracted value rests on a quote from the source's kept text: its page, or a paper's full text or abstract."
                    : "The sources are classified in a systematic map proposed from your research questions; every extracted value rests on a quote from the source's page.", true),
                ("Synthesis", $"The findings are grouped into themes to answer {questions} research question{(questions == 1 ? "" : "s")}, each theme labelled with the kind and quality of the sources it rests on{(p.UsesFormalPool ? ", grey, academic or both; a tension between academic and grey sources is named as one between the state of the art and the state of the practice" : "")}.", true),
                ("Writing", "The paper is written from the findings: an outline, one section per theme, the discussion, a summary for practitioners and an automated peer review; the title and abstract last.", true),
                ("Checking", p.UsesFormalPool
                    ? "Every citation is compared with the kept text of the source it cites: a page, or a paper's full text or abstract; weak ones get a second check and are repaired."
                    : "Every citation is compared with the kept text of the page it cites; weak ones get a second check and are repaired.", true),
            };
        }
    }
}
