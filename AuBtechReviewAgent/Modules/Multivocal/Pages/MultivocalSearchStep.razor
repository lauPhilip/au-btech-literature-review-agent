@inherits MultivocalStartPart

@* Step 4 of the planning form: the kinds of grey literature and where to search them, the search strings, the
   academic databases of the formal pool with their own strings (multivocal plans only), what to include (G9), the
   stopping rule (G8) and the quality threshold (G11). *@

<fieldset>
    <legend class="ui-label">Kinds of grey literature <span class="font-normal text-muted">(at least one)</span></legend>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-1.5">
        @foreach (var (key, label) in AuBtechReviewAgent.MultivocalGuidelines.GreyTypes)
        {
            var k = key;
            <label class="flex items-start gap-2 text-sm text-ink cursor-pointer select-none"><input type="checkbox" class="w-4 h-4 mt-0.5 accent-brand" checked="@Page.plan.GreyTypes.Contains(k)" @onchange="e => Page.plan.GreyTypes = MultivocalStart.Toggle(Page.plan.GreyTypes, k, e, AuBtechReviewAgent.MultivocalGuidelines.GreyTypes.Select(t => t.Key))" /> <span>@label</span></label>
        }
    </div>
</fieldset>
<fieldset>
    <legend class="ui-label">Where to search <span class="font-normal text-muted">(at least one)</span></legend>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-1.5">
        @foreach (var search in AuBtechReviewAgent.MultivocalGuidelines.GreySearches)
        {
            var s = search;
            <label class="flex items-start gap-2 text-sm text-ink cursor-pointer select-none"><input type="checkbox" class="w-4 h-4 mt-0.5 accent-brand" checked="@Page.plan.GreySearches.Contains(s.Key)" @onchange="e => Page.plan.GreySearches = MultivocalStart.Toggle(Page.plan.GreySearches, s.Key, e, AuBtechReviewAgent.MultivocalGuidelines.GreySearches.Select(t => t.Key))" /> <span>@s.Label</span></label>
        }
    </div>
    <p class="text-xs text-muted mt-1.5">No general web search engine is used: none is free and allows its results to be kept. Practitioners and authors are not contacted.</p>
    @if (Page.plan.GreyTypes.Count > 0)
    {
        var reach = AuBtechReviewAgent.MultivocalProtocol.ReachLines(Page.plan);
        <div class="mt-2 border border-line p-2" role="status">
            <p class="text-xs font-medium text-ink">What the chosen searches can find</p>
            <ul class="mt-1 space-y-0.5 text-xs">
                @foreach (var line in reach)
                {
                    <li class="@(line.Warning ? "text-partly" : "text-muted")">@(line.Warning ? "Warning: " : "")@line.Text</li>
                }
            </ul>
        </div>
    }
</fieldset>
<fieldset>
    <legend class="ui-label">Search strings for grey literature</legend>
    <p class="text-xs text-muted mb-1.5">Practitioners use their own words; try the terms they use. Each string is sent to every search. Empty means the topic is used.</p>
    <ol class="space-y-1.5">
        @for (int i = 0; i < Page.plan.GreySearchStrings.Count; i++)
        {
            int index = i;
            <li class="flex items-center gap-2">
                <span class="w-4 text-right text-xs text-muted">@(index + 1)</span>
                <input type="text" aria-label="@($"Search string {index + 1}")" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxSearchStringLength"
                       value="@Page.plan.GreySearchStrings[index]" @onchange="e => Page.plan.GreySearchStrings[index] = e.Value?.ToString() ?? string.Empty" class="ui-input py-1" />
                <button type="button" @onclick="() => Page.plan.GreySearchStrings.RemoveAt(index)" class="ui-btn ui-btn-sm px-2 text-muted hover:text-not-supported" aria-label="@($"Remove search string {index + 1}")">✕</button>
            </li>
        }
    </ol>
    @if (Page.plan.GreySearchStrings.Count < AuBtechReviewAgent.MultivocalPlan.MaxSearchStrings)
    {
        <button type="button" class="text-xs text-heading font-medium hover:underline mt-1.5" @onclick="Page.AddSearchString">Add a search string</button>
    }
</fieldset>
@if (!Page.plan.IsGreyOnly)
{
    <fieldset>
        <legend class="ui-label">Academic databases</legend>
        <p class="text-xs text-muted mb-1.5">The formal literature is searched here, in its own pool. With none ticked, the review uses grey literature only.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-1.5">
            @foreach (var database in AuBtechReviewAgent.SourceCatalog.All)
            {
                var d = database;
                bool usable = Page.FormalAvailable(d.Key);
                <label class="flex items-start gap-2 text-sm select-none @(usable ? "text-ink cursor-pointer" : "text-muted cursor-not-allowed")">
                    <input type="checkbox" class="w-4 h-4 mt-0.5 accent-brand" disabled="@(!usable)" checked="@Page.plan.FormalDatabases.Contains(d.Key)"
                           @onchange="e => Page.plan.FormalDatabases = MultivocalStart.Toggle(Page.plan.FormalDatabases, d.Key, e, AuBtechReviewAgent.SourceCatalog.AllKeys)" />
                    <span>@(d.DisplayName + (usable ? "" : " (needs a key on the server)"))</span>
                </label>
            }
        </div>
    </fieldset>
    @if (Page.plan.FormalDatabases.Count > 0)
    {
        <fieldset>
            <legend class="ui-label">Search strings for academic databases</legend>
            <p class="text-xs text-muted mb-1.5">Researchers use other words than practitioners, so these are separate. Each string is sent to every database. Empty means the topic is used. Only the strings in the list are searched.</p>
            <ol class="space-y-1.5">
                @for (int i = 0; i < Page.plan.FormalSearchStrings.Count; i++)
                {
                    int index = i;
                    <li class="flex items-center gap-2">
                        <span class="w-4 text-right text-xs text-muted">@(index + 1)</span>
                        <input type="text" aria-label="@($"Search string for academic databases {index + 1}")" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxSearchStringLength"
                               value="@Page.plan.FormalSearchStrings[index]" @onchange="e => Page.plan.FormalSearchStrings[index] = e.Value?.ToString() ?? string.Empty" class="ui-input py-1" />
                        <button type="button" @onclick="() => Page.plan.FormalSearchStrings.RemoveAt(index)" class="ui-btn ui-btn-sm px-2 text-muted hover:text-not-supported" aria-label="@($"Remove search string for academic databases {index + 1}")">✕</button>
                    </li>
                }
            </ol>
            <div class="flex flex-wrap items-center gap-3 mt-1.5">
                @if (Page.plan.FormalSearchStrings.Count < AuBtechReviewAgent.MultivocalPlan.MaxSearchStrings)
                {
                    <button type="button" class="text-xs text-heading font-medium hover:underline" @onclick="Page.AddFormalSearchString">Add a search string</button>
                }
                <button type="button" class="ui-btn-ghost ui-btn-sm" @onclick="Page.ProposeFormalStrings" disabled="@(Page.proposingStrings || Page.proposalsLeft <= 0 || string.IsNullOrWhiteSpace(Page.plan.Topic))">
                    @(Page.proposingStrings ? "Asking the model…" : "Propose search strings")
                </button>
            </div>
            @if (Page.UnusedProposals.Count > 0)
            {
                <div class="mt-2 border border-dashed border-line-field p-2">
                    <p class="text-xs text-muted mb-1.5">The model proposes these. Add the ones you want; the protocol records which you used.</p>
                    <ul class="space-y-1">
                        @foreach (var proposal in Page.UnusedProposals)
                        {
                            var text = proposal;
                            <li class="flex items-center justify-between gap-2 text-sm text-ink">
                                <span class="min-w-0 break-words">@text</span>
                                <button type="button" class="ui-btn-ghost ui-btn-sm" @onclick="() => Page.UseProposal(text)" disabled="@(Page.plan.FormalSearchStrings.Count >= AuBtechReviewAgent.MultivocalPlan.MaxSearchStrings)" aria-label="@($"Use the search string {text}")">Use</button>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (Page.proposalError != null)
            {
                <p class="text-xs text-partly mt-1.5" role="status">@Page.proposalError</p>
            }
        </fieldset>
    }
}
<fieldset class="space-y-2">
    <legend class="ui-label">What to include (G9)</legend>
    <p class="text-xs text-muted">Every source found is screened against these, twice, with the same care for every source (G10), so write them about the subject, not about where a source was published.</p>
    <div>
        <label for="p-include" class="text-sm text-ink">A source is included when it is about</label>
        <textarea id="p-include" rows="3" class="ui-input resize-y mt-1" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="Page.plan.InclusionCriteria" @bind:event="oninput"></textarea>
    </div>
    <div>
        <label for="p-exclude" class="text-sm text-ink">A source is excluded when <span class="text-muted">(optional)</span></label>
        <textarea id="p-exclude" rows="2" class="ui-input resize-y mt-1" maxlength="@AuBtechReviewAgent.MultivocalPlan.MaxText" @bind="Page.plan.ExclusionCriteria" @bind:event="oninput"></textarea>
    </div>
</fieldset>
<details class="group border border-line" open>
    <summary class="cursor-pointer select-none px-3 py-2 text-sm text-ink flex items-center justify-between">
        <span>Stopping rule and quality</span>
        <span class="text-[11px] text-muted">@Page.StoppingSummary() · threshold @Page.plan.QualityThreshold/@AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax</span>
    </summary>
    <div class="px-3 pb-3 space-y-3 border-t border-line pt-3">
        <fieldset>
            <legend class="text-sm text-ink">When to stop searching (G8)</legend>
            <div class="space-y-1 mt-1 text-sm text-ink">
                @foreach (var (key, label) in AuBtechReviewAgent.MultivocalGuidelines.StoppingRules)
                {
                    var k = key;
                    <label class="flex items-start gap-2 cursor-pointer"><input type="radio" name="stopping" class="w-4 h-4 mt-0.5 accent-brand" checked="@(Page.plan.StoppingRule == k)" @onchange="() => Page.plan.StoppingRule = k" /> <span>@label</span></label>
                }
            </div>
        </fieldset>
        @if (Page.plan.StoppingRule == "effort")
        {
            <div class="flex items-center justify-between gap-3">
                <label for="p-top" class="text-sm text-ink">Top hits per search string<span class="block text-xs text-muted">The paper looks at the first 100. A plan starts at 20, since each hit is screened twice; raise it for a fuller search.</span></label>
                <input id="p-top" type="number" min="10" max="500" class="ui-input w-20 text-center" @bind="Page.plan.TopHits" />
            </div>
        }
        <div class="flex items-center justify-between gap-3">
            <label for="p-threshold" class="text-sm text-ink">Quality threshold, of @AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax points (G11)<span class="block text-xs text-muted">A grey source scoring below this is excluded. The paper's example uses 10.</span></label>
            <input id="p-threshold" type="number" min="1" max="@AuBtechReviewAgent.MultivocalGuidelines.QualityPointsMax" class="ui-input w-20 text-center" @bind="Page.plan.QualityThreshold" />
        </div>
    </div>
</details>
