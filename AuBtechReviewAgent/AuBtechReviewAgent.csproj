<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>5292a10a-c6ef-49ff-853e-f9af5140575d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.MistralAI" Version="1.77.0-alpha" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

<!-- Run folders, the cache and quota counters are data, not source: keep them out of the project entirely, so
     dotnet watch does not reload the project every time a run writes a file (and publish does not copy them). -->
<PropertyGroup>
  <DefaultItemExcludes>$(DefaultItemExcludes);WorkspaceStore\**;App_Data\**;PapersWorkspace\**;node_modules\**</DefaultItemExcludes>
</PropertyGroup>

<ItemGroup>
  <Watch Remove="PapersWorkspace\**\*" />
  <Watch Remove="WorkspaceStore\**\*" />
  <Watch Remove="App_Data\**\*" />
</ItemGroup>

<!-- Ship the Scimago ranking data with the app so the quartile lookup also works after publish. -->
<ItemGroup>
  <None Update="ScimagoData\**\*.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
</ItemGroup>

</Project>
