@* The button that switches between the light and the dark theme. It needs no Blazor events: wwwroot/js/theme.js
   listens for clicks on any [data-theme-toggle] button, sets data-theme on <html> and remembers the choice.
   The icon and the button's name follow the theme through CSS (dark:), so they are right on the first paint
   and on pages that are not interactive. *@

<button type="button" data-theme-toggle
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-btn text-muted transition-colors hover:bg-active hover:text-heading">
    <span class="sr-only"><span class="dark:hidden">Switch to dark theme</span><span class="hidden dark:inline">Switch to light theme</span></span>
    @* Moon in the light theme, sun in the dark theme: the icon shows what the button switches to. *@
    <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
    <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
</button>

@code {
    /// <summary>
    /// Whether a visitor who has not chosen a theme gets the dark theme when their system is set to dark.
    /// Off until every page uses the theme-aware colours (redesign step 12); until then only a choice made
    /// with this button switches the theme. App.razor writes it on &lt;html&gt; for theme.js.
    /// </summary>
    public static readonly bool FollowSystem = false;

    /// <summary>
    /// Whether the app pages (AppLayout) show this button. Off while those pages still use fixed light colours,
    /// so a visitor cannot pick a dark frame around light pages; each page moves to the theme-aware colours in
    /// its own redesign step, and this comes on in step 12. The landing page is ready for the dark theme and
    /// always shows the button (LandingLayout).
    /// </summary>
    public static readonly bool OfferedOnAppPages = false;

    /// <summary>
    /// Whether the page at this address (relative to the site root, as NavigationManager.ToBaseRelativePath
    /// gives it) can take the dark theme. App.razor writes it on &lt;html&gt; as data-theme-ready, and theme.js
    /// keeps every other page light, so a dark choice made on the landing page does not darken the app pages
    /// before they are ready. The /design pages are ready because CI checks the frame on them in the dark theme.
    /// </summary>
    public static bool ReadyFor(string relativePath)
    {
        if (OfferedOnAppPages) return true;
        string path = (relativePath ?? "").Split('?', '#')[0].Trim('/').ToLowerInvariant();
        return path.Length == 0 || path == "design" || path.StartsWith("design/", StringComparison.Ordinal);
    }
}
