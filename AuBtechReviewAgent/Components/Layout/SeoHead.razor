@* The page title and what search engines and link previews read: description, canonical address, robots,
   Open Graph and Twitter cards, and optionally the structured data of the landing page (SiteSeo). *@
@inject IConfiguration Configuration
@inject NavigationManager Nav

<PageTitle>@FullTitle</PageTitle>

<HeadContent>
    <meta name="description" content="@Description" />
    <meta name="author" content="@AuBtechReviewAgent.SiteSeo.Authors, @AuBtechReviewAgent.SiteSeo.Organisation" />
    <meta name="application-name" content="@AuBtechReviewAgent.SiteSeo.SiteName" />
    @if (NoIndex)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    else
    {
        <link rel="canonical" href="@Url" />
    }
    <meta property="og:site_name" content="@AuBtechReviewAgent.SiteSeo.SiteName" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@FullTitle" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Url" />
    <meta property="og:image" content="@Image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TraceableAI: literature reviews where every citation is checked." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@FullTitle" />
    <meta name="twitter:description" content="@Description" />
    <meta name="twitter:image" content="@Image" />
    @* Data blocks, not scripts: the Content-Security-Policy does not apply to them and nothing runs. *@
    @if (StructuredData)
    {
        @JsonLdBlock(AuBtechReviewAgent.SiteSeo.JsonLd(BaseUrl))
    }
    @if (!NoIndex && Path != "/")
    {
        @JsonLdBlock(AuBtechReviewAgent.SiteSeo.BreadcrumbJsonLd(BaseUrl, new[] { (AuBtechReviewAgent.SiteSeo.SiteName, "/"), (BreadcrumbName ?? Title, Path) }))
    }
    @if (ExtraJsonLd != null)
    {
        @JsonLdBlock(ExtraJsonLd(BaseUrl))
    }
</HeadContent>

@code {
    /// <summary>The page's own title; " · TraceableAI" is added unless it already starts with the name.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string Description { get; set; } = AuBtechReviewAgent.SiteSeo.DefaultDescription;

    /// <summary>The page's path for the canonical link, e.g. "/metrics".</summary>
    [Parameter] public string Path { get; set; } = "/";

    /// <summary>Keep the page out of search results (a run's own pages, error pages).</summary>
    [Parameter] public bool NoIndex { get; set; }

    /// <summary>Add the schema.org description of the app (landing page only).</summary>
    [Parameter] public bool StructuredData { get; set; }

    /// <summary>More schema.org data for this page, built from the site's address (e.g. SiteSeo.DatasetJsonLd).</summary>
    [Parameter] public Func<string, string>? ExtraJsonLd { get; set; }

    /// <summary>The page's name in the breadcrumb trail; the title when not set.</summary>
    [Parameter] public string? BreadcrumbName { get; set; }

    private static MarkupString JsonLdBlock(string json) => new($"<script type=\"application/ld+json\">{json}</script>");

    private string FullTitle => Title.StartsWith(AuBtechReviewAgent.SiteSeo.SiteName, StringComparison.Ordinal)
        ? Title : $"{Title} · {AuBtechReviewAgent.SiteSeo.SiteName}";

    private string BaseUrl
    {
        get
        {
            string? configured = Configuration["Site:PublicUrl"];
            return string.IsNullOrWhiteSpace(configured) ? Nav.BaseUri.TrimEnd('/') : configured.Trim().TrimEnd('/');
        }
    }

    private string Url => AuBtechReviewAgent.SiteSeo.Absolute(BaseUrl, Path);
    private string Image => AuBtechReviewAgent.SiteSeo.Absolute(BaseUrl, AuBtechReviewAgent.SiteSeo.SocialImagePath);
}
