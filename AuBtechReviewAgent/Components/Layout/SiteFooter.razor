@* The footer. On app pages it is one slim line that never moves: the name, and the pages about trust (About,
   Model card, Privacy, Verify an archive, Glossary) with GitHub; on phones only About, Privacy and GitHub.
   The landing page (Landing="true") names the department and OSSYM 2026, with Metrics, Docs and GitHub. *@

<footer class="shrink-0 border-t border-line bg-page text-sm text-muted print:hidden">
    <div class="mx-auto flex w-full max-w-[1600px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-[clamp(16px,3vw,40px)] py-1">
        @if (Landing)
        {
            <p class="py-2">@AuBtechReviewAgent.SiteSeo.Organisation · OSSYM 2026</p>
            <nav aria-label="Project">
                <ul class="-mx-2 flex flex-wrap items-center">
                    <li><a href="/metrics" class="@LinkClass">Metrics</a></li>
                    <li><a href="@($"{AuBtechReviewAgent.SiteSeo.RepositoryUrl}/blob/master/docs/wiki/README.md")" class="@LinkClass">Docs</a></li>
                    <li><a href="@AuBtechReviewAgent.SiteSeo.RepositoryUrl" class="@LinkClass">GitHub</a></li>
                </ul>
            </nav>
        }
        else
        {
            <p class="py-2"><span class="font-display font-semibold text-heading">TraceableAI</span> · BTECH, AU</p>
            <nav aria-label="About TraceableAI">
                <ul class="-mx-2 flex flex-wrap items-center">
                    <li><a href="/about" class="@LinkClass">About</a></li>
                    <li class="hidden sm:block"><a href="/model-card" class="@LinkClass">Model card</a></li>
                    <li><a href="/privacy" class="@LinkClass">Privacy</a></li>
                    <li class="hidden sm:block"><a href="/verify" class="@LinkClass">Verify an archive</a></li>
                    <li class="hidden sm:block"><a href="/glossary" class="@LinkClass">Glossary</a></li>
                    <li><a href="@AuBtechReviewAgent.SiteSeo.RepositoryUrl" class="@LinkClass">GitHub</a></li>
                </ul>
            </nav>
        }
    </div>
</footer>

@code {
    /// <summary>The landing page's footer instead of the slim one of the app pages.</summary>
    [Parameter] public bool Landing { get; set; }

    private const string LinkClass = "inline-flex min-h-11 items-center px-2 underline-offset-4 hover:text-heading hover:underline";
}
