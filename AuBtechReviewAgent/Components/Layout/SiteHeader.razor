@* The top bar of every page: a "Skip to content" link for keyboard users (it jumps to the element with id="main"),
   the bare mark and the name linking to the landing page, and the three places of the app with the current one
   marked. Under 640 px the places fold into a menu button. The landing page shows the bar without the places
   (ShowNav="false"). The theme toggle is shown where the page can take the dark theme (ShowThemeToggle),
   once ThemeToggle.Offered is on.

   Which place is current, and where New review and Review output lead, follow from the address when the page
   does not say (Locate), so the layouts can render this bar without being told. *@
@inject NavigationManager Navigation

<a href="#main" data-skip-to="main" class="ui-skip">Skip to content</a>

<header class="relative z-50 shrink-0 border-b border-line bg-page text-ink print:hidden">
    <div class="mx-auto flex h-16 w-full max-w-[1600px] items-center justify-between gap-3 px-[clamp(16px,3vw,40px)]">
        <a href="/" aria-current="@(current.Active == "overview" ? "page" : null)"
           class="flex min-h-11 shrink-0 items-center gap-2.5 rounded-btn pr-2">
            <BrandMark Size="32" />
            <span class="whitespace-nowrap font-display text-lg font-semibold tracking-tight text-heading">TraceableAI</span>
        </a>

        <div class="flex items-center gap-1 sm:gap-2">
            @if (ShowNav)
            {
                <nav aria-label="Main">
                    <ul class="hidden items-center gap-1 sm:flex">
                        @foreach (var item in Items)
                        {
                            var place = item;
                            <li><a href="@place.Href" aria-current="@(place.Key == current.Active ? "page" : null)" class="@LinkClass(place.Key) inline-flex min-h-11 items-center px-3">@place.Label</a></li>
                        }
                    </ul>
                    @* A <details> menu opens without a script, so it works on pages that are not interactive. *@
                    <details class="group relative sm:hidden">
                        <summary class="inline-flex h-11 cursor-pointer list-none items-center gap-2 rounded-btn px-3 font-display text-sm font-semibold text-heading hover:bg-active [&::-webkit-details-marker]:hidden">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                                <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
                                <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
                            </svg>
                            Menu
                        </summary>
                        <ul class="absolute right-0 top-full mt-2 w-56 border border-line bg-page p-2 shadow-lift">
                            @foreach (var item in Items)
                            {
                                var place = item;
                                <li><a href="@place.Href" aria-current="@(place.Key == current.Active ? "page" : null)" class="@LinkClass(place.Key) flex min-h-11 items-center px-3">@place.Label</a></li>
                            }
                        </ul>
                    </details>
                </nav>
            }
            @if (ShowThemeToggle && ThemeToggle.Offered)
            {
                <ThemeToggle />
            }
        </div>
    </div>
</header>

@code {
    /// <summary>Which item is the current page: "overview", "dashboard", "output" or "metrics". Empty: follow the address.</summary>
    [Parameter] public string Active { get; set; } = "";

    /// <summary>Where New review links to (the run this tab shows, when there is one). Empty: follow the address.</summary>
    [Parameter] public string DashboardHref { get; set; } = "";

    /// <summary>Where Review output links to. Empty: follow the address.</summary>
    [Parameter] public string OutputHref { get; set; } = "";

    /// <summary>Whether the three places are shown; the landing page has only the mark and the theme toggle.</summary>
    [Parameter] public bool ShowNav { get; set; } = true;

    /// <summary>Whether the theme toggle is shown (the layouts ask for it). It appears only while ThemeToggle.Offered is on.</summary>
    [Parameter] public bool ShowThemeToggle { get; set; }

    private Place current = new("", "/review", "/spec-matrix");

    protected override void OnParametersSet()
    {
        var fromAddress = Locate(Navigation.ToBaseRelativePath(Navigation.Uri));
        current = new(
            Active.Length > 0 ? Active : fromAddress.Active,
            DashboardHref.Length > 0 ? DashboardHref : fromAddress.DashboardHref,
            OutputHref.Length > 0 ? OutputHref : fromAddress.OutputHref);
    }

    /// <summary>The current place and the run-aware links, read from an address relative to the site root.</summary>
    public readonly record struct Place(string Active, string DashboardHref, string OutputHref);

    /// <summary>
    /// Reads the current place from the address: /review/{id} and /spec-matrix/{id} link both places to that run,
    /// and the grey literature pages (/mlr/{id}, /mlr-paper/{id}, /mlr-report/{id}) count as New review for their run.
    /// </summary>
    public static Place Locate(string relativePath)
    {
        string path = (relativePath ?? "").Split('?', '#')[0].Trim('/');
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        string first = parts.Length > 0 ? parts[0].ToLowerInvariant() : "";
        string? run = parts.Length > 1 && Guid.TryParse(parts[1], out var id) ? id.ToString() : null;

        return first switch
        {
            "" => new("overview", "/review", "/spec-matrix"),
            "review" => new("dashboard", run != null ? $"/review/{run}" : "/review", run != null ? $"/spec-matrix/{run}" : "/spec-matrix"),
            "start" => new("dashboard", "/review", "/spec-matrix"),
            "spec-matrix" => new("output", run != null ? $"/review/{run}" : "/review", run != null ? $"/spec-matrix/{run}" : "/spec-matrix"),
            "mlr" or "mlr-paper" or "mlr-report" => new("dashboard", run != null ? $"/mlr/{run}" : "/mlr", "/spec-matrix"),
            "metrics" => new("metrics", "/review", "/spec-matrix"),
            _ => new("", "/review", "/spec-matrix"),
        };
    }

    private IEnumerable<(string Key, string Label, string Href)> Items => new[]
    {
        ("dashboard", "New review", current.DashboardHref),
        ("output", "Review output", current.OutputHref),
        ("metrics", "Metrics", "/metrics"),
    };

    // Class names written out in full, so Tailwind finds them.
    private string LinkClass(string key) => key == current.Active
        ? "rounded-btn bg-active font-display text-sm font-semibold text-heading"
        : "rounded-btn font-display text-sm font-medium text-muted transition-colors hover:bg-active hover:text-heading";
}
