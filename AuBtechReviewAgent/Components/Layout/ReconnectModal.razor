@* Shown when the live connection to the server drops (a laptop sleeps, Wi-Fi changes, the server restarts).
   A calm banner at the bottom instead of Blazor's grey box that covers the page: the page stays readable,
   and it says the one thing people worry about, that a running review keeps going on the server. Blazor
   toggles the components-reconnect-* classes on the dialog; the styles are in Styles/tailwind.input.css. *@

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet aria-live="polite" aria-labelledby="reconnect-title">
    <div class="flex items-start gap-3">
        <span class="reconnect-spinner mt-1" aria-hidden="true"></span>
        <div class="min-w-0">
            <p id="reconnect-title" class="font-semibold text-gray-900">
                <span class="components-reconnect-first-attempt-visible">Connection lost, reconnecting…</span>
                <span class="components-reconnect-repeated-attempt-visible">Still reconnecting… next try in <span id="components-seconds-to-next-attempt"></span> s</span>
                <span class="components-reconnect-failed-visible">Could not reconnect</span>
                <span class="components-pause-visible">This page was paused</span>
                <span class="components-resume-failed-visible">This page could not be resumed</span>
            </p>
            <p class="text-sm text-gray-600 mt-0.5">
                <span class="components-reconnect-first-attempt-visible components-reconnect-repeated-attempt-visible">A running review keeps going on the server; this page catches up when the connection is back.</span>
                <span class="components-reconnect-failed-visible components-resume-failed-visible">A running review keeps going on the server. Reload the page to see it again.</span>
                <span class="components-pause-visible">It was inactive for a while. Resume to continue where you left off.</span>
            </p>
        </div>
        <div class="flex gap-2 shrink-0 ml-auto">
            <button id="components-reconnect-button" type="button" class="components-reconnect-failed-visible ui-btn-primary ui-btn-sm">Try again</button>
            <button id="components-resume-button" type="button" class="components-pause-visible components-resume-failed-visible ui-btn-primary ui-btn-sm">Resume</button>
            <button type="button" class="components-reconnect-failed-visible components-resume-failed-visible ui-btn-secondary ui-btn-sm" data-reconnect-reload>Reload</button>
        </div>
    </div>
</dialog>
