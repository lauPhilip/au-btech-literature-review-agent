@using System.Globalization
@implements IDisposable

@* New review while a run is going, waiting or stopped (redesign step 7). The main column, at most 760 px, has the
   eyebrow with the step, the objective as the title, the live line of what happens now (LiveActivityLine), the overall bar and the seven steps (ReviewSteps), each done,
   running or waiting, with one line. The side column says the page can be closed and what is on record so far, with
   the way into the live log. The page adds its own parts through Notice (under the bar), Main (under the steps) and
   Side (under the side cards). The numbers come from ReviewStats, set by the engine through RunProgress; this
   component only shows them. On a phone only the active step keeps its line and the side cards are hidden, so the
   screen fits 390 × 844; while the live line shows, the active step's line and the line's counts are left out there too. *@

@{
    int percent = AuBtechReviewAgent.RunProgress.Percent(Stats);
    bool failed = Stage is AuBtechReviewAgent.PrismaReviewEngine.StageFailed or AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted
        or AuBtechReviewAgent.PrismaReviewEngine.StageCancelled;
    bool queued = Stage == AuBtechReviewAgent.PrismaReviewEngine.StageQueued;
    bool waitingForYou = Stage == AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview;
    int current = AuBtechReviewAgent.ReviewSteps.Current(Stats, Stage);
    string barColor = failed ? "bg-not-supported-chart" : "bg-heading";
    // On a phone the live line under the title says what the active step's line says, so that line is left out to fit 390 × 844.
    bool liveShown = Running && !failed;
}

<div class="mx-auto w-full max-w-[1600px] px-[clamp(16px,3vw,40px)] py-4 sm:py-10">
    <div class="grid grid-cols-1 items-start gap-4 sm:gap-6 lg:grid-cols-[minmax(0,760px)_380px] lg:justify-center xl:gap-10 min-[1600px]:grid-cols-[minmax(0,760px)_440px]">

        <section id="run-panel" class="mx-auto w-full max-w-[760px] min-w-0" aria-labelledby="run-title">
            <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] @(failed ? "text-not-supported" : "text-muted")">@Eyebrow(failed, queued, waitingForYou, current)</p>
            <h1 id="run-title" class="mt-1 font-display text-[clamp(22px,2vw,32px)] font-semibold leading-tight tracking-[-0.025em] text-heading line-clamp-3 sm:mt-2">@Title</h1>
            @if (liveShown)
            {
                <LiveActivityLine Line="AuBtechReviewAgent.LiveActivity.ForSystematic(Stats, Stage, QueuePosition, QueueText)" Class="mt-2 sm:mt-3" />
            }

            <div class="ui-card mt-4 p-4 sm:mt-5 sm:p-6">
                <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="font-semibold text-ink">@CurrentLabel()</span>
                    <span class="shrink-0 font-mono text-xs text-muted">@(failed ? "stopped" : $"{percent}%")@(Elapsed is { } e ? $" · {e}" : "")</span>
                </div>
                <div class="mt-2 h-2 w-full overflow-hidden bg-active" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent" aria-label="Run progress">
                    <div class="h-full @barColor transition-all duration-500 @(Running && !failed && percent == 0 ? "w-1/12 animate-pulse" : "")" style="@(percent > 0 ? $"width:{percent}%" : "")"></div>
                </div>

                @Notice

                <ol class="mt-4 space-y-1" aria-label="The seven steps">
                    @for (int i = 0; i < AuBtechReviewAgent.ReviewSteps.Count; i++)
                    {
                        int index = i;
                        string state = AuBtechReviewAgent.ReviewSteps.StateOf(index, current);
                        if (failed && state == "current") state = "failed";
                        bool active = state is "current" or "failed";
                        string line = active && !string.IsNullOrWhiteSpace(Stats.ProgressDetail) && !waitingForYou ? Stats.ProgressDetail : AuBtechReviewAgent.ReviewSteps.Line(index, SourceCount);
                        <li class="flex items-start gap-3 rounded-field px-3 py-2 @(active ? "bg-active" : "max-sm:py-1")" aria-current="@(active ? "step" : null)">
                            @switch (state)
                            {
                                case "done":
                                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-supported-chart text-white" aria-hidden="true">
                                        <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                                    </span>
                                    break;
                                case "current":
                                    <span class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-[3px] border-heading @(Running && !waitingForYou ? "border-t-transparent motion-safe:animate-spin" : "")" aria-hidden="true"></span>
                                    break;
                                case "failed":
                                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-not-supported-chart font-bold text-white text-xs" aria-hidden="true">!</span>
                                    break;
                                default:
                                    <span class="mt-0.5 h-5 w-5 shrink-0 rounded-full border-2 border-line-field" aria-hidden="true"></span>
                                    break;
                            }
                            <span class="min-w-0">
                                <span class="block font-display text-sm font-semibold @(state == "pending" ? "text-muted" : "text-heading")">@AuBtechReviewAgent.ReviewSteps.All[index].Title<span class="sr-only">@($" ({StateText(state)})")</span></span>
                                <span class="block text-sm leading-snug text-muted @(active && !liveShown ? "" : "max-sm:hidden")">@line</span>
                            </span>
                        </li>
                    }
                </ol>

                @if (Running && !failed)
                {
                    <div class="mt-3">
                        <SourceStatusNote Running="true" />
                    </div>
                }
            </div>

            @if (Running && !failed)
            {
                <p class="mt-3 text-sm text-muted sm:hidden">You can close this page. The review keeps running.</p>
            }

            @Main
        </section>

        <aside class="mx-auto w-full max-w-[760px] min-w-0 space-y-4 lg:max-w-none" aria-label="About this run">
            @if (Running && !failed)
            {
                <div class="ui-card p-4 max-sm:hidden sm:p-5">
                    <h2 class="font-display text-base font-semibold text-heading">You can close this page</h2>
                    <p class="mt-1 text-sm leading-relaxed text-muted">The review keeps running on the server. Come back with the link to this run; while the tab stays open, its title shows the progress.</p>
                    @Notify
                </div>
            }

            <div class="ui-card p-4 max-sm:hidden sm:p-5">
                <h2 class="font-display text-base font-semibold text-heading">On record so far</h2>
                <ul class="mt-2 space-y-1.5 text-sm">
                    @Record(current > AuBtechReviewAgent.ReviewSteps.Protocol, "The protocol, fingerprinted before the search")
                    @Record(current > AuBtechReviewAgent.ReviewSteps.Search, "The raw answers of every database")
                    @Record(current > AuBtechReviewAgent.ReviewSteps.Screening, "Every screening decision, with its reason")
                </ul>
                <button type="button" @onclick="OnShowLog" aria-expanded="@(LogShown ? "true" : "false")"
                        class="ui-btn-secondary mt-3 min-h-[44px] w-full">@(LogShown ? "Hide the live log" : "View the live log")</button>
            </div>

            @Side
        </aside>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AuBtechReviewAgent.ReviewStats Stats { get; set; } = new();
    [Parameter] public string Stage { get; set; } = "";
    [Parameter] public bool Running { get; set; }
    [Parameter] public int QueuePosition { get; set; }

    /// <summary>The place in line with a rough wait ("You are 4th in line, about 25 minutes."), while the run waits.</summary>
    [Parameter] public string? QueueText { get; set; }
    [Parameter] public DateTime? CompletedUtc { get; set; }

    /// <summary>The run's objective, shown as the title (the query when the run has no objective).</summary>
    [Parameter] public string? Objective { get; set; }

    /// <summary>How many databases the run asked; the Search step names the number.</summary>
    [Parameter] public int SourceCount { get; set; }

    /// <summary>Whether the page shows the live log, and what the button that shows it calls.</summary>
    [Parameter] public bool LogShown { get; set; }
    [Parameter] public EventCallback OnShowLog { get; set; }

    /// <summary>Shown under the bar: the reason a run stopped.</summary>
    [Parameter] public RenderFragment? Notice { get; set; }

    /// <summary>Shown under the steps: the human screening check, the live log, the PRISMA funnel.</summary>
    [Parameter] public RenderFragment? Main { get; set; }

    /// <summary>Shown in the "You can close this page" card: the browser notification.</summary>
    [Parameter] public RenderFragment? Notify { get; set; }

    /// <summary>Shown under the side cards: the run's link, its settings and the way to a new review.</summary>
    [Parameter] public RenderFragment? Side { get; set; }

    private System.Threading.Timer? _timer;

    private string Title => string.IsNullOrWhiteSpace(Objective) ? "Your review" : Objective!;

    protected override void OnParametersSet()
    {
        // Tick once a second while the run is going, so the elapsed time moves between engine updates.
        if (Running && _timer == null)
            _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
        else if (!Running && _timer != null)
        {
            _timer.Dispose();
            _timer = null;
        }
    }

    private string Eyebrow(bool failed, bool queued, bool waitingForYou, int current)
    {
        string of = $"step {AuBtechReviewAgent.ReviewSteps.Number(current)} of {AuBtechReviewAgent.ReviewSteps.Count}";
        if (Stage == AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted) return $"Review interrupted · {of}";
        if (Stage == AuBtechReviewAgent.PrismaReviewEngine.StageCancelled) return $"Review cancelled · {of}";
        if (failed) return $"Review stopped · {of}";
        if (queued) return QueuePosition > 0 ? $"Review waiting · number {QueuePosition} in line" : "Review waiting for a free slot";
        if (waitingForYou) return $"Review paused · {of}";
        return $"Review running · {of}";
    }

    private static string StateText(string state) => state switch
    {
        "done" => "done",
        "current" => "running",
        "failed" => "stopped here",
        _ => "waiting",
    };

    private string? Elapsed
    {
        get
        {
            if (Stats.RunStartedUtc is not DateTime started) return null;
            var span = (CompletedUtc ?? DateTime.UtcNow) - started;
            if (span < TimeSpan.Zero) return null;
            return span.TotalHours >= 1 ? $"{(int)span.TotalHours} h {span.Minutes} min"
                 : span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes} min {span.Seconds:00} s"
                 : $"{span.Seconds} s";
        }
    }

    private string CurrentLabel()
    {
        if (Stage == AuBtechReviewAgent.PrismaReviewEngine.StageQueued)
            return !string.IsNullOrEmpty(QueueText) ? $"Waiting for a free run slot. {QueueText}"
                : QueuePosition > 0 ? $"Waiting for a free run slot (number {QueuePosition} in line)" : "Waiting for a free run slot";
        if (Stage == AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview) return "Waiting for your screening decisions";
        if (Stage == AuBtechReviewAgent.PrismaReviewEngine.StageFailed) return "The run stopped with an error";
        if (Stage == AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted) return "The run was interrupted";
        if (Stage == AuBtechReviewAgent.PrismaReviewEngine.StageCancelled) return "The run was cancelled";
        return AuBtechReviewAgent.RunProgress.Steps.TryGetValue(Stats.ProgressStep, out var d) ? d.Label : "Writing the protocol";
    }

    private static RenderFragment Record(bool onFile, string text) => __builder =>
    {
        <li class="flex items-start gap-2 @(onFile ? "text-ink" : "text-muted")">
            @if (onFile)
            {
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-supported" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
            }
            else
            {
                <span class="mt-0.5 h-4 w-4 shrink-0 rounded-full border-2 border-line-field" aria-hidden="true"></span>
            }
            <span>@text<span class="sr-only">@(onFile ? " (on record)" : " (not yet)")</span></span>
        </li>
    };

    public void Dispose() => _timer?.Dispose();
}
