@* How the scholarly databases have answered in the last half hour (SourceStatus), shown on the form and during a
   run so a slow search has a visible reason. Nothing is shown while every database answers normally. *@

@{
    string? summary = AuBtechReviewAgent.SourceStatus.Summary();
}
@if (summary != null)
{
    <p class="border-l-2 border-amber-400 bg-amber-50 px-2.5 py-1.5 text-[11px] leading-snug text-amber-900">
        <span class="font-semibold">Database status:</span> @summary
        @(Running ? " The run waits and retries, so this step may take longer." : " Reviews still work; the search step may take longer.")
    </p>
}

@code {
    [Parameter] public bool Running { get; set; }
}
