@* New review when a run is done (redesign step 7): the outcome first and the one next action. The main column has
   "Review ready", the objective as the title, the studies and themes line, and a card with the citations checked,
   the stacked verdict bar, the counts and the two ways into the report. The side column lists everything the run
   produced, each with Open or Download. The page adds its own parts through Main (under the card) and Side (under
   the file list). On a phone the buttons take the full width and the file list folds behind one line. *@

@{
    var s = Stats;
    int cited = s.CitationsChecked;
    int flagged = s.CitationsPartiallySupported + s.CitationsNotSupported;
    string report = $"/spec-matrix/{RunId}";
}

<div class="mx-auto w-full max-w-[1600px] px-[clamp(16px,3vw,40px)] py-4 sm:py-10">
    <div class="grid grid-cols-1 items-start gap-4 sm:gap-6 lg:grid-cols-[minmax(0,760px)_380px] lg:justify-center xl:gap-10 min-[1600px]:grid-cols-[minmax(0,760px)_440px]">

        <section id="run-panel" class="mx-auto w-full max-w-[760px] min-w-0" aria-labelledby="run-title">
            <p class="flex items-center gap-2 font-display text-xs font-semibold uppercase tracking-[0.14em] text-supported">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-supported-chart text-white" aria-hidden="true">
                    <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                </span>
                Review ready
            </p>
            <h1 id="run-title" class="mt-1 font-display text-[clamp(22px,2vw,32px)] font-semibold leading-tight tracking-[-0.025em] text-heading line-clamp-3 sm:mt-2">@Title</h1>
            <p class="mt-2 text-sm text-muted sm:text-base">@StudiesLine(s)</p>

            <div class="ui-card mt-4 p-4 sm:mt-5 sm:p-6">
                @if (cited > 0)
                {
                    <h2 class="font-display text-lg font-semibold text-heading">@cited @(cited == 1 ? "citation" : "citations") checked against the papers</h2>
                    <div class="mt-3"><VerdictBar Counts="AuBtechReviewAgent.VerdictTally.From(s)" Total="cited + s.CitationsRemoved" /></div>
                    <p class="mt-2 text-sm text-muted max-sm:hidden">
                        @(flagged > 0
                            ? $"{flagged} {(flagged == 1 ? "citation is" : "citations are")} only partly or not supported. They stay in the report, marked, so you can judge them."
                            : "Every checked citation is backed by a passage in the paper it cites.")
                    </p>
                }
                else
                {
                    <h2 class="font-display text-lg font-semibold text-heading">The report is ready</h2>
                    <p class="mt-1 text-sm text-muted">No citations were checked in this run. The report says why.</p>
                }

                <div class="mt-4 flex flex-col gap-2 border-t border-line pt-4 sm:flex-row sm:items-center sm:gap-3">
                    <a href="@report" class="ui-btn-primary min-h-[52px] px-7 text-base max-sm:w-full">Open the report</a>
                    @if (flagged > 0)
                    {
                        <a href="@report" class="ui-btn-secondary min-h-[44px] max-sm:w-full">Review the @flagged flagged @(flagged == 1 ? "citation" : "citations")</a>
                    }
                </div>
            </div>

            @Main
        </section>

        <aside class="mx-auto w-full max-w-[760px] min-w-0 space-y-4 lg:max-w-none" aria-label="About this run">
            <div class="ui-card p-4 max-sm:hidden sm:p-5">
                <h2 class="font-display text-base font-semibold text-heading">Everything from this run</h2>
                @Files
            </div>
            @* On a phone the files and the page's own card fold into one line, so a finished run fits 390 x 844
               (issue #244); the inner card drops its border and padding there, so it does not read as a card in a card. *@
            <details class="ui-card p-4 sm:hidden">
                <summary class="flex min-h-[44px] cursor-pointer items-center font-display text-sm font-semibold text-heading">@PhoneSummary</summary>
                @Files
                @if (Side != null)
                {
                    <div class="mt-3 border-t border-line pt-1 [&_.ui-card]:border-0 [&_.ui-card]:bg-transparent [&_.ui-card]:p-0 [&_.ui-card]:shadow-none">@Side</div>
                }
            </details>

            <div class="max-sm:hidden">@Side</div>
        </aside>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AuBtechReviewAgent.ReviewStats Stats { get; set; } = new();
    [Parameter, EditorRequired] public Guid RunId { get; set; }

    /// <summary>The run's objective, shown as the title (the query when the run has no objective).</summary>
    [Parameter] public string? Objective { get; set; }

    /// <summary>Shown under the citation card: the live log.</summary>
    [Parameter] public RenderFragment? Main { get; set; }

    /// <summary>Shown under the file list: the run's link, its settings, Delete and the way to a new review.</summary>
    [Parameter] public RenderFragment? Side { get; set; }

    private string PhoneSummary => Side == null ? $"All {FileCount} files from this run" : $"This run and its {FileCount} files";

    /// <summary>The files in "Everything from this run", in order.</summary>
    public const int FileCount = 5;

    private string Title => string.IsNullOrWhiteSpace(Objective) ? "Your review" : Objective!;

    /// <summary>One line on what the review found: studies, records, themes and studies cited.</summary>
    public static string StudiesLine(AuBtechReviewAgent.ReviewStats s)
    {
        var parts = new List<string>
        {
            $"{s.Included} {(s.Included == 1 ? "study" : "studies")} included from {s.TotalIdentified} {(s.TotalIdentified == 1 ? "record" : "records")}",
        };
        if (s.ThemesIdentified > 0) parts.Add($"{s.ThemesIdentified} {(s.ThemesIdentified == 1 ? "theme" : "themes")}");
        if (s.Included > 0) parts.Add($"{s.StudiesCitedInSynthesis} of {s.Included} cited");
        return string.Join(" · ", parts);
    }

    /// <summary>The bar as one sentence, for screen readers.</summary>
    public static string BarSentence(AuBtechReviewAgent.ReviewStats s) => AuBtechReviewAgent.VerdictTally.From(s).Sentence(s.CitationsChecked + s.CitationsRemoved);

    private RenderFragment Files => __builder =>
    {
        string api = $"/api/workspace/{RunId}";
        <ul class="mt-2 divide-y divide-line">
            @(FileRow("PRISMA report", "The review, every citation checked", ($"/spec-matrix/{RunId}", "Open", "the report")))
            @(FileRow("Protocol", "Written and fingerprinted before the search", ($"{api}/protocol.md", "Open", "the protocol")))
            @(FileRow("References", "The included studies as BibTeX or RIS", ($"{api}/references.bib", "BibTeX", "the references"), ($"{api}/references.ris", "RIS", "the references")))
            @(FileRow("Screened records", "Every record with its decision, as RIS", ($"{api}/screened.ris", "Download", "the screened records")))
            @(FileRow("Verifiable archive", "Every file fingerprinted, with the LaTeX manuscript", ($"{api}/archive", "Download", "the archive")))
            @(FileRow("Archive to share", "For Zenodo or OSF, without the papers and records that may not be shared", ($"{api}/deposit", "Download", "the archive to share")))
        </ul>
    };

    private static RenderFragment FileRow(string name, string about, params (string Href, string Action, string What)[] links) => __builder =>
    {
        <li class="flex items-center justify-between gap-3 py-2.5">
            <span class="min-w-0">
                <span class="block text-sm font-semibold text-ink">@name</span>
                <span class="block text-xs leading-snug text-muted">@about</span>
            </span>
            <span class="flex shrink-0 gap-1.5">
                @foreach (var link in links)
                {
                    var l = link;
                    <a href="@l.Href" class="ui-btn-secondary ui-btn-sm min-h-[44px] min-w-[44px]">@l.Action<span class="sr-only">@($" {l.What}")</span></a>
                }
            </span>
        </li>
    };
}
