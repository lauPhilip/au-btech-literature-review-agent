@* Text of a paper with every [n] as a button (module design M9, shared by every kind of review). Clicking a number
   opens what the citation check found for that sentence and source: its verdict, the quote and where it was found.
   Sentences are split exactly as the check split them. The page owns which citation is open; this component shows
   it, and the page adds its own extras to the open panel (notes, a re-check) through PanelExtras. With the checked
   editor on (Editable), each sentence can be clicked, or its Edit button pressed, to open the page's edit box. *@

@{
    int scan = 0;
}
<p class="text-ink">
    @for (int i = 0; i < sentences.Count; i++)
    {
        int sentenceIndex = i;
        // Keep the model's paragraph breaks: they sit in the whitespace between two sentences.
        int at = text.IndexOf(sentences[i], scan, StringComparison.Ordinal);
        if (at > scan && text.Substring(scan, at - scan).Contains("\n\n"))
        {
            <br /><br />
        }
        if (at >= 0) scan = at + sentences[i].Length;
        if (Editable)
        {
            @* The checked editor (owner only): the sentence opens the edit box on a click, and its Edit button does so from the keyboard. *@
            <span class="@(Editing == sentenceIndex ? "bg-active outline outline-1 outline-heading" : "cursor-text hover:bg-active")" @onclick="() => OnEdit.InvokeAsync(sentenceIndex)">@Sentence(sentenceIndex)</span>
            <button type="button" id="@EditButtonId(Field, sentenceIndex)" class="ml-1 inline-flex h-6 items-center rounded-btn border border-line-field bg-page px-1.5 align-middle font-sans text-xs font-semibold text-heading hover:border-heading focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand print:hidden"
                    aria-label="@($"Edit sentence {sentenceIndex + 1} of {EditName}")" aria-expanded="@(Editing == sentenceIndex ? "true" : "false")"
                    @onclick="() => OnEdit.InvokeAsync(sentenceIndex)">Edit</button>
        }
        else
        {
            @Sentence(sentenceIndex)
        }
        if (Edited != null && Edited.TryGetValue(sentenceIndex, out int editNumber))
        {
            <a href="@($"{HistoryHref}#{EditHistoryId(editNumber)}")" data-jump-to="@EditHistoryId(editNumber)"
               class="ui-chip ml-1 border-line bg-soft px-1 py-0 align-middle font-sans text-[11px] text-muted hover:text-heading hover:underline print:hidden"
               title="@($"The reviewer edited this sentence (edit {editNumber}); see the history of edits")">edited<span class="sr-only">@($": see edit {editNumber} in the history")</span></a>
        }
        @(" ")
    }
</p>
@if (Editing != null && Editor != null)
{
    @Editor
}
@if (Open is { } open && open.Field == Field)
{
    var check = FindCheck(open.Field, open.Sentence, open.Reference);
    @* Opening a citation moves focus here; Escape or Close returns it to the citation number (WCAG 2.4.3). *@
    <div id="@($"verdict-{Field}")" tabindex="-1" role="region" aria-label="@($"What the check found for reference {open.Reference}")"
         class="mt-3 space-y-2 rounded-card border border-line bg-page p-4 font-sans text-[15px] leading-relaxed text-ink shadow-card focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand print:hidden" @onkeydown="KeyDown">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                @if (check != null)
                {
                    <span class="@Chip(check.Verdict) inline-flex border px-2 py-0.5 text-xs font-semibold">@AuBtechReviewAgent.CitationView.VerdictLabel(check.Verdict)</span>
                }
                <p class="mt-1.5 font-semibold text-heading">[@open.Reference] @(SourceTitle(open.Reference) ?? "Unknown reference")</p>
            </div>
            <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px] shrink-0" @onclick="() => OnClose.InvokeAsync()">Close</button>
        </div>
        @if (check == null)
        {
            <p class="text-muted">This citation was not part of the automated check.</p>
        }
        else
        {
            <p class="text-sm text-muted">Checked against the @check.EvidenceBasis@(string.IsNullOrEmpty(check.EvidenceLocation) ? "" : $", {check.EvidenceLocation}").</p>
            @if (!string.IsNullOrWhiteSpace(check.AttributedText))
            {
                <p class="text-muted">Checked part of the sentence: <span class="italic text-ink">"@check.AttributedText"</span></p>
            }
            @if (!string.IsNullOrWhiteSpace(check.Quote))
            {
                <blockquote class="border-l-2 border-line-field pl-3 italic">"@check.Quote"</blockquote>
                <p class="text-xs @(check.QuoteVerified ? "text-supported" : "text-partly")">
                    @(check.QuoteVerified ? $"The quote was found in the {SourceNoun}'s text." : $"The quote could not be found in the {SourceNoun}'s text.")
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(check.Reason))
            {
                <p>@check.Reason</p>
            }
            @if (!string.IsNullOrWhiteSpace(check.ThemeNote))
            {
                <p class="text-partly">@check.ThemeNote</p>
            }
            @if (check.SecondVerdict != null)
            {
                <p class="text-xs text-muted">
                    First check: @AuBtechReviewAgent.CitationView.VerdictLabel(check.FirstVerdict). Second, independent check with more of the @(SourceNoun): @AuBtechReviewAgent.CitationView.VerdictLabel(check.SecondVerdict).
                    @(check.ResolvedBy == "second check" ? " The second check found a verbatim quote, so its verdict is shown." : "")
                </p>
            }
            @if (SourceLink(open.Reference) is { } link)
            {
                <p><a href="@link" target="_blank" rel="noopener" class="font-semibold text-heading underline underline-offset-2">Open the @SourceNoun<span class="sr-only">@($" for reference {open.Reference}")</span></a></p>
            }
            @PanelExtras?.Invoke(check)
        }
    </div>
}

@code {
    /// <summary>The field the text belongs to, as the citation check named it (e.g. "synthesis-2").</summary>
    [Parameter, EditorRequired] public string Field { get; set; } = "";
    [Parameter] public string? Text { get; set; }

    /// <summary>Every verdict of the run's citation check.</summary>
    [Parameter] public IReadOnlyList<AuBtechReviewAgent.CitationSupportResult> Checks { get; set; } = Array.Empty<AuBtechReviewAgent.CitationSupportResult>();

    /// <summary>The citation the page has open, if any.</summary>
    [Parameter] public (string Field, int Sentence, int Reference)? Open { get; set; }
    [Parameter] public EventCallback<(string Field, int Sentence, int Reference)> OnToggle { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The title of a source by its reference number, for the open panel.</summary>
    [Parameter] public Func<int, string?> SourceTitle { get; set; } = _ => null;

    /// <summary>A link to the source by its reference number (open-access copy, DOI or page), or null; only http(s) addresses.</summary>
    [Parameter] public Func<int, string?> SourceLink { get; set; } = _ => null;

    /// <summary>What a source is, e.g. "paper" or "page".</summary>
    [Parameter] public string SourceNoun { get; set; } = "paper";

    /// <summary>What the page adds to an open citation's panel, such as reviewer notes and a re-check.</summary>
    [Parameter] public RenderFragment<AuBtechReviewAgent.CitationSupportResult>? PanelExtras { get; set; }

    /// <summary>
    /// The checked editor (owner only, edit mode on, a field the reviewer may edit): every sentence gets an Edit button
    /// and opens the edit box when clicked. Off by default, so a page without the editor renders as before.
    /// </summary>
    [Parameter] public bool Editable { get; set; }

    /// <summary>The sentence whose edit box is open, if it is in this text; the page renders the box in <see cref="Editor"/>.</summary>
    [Parameter] public int? Editing { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public RenderFragment? Editor { get; set; }

    /// <summary>The name of this text for the Edit buttons' labels, e.g. "Discussion".</summary>
    [Parameter] public string EditName { get; set; } = "this section";

    /// <summary>Sentences the reviewer edited, with the number of the edit in force; each gets an "edited" mark for every reader.</summary>
    [Parameter] public IReadOnlyDictionary<int, int>? Edited { get; set; }

    /// <summary>The page's own address without a fragment, for the "edited" mark's link to the history.</summary>
    [Parameter] public string HistoryHref { get; set; } = "";

    private string text = "";
    private IReadOnlyList<string> sentences = Array.Empty<string>();

    protected override void OnParametersSet()
    {
        text = Text ?? "";
        sentences = AuBtechReviewAgent.CitationSupportChecker.SplitSentences(text);
    }

    private AuBtechReviewAgent.CitationSupportResult? FindCheck(string field, int sentence, int reference) =>
        Checks.FirstOrDefault(c => c.Field == field && c.SentenceIndex == sentence && c.Reference == reference);

    private static string Chip(string? verdict) => AuBtechReviewAgent.CitationView.Chip(verdict);

    /// <summary>The id of a sentence's Edit button, where focus goes back when its edit box closes.</summary>
    public static string EditButtonId(string field, int sentence) => $"edit-{field}-{sentence}";

    /// <summary>The id of an edit's entry in the history of edits.</summary>
    public static string EditHistoryId(int number) => $"report-edit-{number}";

    // One sentence as the check split it, with every [n] as a button.
    private RenderFragment Sentence(int sentenceIndex) => __builder =>
    {
        foreach (var (part, isMarker) in AuBtechReviewAgent.CitationSupportChecker.SplitMarkers(sentences[sentenceIndex]))
        {
            if (!isMarker || Checks.Count == 0)
            {
                var pieces = AuBtechReviewAgent.MethodsSectionWriter.StripMarkdownEmphasis(part).Split("\n\n");
                for (int k = 0; k < pieces.Length; k++)
                {
                    if (k > 0)
                    {
                        <br /><br />
                    }
                    @pieces[k]
                }
                continue;
            }
            @* One unbreakable group, so a line never ends between "[" and its first number; it may break after a comma. *@
            var refs = AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(part);
            <span class="whitespace-nowrap"><span class="text-muted">[</span>@for (int r = 0; r < refs.Count; r++)
            {
                int reference = refs[r];
                var check = FindCheck(Field, sentenceIndex, reference);
                bool isOpen = Open == (Field, sentenceIndex, reference);
                <button type="button" id="@AuBtechReviewAgent.CitationView.CiteId(Field, sentenceIndex, reference)" class="@Chip(check?.Verdict) @(isOpen ? "ring-2 ring-heading ring-offset-1" : "") mx-px inline-flex min-w-[1.7em] items-center justify-center border px-1 align-baseline font-mono text-[0.8em] font-semibold leading-snug hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand print:border-0 print:bg-transparent print:p-0"
                        title="@(check == null ? "Not checked" : AuBtechReviewAgent.CitationView.VerdictLabel(check.Verdict))"
                        aria-label="@($"Reference {reference}: {(check == null ? "not checked" : AuBtechReviewAgent.CitationView.VerdictLabel(check.Verdict).ToLowerInvariant())}")"
                        aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@($"verdict-{Field}")"
                        @onclick="() => OnToggle.InvokeAsync((Field, sentenceIndex, reference))" @onclick:stopPropagation="Editable">@reference</button>
                if (r < refs.Count - 1)
                {
                    <span class="whitespace-normal">, </span>
                }
            }<span class="text-muted">]</span></span>
        }
    };

    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
