@* The paper's check of itself (PaperSelfCheck, issues #531 and #532): ten checks made in code once the report was written,
   shown after the front page, where the citation summary used to be (issue #635 moved it to the panel beside the report). It is one <details> element, so it opens without scripts; the summary line says how
   they went ("8 checks passed, 2 notes, 1 fault"). Each row has the outcome, what was found and, opened, the evidence and
   what the check looks for. Every value is shown as text. Square corners, ui-* classes, screen only. *@

<details id="@AuBtechReviewAgent.ReportOutline.SelfCheckId" class="mt-8 border border-line bg-soft p-4 sm:p-5 print:hidden" data-self-check>
    <summary class="flex min-h-[44px] cursor-pointer items-center gap-3 font-display text-base font-semibold text-heading">
        <span>The paper checked itself: @Result.SummaryLine</span>
    </summary>
    <p class="mt-2 text-[15px] text-muted">
        These checks were made in code when the report was finished. They change nothing in the paper; they show a reader what to look at.
        A note is worth a look. A fault is something a reader would notice as wrong.@(Result.CheckedUtc.Length > 0 ? $" Checked {Result.CheckedUtc}." : "")
    </p>
    <div class="mt-3 overflow-x-auto" tabindex="0" role="region" aria-label="The ten checks of the paper; scrolls sideways when it is wider than the screen">
        <table class="w-full min-w-[34rem] border-collapse text-left text-[15px]">
            <caption class="sr-only">The checks the paper made of itself, with their outcome and what each found</caption>
            <thead>
                <tr class="border-b border-line text-sm text-muted">
                    <th scope="col" class="w-10 py-2 pr-2 font-semibold">No.</th>
                    <th scope="col" class="py-2 pr-3 font-semibold">Check</th>
                    <th scope="col" class="py-2 pr-3 font-semibold">Outcome</th>
                    <th scope="col" class="py-2 font-semibold">What was found</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var check in Result.Checks)
                {
                    <tr class="border-b border-line align-top" data-check-outcome="@check.Outcome">
                        <td class="py-2 pr-2 text-muted">@check.Number</td>
                        <th scope="row" class="py-2 pr-3 font-semibold text-ink">@check.Title</th>
                        <td class="py-2 pr-3"><span class="@ChipClass(check.Outcome)">@OutcomeLabel(check.Outcome)</span></td>
                        <td class="py-2">
                            <p class="text-ink">@check.Summary</p>
                            <details class="mt-1">
                                <summary class="min-h-[44px] cursor-pointer py-2 text-sm text-muted underline decoration-dotted underline-offset-2">Evidence and what this check looks for</summary>
                                <p class="text-sm text-muted">@check.Explanation</p>
                                @if (check.Evidence.Count == 0)
                                {
                                    <p class="mt-2 text-sm text-muted">Nothing to show: the check found nothing to point at.</p>
                                }
                                else
                                {
                                    <ul class="mt-2 space-y-2 text-sm">
                                        @foreach (var e in check.Evidence)
                                        {
                                            <li class="border-l-2 border-line pl-3">
                                                <span class="font-semibold text-ink">@e.Part</span>
                                                @if (e.Text.Length > 0) { <span class="block break-words text-ink">@e.Text</span> }
                                                @if (e.Detail.Length > 0) { <span class="block text-muted">@e.Detail</span> }
                                            </li>
                                        }
                                    </ul>
                                }
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>

@code {
    [Parameter, EditorRequired] public AuBtechReviewAgent.PaperSelfCheckFile Result { get; set; } = default!;

    internal static string OutcomeLabel(string outcome) => outcome switch
    {
        AuBtechReviewAgent.CheckOutcome.Fault => "Fault",
        AuBtechReviewAgent.CheckOutcome.Note => "Note",
        _ => "Passed",
    };

    internal static string ChipClass(string outcome) => outcome switch
    {
        AuBtechReviewAgent.CheckOutcome.Fault => "ui-chip-bad",
        AuBtechReviewAgent.CheckOutcome.Note => "ui-chip-partial",
        _ => "ui-chip-ok",
    };
}
