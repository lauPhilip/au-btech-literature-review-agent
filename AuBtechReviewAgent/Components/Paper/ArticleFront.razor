@* The front page of a report, laid out like a journal article but with TraceableAI's own identity and no journal's
   (wiki page 06): the masthead with the run, the banner that says an AI system wrote it, the title, the byline with
   its note, the Article info box beside the abstract, and the buttons for the PDF, the citation, the source archive
   and the decision log. On paper the buttons become links. No publisher, journal, volume, page range, DOI, university
   or funder is named. Every value comes from ArticleInfo, which reads the run's files in code. It renders on paper
   only unless OnScreen is set; the buttons need no live connection (wwwroot/js/review-output.js handles them). *@
@inject NavigationManager Nav

@* The running header (CSS margin boxes); every character of the title is escaped in ArticleInfo.RunningHeaderCss. *@
<style>@((MarkupString)Info.RunningHeaderCss())</style>
<header class="article-front @(OnScreen ? "" : "hidden print:block")" aria-label="Front page" data-front-page>
    <div class="af-masthead">
        <div>
            <p class="af-wordmark">TraceableAI</p>
            <p class="af-series">@Info.MastheadKind · @Info.Guideline</p>
        </div>
        <div class="af-run">
            @if (Info.GeneratedUtc != null)
            {
                <p>Generated @ArticleInfo.Date(Info.GeneratedUtc)</p>
            }
            <p>@Info.RunLabel</p>
        </div>
    </div>
    <p class="af-disclosure" role="note">@ArticleInfo.Disclosure</p>

    <h1 class="af-title">@Info.Title</h1>
    <p class="af-author">@ArticleInfo.Author<sup>*</sup></p>
    <p class="af-note"><sup>*</sup> @Info.BylineNote</p>

    <div class="af-grid">
        <aside class="af-info" aria-labelledby="af-info-label">
            <h2 class="af-label" id="af-info-label">Article info</h2>
            <dl>
                @foreach (var group in Info.InfoGroups())
                {
                    var g = group;
                    <div class="af-group">
                        <dt>@g.Label</dt>
                        @foreach (var line in g.Lines)
                        {
                            <dd>@line</dd>
                        }
                    </div>
                }
            </dl>
        </aside>
        <section class="af-abstract" id="@AbstractId" data-report-section="@(AbstractId == null ? null : "")" aria-labelledby="af-abstract-label">
            <h2 class="af-label" id="af-abstract-label">Abstract</h2>
            @foreach (var part in Info.AbstractParagraphs)
            {
                var p = part;
                @if (p.Heading != null)
                {
                    <p><strong>@(p.Heading).</strong> @p.Text</p>
                }
                else
                {
                    <p>@p.Text</p>
                }
            }
        </section>
    </div>

    <div class="af-actions print:hidden">
        <button type="button" class="ui-btn-secondary min-h-[44px]" data-print title="Print the report, or choose Save as PDF in the print window">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"></path></svg>
            PDF
        </button>
        <button type="button" class="ui-btn-secondary min-h-[44px]" data-copy="@CiteId" data-copy-label="Cite" title="Copy a reference to this report">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h4v4H8v3H6v-4zM15 7h4v4h-3v3h-2v-4z"></path></svg>
            <span data-copy-text>Cite</span>
        </button>
        @if (Info.LinksToRun)
        {
        <a href="@Link(Info.ArchivePath)" class="ui-btn-secondary min-h-[44px]" title="Every file of the run, fingerprinted, with the source papers and the LaTeX manuscript">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Source archive
        </a>
        <a href="@Link(Info.DecisionLogPath)" class="ui-btn-secondary min-h-[44px]" title="@Info.DecisionLogTitle">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h11M9 12h11M9 19h11M4 5h.01M4 12h.01M4 19h.01"></path></svg>
            Decision log
        </a>
        }
        <span class="sr-only" role="status" data-copy-status="@CiteId"></span>
    </div>

    @* On paper the buttons are links with full addresses, so a printed or saved copy still leads back to the run. *@
    <ul class="af-links hidden print:block">
        <li>Online: <a href="@Link(Info.ReportPath)">@Link(Info.ReportPath)</a></li>
        @if (Info.LinksToRun)
        {
            <li>Source archive: <a href="@Link(Info.ArchivePath)">@Link(Info.ArchivePath)</a></li>
            <li>Decision log: <a href="@Link(Info.DecisionLogPath)">@Link(Info.DecisionLogPath)</a></li>
        }
        @if (Info.HasProtocol && Info.LinksToRun)
        {
            <li>Protocol: <a href="@Link(Info.ProtocolPath)">@Link(Info.ProtocolPath)</a></li>
        }
    </ul>
    <p class="af-cite hidden print:block"><span class="af-cite-label">How to cite</span> <span id="@CiteId">@Info.HowToCite(Nav.BaseUri)</span></p>
    @if (Info.Keywords.Count > 0)
    {
        <p class="af-footnote hidden print:block">Keywords are taken in code from the protocol's topic, the search strings and the names of the themes; no language model chose them.</p>
    }
</header>

@code {
    [Parameter, EditorRequired] public AuBtechReviewAgent.ArticleInfo Info { get; set; } = default!;

    /// <summary>Show the front page on screen as well; by default it is on paper only.</summary>
    [Parameter] public bool OnScreen { get; set; }

    /// <summary>The id the contents list jumps to for the abstract; null when the page has its own abstract section.</summary>
    [Parameter] public string? AbstractId { get; set; }

    private string CiteId => $"cite-text-{Info.ShortRunId}";

    private string Link(string path) => AuBtechReviewAgent.ArticleInfo.Absolute(Nav.BaseUri, path);
}
