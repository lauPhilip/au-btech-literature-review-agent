@* The edit box of the checked editor: the reviewer rewrites one sentence beside the quotes its citations rest on,
   and "Check and save" checks every citation in the new sentence against the papers before the edit is kept
   (PrismaReviewEngine.EditReportSentenceAsync). The page owns the edit and its state; this box shows it. *@

<section id="@BoxId" aria-label="@($"Edit sentence {Sentence + 1} of {Label}")" @onkeydown="KeyDown"
         class="mt-3 border border-heading bg-page p-4 font-sans text-[15px] leading-relaxed text-ink print:hidden">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="font-display text-base font-semibold text-heading">Edit sentence @(Sentence + 1) of @Label</h3>
        <p class="text-xs text-muted">@UsedLine</p>
    </div>

    @if (Result != null)
    {
        <div role="status" class="mt-3 space-y-3">
            <p class="font-semibold text-supported">Saved. Every citation in your sentence was checked against the @(SourceNoun)s.</p>
            <blockquote class="border-l-2 border-heading pl-3">@Result.After</blockquote>
            <h4 class="text-sm font-semibold text-heading">What the check found</h4>
            <EditVerdicts Checks="Result.Checks" SourceTitle="SourceTitle" SourceNoun="@SourceNoun" Empty="Your sentence cites no study, so there was nothing to check." />
            @if (Result.Checks.Any(c => c.Verdict is AuBtechReviewAgent.CitationSupportChecker.Partial or AuBtechReviewAgent.CitationSupportChecker.NotSupported))
            {
                <p class="text-sm text-partly">A citation that is not fully supported stays in the text and is marked, like in the generated text. You can edit the sentence again or undo the edit.</p>
            }
            @if (Result.Checks.Any(c => c.Verdict == AuBtechReviewAgent.CitationSupportChecker.Unverifiable))
            {
                <p class="text-sm text-muted">A citation that could not be checked is marked as not verified. You can undo the edit and try again later.</p>
            }
        </div>
        <div class="mt-3 flex gap-2">
            <button type="button" class="ui-btn-primary ui-btn-sm min-h-[44px]" @onclick="() => OnCancel.InvokeAsync()">Done</button>
        </div>
    }
    else
    {
        <div class="mt-3 grid gap-4 md:grid-cols-2">
            <div>
                <label for="@TextId" class="ui-label">Your sentence</label>
                <textarea id="@TextId" rows="5" maxlength="@AuBtechReviewAgent.ReportEdits.MaxSentenceLength" @bind="draft" disabled="@Checking"
                          aria-describedby="@($"{BoxId}-hint")" class="ui-input rounded-none"></textarea>
                <p id="@($"{BoxId}-hint")" class="mt-1 text-xs text-muted">Keep it one sentence. Cite studies by their number in the reference list, like [3].</p>
                <div class="mt-2 flex flex-wrap gap-2">
                    <button type="button" class="ui-btn-primary ui-btn-sm min-h-[44px]" disabled="@Checking" @onclick="() => OnSave.InvokeAsync(draft)">@(Checking ? "Checking…" : "Check and save")</button>
                    <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px]" disabled="@Checking" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
                </div>
                @if (Checking)
                {
                    int cited = AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(draft).Count;
                    <div role="status" class="mt-3">
                        <p class="text-sm text-ink">@(cited == 0 ? "Saving your sentence." : $"Checking {(cited == 1 ? "1 citation" : $"{cited} citations")} against the {SourceNoun}s. This can take up to a minute.")</p>
                        <div class="mt-1.5 h-1 w-full overflow-hidden bg-soft" aria-hidden="true"><div class="h-full w-1/3 bg-heading motion-safe:animate-pulse"></div></div>
                    </div>
                }
                @if (Error != null)
                {
                    <p role="alert" class="mt-3 border-l-2 border-not-supported pl-3 text-sm text-not-supported">@Error</p>
                }
            </div>
            <div>
                <h4 class="text-sm font-semibold text-heading">What its citations rest on now</h4>
                <div class="mt-1.5"><EditVerdicts Checks="Checks" SourceTitle="SourceTitle" SourceNoun="@SourceNoun" /></div>
            </div>
        </div>
    }
</section>

@code {
    public const string BoxId = "sentence-editor";
    public const string TextId = "sentence-editor-text";

    /// <summary>The sentence's number in its text, from 0.</summary>
    [Parameter] public int Sentence { get; set; }

    /// <summary>The part of the report, in plain words (<see cref="AuBtechReviewAgent.EditView.FieldLabel"/>).</summary>
    [Parameter] public string Label { get; set; } = "the report";

    /// <summary>The sentence as the report reads now; the box starts with it.</summary>
    [Parameter] public string Original { get; set; } = "";

    /// <summary>The verdicts the sentence has now, with their quotes.</summary>
    [Parameter] public IReadOnlyList<AuBtechReviewAgent.CitationSupportResult> Checks { get; set; } = Array.Empty<AuBtechReviewAgent.CitationSupportResult>();

    [Parameter] public bool Checking { get; set; }

    /// <summary>Why the edit was refused or failed, in plain words.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>The saved edit with its new verdicts, once the check is done.</summary>
    [Parameter] public AuBtechReviewAgent.ReportEdit? Result { get; set; }

    /// <summary>"3 of 100 edits used".</summary>
    [Parameter] public string UsedLine { get; set; } = "";

    [Parameter] public Func<int, string?> SourceTitle { get; set; } = _ => null;
    [Parameter] public string SourceNoun { get; set; } = "paper";
    [Parameter] public EventCallback<string> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string draft = "";
    private string? startedFrom;

    protected override void OnParametersSet()
    {
        // A new sentence (or the same one after a save) starts from its text; a refused edit keeps what was typed.
        if (startedFrom != Original)
        {
            startedFrom = Original;
            draft = Original;
        }
    }

    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" && !Checking ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
