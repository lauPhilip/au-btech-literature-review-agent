<!DOCTYPE html>
<html lang="en" class="h-full w-full m-0 p-0 overflow-hidden" data-follow-system="@(Layout.ThemeToggle.FollowSystem ? "true" : "false")"
      data-theme-ready="@(Layout.ThemeToggle.ReadyFor(Navigation.ToBaseRelativePath(Navigation.Uri)) ? "true" : "false")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Sets data-theme on <html> before anything is painted, so a dark choice never flashes white. It must be a
       file and not an inline script, because the Content-Security-Policy allows only scripts from this site. *@
    <script src="@Assets["js/theme.js"]"></script>
    @* @Assets[...] gives each file a fingerprinted address (it changes when the file changes), so browsers may
       keep it for a year instead of asking again on every visit; MapStaticAssets serves it Brotli-compressed. *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* Tailwind is compiled ahead of time (npm run build:css) instead of loaded from a CDN, so the page needs no
       third-party scripts and can run under a strict Content-Security-Policy. It comes after app.css, as the
       CDN version did, so its reset (e.g. links inherit their colour) still wins over app.css. *@
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    @* The report as paper (wiki page 06), plain CSS: the front page and the A4 sheets on screen, and the journal layout for print. *@
    <link rel="stylesheet" href="@Assets["css/report-paper.css"]" />
    <link rel="stylesheet" href="@Assets["css/journal-print.css"]" media="print" />
    <link rel="icon" href="favicon.ico" sizes="any" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="192x192" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    @* The body font is preloaded so text does not change font after it appears. *@
    <link rel="preload" href="fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#13294B" />
    <link rel="manifest" href="site.webmanifest" />
    <HeadOutlet />
</head>

<body class="h-full w-full m-0 p-0 bg-soft overflow-hidden text-ink font-sans">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["js/mermaid-render.js"]"></script>
    <script src="@Assets["js/review-output.js"]"></script>
    <script src="@Assets["js/paged-tables.js"]"></script>
    <script src="@Assets["js/paged-blocks.js"]"></script>
    <script src="@Assets["js/paged-fit.js"]"></script>
    <script src="@Assets["js/paged-preview.js"]"></script>
    <script src="@Assets["js/citation-loop.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@* The address decides whether this page can take the dark theme (ThemeToggle.ReadyFor). Blazor's enhanced
   navigation copies <html>'s attributes from the next page, so data-theme-ready follows every page change. *@
@inject NavigationManager Navigation
