@* "Cite this report" for one version of a gallery report (GalleryCitation.cs): a button that opens an APA reference
   and a BibTeX entry. It is a plain <details> element, so it opens without scripts or a live connection; the text can
   be selected and copied. Every value is shown as text. *@

<details class="mt-3" data-gallery-cite>
    <summary class="ui-btn-secondary ui-btn-sm inline-flex min-h-[44px] cursor-pointer list-none">Cite this report</summary>
    <div class="mt-3 border border-line bg-page p-4 text-sm">
        <p class="text-muted">Cite this report as the output of a software tool. The address is the report's DOI when it has one, and otherwise this version's own address on this site; either keeps showing the same report when newer versions are added.</p>
        <h3 class="mt-3 font-display text-xs font-semibold uppercase tracking-[0.08em] text-muted">APA 7</h3>
        <p class="mt-1 break-words text-ink" data-cite-apa>@apa.Before<em>@apa.Title</em>@apa.After</p>
        <h3 class="mt-3 font-display text-xs font-semibold uppercase tracking-[0.08em] text-muted">BibTeX</h3>
        <pre class="mt-1 overflow-x-auto border border-line bg-soft p-3 text-xs leading-relaxed text-ink" data-cite-bibtex>@AuBtechReviewAgent.GalleryCitation.BibTex(Entry, BaseUrl)</pre>
    </div>
</details>

@code {
    [Parameter, EditorRequired] public AuBtechReviewAgent.GalleryEntry Entry { get; set; } = default!;

    /// <summary>The site's public address without a trailing slash (SiteSeo.BaseUrl).</summary>
    [Parameter, EditorRequired] public string BaseUrl { get; set; } = "";

    private (string Before, string Title, string After) apa;

    protected override void OnParametersSet() => apa = AuBtechReviewAgent.GalleryCitation.ApaParts(Entry, BaseUrl);
}
