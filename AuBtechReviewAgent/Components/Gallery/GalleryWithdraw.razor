@inject AuBtechReviewAgent.GalleryStore Store
@inject IJSRuntime JS
@inject NavigationManager Nav

@* The owner's withdraw button on a gallery entry. It appears only when this browser still holds the edit key of a
   run one of the entry's versions was made from (browsers keep a key for 30 days); everyone else sees nothing.
   Withdrawing removes every version (GalleryStore.WithdrawAsync). *@

@if (canWithdraw)
{
    <div class="mt-3 border-t border-line pt-3">
        @if (!confirm)
        {
            <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px]" @onclick="() => confirm = true">Withdraw from the gallery</button>
            <span class="ml-2 text-xs text-muted">You see this because this browser started the run.</span>
        }
        else
        {
            <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Withdraw from the gallery">
                <span class="text-ink">Remove this report and all its versions from the gallery for good?</span>
                <button type="button" class="ui-btn-danger ui-btn-sm min-h-[44px]" @onclick="WithdrawAsync" disabled="@busy">Withdraw</button>
                <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px]" @onclick="() => confirm = false">Keep it</button>
            </div>
        }
        @if (failed)
        {
            <p class="mt-2 text-not-supported" role="status">It could not be withdrawn. Try again later.</p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string EntryId { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<Guid> RunIds { get; set; } = Array.Empty<Guid>();

    private string? editKey;
    private bool canWithdraw, confirm, busy, failed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (Store.Find(EntryId) is not { } entry) return;
        foreach (var runId in RunIds.Distinct())
        {
            string? key;
            try { key = await JS.InvokeAsync<string?>("traceableReview.getEditKey", runId.ToString()); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { return; }
            if (!AuBtechReviewAgent.GalleryStore.CanWithdraw(entry, key)) continue;
            (editKey, canWithdraw) = (key, true);
            break;
        }
        if (canWithdraw) StateHasChanged();
    }

    private async Task WithdrawAsync()
    {
        if (busy) return;
        busy = true;
        failed = !await Store.WithdrawAsync(EntryId, editKey);
        busy = false;
        if (!failed) Nav.NavigateTo("/gallery", forceLoad: true);
    }
}
