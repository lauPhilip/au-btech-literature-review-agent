@page "/verify"
@layout AppLayout
@rendermode InteractiveServer
@inject ILogger<Verify> Logger
@inject IHttpContextAccessor HttpContextAccessor
@inject AuBtechReviewAgent.ActionLimiter Actions

@* Checks an uploaded run archive against its manifest.json (RunManifest.CheckArchive). The upload goes to a
   temporary file that is deleted when the check ends, one check at a time across the site (ArchiveUpload), and each
   address may check a limited number an hour (ActionLimiter). *@

<SeoHead Title="Verify a run archive" Path="/verify" BreadcrumbName="Verify"
         Description="Check that a TraceableAI run archive has not been changed: every file is compared with the SHA-256 fingerprint in its manifest." />

<DocPage Current="/verify" Eyebrow="Verify" Title="Check that an archive is unchanged" Wide="true">
    <Lead>
        Every run archive contains <code class="font-mono text-[15px]">manifest.json</code>, with a SHA-256 fingerprint of each file and of
        the manifest itself. Upload an archive to compare every file with its fingerprint.
    </Lead>
    <ChildContent>
        <div class="mt-8 grid grid-cols-1 items-start gap-6 xl:grid-cols-2">
            <div>
                <label for="archive" class="flex min-h-[220px] cursor-pointer flex-col items-center justify-center gap-2 rounded-card border-2 border-dashed border-line-field bg-soft p-6 text-center hover:border-heading focus-within:border-heading focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-heading @(checking ? "opacity-60" : "")">
                    <svg class="h-8 w-8 text-heading" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                    <span class="font-display text-base font-semibold text-heading">Choose a run archive</span>
                    <span class="text-sm text-muted">A .zip file of at most @(MaxUploadMb) MB. It is checked on the server and not stored.</span>
                    <InputFile id="archive" OnChange="CheckAsync" accept=".zip,application/zip" disabled="@checking" aria-describedby="archive-help" class="sr-only" />
                </label>
                <p id="archive-help" class="mt-3 text-sm text-muted">You can also check it yourself: unzip it and compare <code class="font-mono">sha256sum</code> (or <code class="font-mono">Get-FileHash</code> in PowerShell) with the manifest.</p>
            </div>

            <div role="status" aria-live="polite">
                @if (checking)
                {
                    <p class="text-ink">Checking @fileName …</p>
                }
                else if (error != null)
                {
                    <div class="rounded-card border border-not-supported-border bg-not-supported-fill p-5 text-not-supported">
                        <p class="font-semibold">The file could not be checked</p>
                        <p class="mt-1 text-sm">@error</p>
                    </div>
                }
                else if (result is { } r)
                {
                    <div class="rounded-card border p-5 @(r.Unchanged ? "border-supported-border bg-supported-fill" : "border-not-supported-border bg-not-supported-fill")">
                        <p class="flex items-center gap-2 font-display text-lg font-semibold @(r.Unchanged ? "text-supported" : "text-not-supported")">
                            @if (r.Unchanged)
                            {
                                <span aria-hidden="true">✓</span><span>Unchanged: all @r.FilesListed files match their fingerprints</span>
                            }
                            else if (!r.HasManifest)
                            {
                                <span aria-hidden="true">✕</span><span>This is not a TraceableAI run archive: it has no manifest.json</span>
                            }
                            else
                            {
                                <span aria-hidden="true">✕</span><span>This archive was changed after the run</span>
                            }
                        </p>
                        @if (r.HasManifest)
                        {
                            <p class="mt-1 text-sm text-ink">@ManifestLine(r.ManifestIntact)</p>
                        }
                    </div>

                    @if (r.HasManifest)
                    {
                        <dl class="mt-5 grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-[10rem_1fr]">
                            <dt class="text-muted">File</dt><dd class="break-all text-ink">@fileName</dd>
                            <dt class="text-muted">Run</dt><dd class="break-all font-mono text-ink">@(r.RunId ?? "–")</dd>
                            <dt class="text-muted">Archive made</dt><dd class="text-ink">@(r.CreatedUtc?.Replace("T", " ").TrimEnd('Z') ?? "–") UTC</dd>
                            <dt class="text-muted">App version</dt><dd class="break-all text-ink">@(r.AppVersion ?? "–")</dd>
                            <dt class="text-muted">Model</dt><dd class="text-ink">@(r.Model ?? "–")</dd>
                            <dt class="text-muted">Protocol fingerprint</dt><dd class="break-all font-mono text-ink">@(r.ProtocolHash ?? "–")</dd>
                        </dl>
                    }

                    @if (r.Files is { Count: > 0 } listedFiles)
                    {
                        @* Every file the manifest lists, each with what the check found (issue #245). *@
                        <h2 class="mt-6 font-display text-base font-semibold text-heading">Files in the manifest (@listedFiles.Count)</h2>
                        <ul class="mt-2 divide-y divide-line border-y border-line text-xs">
                            @foreach (var file in listedFiles.Take(MaxShown))
                            {
                                bool ok = file.Status == "Matches";
                                <li class="flex items-center justify-between gap-3 py-1.5">
                                    <span class="break-all font-mono text-ink">@file.Path</span>
                                    <span class="shrink-0 font-semibold @(ok ? "text-supported" : "text-not-supported")">@file.Status</span>
                                </li>
                            }
                        </ul>
                        @if (listedFiles.Count > MaxShown)
                        {
                            <p class="mt-2 text-xs text-muted">And @(listedFiles.Count - MaxShown) more, each listed in the archive's manifest.json.</p>
                        }
                    }
                    @if (r.NotListed.Count > 0)
                    {
                        <h2 class="mt-6 font-display text-base font-semibold text-heading">Files that are not in the manifest (@r.NotListed.Count)</h2>
                        <ul class="mt-2 space-y-1 font-mono text-xs text-ink">
                            @foreach (var file in r.NotListed.Take(MaxShown))
                            {
                                <li class="break-all">@file</li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <div class="rounded-card border border-line p-5 text-sm text-muted">The result appears here: whether every file still matches its fingerprint, and which do not.</div>
                }
            </div>
        </div>
    </ChildContent>
</DocPage>

@code {
    private const int MaxShown = 500;

    /// <summary>What the manifest's own fingerprint says: unchanged, edited, or from a version that had none.</summary>
    private static string ManifestLine(bool? intact)
    {
        if (intact is null) return "This manifest is from an older version without a fingerprint of itself.";
        return intact.Value
            ? "The manifest itself is also unchanged."
            : "The manifest itself was edited: its own fingerprint no longer matches, so the list of fingerprints cannot be trusted.";
    }

    private const int MaxUploadMb = AuBtechReviewAgent.ArchiveUpload.MaxMb;

    private bool checking;
    private string? fileName;
    private string? error;
    private AuBtechReviewAgent.RunManifest.ArchiveCheck? result;

    // The address the upload limit counts by, read during the prerender as the review form reads it.
    [PersistentState]
    public string? PrerenderClientAddress { get; set; }

    protected override void OnInitialized() =>
        PrerenderClientAddress ??= AuBtechReviewAgent.RunQuotaService.NormalizeClientAddress(HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress);

    private async Task CheckAsync(InputFileChangeEventArgs e)
    {
        checking = true;
        error = null;
        result = null;
        fileName = e.File.Name;
        try
        {
            if (AuBtechReviewAgent.ArchiveUpload.Refuse(e.File.Name, e.File.Size) is { } refused) { error = refused; return; }
            if (!Actions.TryTake(AuBtechReviewAgent.ActionLimiter.VerifyUpload, PrerenderClientAddress ?? "unknown", out string limited)) { error = limited; return; }
            await using var upload = e.File.OpenReadStream(MaxUploadMb * 1024L * 1024L);
            result = await AuBtechReviewAgent.ArchiveUpload.CheckAsync(upload);
            if (result == null) error = "Another archive is being checked just now. Try again in a minute.";
        }
        catch (IOException ex) when (ex.Message.Contains("exceeds", StringComparison.OrdinalIgnoreCase))
        {
            error = $"The file is larger than {MaxUploadMb} MB.";
        }
        catch (InvalidDataException ex)
        {
            error = ex.Message.StartsWith("The archive", StringComparison.Ordinal) ? ex.Message : "The file is not a valid zip archive.";
        }
        catch (System.Text.Json.JsonException)
        {
            error = "The archive's manifest.json could not be read.";
        }
        catch (Exception ex) when (ex is IOException or KeyNotFoundException or InvalidOperationException)
        {
            Logger.LogInformation("Archive check failed: {Message}", ex.Message.Replace("\r", " ").Replace("\n", " "));
            error = "The file could not be read as a run archive.";
        }
        finally
        {
            checking = false;
        }
    }
}
