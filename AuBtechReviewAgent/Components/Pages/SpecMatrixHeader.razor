@* The top of the report page under the front page: the box with the citations checked (on screen only), and, when the
   page has no front page (a gallery copy), the old header with the title and the abstract. The page passes itself as
   Page; its state stays there. *@

@if (Page.articleInfo == null)
{
    <header class="border-b border-line pb-6">
        <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">Systematic review · PRISMA 2020@(Page.dateLine.Length > 0 ? $" · {Page.dateLine}" : "")</p>
        <h1 class="mt-2 max-w-[24ch] font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">@SpecMatrix.ScrubAnchors(Page.report.TitleItem)</h1>
        @if (Page.runLine.Length > 0)
        {
            <p class="mt-3 text-[15px] text-muted">@Page.runLine</p>
        }
        <p class="mt-1 text-xs text-muted">
            <span class="break-all font-mono">protocol @(string.IsNullOrWhiteSpace(Page.report.ProtocolHash) ? "not recorded" : Page.report.ProtocolHash)</span>
        </p>
    </header>

    <section id="@AuBtechReviewAgent.ReportOutline.AbstractId" data-report-section class="scroll-mt-20 pt-6">
        <h2 class="font-display text-xl font-semibold tracking-tight text-heading">Abstract</h2>
        <p class="mt-2">@SpecMatrix.ScrubAnchors(Page.report.AbstractItem)</p>
    </section>
}
@if (Page.auditChecks.Count > 0)
{
    var counts = AuBtechReviewAgent.VerdictTally.From(Page.auditChecks, Page.auditRemoved);
    <div class="@(Page.articleInfo == null ? "mt-5" : "mt-8") border border-line bg-soft p-4 sm:p-5 print:hidden">
        <h2 class="font-display text-base font-semibold text-heading">@counts.Checked @(counts.Checked == 1 ? "citation" : "citations") checked against the papers</h2>
        <div class="mt-2"><VerdictBar Counts="counts" /></div>
        <p class="mt-2 text-[15px] text-muted">
            Each number in the text is coloured by what the check found. Open one to see the passage it was checked against.
            @(counts.Flagged > 0 ? $"{counts.Flagged} {(counts.Flagged == 1 ? "citation is" : "citations are")} only partly or not supported; they stay in the report, marked." : "")
            @(counts.Removed > 0 ? $"{counts.Removed} {(counts.Removed == 1 ? "citation was" : "citations were")} still not supported after the repair and {(counts.Removed == 1 ? "was" : "were")} removed; citation-audit.json lists {(counts.Removed == 1 ? "it" : "them")}." : "")
        </p>
    </div>
}

@if (Page.selfCheck != null && Page.selfCheck.Checks.Count > 0)
{
    <SelfCheckTable Result="Page.selfCheck" />
}

@code {
    [Parameter, EditorRequired] public SpecMatrix Page { get; set; } = default!;
}
