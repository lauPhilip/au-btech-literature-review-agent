@* The top of the report page under the front page: when the page has no front page (a gallery copy), the old header
   with the title and the abstract. The citation checks are not repeated in the pages: the front page gives the count
   and the panel beside the report (CitationCheckPanel) gives the rest (issue #635). The page passes itself as Page;
   its state stays there. *@

@if (Page.articleInfo == null)
{
    <header class="border-b border-line pb-6">
        <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">Systematic review · PRISMA 2020@(Page.dateLine.Length > 0 ? $" · {Page.dateLine}" : "")</p>
        <h1 class="mt-2 max-w-[24ch] font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">@SpecMatrix.ScrubAnchors(Page.report.TitleItem)</h1>
        @if (Page.runLine.Length > 0)
        {
            <p class="mt-3 text-[15px] text-muted">@Page.runLine</p>
        }
        <p class="mt-1 text-xs text-muted">
            <span class="break-all font-mono">protocol @(string.IsNullOrWhiteSpace(Page.report.ProtocolHash) ? "not recorded" : Page.report.ProtocolHash)</span>
        </p>
    </header>

    <section id="@AuBtechReviewAgent.ReportOutline.AbstractId" data-report-section class="scroll-mt-20 pt-6">
        <h2 class="font-display text-xl font-semibold tracking-tight text-heading">Abstract</h2>
        <p class="mt-2">@SpecMatrix.ScrubAnchors(Page.report.AbstractItem)</p>
    </section>
}

@* The paper's check of itself (issue #532): a closed table of the ten checks, on screen only, after the front page. *@
@if (Page.selfCheck != null && Page.selfCheck.Checks.Count > 0)
{
    <SelfCheckTable Result="Page.selfCheck" />
}

@code {
    [Parameter, EditorRequired] public SpecMatrix Page { get; set; } = default!;
}
