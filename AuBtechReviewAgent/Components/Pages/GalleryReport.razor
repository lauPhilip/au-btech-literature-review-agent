@page "/gallery/{Id}"
@page "/gallery/{Id}/v/{Version:int}"
@layout AppLayout
@inject AuBtechReviewAgent.GalleryStore Store
@inject AuBtechReviewAgent.ReviewModulesOptions ModuleOptions
@inject NavigationManager Nav
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@* One report in the gallery, shown only as it prints: the report page draws a version's copy (SpecMatrix with
   GalleryId and GalleryVersion) inside "ui-print-view", which applies the print layout on screen
   (Styles/tailwind.input.css). /gallery/{id} shows the newest version; /gallery/{id}/v/{n} always shows version n.
   The page around it is plain; the report and the owner's withdraw button are the only live parts. *@

@if (entry != null && newest != null)
{
    <SeoHead Title="@entry.Title" Path="@CanonicalPath" BreadcrumbName="Gallery" AiGeneratedBy="@(Array.Empty<string>())"
             Description="@($"An example {AuBtechReviewAgent.GalleryCard.TypeLabel(entry.Card).ToLowerInvariant()} made with TraceableAI, shown as it prints, with every citation checked against its source.")" />

    <div class="mx-auto w-full max-w-[960px] px-[clamp(16px,3vw,40px)] py-6 sm:py-10">
        <a href="/gallery" class="ui-btn-ghost min-h-[44px] px-2"><span aria-hidden="true">←</span> All example reports</a>

        @if (entry.Version != newest.Version)
        {
            <p class="mt-4 border border-line bg-soft p-3 text-sm text-ink" role="note" data-older-version>
                This is version @entry.Version of this review, added on @AuBtechReviewAgent.GalleryCard.Date(entry.Versions.First(v => v.Number == entry.Version).AddedUtc).
                <a href="@($"/gallery/{entry.Id}")" class="font-medium text-heading underline underline-offset-2">See the newest, version @newest.Version</a>
            </p>
        }

        <section class="mt-4 border border-line bg-soft p-4 text-sm sm:p-5" aria-labelledby="how-made">
            <h2 id="how-made" class="font-display text-base font-semibold text-heading">How this was made</h2>
            <p class="mt-1 text-ink">@AuBtechReviewAgent.GalleryCard.HowMade(entry)</p>
            @if (AuBtechReviewAgent.GalleryCard.CitationSupport(entry.Citations) is string support)
            {
                <p class="mt-2 text-ink" data-citation-support>@support.</p>
            }
            @if (AuBtechReviewAgent.GalleryCard.SelfCheckLine(entry.SelfCheck) is string selfCheck)
            {
                <p class="mt-1 text-ink" data-self-check>@selfCheck. The report checked its own paper in code once it was finished, as an editor would; a note is worth a look and a fault is something a reader would notice.</p>
            }
            <p class="mt-2 text-muted">
                @AuBtechReviewAgent.GalleryCard.Provenance(entry). Shown as it prints, drawn from a copy of the run's files with today's layout.
                <a href="/model-card" class="text-heading underline underline-offset-2">How the tool works</a> ·
                <a href="/privacy#gallery" class="text-heading underline underline-offset-2">What the gallery keeps</a>
            </p>
            <AuBtechReviewAgent.Components.Gallery.GalleryCite Entry="entry" BaseUrl="@BaseUrl" />
            <AuBtechReviewAgent.Components.Gallery.GalleryWithdraw EntryId="@entry.Id" RunIds="@RunIds" @rendermode="InteractiveServer" />
        </section>

        @if (entry.Versions.Count > 1)
        {
            <AuBtechReviewAgent.Components.Gallery.GalleryVersions Entry="entry" Current="entry.Version" />
        }

        <div class="mt-6 border border-line bg-page px-5 py-8 shadow-card sm:px-12 sm:py-12 ui-print-view" data-gallery-report>
            <AuBtechReviewAgent.Components.Pages.SpecMatrix GalleryId="@entry.Id" GalleryVersion="@entry.Version" />
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public int? Version { get; set; }
    [CascadingParameter] private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private string BaseUrl => AuBtechReviewAgent.SiteSeo.BaseUrl(Configuration, HttpContext?.Request) is { Length: > 0 } url
        ? url : Nav.BaseUri.TrimEnd('/');

    private AuBtechReviewAgent.GalleryEntry? entry, newest;

    // The newest version's own address is the entry's, so search engines keep one address for the same page.
    private string CanonicalPath => entry!.Version == newest!.Version ? $"/gallery/{entry.Id}" : AuBtechReviewAgent.GalleryCard.VersionPath(entry.Id, entry.Version);

    private IReadOnlyList<Guid> RunIds => entry!.Versions.Select(v => v.RunId).ToList();

    protected override void OnParametersSet()
    {
        newest = Store.Find(Id);
        entry = Version is int number ? Store.Find(Id, number) : newest;
        // Only the systematic review's report can be drawn from a copy yet; a review whose card is not shown stays out of sight.
        if (entry == null || newest == null || !ModuleOptions.Shows(entry.Card) || entry.Module != AuBtechReviewAgent.ReviewModules.Default.Key)
        {
            entry = null;
            Nav.NotFound();
        }
    }
}
