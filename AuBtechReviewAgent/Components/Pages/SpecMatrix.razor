@page "/spec-matrix"
@page "/spec-matrix/{RunId:guid}"
@layout AppLayout
@rendermode InteractiveServer

@using System.IO
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine
@inject AuBtechReviewAgent.RunStore Runs

<SeoHead Title="Review output" Path="/spec-matrix" NoIndex="true" Description="A PRISMA 2020 review report with every citation checked against the cited paper." />

@if (!HasReport)
{
    <div class="mx-auto my-12 max-w-xl px-4">
        <div class="ui-card p-6 text-center">
            <h1 class="font-display text-lg font-semibold text-heading">@(deleted ? "The run was deleted" : "No report yet")</h1>
            <p class="mt-1 text-sm text-muted">
                @(deleted ? "Its ledger, report and downloaded papers have been removed from the server."
                          : "Start a review on New review. The report appears here when the run is done.")
            </p>
            <a href="/review" class="ui-btn-primary mt-4 min-h-[44px]">New review</a>
        </div>
    </div>
}
else
{
    string runHref = $"/review/{State.CurrentSessionId}";
    string api = $"/api/workspace/{State.CurrentSessionId}";
    <div class="mx-auto w-full max-w-[1600px] px-[clamp(16px,3vw,40px)] py-4 sm:py-8 print:max-w-none print:p-0">

        <div class="mb-4 flex flex-wrap items-center justify-between gap-2 print:hidden">
            <a href="@runHref" class="ui-btn-ghost min-h-[44px] px-2"><span aria-hidden="true">←</span> Back to the run</a>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" @onclick="PrintReport" class="ui-btn-secondary min-h-[44px] max-sm:hidden" title="Print the report, or choose Save as PDF in the print window">Print or save as PDF</button>
                <a href="@($"{api}/archive")" class="ui-btn-primary min-h-[44px]" title="Every file of the run, fingerprinted, with the LaTeX manuscript">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download archive
                </a>
                <details class="relative">
                    <summary class="ui-btn-secondary min-h-[44px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">More<span class="sr-only"> actions for this report</span></summary>
                    <div class="absolute right-0 z-40 mt-2 w-[min(20rem,calc(100vw-2rem))] space-y-1 rounded-card border border-line bg-page p-2 shadow-lift">
                        <button type="button" @onclick="CopyLink" class="flex min-h-[44px] w-full items-center rounded-btn px-3 text-left text-sm text-ink hover:bg-active" title="Anyone with the link can read this report; only the browser that started the run can change it">@(linkCopied ? "Link copied" : "Copy link to this report")</button>
                        <a href="@($"/review?from={State.CurrentSessionId}")" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">New review from these settings</a>
                        @if (hasProtocol)
                        {
                            <a href="@($"{api}/protocol.md")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">Protocol, written before the search</a>
                        }
                        <a href="@($"{api}/references.bib")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">References as BibTeX</a>
                        <a href="@($"{api}/references.ris")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">References as RIS (Zotero, EndNote)</a>
                        <a href="@($"{api}/screened.ris")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active" title="Every screened record, tagged included or excluded with the reason">Every screened record as RIS</a>
                        <div class="border-t border-line pt-1">
                            @if (!canEdit)
                            {
                                <p class="px-3 py-2 text-xs text-muted">Read-only. Only the browser that started this run can change or delete it.</p>
                            }
                            else if (!ReviewEngine.IsRunActive(State.CurrentSessionId))
                            {
                                @if (!confirmDelete)
                                {
                                    <button type="button" @onclick="() => confirmDelete = true" class="flex min-h-[44px] w-full items-center rounded-btn px-3 text-left text-sm text-not-supported hover:bg-not-supported-fill">Delete run</button>
                                }
                                else
                                {
                                    <div class="space-y-2 rounded-btn bg-not-supported-fill p-3 text-sm text-not-supported" role="alert">
                                        <p>Delete this run and its files for good?</p>
                                        <div class="flex gap-2">
                                            <button type="button" @onclick="DeleteRun" class="ui-btn-danger ui-btn-sm min-h-[44px]">Delete</button>
                                            <button type="button" @onclick="() => confirmDelete = false" class="ui-btn-secondary ui-btn-sm min-h-[44px]">Cancel</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </details>
            </div>
        </div>

        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[220px_minmax(0,1fr)] xl:gap-8 min-[1500px]:grid-cols-[220px_minmax(0,1fr)_350px] print:block">
            <div class="max-lg:hidden print:hidden">
                <ReportContents Entries="Outline" PageHref="@($"/spec-matrix/{State.CurrentSessionId}")" />
            </div>

            <div class="min-w-0">
        <CitationAttentionBar Attention="AttentionList" Index="attentionIndex" OnStep="StepAttention" HideFromLarge="true" />
        <article class="mx-auto w-full max-w-[880px] rounded-card border border-line bg-page px-5 py-6 text-[17px] leading-[1.7] text-ink shadow-card sm:px-10 sm:py-10 [&_blockquote]:max-w-[70ch] [&_h3]:max-w-[70ch] [&_p]:max-w-[70ch] print:max-w-none print:rounded-none print:border-0 print:p-0 print:text-[11pt] print:leading-normal print:shadow-none">

            <header class="border-b border-line pb-6">
                <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">Systematic review · PRISMA 2020@(dateLine.Length > 0 ? $" · {dateLine}" : "")</p>
                <h1 class="mt-2 max-w-[24ch] font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">@ScrubAnchors(report.TitleItem)</h1>
                @if (runLine.Length > 0)
                {
                    <p class="mt-3 text-[15px] text-muted">@runLine</p>
                }
                <p class="mt-1 text-xs text-muted">
                    Department of Business Development and Technology, Aarhus University ·
                    <span class="break-all font-mono">protocol @(string.IsNullOrWhiteSpace(report.ProtocolHash) ? "not recorded" : report.ProtocolHash)</span>
                </p>

                @if (auditChecks.Count > 0)
                {
                    var counts = AuBtechReviewAgent.VerdictTally.From(auditChecks);
                    <div class="mt-5 rounded-card border border-line bg-soft p-4 sm:p-5 print:hidden">
                        <h2 class="font-display text-base font-semibold text-heading">@counts.Total @(counts.Total == 1 ? "citation" : "citations") checked against the papers</h2>
                        <div class="mt-2"><VerdictBar Counts="counts" /></div>
                        <p class="mt-2 text-[15px] text-muted">
                            Each number in the text is coloured by what the check found. Open one to see the passage it was checked against.
                            @(counts.Flagged > 0 ? $"{counts.Flagged} {(counts.Flagged == 1 ? "citation is" : "citations are")} only partly or not supported; they stay in the report, marked." : "")
                        </p>
                    </div>
                }
            </header>

            <section id="@AuBtechReviewAgent.ReportOutline.AbstractId" data-report-section class="scroll-mt-20 pt-6">
                <h2 class="font-display text-xl font-semibold tracking-tight text-heading">Abstract</h2>
                <p class="mt-2">@ScrubAnchors(report.AbstractItem)</p>
            </section>

            <div class="space-y-10 pt-8">


                <section id="@AuBtechReviewAgent.ReportOutline.IntroductionId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">1. Introduction</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">1.1 Rationale (Item 3)</h3>
                    @CitedText("rationaleItem", ScrubAnchors(report.RationaleItem))
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">1.2 Objectives (Item 4)</h3>
                    <p class="text-ink">@ScrubAnchors(report.ObjectivesItem)</p>
                    @if (researchQuestions.Count > 0)
                    {
                        <ol class="space-y-1 pt-1">
                            @for (int i = 0; i < researchQuestions.Count; i++)
                            {
                                <li class="text-ink"><span class="font-bold">RQ@(i + 1).</span> @researchQuestions[i]</li>
                            }
                        </ol>
                    }
                </div>

                </section>

                <section id="@AuBtechReviewAgent.ReportOutline.MethodologyId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">2. Methodology</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">2.1 Eligibility Criteria (Item 5)</h3>
                    <p class="text-ink">@ScrubAnchors(report.EligibilityItem)</p>
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">2.2 Information Sources (Item 6)</h3>
                    <p class="text-ink">@ScrubAnchors(report.SourcesItem)</p>
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">2.3 Search Execution (Item 7)</h3>
                    <p class="text-ink">@ScrubAnchors(report.SearchStrategyItem)</p>
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">2.4 Selection Process (Item 8)</h3>
                    <p class="text-ink">@ScrubAnchors(report.SelectionProcessItem)</p>
                </div>

                @if (flow != null)
                {
                    @FlowFigure(flow)
                }

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">2.5 Data Collection and Quality Appraisal (Items 9-11)</h3>
                    <p class="text-ink">@ScrubAnchors(report.BiasAssessmentItem)</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(report.SynthesisMethodsItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">2.6 Synthesis Methods (Item 13d)</h3>
                        <p class="text-ink">@report.SynthesisMethodsItem</p>
                    </div>
                }

                </section>

                <section id="@AuBtechReviewAgent.ReportOutline.StudiesId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">3. Characteristics of the Included Studies</h2>

                <div class="space-y-2">
                    <p>@DataParagraph()</p>

                    <p>
                        @if (peerReviewOnlyToggle)
                        {
                            <span>The peer-review filter was on for this review: @passedPeerReviewCheck records passed the check and went to screening, while @failedPeerReviewCheck were excluded as un-reviewed preprints or working papers. </span>
                        }
                        else
                        {
                            <span>The peer-review filter was off, so preprints and other un-reviewed records could be included. </span>
                        }
                        <span>In total, @tableRecords.Count papers were included for data extraction.</span>
                    </p>
                </div>

                <div class="space-y-4 pt-2 overflow-visible">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2 border border-line p-3 bg-page print-keep">
                            <span class="text-[13px] font-bold text-ink block border-b border-line pb-1">Figure 3.1: Included Publications per Year</span>
                            <div class="space-y-2 pt-1">
                                @{ int maxYear = Math.Max(1, publicationsByYear.Values.DefaultIfEmpty(0).Max()); }
                                @foreach (var kvp in publicationsByYear)
                                {
                                    <div class="flex items-center text-[13px]">
                                        <span class="w-10 font-mono text-muted font-bold">@kvp.Key</span>
                                        <div class="flex-1 bg-soft h-3.5 mx-2 border border-line overflow-hidden">
                                            <div class="bg-heading h-full transition-all" style="width: @(kvp.Value * 100 / maxYear)%"></div>
                                        </div>
                                        <span class="w-4 font-mono text-right text-ink font-bold">@kvp.Value</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="space-y-2 border border-line p-3 bg-page print-keep">
                            <span class="text-[13px] font-bold text-ink block border-b border-line pb-1">Figure 3.2: Included Papers by Source</span>
                            <div class="space-y-2 pt-1">
                                @{ int maxPlatform = Math.Max(1, platformShares.Select(p => p.Count).DefaultIfEmpty(0).Max()); }
                                @foreach (var share in platformShares)
                                {
                                    <div class="flex items-center text-[13px] mb-1">
                                        <span class="w-24 truncate text-muted font-medium" title="@share.Label">@share.Label</span>
                                        <div class="flex-1 bg-soft h-3.5 mx-2 border border-line overflow-hidden">
                                            <div class="@share.Color h-full" style="width: @(share.Count * 100 / maxPlatform)%"></div>
                                        </div>
                                        <span class="w-4 font-mono text-right text-ink font-bold">@share.Count</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2 border border-line p-3 bg-page print-keep">
                            <span class="text-[13px] font-bold text-ink block border-b border-line pb-1">Figure 3.3: Distribution by Publishing Venue Type</span>
                            @{
                                int totalVenues = journalCount + conferenceCount + transactionsCount + proceedingsCount + preprintCount;
                                double jP = totalVenues > 0 ? ((double)journalCount / totalVenues) * 360 : 0;
                                double cP = totalVenues > 0 ? ((double)conferenceCount / totalVenues) * 360 : 0;
                                double tP = totalVenues > 0 ? ((double)transactionsCount / totalVenues) * 360 : 0;
                                double pP = totalVenues > 0 ? ((double)proceedingsCount / totalVenues) * 360 : 0;
                                string v1 = Deg(jP), v2 = Deg(jP + cP), v3 = Deg(jP + cP + tP), v4 = Deg(jP + cP + tP + pP);
                            }
                            <div class="flex items-center gap-6 py-2 px-1">
                                <div class="w-16 h-14 rounded-full border border-line-field shadow-sm flex-none"
                                     style="background: conic-gradient(#0284c7 0deg @(v1)deg, #4f46e5 @(v1)deg @(v2)deg, #0d9488 @(v2)deg @(v3)deg, #b45309 @(v3)deg @(v4)deg, #dc2626 @(v4)deg 360deg);">
                                </div>
                                <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-muted font-mono">
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-sky-600 "></div> Journals (@journalCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-indigo-600 "></div> Conferences (@conferenceCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-teal-600 "></div> Transactions (@transactionsCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-amber-700 "></div> Proceedings (@proceedingsCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-red-600 "></div> Preprints (@preprintCount)</div>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2 border border-line p-3 bg-page print-keep">
                            <span class="text-[13px] font-bold text-ink block border-b border-line pb-1">Figure 3.4: Journal Quartile and Venue Tier</span>
                            <div class="flex items-end justify-between h-28 pt-2 border-b border-line-field px-2">
                                @foreach (var label in new[] { "Q1", "Q2", "Q3", "Q4", "Conf", "Preprint" })
                                {
                                    var inTier = tableRecords.Where(r => InTier(r, label)).ToList();
                                    int totalMax = Math.Max(1, tableRecords.Count);
                                    <div class="flex flex-col items-center w-10">
                                        <div class="w-5 bg-soft border border-line-field overflow-hidden flex flex-col justify-end" style="height: @(inTier.Count * 90 / totalMax)px" title="@label: @inTier.Count">
                                            @foreach (var share in platformShares)
                                            {
                                                int n = inTier.Count(r => r.Category == share.Category);
                                                if (n > 0)
                                                {
                                                    <div class="@share.Color" style="height: @(n * 100 / Math.Max(1, inTier.Count))%"></div>
                                                }
                                            }
                                        </div>
                                        <span class="text-xs font-mono font-bold mt-1 text-muted">@label</span>
                                    </div>
                                }
                            </div>
                            <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs font-mono mt-2 text-muted">
                                @foreach (var share in platformShares)
                                {
                                    <div class="flex items-center gap-1"><div class="w-2.5 h-2.5 @share.Color "></div> @share.Label (@share.Count)</div>
                                }
                            </div>
                            <p class="text-xs text-muted">Quartiles from SCImago Journal Rank (SJR), exact title match only.</p>
                        </div>
                    </div>
                </div>

                </section>

                <section id="@AuBtechReviewAgent.ReportOutline.ResultsId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">4. Results & Synthesis</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">4.1 Overview of the Synthesis (Item 20a)</h3>
                    @if (auditChecks.Count > 0)
                    {
                        <p class="text-sm text-muted print:hidden">Open a citation number to see what the automated check found in the cited paper.</p>
                    }
                    @CitedText("synthesisResultsItem", ScrubAnchors(report.SynthesisResultsItem))

                    @for (int k = 0; k < report.SynthesisSections.Count; k++)
                    {
                        var part = report.SynthesisSections[k];
                        <h3 id="@AuBtechReviewAgent.ReportOutline.ThemeId(k)" data-report-section class="scroll-mt-20 pt-4 font-display text-base font-semibold text-heading">4.@(k + 2) @part.Heading</h3>
                        @CitedText(part.Field, part.Text)
                    }

                    @if (codebook is { Themes.Count: > 0 })
                    {
                        <div class="mt-4">
                            <h3 class="mb-2 font-display text-base font-semibold text-heading">Evidence map: studies by theme</h3>
                            <div class="overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                                <table class="w-full border border-line text-sm">
                                    <thead class="bg-soft text-muted">
                                        <tr>
                                            <th class="border-b border-line p-2 text-left">Theme</th>
                                            <th class="border-b border-line p-2 text-left">Studies</th>
                                            <th class="border-b border-line p-2 text-left">Cited in its subsection</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var theme in codebook.Themes)
                                        {
                                            var cov = codebook.Coverage.FirstOrDefault(c => c.ThemeId == theme.Id);
                                            <tr class="border-b border-line align-top">
                                                <td class="p-2"><span class="font-semibold">@theme.Name</span><br /><span class="text-muted">@theme.Description</span></td>
                                                <td class="p-2 font-mono">@string.Join(", ", theme.Studies.Select(r => $"[{r}]"))</td>
                                                <td class="p-2">@(cov == null ? "-" : $"{cov.CitedFinal.Count} of {cov.Studies.Count}")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (codebook.SecondCoding?.Kappa is double kappa)
                            {
                                <p class="text-xs text-muted mt-1">Second, independent coding: Cohen's kappa = @kappa.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) over @codebook.SecondCoding.CellsCompared study-theme decisions.</p>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(report.CoverageSummary))
                    {
                        <p class="border-l-2 border-heading pl-3 text-[15px] italic text-muted">@report.CoverageSummary</p>
                    }

                    @if (report.Artifact is { } art)
                    {
                        <div class="mt-5 border border-line p-3 space-y-2">
                            <span class="text-xs font-bold text-muted uppercase block">Artifact: @(string.IsNullOrWhiteSpace(art.Title) ? AuBtechReviewAgent.ArtifactKinds.All.FirstOrDefault(k => k.Key == art.Requested).Label : art.Title)</span>
                            @if (art.Error != null)
                            {
                                <p class="text-[13px] text-muted italic">@art.Error</p>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(art.Caption))
                                {
                                    <p class="text-[13px] text-muted">@art.Caption</p>
                                }
                                @if (art.IsDiagram && !string.IsNullOrEmpty(mermaidDiagramCode))
                                {
                                    @* Filled by wwwroot/js/mermaid-render.js; Blazor leaves the empty element alone. *@
                                    <div id="mermaid-preview" class="w-full flex flex-col items-center justify-center text-center bg-soft p-3 overflow-x-auto print:overflow-visible"></div>
                                    @if (art.Nodes.Any(n => AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(n.Label).Count > 0))
                                    {
                                        <span class="text-xs font-bold text-muted uppercase block pt-1">Cited boxes in the diagram</span>
                                        @for (int k = 0; k < art.Nodes.Count; k++)
                                        {
                                            if (AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(art.Nodes[k].Label).Count == 0) continue;
                                            @CitedText($"artifact-n{k + 1}", art.Nodes[k].Label)
                                        }
                                    }
                                }
                                else if (art.Kind == AuBtechReviewAgent.ArtifactKinds.Table)
                                {
                                    <div class="overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                                        <table class="w-full text-[13px] border border-line align-top">
                                            <thead class="bg-soft text-muted text-left">
                                                <tr>@foreach (var col in art.Columns) { <th class="p-1.5 border-b border-line">@col</th> }</tr>
                                            </thead>
                                            <tbody>
                                                @for (int r = 0; r < art.Rows.Count; r++)
                                                {
                                                    int row = r;
                                                    <tr class="border-t border-line align-top">
                                                        @for (int c = 0; c < art.Rows[row].Count; c++)
                                                        {
                                                            <td class="p-2">@CitedText($"artifact-r{row + 1}c{c + 1}", art.Rows[row][c])</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <ul class="list-disc pl-5 space-y-1">
                                        @for (int b = 0; b < art.Bullets.Count; b++)
                                        {
                                            <li>@CitedText($"artifact-b{b + 1}", art.Bullets[b])</li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(mermaidDiagramCode))
                    {
                        <div class="mt-4 border border-line p-4 bg-soft flex flex-col items-center justify-center print:hidden">
                            <span class="text-xs font-bold text-muted block mb-3 uppercase tracking-widest">Diagram</span>
                            @* Older runs: the diagram the report draft wrote. *@
                            <div id="mermaid-preview" class="w-full flex flex-col items-center justify-center text-center"></div>
                        </div>
                    }
                </div>

                </section>

                <section id="@AuBtechReviewAgent.ReportOutline.DiscussionId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">5. Discussion</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">5.1 General Interpretation (Item 23a)</h3>
                    @CitedText("discussionItem", report.DiscussionItem)
                    @if (!string.IsNullOrWhiteSpace(report.CitationCheckSummary))
                    {
                        <p class="border-l-2 border-heading pl-3 text-[15px] italic text-muted">@report.CitationCheckSummary</p>
                    }
                </div>

                @* PRISMA 2020 items 23b to 23d, which published reviews give their own headings. Runs made before they were
                   written have none of them; 23c is written in code from the run's facts. *@
                @{ int discussionPart = 1; }
                @if (!string.IsNullOrWhiteSpace(report.EvidenceLimitationsItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(++discussionPart) Limitations of the Evidence (Item 23b)</h3>
                        @CitedText("evidenceLimitationsItem", report.EvidenceLimitationsItem)
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(report.ReviewLimitationsItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(++discussionPart) Limitations of the Review Process (Item 23c)</h3>
                        <p class="text-ink">@report.ReviewLimitationsItem</p>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(report.ImplicationsItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(++discussionPart) Implications for Practice and Policy (Item 23d)</h3>
                        @CitedText("implicationsItem", report.ImplicationsItem)
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(report.FutureResearchItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(++discussionPart) Directions for Future Research (Item 23d)</h3>
                        @CitedText("futureResearchItem", report.FutureResearchItem)
                    </div>
                }

                </section>

                @{ int declarationsNumber = AuBtechReviewAgent.ReportOutline.DeclarationsNumber(report); }
                @if (AuBtechReviewAgent.ReportOutline.HasConclusion(report))
                {
                    <section id="@AuBtechReviewAgent.ReportOutline.ConclusionId" data-report-section class="scroll-mt-20 space-y-5">
                        <h2 class="font-display text-xl font-semibold tracking-tight text-heading">6. Conclusion</h2>
                        @foreach (var answer in report.ResearchAnswers ?? new List<ResearchAnswer>())
                        {
                            <div class="space-y-2">
                                <h3 class="font-display text-base font-semibold text-heading">RQ@(answer.Number). @answer.Question</h3>
                                @CitedText($"researchAnswer{answer.Number}", answer.Answer)
                            </div>
                        }
                        <div class="space-y-2">
                            @CitedText("conclusionItem", report.ConclusionItem)
                        </div>
                    </section>
                }

                <section id="@AuBtechReviewAgent.ReportOutline.DeclarationsId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">@(declarationsNumber). Declarations</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).1 Registration and Protocol (Item 24)</h3>
                    <p class="text-ink">
                        @(string.IsNullOrWhiteSpace(report.ProtocolItem) ? AuBtechReviewAgent.PrismaReviewEngine.NoProtocolText : report.ProtocolItem)
                        @if (hasProtocol)
                        {
                            <a class="text-heading underline ml-1" href="@($"/api/workspace/{State.CurrentSessionId}/protocol.md")" target="_blank">Open protocol.md</a>
                        }
                    </p>
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).2 Support & Funding (Item 25)</h3>
                    <p class="text-ink">@ScrubAnchors(report.SupportItem)</p>
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).3 Availability of Data and Code (Item 27)</h3>
                    <p class="text-ink">@ScrubAnchors(report.AvailabilityItem)</p>
                </div>

                @if (aiStatement.Length > 0)
                {
                    @* Ready to copy into a paper or thesis; built only from what the run recorded (AiUseStatement). *@
                    <div class="space-y-2" id="ai-use">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).4 Use of Artificial Intelligence</h3>
                            <span class="flex flex-wrap gap-2 print:hidden">
                                <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px]" @onclick='() => CopyStatement(aiStatement, "Methods statement")'>Copy for the methods</button>
                                <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px]" @onclick='() => CopyStatement(aiShort, "Short declaration")'>Copy a short declaration</button>
                            </span>
                        </div>
                        <p class="text-ink">@aiStatement</p>
                        <p class="text-xs text-muted print:hidden" role="status">@(copyNotice ?? "Edit it to fit your venue's policy on AI use before you submit.")</p>
                    </div>
                }
                </section>

            </div>

            <section id="@AuBtechReviewAgent.ReportOutline.ReferencesId" data-report-section class="mt-10 scroll-mt-20 border-t border-line pt-8">
                <h2 class="mb-4 font-display text-xl font-semibold tracking-tight text-heading">References</h2>
                @if (includedCitations.Count == 0)
                {
                    <p class="italic text-muted">No sources were included in this run.</p>
                }
                else
                {
                    <ol class="space-y-2 text-[15px] text-ink">
                        @for (int i = 0; i < includedCitations.Count; i++)
                        {
                            int number = i + 1;
                            string citation = includedCitations[i];
                            <li class="pl-2 leading-relaxed">
                                <span class="font-mono font-bold text-heading mr-1">[@number]</span> - <ApaReference Text="@citation" />
                            </li>
                        }
                    </ol>
                }
            </section>

            @* The tables of the included studies come after the references, as Tables A.1 to A.3 (issue #139). *@
            <section id="@AuBtechReviewAgent.ReportOutline.AppendixId" data-report-section class="mt-10 scroll-mt-20 space-y-6 border-t border-line pt-8">
                <h2 class="font-display text-xl font-semibold tracking-tight text-heading">Appendix</h2>

                <div class="space-y-2 pt-4 max-w-full overflow-hidden">
                    <h3 class="font-display text-base font-semibold text-heading">Table A.1: Included Studies</h3>
                    <div class="border border-line bg-page overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                        <table class="w-full text-left border-collapse text-xs leading-relaxed table-fixed min-w-[700px] print:min-w-0">
                            <thead>
                                <tr class="bg-soft border-b border-line text-ink font-bold font-mono text-xs uppercase sticky top-0 z-10">
                                    <th class="p-2 border-r border-line w-[5%]">Ref.</th>
                                    <th class="p-2 border-r border-line w-[17%]">Paper Name</th>
                                    <th class="p-2 border-r border-line w-[22%]">Executive Summary</th>
                                    <th class="p-2 border-r border-line w-[20%]">Inclusion Rationale</th>
                                    <th class="p-2 border-r border-line w-[12%] text-center">Source</th>
                                    <th class="p-2 w-[24%]">Citation (APA 7th)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-line text-ink">
                                @foreach (var paperRow in tableRecords)
                                {
                                    string badgeClass = platformShares.FirstOrDefault(p => p.Category == paperRow.Category)?.Badge ?? "text-ink bg-soft";
                                    <tr class="hover:bg-soft" id="@($"ref-{paperRow.ReferenceNumber}")">
                                        <td class="p-2 font-mono text-heading font-bold border-r border-line align-top">[@paperRow.ReferenceNumber]</td>
                                        <td class="p-2 border-r border-line align-top break-words">
                                            <span class="font-semibold text-ink">@paperRow.Title</span>
                                            @StudyLinks(paperRow)
                                            @StudyNote(paperRow.ReferenceNumber)
                                        </td>
                                        <td class="p-2 text-muted border-r border-line align-top font-light break-words">@paperRow.Summary</td>
                                        <td class="p-2 text-muted border-r border-line align-top font-light text-xs break-words">@paperRow.InclusionRationale</td>
                                        <td class="p-2 border-r border-line align-top text-center font-mono font-medium text-xs">
                                            <span class="px-1.5 py-0.5 @badgeClass">@AuBtechReviewAgent.PrismaReviewEngine.CategoryLabel(paperRow.Category)</span>
                                        </td>
                                        <td class="p-2 font-mono text-xs text-muted bg-soft align-top leading-normal break-all"><ApaReference Text="@paperRow.ApaCitation" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (extractions.Count > 0)
                {
                    <div class="space-y-2 pt-2 max-w-full overflow-hidden">
                        <h3 class="font-display text-base font-semibold text-heading">Table A.2: Extracted Study Data</h3>
                        <div class="border border-line bg-page overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                            <table class="w-full text-left border-collapse text-xs leading-relaxed table-fixed min-w-[700px] print:min-w-0">
                                <thead>
                                    <tr class="bg-soft border-b border-line text-ink font-bold font-mono text-xs uppercase">
                                        <th class="p-2 border-r border-line w-[5%]">Ref.</th>
                                        <th class="p-2 border-r border-line w-[15%]">Study type</th>
                                        <th class="p-2 border-r border-line w-[20%]">Method</th>
                                        <th class="p-2 border-r border-line w-[15%]">Sample</th>
                                        <th class="p-2 w-[45%]">Key findings</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-line text-ink">
                                    @foreach (var e in extractions)
                                    {
                                        <tr>
                                            <td class="p-2 font-mono text-heading font-bold border-r border-line align-top">[@e.ReferenceNumber]</td>
                                            @if (e.Error != null)
                                            {
                                                <td colspan="4" class="p-2 text-not-supported">Extraction failed for this study.</td>
                                            }
                                            else
                                            {
                                                <td class="p-2 border-r border-line align-top">@e.StudyType<span class="block text-xs text-muted">@e.EvidenceBasis</span></td>
                                                <td class="p-2 border-r border-line align-top">@Evidence(e.Method)</td>
                                                <td class="p-2 border-r border-line align-top">@Evidence(e.Sample)</td>
                                                <td class="p-2 align-top space-y-1">
                                                    @foreach (var f in e.KeyFindings)
                                                    {
                                                        <div>@Evidence(f)</div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="text-xs text-muted">Hover over a value to see the quote it was taken from. <span class="text-partly">†</span> The quote could not be found in the paper's text, so treat the value with caution.</p>
                    </div>

                    <div class="space-y-2 pt-2 max-w-full overflow-hidden">
                        <h3 class="font-display text-base font-semibold text-heading">Table A.3: Quality Appraisal and <Term Key="risk-of-bias">Risk of Bias</Term> (MMAT 2018)</h3>
                        @if (extractions.Any(AuBtechReviewAgent.MethodsSectionWriter.ShowInAppraisalTable))
                        {
                            <div class="border border-line bg-page overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                                <table class="w-full text-left border-collapse text-xs min-w-[560px] print:min-w-0">
                                    <thead>
                                        <tr class="bg-soft border-b border-line text-ink font-bold font-mono text-xs uppercase">
                                            <th class="p-2 border-r border-line">Ref.</th>
                                            <th class="p-2 border-r border-line">Category</th>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <th class="p-2 border-r border-line text-center">@i</th>
                                            }
                                            <th class="p-2 text-center" title="How many of the five questions were answered yes. MMAT does not combine them into one score.">Met</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line text-ink">
                                        @foreach (var e in extractions.Where(AuBtechReviewAgent.MethodsSectionWriter.ShowInAppraisalTable))
                                        {
                                            <tr>
                                                <td class="p-2 font-mono text-heading font-bold border-r border-line">[@e.ReferenceNumber]</td>
                                                <td class="p-2 border-r border-line">@AppraisalCategory(e)</td>
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    var a = i < e.Appraisal.Count ? e.Appraisal[i] : null;
                                                    var light = AuBtechReviewAgent.RiskOfBias.For(a?.Answer);
                                                    <td class="p-2 border-r border-line text-center whitespace-nowrap @light.Text"
                                                        title="@(a == null ? "" : $"{a.Id} {a.Criterion}{(string.IsNullOrEmpty(a.Quote) ? "" : $" — \"{a.Quote}\"")}")">
                                                        <span class="inline-block w-2 h-2 rounded-full align-middle mr-1 @light.Dot" aria-hidden="true"></span><span class="align-middle">@light.Word</span>
                                                    </td>
                                                }
                                                <td class="p-2 text-center font-mono whitespace-nowrap">@(e.Appraisal.Count == 0 ? "–" : $"{e.AppraisalYes} of {e.Appraisal.Count}")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="text-xs text-muted">Hover over an answer to see the question and the supporting quote. "Met" counts the questions answered yes; following MMAT's guidance it is not an overall quality score. Appraised by the language model; check before use.</p>
                            @foreach (var category in AuBtechReviewAgent.RiskOfBias.Summarise(extractions))
                            {
                                <figure class="mt-3 border border-line bg-page p-3">
                                    <figcaption class="text-xs font-semibold text-ink">@category.Category.Replace('_', ' ') studies (@category.Studies): answers per question</figcaption>
                                    <div class="mt-2 space-y-1.5">
                                        @foreach (var q in category.Questions)
                                        {
                                            <div class="grid grid-cols-[minmax(0,1fr)_8rem] sm:grid-cols-[minmax(0,1fr)_12rem] gap-2 items-center text-xs">
                                                <span class="text-ink leading-snug"><span class="font-mono text-muted">@q.Id</span> @q.Criterion</span>
                                                <span class="flex h-3 w-full overflow-hidden bg-soft" role="img" aria-label="@($"{q.Yes} yes, {q.No} no, {q.CantTell} can't tell")"
                                                      title="@($"{q.Yes} yes · {q.No} no · {q.CantTell} can't tell")">
                                                    @foreach (var (count, dot) in new[] { (q.Yes, "bg-verdict-ok"), (q.CantTell, "bg-verdict-partial"), (q.No, "bg-verdict-bad") })
                                                    {
                                                        @if (count > 0)
                                                        {
                                                            <span class="h-full @dot" style="width:@((100.0 * count / q.Total).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                                        }
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                    <p class="mt-2 text-xs text-muted"><span class="inline-block w-2 h-2 rounded-full bg-verdict-ok align-middle"></span> yes · <span class="inline-block w-2 h-2 rounded-full bg-verdict-partial align-middle"></span> can't tell · <span class="inline-block w-2 h-2 rounded-full bg-verdict-bad align-middle"></span> no</p>
                                </figure>
                            }
                        }
                        @if (AuBtechReviewAgent.MethodsSectionWriter.NotAppraisedNote(extractions) is { Length: > 0 } notAppraised)
                        {
                            <p class="text-xs text-muted">@notAppraised</p>
                        }
                    </div>
                }
            </section>

            <div class="mt-12 border-t border-line pt-4 text-center text-xs uppercase tracking-[0.14em] text-muted">
                OSSYM 2026 - 8th International Open Search Symposium
            </div>
            @* Only on paper: where the printed report came from, so a printout can be traced back to its run. *@
            <p class="hidden print:block mt-2 text-center text-xs text-muted">
                Generated with TraceableAI · run @State.CurrentSessionId · @(report.GeneratedAt) · protocol @(string.IsNullOrWhiteSpace(report.ProtocolHash) ? "not recorded" : report.ProtocolHash)
            </p>

        </article>
            </div>

            <div class="hidden min-[1500px]:block print:hidden">
                <CitationCheckPanel Checks="auditChecks" Filter="@checkFilter" OnFilter="SetCheckFilter" Position="checkIndex" OnNext="StepCheck"
                                    RunId="State.CurrentSessionId" HasProtocol="hasProtocol" />
            </div>
        </div>
    </div>
}

@code {
    [Inject] private UiStateContainer State { get; set; } = default!;

    /// <summary>Set when the page is opened as /spec-matrix/{RunId}, so a report can be reopened from a link.</summary>
    [Parameter] public Guid? RunId { get; set; }

    private PrismaReport report = new PrismaReport();
    private List<string> includedCitations = new();
    private Dictionary<string, int> publicationsByYear = new();
    private readonly List<IncludedPaperMetricRow> tableRecords = new();
    private readonly List<AuBtechReviewAgent.StudyExtraction> extractions = new();
    private readonly List<AuBtechReviewAgent.CitationSupportResult> auditChecks = new();
    private AuBtechReviewAgent.ThematicCodebook? codebook;
    private int journalCount, conferenceCount, transactionsCount, proceedingsCount, preprintCount;

    private sealed record PlatformShare(string Category, string Label, int Count, string Color, string Badge);
    private List<PlatformShare> platformShares = new();

    // Literal class names so the Tailwind build finds them.
    private static readonly string[] BarColors = { "bg-teal-500", "bg-orange-500", "bg-blue-400", "bg-yellow-400", "bg-purple-400", "bg-rose-400", "bg-lime-500", "bg-unverifiable-chart" };
    private static readonly string[] BadgeColors = { "text-teal-800 bg-teal-50", "text-orange-800 bg-orange-50", "text-blue-800 bg-blue-50", "text-yellow-800 bg-yellow-50", "text-purple-800 bg-purple-50", "text-rose-800 bg-rose-50", "text-lime-800 bg-lime-50", "text-ink bg-soft" };

    private bool peerReviewOnlyToggle;
    private int passedPeerReviewCheck;
    private int failedPeerReviewCheck;
    private bool hasProtocol;
    private bool confirmDelete;
    private bool deleted;

    private string mermaidDiagramCode = "";

    // The citation marker the reader clicked: (field, sentence index, reference number).
    private (string Field, int Sentence, int Reference)? openCitation;

    // The run's figures and its PRISMA flow, for the run line and Figure 2.1; null for a run without a ledger.
    private AuBtechReviewAgent.ReviewStats? stats;
    private AuBtechReviewAgent.PrismaFlowCounts? flow;
    private string runLine = "";
    private string dateLine = "";

    /// <summary>The sections of this report, for the contents list (the page gives each the same id).</summary>
    private List<AuBtechReviewAgent.OutlineEntry> Outline => AuBtechReviewAgent.ReportOutline.Systematic(report);

    private bool HasReport => !deleted && report != null && !string.IsNullOrEmpty(report.TitleItem) && report.TitleItem != "Pending...";

    private void DeleteRun()
    {
        confirmDelete = false;
        if (Runs.DeleteRun(State.CurrentSessionId, editKey))
        {
            deleted = true;
            State.CurrentSessionId = Guid.Empty;
            report = new PrismaReport();
        }
    }

    private static string ScrubAnchors(string rawText)
    {
        if (string.IsNullOrWhiteSpace(rawText)) return "";
        string clean = Regex.Replace(rawText, @"\[MERMAID_START\].*?\[MERMAID_END\]", "", RegexOptions.Singleline);
        clean = Regex.Replace(clean, @"\[TIKZ_START\].*?\[TIKZ_END\]", "", RegexOptions.Singleline);
        clean = Regex.Replace(clean, @"\[Source Context Anchor \d+.*?\]", "").Trim();
        return AuBtechReviewAgent.MethodsSectionWriter.StripMarkdownEmphasis(clean);
    }

    private static string Deg(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>One line under the title: studies and records, themes, citations checked and the app version.</summary>
    private static string RunLine(AuBtechReviewAgent.ReviewState state)
    {
        var s = state.Stats;
        var parts = new List<string> { $"{s.Included} {(s.Included == 1 ? "study" : "studies")} from {s.TotalIdentified} {(s.TotalIdentified == 1 ? "record" : "records")}" };
        if (s.ThemesIdentified > 0) parts.Add($"{s.ThemesIdentified} {(s.ThemesIdentified == 1 ? "theme" : "themes")}");
        if (s.CitationsChecked > 0) parts.Add($"{s.CitationsChecked} {(s.CitationsChecked == 1 ? "citation" : "citations")} checked");
        string? version = state.RunSettings?.AppVersion;
        if (!string.IsNullOrWhiteSpace(version)) parts.Add("TraceableAI " + AuBtechReviewAgent.ToolVersion.Display(version));
        return string.Join(" · ", parts);
    }

    private static bool InTier(IncludedPaperMetricRow r, string label) => label switch
    {
        "Conf" => r.VenueType is "Conferences" or "Proceedings",
        "Preprint" => r.VenueType is "Preprints" or "Other",
        _ => (r.Quartile ?? "").Equals(label, StringComparison.OrdinalIgnoreCase),
    };

    private static string AppraisalCategory(AuBtechReviewAgent.StudyExtraction e) =>
        e.Error != null ? "not appraised" :
        e.AppraisalCategory == "not_empirical" ? "not empirical (MMAT does not apply)" :
        e.AppraisalCategory.Replace('_', ' ');

    /// <summary>A one-paragraph description of the included set, built only from the run's own data.</summary>
    // Section 3 points to the tables in the appendix (issue #139), with the same sentence as main.tex.
    private string DataParagraph() => (AuBtechReviewAgent.MethodsSectionWriter.IncludedSet(tableRecords) + " " +
        AuBtechReviewAgent.MethodsSectionWriter.AppendixPointer(tableRecords.Count, extractions)).Trim();

    /// <summary>
    /// Figure 2.1: the PRISMA 2020 flow of records, from the run's own counts (PrismaFlowCounts, the same numbers as
    /// the diagram in main.tex). Every identified record ends in exactly one box. The screening kappa sits under it.
    /// </summary>
    private RenderFragment FlowFigure(AuBtechReviewAgent.PrismaFlowCounts c) => __builder =>
    {
        int removed = c.DuplicatesRemoved + c.OutsideDateRange + c.CappedBeyondMax + c.ScreeningErrors;
        int excluded = c.ExcludedPeerReview + c.ExcludedAtScreening;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var bySource = c.IdentifiedBySource.Select(x => $"{x.Source} {x.Count}").ToList();
        if (c.IdentifiedViaCitations > 0) bySource.Add($"citation chaining {c.IdentifiedViaCitations}");
        string identifiedDetail = string.Join(" · ", bySource);
        var removals = new List<string>();
        if (c.DuplicatesRemoved > 0) removals.Add($"duplicates {c.DuplicatesRemoved}");
        if (c.OutsideDateRange > 0) removals.Add($"outside the years {c.OutsideDateRange}");
        if (c.CappedBeyondMax > 0) removals.Add($"over the cap per source {c.CappedBeyondMax}");
        if (c.ScreeningErrors > 0) removals.Add($"could not be screened {c.ScreeningErrors}");
        string removedDetail = string.Join(" · ", removals);
        var reasons = c.ExcludedByReason.Select(x => $"{x.Reason} {x.Count}").ToList();
        if (c.ExcludedPeerReview > 0) reasons.Add($"not peer reviewed {c.ExcludedPeerReview}");
        string excludedDetail = string.Join(" · ", reasons);
        string screenedLabel = stats is { DualScreened: > 0 } ? "Screened twice, independently" : "Screened";
        <figure class="print-keep rounded-card border border-line bg-soft p-4 sm:p-5" aria-labelledby="flow-caption">
            <figcaption id="flow-caption" class="text-[15px] font-semibold text-ink">Figure 2.1: Flow of records through the review (PRISMA 2020)</figcaption>
            <ol class="mt-3 space-y-2 text-[15px] leading-snug">
                @(FlowRow("Identified", c.Identified, identifiedDetail, "Removed before screening", removed, removedDetail))
                @(FlowRow(screenedLabel, c.Screened, "Title and abstract", "Excluded", excluded, excludedDetail))
                @(FlowRow("Included", c.Included, $"full text read {c.FullTextRetrieved} · abstract only {c.AbstractOnly}", null, 0, ""))
            </ol>
            @if (stats is { DualScreened: > 0 } st)
            {
                <p class="mt-3 text-sm text-muted">
                    The two screenings agreed on @(st.DualScreened - st.ScreeningDisagreements) of @st.DualScreened records@(st.ScreeningKappa is double k ? $" (Cohen's kappa = {k.ToString("0.00", inv)})" : "").
                    Disagreements were included and flagged.
                    @AuBtechReviewAgent.MethodsSectionWriter.KappaNote(st.DualScreened - st.ScreeningDisagreements, st.DualScreened, st.ScreeningKappa)
                </p>
            }
            @if (!c.IsConsistent)
            {
                <p class="mt-2 text-sm text-partly">These counts do not add up for this run (it may predate the current counting); see transparent-process.json.</p>
            }
        </figure>
    };

    private static RenderFragment FlowRow(string label, int count, string detail, string? sideLabel, int sideCount, string sideDetail) => __builder =>
    {
        <li class="grid grid-cols-1 gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div class="border border-line-field bg-page p-3">
                <span class="flex items-baseline justify-between gap-2"><span class="font-semibold text-ink">@label</span><span class="font-mono font-semibold text-heading">@count</span></span>
                @if (detail.Length > 0)
                {
                    <span class="mt-0.5 block text-sm text-muted">@detail</span>
                }
            </div>
            @if (sideLabel != null)
            {
                <div class="border border-dashed border-line-field p-3">
                    <span class="flex items-baseline justify-between gap-2"><span class="text-ink">@sideLabel</span><span class="font-mono text-muted">@sideCount</span></span>
                    @if (sideDetail.Length > 0)
                    {
                        <span class="mt-0.5 block text-sm text-muted">@sideDetail</span>
                    }
                </div>
            }
        </li>
    };

    /// <summary>The value with its quote as a tooltip; a dagger when the quote was not found in the paper.</summary>
    private RenderFragment Evidence(AuBtechReviewAgent.EvidencedValue v) => __builder =>
    {
        bool notReported = v.Value.Equals("not reported", StringComparison.OrdinalIgnoreCase);
        <span class="@(notReported ? "text-muted italic" : "")" title="@(string.IsNullOrEmpty(v.Quote) ? "" : $"\"{v.Quote}\"")">@v.Value</span>
        @if (!notReported && !v.QuoteVerified)
        {
            <span class="text-partly" title="The supporting quote was not found in the paper's text">†</span>
        }
    };

    /// <summary>
    /// Renders text with every [n] as a button, with the shared paper component (Components/Paper/CitedProse.razor);
    /// this page adds its reviewer notes and the re-check to an open citation's panel.
    /// </summary>
    private RenderFragment CitedText(string field, string text) => __builder =>
    {
        <CitedProse Field="@field" Text="@text" Checks="auditChecks" Open="openCitation"
                    OnToggle="@(c => ToggleCitation(c.Field, c.Sentence, c.Reference))" OnClose="CloseCitation"
                    SourceTitle="@(reference => tableRecords.FirstOrDefault(t => t.ReferenceNumber == reference)?.Title)"
                    SourceLink="SourceLink"
                    PanelExtras="CitationExtras" />
    };

    /// <summary>What this page adds to an open citation's panel: the reviewer's note, a past re-check and the "Check again" button.</summary>
    private RenderFragment<AuBtechReviewAgent.CitationSupportResult> CitationExtras => check => __builder =>
    {
        if (openCitation is not { } open) return;
        @CitationNote(open)
        @if (RecheckOf(open) is { } done)
        {
            <p class="text-xs text-muted">Checked again @done.CheckedUtc.ToString("yyyy-MM-dd HH:mm") UTC: was @VerdictLabel(done.VerdictBefore) (@done.EvidenceBefore), now @VerdictLabel(done.VerdictAfter) (@done.EvidenceAfter).</p>
        }
        @if (canEdit && check.Verdict is AuBtechReviewAgent.CitationSupportChecker.Partial or AuBtechReviewAgent.CitationSupportChecker.NotSupported)
        {
            <div class="pt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                <button type="button" class="ui-btn ui-btn-sm py-0.5 border border-line-field bg-page text-ink hover:border-heading disabled:opacity-50"
                        disabled="@(rechecking || rechecksLeft <= 0)" @onclick="() => RecheckAsync(open)">
                    @(rechecking ? "Checking again…" : "Check again")
                </button>
                <span class="text-xs text-muted">
                    @(rechecksLeft > 0
                        ? $"Runs the check once more{(check.EvidenceBasis == "abstract only" ? ", with the full text if an open-access copy can be found now" : " on the full text")}. {rechecksLeft} re-check{(rechecksLeft == 1 ? "" : "s")} left for this run."
                        : "This run has used its re-checks.")
                </span>
            </div>
        }
        @if (recheckMessage != null)
        {
            <p class="text-xs @(recheckFailed ? "text-not-supported" : "text-ink")" role="status">@recheckMessage</p>
        }
    };

    // ── Links and reviewer notes ─────────────────────────────────────────────────────────────────
    private Dictionary<string, string> fullTextUrls = new();
    private List<AuBtechReviewAgent.ReviewerNote> notes = new();
    private string? editingNote;     // which note is open for editing: "study-3" or "citation-field-2-3"
    private string noteDraft = "";
    private string? noteMessage;

    private static string? DoiUrl(string? doi) =>
        string.IsNullOrWhiteSpace(doi) ? null : "https://doi.org/" + Uri.EscapeDataString(doi.Trim()).Replace("%2F", "/");

    /// <summary>DOI and open-access PDF links under a study's title (only http(s) addresses are linked).</summary>
    private RenderFragment StudyLinks(IncludedPaperMetricRow row) => __builder =>
    {
        string? doi = DoiUrl(row.Doi);
        string? sourcePage = doi == null && AuBtechReviewAgent.PrismaReviewEngine.IsWebAddress(row.Url) ? row.Url : null;
        string? pdf = fullTextUrls.TryGetValue(row.PaperId, out var u) ? u : null;
        if (doi == null && sourcePage == null && pdf == null) return;
        <span class="mt-1 flex flex-wrap gap-x-2 text-xs print:hidden">
            @if (doi != null)
            {
                <a href="@doi" target="_blank" rel="noopener" class="text-heading underline underline-offset-2">DOI</a>
            }
            @if (sourcePage != null)
            {
                <a href="@sourcePage" target="_blank" rel="noopener" class="text-heading underline underline-offset-2">Source page</a>
            }
            @if (pdf != null)
            {
                <a href="@pdf" target="_blank" rel="noopener" class="text-heading underline underline-offset-2">Open-access PDF</a>
            }
        </span>
    };

    private RenderFragment StudyNote(int reference) => __builder =>
    {
        var note = notes.FirstOrDefault(n => n.IsFor(AuBtechReviewAgent.ReviewerNote.Study, reference));
        @NoteBlock($"study-{reference}", note, AuBtechReviewAgent.ReviewerNote.Study, reference, "", -1)
    };

    private RenderFragment CitationNote((string Field, int Sentence, int Reference) c) => __builder =>
    {
        var note = notes.FirstOrDefault(n => n.IsFor(AuBtechReviewAgent.ReviewerNote.Citation, c.Reference, c.Field, c.Sentence));
        @NoteBlock($"citation-{c.Field}-{c.Sentence}-{c.Reference}", note, AuBtechReviewAgent.ReviewerNote.Citation, c.Reference, c.Field, c.Sentence)
    };

    /// <summary>A note as text for every reader; with the edit key, an Add/Edit button and a small form.</summary>
    private RenderFragment NoteBlock(string id, AuBtechReviewAgent.ReviewerNote? note, string kind, int reference, string field, int sentence) => __builder =>
    {
        if (editingNote == id)
        {
            <div class="mt-1.5">
                <label for="@($"note-{id}")" class="block text-xs font-semibold text-ink">Your note</label>
                <textarea id="@($"note-{id}")" rows="2" maxlength="@AuBtechReviewAgent.RunStore.MaxNoteLength" @bind="noteDraft"
                          class="mt-0.5 w-full border border-line-field p-1.5 text-[13px] font-normal text-ink focus:border-heading focus:outline-none"></textarea>
                <div class="mt-1 flex gap-2">
                    <button type="button" class="ui-btn-primary ui-btn-sm py-0.5" @onclick="() => SaveNoteAsync(kind, reference, field, sentence)">Save note</button>
                    <button type="button" class="ui-btn-secondary ui-btn-sm py-0.5" @onclick="() => editingNote = null">Cancel</button>
                </div>
                @if (noteMessage != null)
                {
                    <p class="mt-1 text-xs text-not-supported" role="alert">@noteMessage</p>
                }
            </div>
        }
        else
        {
            if (note != null)
            {
                <p class="mt-1.5 border-l-2 border-heading pl-2 text-xs font-normal text-ink whitespace-pre-line">
                    <span class="font-semibold text-ink">Reviewer's note:</span> @note.Text
                </p>
            }
            if (canEdit)
            {
                <button type="button" class="mt-1 text-xs font-medium text-heading hover:underline print:hidden"
                        @onclick="() => { editingNote = id; noteDraft = note?.Text ?? string.Empty; noteMessage = null; }">@(note == null ? "Add a note" : "Edit note")</button>
            }
        }
    };

    private async Task SaveNoteAsync(string kind, int reference, string field, int sentence)
    {
        bool saved = await Runs.SaveNoteAsync(State.CurrentSessionId, editKey, kind, reference, noteDraft, field, sentence);
        if (saved)
        {
            notes = Runs.LoadNotes(State.CurrentSessionId).ToList();
            editingNote = null;
            noteMessage = null;
        }
        else
        {
            noteMessage = "The note could not be saved. Only the browser that started this run can add notes.";
        }
    }

    // Re-checking one citation after the run (PrismaReviewEngine.RecheckCitationAsync).
    private List<AuBtechReviewAgent.CitationRecheck> rechecks = new();
    private int rechecksLeft;
    private bool rechecking;
    private string? recheckMessage;
    private bool recheckFailed;

    /// <summary>Reads the verdicts and re-checks from citation-audit.json (and, after a re-check, the report's check sentence).</summary>
    private async Task LoadAuditAsync(string folder, bool reloadReport = true)
    {
        string auditPath = Path.Join(folder, "citation-audit.json");
        auditChecks.Clear();
        rechecks = new();
        if (File.Exists(auditPath))
        {
            try
            {
                using var doc = JsonDocument.Parse(await File.ReadAllTextAsync(auditPath));
                if (doc.RootElement.TryGetProperty("SupportChecks", out var checks))
                    auditChecks.AddRange(JsonSerializer.Deserialize<List<AuBtechReviewAgent.CitationSupportResult>>(checks.GetRawText()) ?? new());
                if (doc.RootElement.TryGetProperty("Rechecks", out var done))
                    rechecks = JsonSerializer.Deserialize<List<AuBtechReviewAgent.CitationRecheck>>(done.GetRawText()) ?? new();
            }
            catch (Exception ex) when (ex is JsonException or IOException) { auditChecks.Clear(); rechecks = new(); }
        }
        rechecksLeft = auditChecks.Count == 0 ? 0 : Math.Max(0, AuBtechReviewAgent.PrismaReviewEngine.MaxRechecksPerRun - rechecks.Count);

        string reportPath = Path.Join(folder, "prisma-report.json");
        if (reloadReport && File.Exists(reportPath))
        {
            try
            {
                var updated = JsonSerializer.Deserialize<PrismaReport>(await File.ReadAllTextAsync(reportPath), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (updated != null) report.CitationCheckSummary = updated.CitationCheckSummary;
            }
            catch (Exception ex) when (ex is JsonException or IOException) { }
        }
    }

    private AuBtechReviewAgent.CitationRecheck? RecheckOf((string Field, int Sentence, int Reference) c) =>
        rechecks.LastOrDefault(r => r.Field == c.Field && r.SentenceIndex == c.Sentence && r.Reference == c.Reference);

    private async Task RecheckAsync((string Field, int Sentence, int Reference) c)
    {
        if (rechecking) return;
        rechecking = true;
        recheckMessage = null;
        recheckFailed = false;
        try
        {
            var result = await ReviewEngine.RecheckCitationAsync(State.CurrentSessionId, c.Field, c.Sentence, c.Reference, editKey: editKey);
            await LoadAuditAsync(Runs.FolderOf(State.CurrentSessionId));
            recheckMessage = $"Checked again: {VerdictLabel(result.Verdict).ToLowerInvariant()}, against the {result.EvidenceBasis}.";
        }
        catch (AuBtechReviewAgent.PrismaReviewEngine.RecheckException ex)
        {
            recheckMessage = ex.Message;
            recheckFailed = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            recheckMessage = "The check could not be run just now (the model or the paper's server did not answer). Try again later.";
            recheckFailed = true;
        }
        finally
        {
            rechecking = false;
        }
    }

    private AuBtechReviewAgent.CitationSupportResult? FindCheck(string field, int sentence, int reference) =>
        auditChecks.FirstOrDefault(c => c.Field == field && c.SentenceIndex == sentence && c.Reference == reference);

    private static string CiteId(string field, int sentence, int reference) => AuBtechReviewAgent.CitationView.CiteId(field, sentence, reference);

    // Citations that need a reader's attention (partly or not supported), in the order they appear in the report.
    private List<AuBtechReviewAgent.CitationSupportResult> AttentionList =>
        AuBtechReviewAgent.CitationView.Attention(auditChecks, f => AuBtechReviewAgent.CitationView.FieldRank(f, report.SynthesisSections.Select(x => x.Field).ToList()));
    private int attentionIndex = -1;

    private async Task StepAttention(int delta)
    {
        var list = AttentionList;
        if (list.Count == 0) return;
        attentionIndex = ((attentionIndex < 0 && delta < 0 ? 0 : attentionIndex) + delta + list.Count) % list.Count;
        await OpenAndScrollAsync(list[attentionIndex]);
    }

    // The citation-check panel (from 1500 px): which citations it steps through, and where it is.
    private string checkFilter = AuBtechReviewAgent.ReportOutline.Flagged;
    private int checkIndex = -1;

    private void SetCheckFilter(string filter)
    {
        checkFilter = filter;
        checkIndex = -1;
    }

    private async Task StepCheck()
    {
        var list = AuBtechReviewAgent.ReportOutline.InOrder(auditChecks, checkFilter,
            f => AuBtechReviewAgent.CitationView.FieldRank(f, report.SynthesisSections.Select(x => x.Field).ToList()));
        if (list.Count == 0) return;
        checkIndex = (checkIndex + 1) % list.Count;
        await OpenAndScrollAsync(list[checkIndex]);
    }

    private async Task OpenAndScrollAsync(AuBtechReviewAgent.CitationSupportResult c)
    {
        openCitation = (c.Field, c.SentenceIndex, c.Reference);
        StateHasChanged();
        try { await JS.InvokeAsync<bool>("traceableReview.scrollTo", CiteId(c.Field, c.SentenceIndex, c.Reference)); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Where a reader can open a source: its open-access copy, else its DOI, else its page (only http(s) addresses).</summary>
    private string? SourceLink(int reference)
    {
        var row = tableRecords.FirstOrDefault(t => t.ReferenceNumber == reference);
        if (row == null) return null;
        if (fullTextUrls.TryGetValue(row.PaperId, out var pdf) && AuBtechReviewAgent.PrismaReviewEngine.IsWebAddress(pdf)) return pdf;
        return DoiUrl(row.Doi) ?? (AuBtechReviewAgent.PrismaReviewEngine.IsWebAddress(row.Url) ? row.Url : null);
    }

    // Element to focus after the next render: the verdict box when a citation opens, the number when it closes.
    private string? pendingFocus;

    private void ToggleCitation(string field, int sentence, int reference)
    {
        bool closing = openCitation == (field, sentence, reference);
        openCitation = closing ? null : (field, sentence, reference);
        pendingFocus = closing ? null : $"verdict-{field}";
    }

    // The statement on AI use for this run (section 6.4), and the confirmation after copying it.
    private string aiStatement = "";
    private string aiShort = "";
    private List<string> researchQuestions = new();
    private string? copyNotice;

    private async Task CopyStatement(string text, string what)
    {
        bool copied = false;
        try { copied = await JS.InvokeAsync<bool>("traceableReview.copyText", text); }
        catch (JSException) { /* the browser refused the clipboard; the text stays on the page to select by hand */ }
        catch (JSDisconnectedException) { /* the tab was closed */ }
        copyNotice = copied ? $"{what} copied. Edit it to fit your venue's policy on AI use before you submit." : "Copying is not allowed here; select the text and copy it by hand.";
    }

    private async Task PrintReport()
    {
        try { await JS.InvokeVoidAsync("traceableReview.print"); }
        catch (JSException) { /* printing is a convenience; Ctrl+P works too */ }
        catch (JSDisconnectedException) { /* the tab was closed */ }
    }

    private void CloseCitation()
    {
        if (openCitation is { } open) pendingFocus = CiteId(open.Field, open.Sentence, open.Reference);
        openCitation = null;
    }

    private static string VerdictLabel(string? verdict) => AuBtechReviewAgent.CitationView.VerdictLabel(verdict);
    private static string VerdictText(string? verdict) => AuBtechReviewAgent.CitationView.VerdictText(verdict);

    // The run's edit key from this browser's storage: only the browser that started the run can change it.
    private string? editKey;
    private Guid editKeyFor;
    private bool canEdit;
    private bool linkCopied;

    private async Task CopyLink()
    {
        try { linkCopied = await JS.InvokeAsync<bool>("traceableReview.copyLink"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { linkCopied = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (State.CurrentSessionId != Guid.Empty && editKeyFor != State.CurrentSessionId)
        {
            editKeyFor = State.CurrentSessionId;
            try { editKey = await JS.InvokeAsync<string?>("traceableReview.getEditKey", State.CurrentSessionId.ToString()); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { editKey = null; }
            bool allowed = Runs.CanEdit(State.CurrentSessionId, editKey);
            if (allowed != canEdit) { canEdit = allowed; StateHasChanged(); }
        }
        if (pendingFocus is { } focusId)
        {
            pendingFocus = null;
            try { await JS.InvokeAsync<bool>("traceableReview.focus", focusId); }
            catch (JSException) { /* moving focus is a convenience; the page works without it */ }
            catch (JSDisconnectedException) { /* the tab was closed */ }
        }
        if (!string.IsNullOrEmpty(mermaidDiagramCode))
        {
            try
            {
                await JS.InvokeAsync<bool>("traceableMermaid.render", "mermaid-preview", mermaidDiagramCode);
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RunId is Guid id && id != Guid.Empty)
        {
            // A run made by another kind of review has its own report page.
            if (AuBtechReviewAgent.ReviewModules.ElsewhereFor(Runs.LoadHeader(id), AuBtechReviewAgent.ReviewMethod.SystematicKey) is string elsewhere)
            {
                Nav.NavigateTo(elsewhere, replace: true);
                return;
            }
            State.CurrentSessionId = id;
        }

        report = new PrismaReport();
        includedCitations = new();
        tableRecords.Clear();
        extractions.Clear();
        auditChecks.Clear();
        codebook = null;
        publicationsByYear = new();
        platformShares = new();
        journalCount = conferenceCount = transactionsCount = proceedingsCount = preprintCount = 0;
        peerReviewOnlyToggle = false;
        aiStatement = aiShort = "";
        researchQuestions = new();
        copyNotice = null;
        passedPeerReviewCheck = failedPeerReviewCheck = 0;
        mermaidDiagramCode = "";
        openCitation = null;
        deleted = false;
        stats = null;
        flow = null;
        runLine = dateLine = "";
        checkFilter = AuBtechReviewAgent.ReportOutline.Flagged;
        checkIndex = attentionIndex = -1;

        string folder = Runs.FolderOf(State.CurrentSessionId);
        string reportPath = Path.Join(folder, "prisma-report.json");
        hasProtocol = File.Exists(Path.Join(folder, "protocol.md"));

        if (File.Exists(reportPath))
        {
            try
            {
                string content = await File.ReadAllTextAsync(reportPath);
                report = JsonSerializer.Deserialize<PrismaReport>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new PrismaReport();
            }
            catch { report = new PrismaReport(); }
        }

        await LoadAuditAsync(folder, reloadReport: false);

        var state = ReviewEngine.LoadState(State.CurrentSessionId);
        if (state == null) return;

        peerReviewOnlyToggle = state.PeerReviewOnlyToggle;
        stats = state.Stats;
        flow = AuBtechReviewAgent.PrismaFlowCounts.From(state);
        runLine = RunLine(state);
        dateLine = state.CompletedUtc is DateTime done ? done.ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture) : "";
        aiStatement = AuBtechReviewAgent.AiUseStatement.Methods(state, State.CurrentSessionId);
        aiShort = AuBtechReviewAgent.AiUseStatement.Short(state);
        researchQuestions = state.ResearchQuestions?.ToList() ?? new List<string>();
        passedPeerReviewCheck = state.Stats.PassedPeerReviewCheck;
        failedPeerReviewCheck = state.Stats.FailedPeerReviewCheck;
        if (state.Extractions != null) extractions.AddRange(state.Extractions);
        codebook = state.ThematicSynthesis;

        // Older runs have ReferenceNumber = 0 everywhere; OrderBy is stable, so they keep their order.
        tableRecords.AddRange(state.SynthesizedRecords.OrderBy(r => r.ReferenceNumber));
        fullTextUrls = state.FullTextUrls ?? new();
        notes = Runs.LoadNotes(State.CurrentSessionId).ToList();
        includedCitations = tableRecords.Select(r => r.ApaCitation.Trim().TrimEnd('.')).ToList();

        platformShares = tableRecords
            .GroupBy(r => string.IsNullOrWhiteSpace(r.Category) ? "Other" : r.Category)
            .OrderByDescending(g => g.Count()).ThenBy(g => g.Key, StringComparer.Ordinal)
            .Select((g, i) => new PlatformShare(g.Key, AuBtechReviewAgent.PrismaReviewEngine.CategoryLabel(g.Key), g.Count(),
                BarColors[i % BarColors.Length], BadgeColors[i % BadgeColors.Length]))
            .ToList();

        publicationsByYear = tableRecords
            .GroupBy(r => r.Year > 0 ? r.Year.ToString() : "n.d.")
            .OrderBy(g => g.Key == "n.d." ? "9999" : g.Key, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.Count());

        journalCount = tableRecords.Count(r => r.VenueType == "Journals");
        transactionsCount = tableRecords.Count(r => r.VenueType == "Transactions");
        conferenceCount = tableRecords.Count(r => r.VenueType == "Conferences");
        proceedingsCount = tableRecords.Count(r => r.VenueType == "Proceedings");
        preprintCount = tableRecords.Count - journalCount - transactionsCount - conferenceCount - proceedingsCount;

        if (report.Artifact is { IsDiagram: true, Error: null } artifactDiagram)
        {
            mermaidDiagramCode = artifactDiagram.Mermaid;
        }
        else if (!string.IsNullOrEmpty(report.SynthesisResultsItem))
        {
            var mermaidMatch = Regex.Match(report.SynthesisResultsItem, @"\[MERMAID_START\](.*?)\[MERMAID_END\]", RegexOptions.Singleline);
            // Older runs stored the model's diagram unrepaired; clean it here as well.
            if (mermaidMatch.Success) mermaidDiagramCode = AuBtechReviewAgent.MermaidSanitizer.Sanitize(mermaidMatch.Groups[1].Value.Trim());
        }
    }
}
