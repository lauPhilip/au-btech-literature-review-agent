@page "/spec-matrix"
@page "/spec-matrix/{RunId:guid}"
@layout AppLayout
@rendermode InteractiveServer

@using System.IO
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine
@inject AuBtechReviewAgent.RunStore Runs

<SeoHead Title="Review output" Path="/spec-matrix" NoIndex="true" Description="A PRISMA 2020 review report with every citation checked against the cited paper." />

@if (!HasReport)
{
    <div class="mx-auto my-12 max-w-xl px-4">
        <div class="ui-card p-6 text-center">
            <h1 class="font-display text-lg font-semibold text-heading">@(deleted ? "The run was deleted" : "No report yet")</h1>
            <p class="mt-1 text-sm text-muted">
                @(deleted ? "Its ledger, report and downloaded papers have been removed from the server."
                          : "Start a review on New review. The report appears here when the run is done.")
            </p>
            <a href="/review" class="ui-btn-primary mt-4 min-h-[44px]">New review</a>
        </div>
    </div>
}
else
{
    string runHref = $"/review/{State.CurrentSessionId}";
    string api = $"/api/workspace/{State.CurrentSessionId}";
    <div class="mx-auto w-full max-w-[1600px] px-[clamp(16px,3vw,40px)] py-4 sm:py-8 print:max-w-none print:p-0">

        <div class="mb-4 flex flex-wrap items-center justify-between gap-2 print:hidden">
            <a href="@runHref" class="ui-btn-ghost min-h-[44px] px-2"><span aria-hidden="true">←</span> Back to the run</a>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" @onclick="PrintReport" class="ui-btn-secondary min-h-[44px] max-sm:hidden" title="Print the report, or choose Save as PDF in the print window">Print or save as PDF</button>
                <a href="@($"{api}/archive")" class="ui-btn-primary min-h-[44px]" title="Every file of the run, fingerprinted, with the LaTeX manuscript">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download archive
                </a>
                <details class="relative">
                    <summary class="ui-btn-secondary min-h-[44px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">More<span class="sr-only"> actions for this report</span></summary>
                    <div class="absolute right-0 z-40 mt-2 w-[min(20rem,calc(100vw-2rem))] space-y-1 rounded-card border border-line bg-page p-2 shadow-lift">
                        <button type="button" @onclick="CopyLink" class="flex min-h-[44px] w-full items-center rounded-btn px-3 text-left text-sm text-ink hover:bg-active" title="Anyone with the link can read this report; only the browser that started the run can change it">@(linkCopied ? "Link copied" : "Copy link to this report")</button>
                        <a href="@($"/review?from={State.CurrentSessionId}")" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">New review from these settings</a>
                        @if (hasProtocol)
                        {
                            <a href="@($"{api}/protocol.md")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">Protocol, written before the search</a>
                        }
                        <a href="@($"{api}/references.bib")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">References as BibTeX</a>
                        <a href="@($"{api}/references.ris")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active">References as RIS (Zotero, EndNote)</a>
                        <a href="@($"{api}/screened.ris")" target="_blank" class="flex min-h-[44px] items-center rounded-btn px-3 text-sm text-ink hover:bg-active" title="Every screened record, tagged included or excluded with the reason">Every screened record as RIS</a>
                        <div class="border-t border-line pt-1">
                            @if (!canEdit)
                            {
                                <p class="px-3 py-2 text-xs text-muted">Read-only. Only the browser that started this run can change or delete it.</p>
                            }
                            else if (!ReviewEngine.IsRunActive(State.CurrentSessionId))
                            {
                                @if (!confirmDelete)
                                {
                                    <button type="button" @onclick="() => confirmDelete = true" class="flex min-h-[44px] w-full items-center rounded-btn px-3 text-left text-sm text-not-supported hover:bg-not-supported-fill">Delete run</button>
                                }
                                else
                                {
                                    <div class="space-y-2 rounded-btn bg-not-supported-fill p-3 text-sm text-not-supported" role="alert">
                                        <p>Delete this run and its files for good?</p>
                                        <div class="flex gap-2">
                                            <button type="button" @onclick="DeleteRun" class="ui-btn-danger ui-btn-sm min-h-[44px]">Delete</button>
                                            <button type="button" @onclick="() => confirmDelete = false" class="ui-btn-secondary ui-btn-sm min-h-[44px]">Cancel</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </details>
            </div>
        </div>

        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[220px_minmax(0,1fr)] xl:gap-8 min-[1500px]:grid-cols-[220px_minmax(0,1fr)_350px] print:block">
            <div class="max-lg:hidden print:hidden">
                <ReportContents Entries="Outline" PageHref="@($"/spec-matrix/{State.CurrentSessionId}")" />
            </div>

            <div class="min-w-0">
        <CitationAttentionBar Attention="AttentionList" Index="attentionIndex" OnStep="StepAttention" HideFromLarge="true" />
        <article class="mx-auto w-full max-w-[880px] rounded-card border border-line bg-page px-5 py-6 text-[17px] leading-[1.7] text-ink shadow-card sm:px-10 sm:py-10 [&_blockquote]:max-w-[70ch] [&_h3]:max-w-[70ch] [&_p]:max-w-[70ch] print:max-w-none print:rounded-none print:border-0 print:p-0 print:text-[11pt] print:leading-normal print:shadow-none">

            <header class="border-b border-line pb-6">
                <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">Systematic review · PRISMA 2020@(dateLine.Length > 0 ? $" · {dateLine}" : "")</p>
                <h1 class="mt-2 max-w-[24ch] font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">@ScrubAnchors(report.TitleItem)</h1>
                @if (runLine.Length > 0)
                {
                    <p class="mt-3 text-[15px] text-muted">@runLine</p>
                }
                <p class="mt-1 text-xs text-muted">
                    Department of Business Development and Technology, Aarhus University ·
                    <span class="break-all font-mono">protocol @(string.IsNullOrWhiteSpace(report.ProtocolHash) ? "not recorded" : report.ProtocolHash)</span>
                </p>

                @if (auditChecks.Count > 0)
                {
                    var counts = AuBtechReviewAgent.VerdictTally.From(auditChecks);
                    <div class="mt-5 rounded-card border border-line bg-soft p-4 sm:p-5 print:hidden">
                        <h2 class="font-display text-base font-semibold text-heading">@counts.Total @(counts.Total == 1 ? "citation" : "citations") checked against the papers</h2>
                        <div class="mt-2"><VerdictBar Counts="counts" /></div>
                        <p class="mt-2 text-[15px] text-muted">
                            Each number in the text is coloured by what the check found. Open one to see the passage it was checked against.
                            @(counts.Flagged > 0 ? $"{counts.Flagged} {(counts.Flagged == 1 ? "citation is" : "citations are")} only partly or not supported; they stay in the report, marked." : "")
                        </p>
                    </div>
                }
            </header>

            <section id="@AuBtechReviewAgent.ReportOutline.AbstractId" data-report-section class="scroll-mt-20 pt-6">
                <h2 class="font-display text-xl font-semibold tracking-tight text-heading">Abstract</h2>
                <p class="mt-2">@ScrubAnchors(report.AbstractItem)</p>
            </section>

            <div class="space-y-10 pt-8">


                <SpecMatrixIntroduction Page="this" />

                <SpecMatrixStudies Page="this" />

                <section id="@AuBtechReviewAgent.ReportOutline.ResultsId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">4. Results & Synthesis</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">4.1 Overview of the Synthesis (Item 20a)</h3>
                    @if (auditChecks.Count > 0)
                    {
                        <p class="text-sm text-muted print:hidden">Open a citation number to see what the automated check found in the cited paper.</p>
                    }
                    @CitedText("synthesisResultsItem", ScrubAnchors(report.SynthesisResultsItem))

                    @for (int k = 0; k < report.SynthesisSections.Count; k++)
                    {
                        var part = report.SynthesisSections[k];
                        <h3 id="@AuBtechReviewAgent.ReportOutline.ThemeId(k)" data-report-section class="scroll-mt-20 pt-4 font-display text-base font-semibold text-heading">4.@(k + 2) @part.Heading</h3>
                        @CitedText(part.Field, part.Text)
                    }

                    @if (codebook is { Themes.Count: > 0 })
                    {
                        <div class="mt-4">
                            <h3 class="mb-2 font-display text-base font-semibold text-heading">Evidence map: studies by theme</h3>
                            <div class="overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                                <table class="w-full border border-line text-sm">
                                    <thead class="bg-soft text-muted">
                                        <tr>
                                            <th class="border-b border-line p-2 text-left">Theme</th>
                                            <th class="border-b border-line p-2 text-left">Studies</th>
                                            <th class="border-b border-line p-2 text-left">Cited in its subsection</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var theme in codebook.Themes)
                                        {
                                            var cov = codebook.Coverage.FirstOrDefault(c => c.ThemeId == theme.Id);
                                            <tr class="border-b border-line align-top">
                                                <td class="p-2"><span class="font-semibold">@theme.Name</span><br /><span class="text-muted">@theme.Description</span></td>
                                                <td class="p-2 font-mono">@string.Join(", ", theme.Studies.Select(r => $"[{r}]"))</td>
                                                <td class="p-2">@(cov == null ? "-" : $"{cov.CitedFinal.Count} of {cov.Studies.Count}")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (codebook.SecondCoding?.Kappa is double kappa)
                            {
                                <p class="text-xs text-muted mt-1">Second, independent coding: Cohen's kappa = @kappa.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) over @codebook.SecondCoding.CellsCompared study-theme decisions.</p>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(report.CoverageSummary))
                    {
                        <p class="border-l-2 border-heading pl-3 text-[15px] italic text-muted">@report.CoverageSummary</p>
                    }

                    @if (report.Artifact is { } art)
                    {
                        <div class="mt-5 border border-line p-3 space-y-2">
                            <span class="text-xs font-bold text-muted uppercase block">Artifact: @(string.IsNullOrWhiteSpace(art.Title) ? AuBtechReviewAgent.ArtifactKinds.All.FirstOrDefault(k => k.Key == art.Requested).Label : art.Title)</span>
                            @if (art.Error != null)
                            {
                                <p class="text-[13px] text-muted italic">@art.Error</p>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(art.Caption))
                                {
                                    <p class="text-[13px] text-muted">@art.Caption</p>
                                }
                                @if (art.IsDiagram && !string.IsNullOrEmpty(mermaidDiagramCode))
                                {
                                    @* Filled by wwwroot/js/mermaid-render.js; Blazor leaves the empty element alone. *@
                                    <div id="mermaid-preview" class="w-full flex flex-col items-center justify-center text-center bg-soft p-3 overflow-x-auto print:overflow-visible"></div>
                                    @if (art.Nodes.Any(n => AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(n.Label).Count > 0))
                                    {
                                        <span class="text-xs font-bold text-muted uppercase block pt-1">Cited boxes in the diagram</span>
                                        @for (int k = 0; k < art.Nodes.Count; k++)
                                        {
                                            if (AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(art.Nodes[k].Label).Count == 0) continue;
                                            @CitedText($"artifact-n{k + 1}", art.Nodes[k].Label)
                                        }
                                    }
                                }
                                else if (art.Kind == AuBtechReviewAgent.ArtifactKinds.Table)
                                {
                                    <div class="overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                                        <table class="w-full text-[13px] border border-line align-top">
                                            <thead class="bg-soft text-muted text-left">
                                                <tr>@foreach (var col in art.Columns) { <th class="p-1.5 border-b border-line">@col</th> }</tr>
                                            </thead>
                                            <tbody>
                                                @for (int r = 0; r < art.Rows.Count; r++)
                                                {
                                                    int row = r;
                                                    <tr class="border-t border-line align-top">
                                                        @for (int c = 0; c < art.Rows[row].Count; c++)
                                                        {
                                                            <td class="p-2">@CitedText($"artifact-r{row + 1}c{c + 1}", art.Rows[row][c])</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <ul class="list-disc pl-5 space-y-1">
                                        @for (int b = 0; b < art.Bullets.Count; b++)
                                        {
                                            <li>@CitedText($"artifact-b{b + 1}", art.Bullets[b])</li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(mermaidDiagramCode))
                    {
                        <div class="mt-4 border border-line p-4 bg-soft flex flex-col items-center justify-center print:hidden">
                            <span class="text-xs font-bold text-muted block mb-3 uppercase tracking-widest">Diagram</span>
                            @* Older runs: the diagram the report draft wrote. *@
                            <div id="mermaid-preview" class="w-full flex flex-col items-center justify-center text-center"></div>
                        </div>
                    }
                </div>

                </section>

                <section id="@AuBtechReviewAgent.ReportOutline.DiscussionId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">5. Discussion</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">5.1 General Interpretation (Item 23a)</h3>
                    @CitedText("discussionItem", report.DiscussionItem)
                    @if (!string.IsNullOrWhiteSpace(report.CitationCheckSummary))
                    {
                        <p class="border-l-2 border-heading pl-3 text-[15px] italic text-muted">@report.CitationCheckSummary</p>
                    }
                </div>

                @* PRISMA 2020 items 23b to 23d, which published reviews give their own headings. Runs made before they were
                   written have none of them; 23c is written in code from the run's facts. *@
                @{ int discussionPart = 1; }
                @if (!string.IsNullOrWhiteSpace(report.EvidenceLimitationsItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(++discussionPart) Limitations of the Evidence (Item 23b)</h3>
                        @CitedText("evidenceLimitationsItem", report.EvidenceLimitationsItem)
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(report.ReviewLimitationsItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(++discussionPart) Limitations of the Review Process (Item 23c)</h3>
                        <p class="text-ink">@report.ReviewLimitationsItem</p>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(report.ImplicationsItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(++discussionPart) Implications for Practice and Policy (Item 23d)</h3>
                        @CitedText("implicationsItem", report.ImplicationsItem)
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(report.FutureResearchItem))
                {
                    <div class="space-y-2">
                        <h3 class="font-display text-base font-semibold text-heading">5.@(discussionPart + 1) Directions for Future Research (Item 23d)</h3>
                        @CitedText("futureResearchItem", report.FutureResearchItem)
                    </div>
                }

                </section>

                @{ int declarationsNumber = AuBtechReviewAgent.ReportOutline.DeclarationsNumber(report); }
                @if (AuBtechReviewAgent.ReportOutline.HasConclusion(report))
                {
                    <section id="@AuBtechReviewAgent.ReportOutline.ConclusionId" data-report-section class="scroll-mt-20 space-y-5">
                        <h2 class="font-display text-xl font-semibold tracking-tight text-heading">6. Conclusion</h2>
                        @foreach (var answer in report.ResearchAnswers ?? new List<ResearchAnswer>())
                        {
                            <div class="space-y-2">
                                <h3 class="font-display text-base font-semibold text-heading">RQ@(answer.Number). @answer.Question</h3>
                                @CitedText($"researchAnswer{answer.Number}", answer.Answer)
                            </div>
                        }
                        <div class="space-y-2">
                            @CitedText("conclusionItem", report.ConclusionItem)
                        </div>
                    </section>
                }

                <section id="@AuBtechReviewAgent.ReportOutline.DeclarationsId" data-report-section class="scroll-mt-20 space-y-5">
                    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">@(declarationsNumber). Declarations</h2>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).1 Registration and Protocol (Item 24)</h3>
                    <p class="text-ink">
                        @(string.IsNullOrWhiteSpace(report.ProtocolItem) ? AuBtechReviewAgent.PrismaReviewEngine.NoProtocolText : report.ProtocolItem)
                        @if (hasProtocol)
                        {
                            <a class="text-heading underline ml-1" href="@($"/api/workspace/{State.CurrentSessionId}/protocol.md")" target="_blank">Open protocol.md</a>
                        }
                    </p>
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).2 Support & Funding (Item 25)</h3>
                    <p class="text-ink">@ScrubAnchors(report.SupportItem)</p>
                </div>

                <div class="space-y-2">
                    <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).3 Availability of Data and Code (Item 27)</h3>
                    <p class="text-ink">@ScrubAnchors(report.AvailabilityItem)</p>
                </div>

                @if (aiStatement.Length > 0)
                {
                    @* Ready to copy into a paper or thesis; built only from what the run recorded (AiUseStatement). *@
                    <div class="space-y-2" id="ai-use">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <h3 class="font-display text-base font-semibold text-heading">@(declarationsNumber).4 Use of Artificial Intelligence</h3>
                            <span class="flex flex-wrap gap-2 print:hidden">
                                <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px]" @onclick='() => CopyStatement(aiStatement, "Methods statement")'>Copy for the methods</button>
                                <button type="button" class="ui-btn-secondary ui-btn-sm min-h-[44px]" @onclick='() => CopyStatement(aiShort, "Short declaration")'>Copy a short declaration</button>
                            </span>
                        </div>
                        <p class="text-ink">@aiStatement</p>
                        <p class="text-xs text-muted print:hidden" role="status">@(copyNotice ?? "Edit it to fit your venue's policy on AI use before you submit.")</p>
                    </div>
                }
                </section>

            </div>

            <section id="@AuBtechReviewAgent.ReportOutline.ReferencesId" data-report-section class="mt-10 scroll-mt-20 border-t border-line pt-8">
                <h2 class="mb-4 font-display text-xl font-semibold tracking-tight text-heading">References</h2>
                @if (includedCitations.Count == 0)
                {
                    <p class="italic text-muted">No sources were included in this run.</p>
                }
                else
                {
                    <ol class="space-y-2 text-[15px] text-ink">
                        @for (int i = 0; i < includedCitations.Count; i++)
                        {
                            int number = i + 1;
                            string citation = includedCitations[i];
                            <li class="pl-2 leading-relaxed">
                                <span class="font-mono font-bold text-heading mr-1">[@number]</span> - <ApaReference Text="@citation" />
                            </li>
                        }
                    </ol>
                }
            </section>

            @* The tables of the included studies come after the references, as Tables A.1 to A.3 (issue #139). *@
            <section id="@AuBtechReviewAgent.ReportOutline.AppendixId" data-report-section class="mt-10 scroll-mt-20 space-y-6 border-t border-line pt-8">
                <h2 class="font-display text-xl font-semibold tracking-tight text-heading">Appendix</h2>

                <div class="space-y-2 pt-4 max-w-full overflow-hidden">
                    <h3 class="font-display text-base font-semibold text-heading">Table A.1: Included Studies</h3>
                    <div class="border border-line bg-page overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                        <table class="w-full text-left border-collapse text-xs leading-relaxed table-fixed min-w-[700px] print:min-w-0">
                            <thead>
                                <tr class="bg-soft border-b border-line text-ink font-bold font-mono text-xs uppercase sticky top-0 z-10">
                                    <th class="p-2 border-r border-line w-[5%]">Ref.</th>
                                    <th class="p-2 border-r border-line w-[17%]">Paper Name</th>
                                    <th class="p-2 border-r border-line w-[22%]">Executive Summary</th>
                                    <th class="p-2 border-r border-line w-[20%]">Inclusion Rationale</th>
                                    <th class="p-2 border-r border-line w-[12%] text-center">Source</th>
                                    <th class="p-2 w-[24%]">Citation (APA 7th)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-line text-ink">
                                @foreach (var paperRow in tableRecords)
                                {
                                    string badgeClass = platformShares.FirstOrDefault(p => p.Category == paperRow.Category)?.Badge ?? "text-ink bg-soft";
                                    <tr class="hover:bg-soft" id="@($"ref-{paperRow.ReferenceNumber}")">
                                        <td class="p-2 font-mono text-heading font-bold border-r border-line align-top">[@paperRow.ReferenceNumber]</td>
                                        <td class="p-2 border-r border-line align-top break-words">
                                            <span class="font-semibold text-ink">@paperRow.Title</span>
                                            @StudyLinks(paperRow)
                                            @StudyNote(paperRow.ReferenceNumber)
                                        </td>
                                        <td class="p-2 text-muted border-r border-line align-top font-light break-words">@paperRow.Summary</td>
                                        <td class="p-2 text-muted border-r border-line align-top font-light text-xs break-words">@paperRow.InclusionRationale</td>
                                        <td class="p-2 border-r border-line align-top text-center font-mono font-medium text-xs">
                                            <span class="px-1.5 py-0.5 @badgeClass">@AuBtechReviewAgent.PrismaReviewEngine.CategoryLabel(paperRow.Category)</span>
                                        </td>
                                        <td class="p-2 font-mono text-xs text-muted bg-soft align-top leading-normal break-all"><ApaReference Text="@paperRow.ApaCitation" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (extractions.Count > 0)
                {
                    <div class="space-y-2 pt-2 max-w-full overflow-hidden">
                        <h3 class="font-display text-base font-semibold text-heading">Table A.2: Extracted Study Data</h3>
                        <div class="border border-line bg-page overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                            <table class="w-full text-left border-collapse text-xs leading-relaxed table-fixed min-w-[700px] print:min-w-0">
                                <thead>
                                    <tr class="bg-soft border-b border-line text-ink font-bold font-mono text-xs uppercase">
                                        <th class="p-2 border-r border-line w-[5%]">Ref.</th>
                                        <th class="p-2 border-r border-line w-[15%]">Study type</th>
                                        <th class="p-2 border-r border-line w-[20%]">Method</th>
                                        <th class="p-2 border-r border-line w-[15%]">Sample</th>
                                        <th class="p-2 w-[45%]">Key findings</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-line text-ink">
                                    @foreach (var e in extractions)
                                    {
                                        <tr>
                                            <td class="p-2 font-mono text-heading font-bold border-r border-line align-top">[@e.ReferenceNumber]</td>
                                            @if (e.Error != null)
                                            {
                                                <td colspan="4" class="p-2 text-not-supported">Extraction failed for this study.</td>
                                            }
                                            else
                                            {
                                                <td class="p-2 border-r border-line align-top">@e.StudyType<span class="block text-xs text-muted">@e.EvidenceBasis</span></td>
                                                <td class="p-2 border-r border-line align-top">@Evidence(e.Method)</td>
                                                <td class="p-2 border-r border-line align-top">@Evidence(e.Sample)</td>
                                                <td class="p-2 align-top space-y-1">
                                                    @foreach (var f in e.KeyFindings)
                                                    {
                                                        <div>@Evidence(f)</div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="text-xs text-muted">Hover over a value to see the quote it was taken from. <span class="text-partly">†</span> The quote could not be found in the paper's text, so treat the value with caution.</p>
                    </div>

                    <div class="space-y-2 pt-2 max-w-full overflow-hidden">
                        <h3 class="font-display text-base font-semibold text-heading">Table A.3: Quality Appraisal and <Term Key="risk-of-bias">Risk of Bias</Term> (MMAT 2018)</h3>
                        @if (extractions.Any(AuBtechReviewAgent.MethodsSectionWriter.ShowInAppraisalTable))
                        {
                            <div class="border border-line bg-page overflow-x-auto print:overflow-visible" tabindex="0" role="region" aria-label="Scrolls sideways">
                                <table class="w-full text-left border-collapse text-xs min-w-[560px] print:min-w-0">
                                    <thead>
                                        <tr class="bg-soft border-b border-line text-ink font-bold font-mono text-xs uppercase">
                                            <th class="p-2 border-r border-line">Ref.</th>
                                            <th class="p-2 border-r border-line">Category</th>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <th class="p-2 border-r border-line text-center">@i</th>
                                            }
                                            <th class="p-2 text-center" title="How many of the five questions were answered yes. MMAT does not combine them into one score.">Met</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line text-ink">
                                        @foreach (var e in extractions.Where(AuBtechReviewAgent.MethodsSectionWriter.ShowInAppraisalTable))
                                        {
                                            <tr>
                                                <td class="p-2 font-mono text-heading font-bold border-r border-line">[@e.ReferenceNumber]</td>
                                                <td class="p-2 border-r border-line">@AppraisalCategory(e)</td>
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    var a = i < e.Appraisal.Count ? e.Appraisal[i] : null;
                                                    var light = AuBtechReviewAgent.RiskOfBias.For(a?.Answer);
                                                    <td class="p-2 border-r border-line text-center whitespace-nowrap @light.Text"
                                                        title="@(a == null ? "" : $"{a.Id} {a.Criterion}{(string.IsNullOrEmpty(a.Quote) ? "" : $" — \"{a.Quote}\"")}")">
                                                        <span class="inline-block w-2 h-2 rounded-full align-middle mr-1 @light.Dot" aria-hidden="true"></span><span class="align-middle">@light.Word</span>
                                                    </td>
                                                }
                                                <td class="p-2 text-center font-mono whitespace-nowrap">@(e.Appraisal.Count == 0 ? "–" : $"{e.AppraisalYes} of {e.Appraisal.Count}")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="text-xs text-muted">Hover over an answer to see the question and the supporting quote. "Met" counts the questions answered yes; following MMAT's guidance it is not an overall quality score. Appraised by the language model; check before use.</p>
                            @foreach (var category in AuBtechReviewAgent.RiskOfBias.Summarise(extractions))
                            {
                                <figure class="mt-3 border border-line bg-page p-3">
                                    <figcaption class="text-xs font-semibold text-ink">@category.Category.Replace('_', ' ') studies (@category.Studies): answers per question</figcaption>
                                    <div class="mt-2 space-y-1.5">
                                        @foreach (var q in category.Questions)
                                        {
                                            <div class="grid grid-cols-[minmax(0,1fr)_8rem] sm:grid-cols-[minmax(0,1fr)_12rem] gap-2 items-center text-xs">
                                                <span class="text-ink leading-snug"><span class="font-mono text-muted">@q.Id</span> @q.Criterion</span>
                                                <span class="flex h-3 w-full overflow-hidden bg-soft" role="img" aria-label="@($"{q.Yes} yes, {q.No} no, {q.CantTell} can't tell")"
                                                      title="@($"{q.Yes} yes · {q.No} no · {q.CantTell} can't tell")">
                                                    @foreach (var (count, dot) in new[] { (q.Yes, "bg-verdict-ok"), (q.CantTell, "bg-verdict-partial"), (q.No, "bg-verdict-bad") })
                                                    {
                                                        @if (count > 0)
                                                        {
                                                            <span class="h-full @dot" style="width:@((100.0 * count / q.Total).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                                        }
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                    <p class="mt-2 text-xs text-muted"><span class="inline-block w-2 h-2 rounded-full bg-verdict-ok align-middle"></span> yes · <span class="inline-block w-2 h-2 rounded-full bg-verdict-partial align-middle"></span> can't tell · <span class="inline-block w-2 h-2 rounded-full bg-verdict-bad align-middle"></span> no</p>
                                </figure>
                            }
                        }
                        @if (AuBtechReviewAgent.MethodsSectionWriter.NotAppraisedNote(extractions) is { Length: > 0 } notAppraised)
                        {
                            <p class="text-xs text-muted">@notAppraised</p>
                        }
                    </div>
                }
            </section>

            <div class="mt-12 border-t border-line pt-4 text-center text-xs uppercase tracking-[0.14em] text-muted">
                OSSYM 2026 - 8th International Open Search Symposium
            </div>
            @* Only on paper: where the printed report came from, so a printout can be traced back to its run. *@
            <p class="hidden print:block mt-2 text-center text-xs text-muted">
                Generated with TraceableAI · run @State.CurrentSessionId · @(report.GeneratedAt) · protocol @(string.IsNullOrWhiteSpace(report.ProtocolHash) ? "not recorded" : report.ProtocolHash)
            </p>

        </article>
            </div>

            <div class="hidden min-[1500px]:block print:hidden">
                <CitationCheckPanel Checks="auditChecks" Filter="@checkFilter" OnFilter="SetCheckFilter" Position="checkIndex" OnNext="StepCheck"
                                    RunId="State.CurrentSessionId" HasProtocol="hasProtocol" />
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Renders text with every [n] as a button, with the shared paper component (Components/Paper/CitedProse.razor);
    /// this page adds its reviewer notes and the re-check to an open citation's panel.
    /// </summary>
    internal RenderFragment CitedText(string field, string text) => __builder =>
    {
        <CitedProse Field="@field" Text="@text" Checks="auditChecks" Open="openCitation"
                    OnToggle="@(c => ToggleCitation(c.Field, c.Sentence, c.Reference))" OnClose="CloseCitation"
                    SourceTitle="@(reference => tableRecords.FirstOrDefault(t => t.ReferenceNumber == reference)?.Title)"
                    SourceLink="SourceLink"
                    PanelExtras="CitationExtras" />
    };

    /// <summary>What this page adds to an open citation's panel: the reviewer's note, a past re-check and the "Check again" button.</summary>
    internal RenderFragment<AuBtechReviewAgent.CitationSupportResult> CitationExtras => check => __builder =>
    {
        if (openCitation is not { } open) return;
        @CitationNote(open)
        @if (RecheckOf(open) is { } done)
        {
            <p class="text-xs text-muted">Checked again @done.CheckedUtc.ToString("yyyy-MM-dd HH:mm") UTC: was @VerdictLabel(done.VerdictBefore) (@done.EvidenceBefore), now @VerdictLabel(done.VerdictAfter) (@done.EvidenceAfter).</p>
        }
        @if (canEdit && check.Verdict is AuBtechReviewAgent.CitationSupportChecker.Partial or AuBtechReviewAgent.CitationSupportChecker.NotSupported)
        {
            <div class="pt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                <button type="button" class="ui-btn ui-btn-sm py-0.5 border border-line-field bg-page text-ink hover:border-heading disabled:opacity-50"
                        disabled="@(rechecking || rechecksLeft <= 0)" @onclick="() => RecheckAsync(open)">
                    @(rechecking ? "Checking again…" : "Check again")
                </button>
                <span class="text-xs text-muted">
                    @(rechecksLeft > 0
                        ? $"Runs the check once more{(check.EvidenceBasis == "abstract only" ? ", with the full text if an open-access copy can be found now" : " on the full text")}. {rechecksLeft} re-check{(rechecksLeft == 1 ? "" : "s")} left for this run."
                        : "This run has used its re-checks.")
                </span>
            </div>
        }
        @if (recheckMessage != null)
        {
            <p class="text-xs @(recheckFailed ? "text-not-supported" : "text-ink")" role="status">@recheckMessage</p>
        }
    };

    internal RenderFragment StudyNote(int reference) => __builder =>
    {
        var note = notes.FirstOrDefault(n => n.IsFor(AuBtechReviewAgent.ReviewerNote.Study, reference));
        @NoteBlock($"study-{reference}", note, AuBtechReviewAgent.ReviewerNote.Study, reference, "", -1)
    };

    internal RenderFragment CitationNote((string Field, int Sentence, int Reference) c) => __builder =>
    {
        var note = notes.FirstOrDefault(n => n.IsFor(AuBtechReviewAgent.ReviewerNote.Citation, c.Reference, c.Field, c.Sentence));
        @NoteBlock($"citation-{c.Field}-{c.Sentence}-{c.Reference}", note, AuBtechReviewAgent.ReviewerNote.Citation, c.Reference, c.Field, c.Sentence)
    };

    /// <summary>A note as text for every reader; with the edit key, an Add/Edit button and a small form.</summary>
    internal RenderFragment NoteBlock(string id, AuBtechReviewAgent.ReviewerNote? note, string kind, int reference, string field, int sentence) => __builder =>
    {
        if (editingNote == id)
        {
            <div class="mt-1.5">
                <label for="@($"note-{id}")" class="block text-xs font-semibold text-ink">Your note</label>
                <textarea id="@($"note-{id}")" rows="2" maxlength="@AuBtechReviewAgent.RunStore.MaxNoteLength" @bind="noteDraft"
                          class="mt-0.5 w-full border border-line-field p-1.5 text-[13px] font-normal text-ink focus:border-heading focus:outline-none"></textarea>
                <div class="mt-1 flex gap-2">
                    <button type="button" class="ui-btn-primary ui-btn-sm py-0.5" @onclick="() => SaveNoteAsync(kind, reference, field, sentence)">Save note</button>
                    <button type="button" class="ui-btn-secondary ui-btn-sm py-0.5" @onclick="() => editingNote = null">Cancel</button>
                </div>
                @if (noteMessage != null)
                {
                    <p class="mt-1 text-xs text-not-supported" role="alert">@noteMessage</p>
                }
            </div>
        }
        else
        {
            if (note != null)
            {
                <p class="mt-1.5 border-l-2 border-heading pl-2 text-xs font-normal text-ink whitespace-pre-line">
                    <span class="font-semibold text-ink">Reviewer's note:</span> @note.Text
                </p>
            }
            if (canEdit)
            {
                <button type="button" class="mt-1 text-xs font-medium text-heading hover:underline print:hidden"
                        @onclick="() => { editingNote = id; noteDraft = note?.Text ?? string.Empty; noteMessage = null; }">@(note == null ? "Add a note" : "Edit note")</button>
            }
        }
    };


    /// <summary>The value with its quote as a tooltip; a dagger when the quote was not found in the paper.</summary>
    private RenderFragment Evidence(AuBtechReviewAgent.EvidencedValue v) => __builder =>
    {
        bool notReported = v.Value.Equals("not reported", StringComparison.OrdinalIgnoreCase);
        <span class="@(notReported ? "text-muted italic" : "")" title="@(string.IsNullOrEmpty(v.Quote) ? "" : $"\"{v.Quote}\"")">@v.Value</span>
        @if (!notReported && !v.QuoteVerified)
        {
            <span class="text-partly" title="The supporting quote was not found in the paper's text">†</span>
        }
    };

    /// <summary>DOI and open-access PDF links under a study's title (only http(s) addresses are linked).</summary>
    private RenderFragment StudyLinks(IncludedPaperMetricRow row) => __builder =>
    {
        string? doi = DoiUrl(row.Doi);
        string? sourcePage = doi == null && AuBtechReviewAgent.PrismaReviewEngine.IsWebAddress(row.Url) ? row.Url : null;
        string? pdf = fullTextUrls.TryGetValue(row.PaperId, out var u) ? u : null;
        if (doi == null && sourcePage == null && pdf == null) return;
        <span class="mt-1 flex flex-wrap gap-x-2 text-xs print:hidden">
            @if (doi != null)
            {
                <a href="@doi" target="_blank" rel="noopener" class="text-heading underline underline-offset-2">DOI</a>
            }
            @if (sourcePage != null)
            {
                <a href="@sourcePage" target="_blank" rel="noopener" class="text-heading underline underline-offset-2">Source page</a>
            }
            @if (pdf != null)
            {
                <a href="@pdf" target="_blank" rel="noopener" class="text-heading underline underline-offset-2">Open-access PDF</a>
            }
        </span>
    };
}
