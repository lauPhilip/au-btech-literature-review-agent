@page "/spec-matrix"
@page "/spec-matrix/{RunId:guid}"
@rendermode InteractiveServer

@using System.IO
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine

<PageTitle>PRISMA 2020 Checklist Manuscript Preview</PageTitle>

<style>
    html, body {
        background-color: #4b5563 !important;
        min-height: 100vh;
        overflow-y: auto !important;
    }
    @@media print {
        body, html {
            background: white !important;
            overflow-y: visible !important;
        }
    }
</style>

<header class="bg-[#003B5C] text-white flex-none shrink-0 z-50 shadow-md print:hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center space-x-3 hover:opacity-90 transition-opacity min-w-0 shrink overflow-hidden">
            <span class="font-bold tracking-tight text-xs sm:text-sm whitespace-nowrap truncate">AARHUS UNIVERSITY</span>
            <span class="text-white/40 font-light hidden lg:inline">|</span>
            <span class="text-xs tracking-wider font-medium opacity-90 uppercase hidden lg:inline">au-btech-literature-review-agent</span>
        </a>
        <nav class="flex items-center gap-3 sm:gap-6 text-[10px] sm:text-xs font-semibold uppercase tracking-wider whitespace-nowrap shrink-0">
            <a href="/" class="text-white/70 hover:text-white transition-colors py-4">Overview</a>
            <a href="@(State.CurrentSessionId != Guid.Empty ? $"/review/{State.CurrentSessionId}" : "/review")" class="text-white/70 hover:text-white transition-colors py-4">Dashboard</a>
            <a href="@(State.CurrentSessionId != Guid.Empty ? $"/spec-matrix/{State.CurrentSessionId}" : "/spec-matrix")" class="text-white border-b-2 border-white py-4">Review Output</a>
            <a href="/metrics" class="text-white/70 hover:text-white transition-colors py-4">Metrics</a>
        </nav>
    </div>
</header>

<div class="w-full bg-gray-600 p-4 md:p-8 flex flex-col items-center justify-start min-h-screen overflow-y-auto print:bg-white print:p-0 pb-16">

    @if (HasReport)
    {
        <div class="w-full max-w-[8.5in] mb-4 flex flex-wrap justify-end gap-2 print:hidden flex-none">
            @if (hasProtocol)
            {
                <a href="@($"/api/workspace/{State.CurrentSessionId}/protocol.md")" target="_blank" class="bg-white text-[#003B5C] text-xs font-bold uppercase tracking-wider px-3 py-2 rounded shadow hover:bg-gray-100 transition-all" title="The review plan written before the search started">Protocol</a>
            }
            <a href="@($"/review?from={State.CurrentSessionId}")" class="bg-white text-[#003B5C] text-xs font-bold uppercase tracking-wider px-3 py-2 rounded shadow hover:bg-gray-100 transition-all" title="Open the dashboard with this run's question, criteria and options filled in">New review from these settings</a>
            <a href="@($"/api/workspace/{State.CurrentSessionId}/references.bib")" target="_blank" class="bg-white text-[#003B5C] text-xs font-bold uppercase tracking-wider px-3 py-2 rounded shadow hover:bg-gray-100 transition-all">BibTeX</a>
            <a href="@($"/api/workspace/{State.CurrentSessionId}/references.ris")" target="_blank" class="bg-white text-[#003B5C] text-xs font-bold uppercase tracking-wider px-3 py-2 rounded shadow hover:bg-gray-100 transition-all">RIS (Zotero / EndNote)</a>
            <button @onclick="TriggerZipArchiveDownload" class="bg-[#003B5C] text-white text-xs font-bold uppercase tracking-wider px-4 py-2 rounded shadow hover:bg-opacity-95 transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <span>Download Review Footprint (.ZIP)</span>
            </button>
            @if (!ReviewEngine.IsRunActive(State.CurrentSessionId))
            {
                @if (!confirmDelete)
                {
                    <button @onclick="() => confirmDelete = true" class="bg-white text-red-700 text-xs font-bold uppercase tracking-wider px-3 py-2 rounded shadow hover:bg-red-50 transition-all">Delete run</button>
                }
                else
                {
                    <span class="bg-red-50 text-red-800 text-xs px-3 py-2 rounded shadow flex items-center gap-2">
                        Delete this run and its files for good?
                        <button @onclick="DeleteRun" class="px-2 py-0.5 bg-red-600 text-white rounded font-bold">Delete</button>
                        <button @onclick="() => confirmDelete = false" class="px-2 py-0.5 border border-red-200 rounded">Cancel</button>
                    </span>
                }
            }
        </div>
    }

    @if (!HasReport)
    {
        <div class="bg-amber-50 border border-amber-200 text-amber-800 p-6 rounded-lg text-sm max-w-xl text-center shadow-lg my-12">
            <div class="font-bold mb-1">@(deleted ? "The run was deleted" : "No Generated PRISMA Report Available")</div>
            <p class="text-xs text-amber-700 font-light">
                @(deleted ? "Its ledger, report and downloaded papers have been removed from the server."
                          : "Go back to the Dashboard, run the agent, and the review appears here when the run is complete.")
            </p>
        </div>
    }
    else
    {
        @if (AttentionList is { Count: > 0 } attention)
        {
            <div class="sticky top-0 z-40 w-full max-w-[8.5in] mb-3 bg-white/95 backdrop-blur border border-amber-200 rounded shadow px-3 py-2 flex flex-wrap items-center justify-between gap-2 font-sans text-xs print:hidden">
                <span class="text-gray-800">
                    <span class="font-semibold text-amber-800">@attention.Count @(attention.Count == 1 ? "citation needs" : "citations need") your attention</span>
                    <span class="text-gray-500"> · @attention.Count(c => c.Verdict == AuBtechReviewAgent.CitationSupportChecker.NotSupported) not supported, @attention.Count(c => c.Verdict == AuBtechReviewAgent.CitationSupportChecker.Partial) partly supported</span>
                </span>
                <span class="flex items-center gap-2">
                    @if (attentionIndex >= 0)
                    {
                        <span class="text-gray-500 font-mono">@(attentionIndex + 1) / @attention.Count</span>
                    }
                    <button type="button" class="px-2 py-1 border border-gray-300 rounded hover:bg-gray-50" @onclick="() => StepAttention(-1)">Previous</button>
                    <button type="button" class="px-2 py-1 bg-[#003B5C] text-white rounded hover:bg-opacity-95" @onclick="() => StepAttention(1)">@(attentionIndex < 0 ? "Show the first" : "Next")</button>
                </span>
            </div>
        }
        <article class="w-full max-w-[8.5in] bg-white shadow-2xl p-6 md:p-[1in] text-gray-900 font-serif text-[11pt] leading-relaxed mx-auto border border-gray-300 print:shadow-none print:border-none print:p-0 overflow-visible">

            <div class="text-center space-y-3 mb-8 font-sans print:space-y-2">
                <div class="text-[9px] tracking-widest text-gray-500 uppercase font-bold">AI-Generated Systematic Literature Review</div>
                <h1 class="text-2xl font-bold tracking-tight font-serif text-gray-900 leading-tight">@ScrubAnchors(report.TitleItem)</h1>

                <div class="text-xs font-medium text-gray-600 font-sans">
                    Department of Business Development and Technology, Aarhus University
                </div>
                <div class="text-[10px] text-gray-400 font-mono">
                    Protocol Hash: @(string.IsNullOrWhiteSpace(report.ProtocolHash) ? "not recorded" : report.ProtocolHash) | Generated: @report.GeneratedAt
                </div>
                <hr class="border-gray-300 my-4" />
            </div>

            <div class="mb-6 font-sans text-xs bg-gray-50 border border-gray-200 p-4 rounded-sm text-justify">
                <span class="font-bold text-[#003B5C] block mb-1 uppercase tracking-wider text-[10px]">Abstract</span>
                <p class="text-gray-700 font-light leading-normal">@ScrubAnchors(report.AbstractItem)</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 text-justify text-xs leading-relaxed overflow-visible">

                <div class="space-y-3 md:col-span-2 border-b border-gray-200 pb-1">
                    <h2 class="font-sans font-bold text-sm text-[#003B5C] uppercase tracking-wide">1. Introduction</h2>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">1.1 Rationale (Item 3)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.RationaleItem)</p>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">1.2 Objectives (Item 4)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.ObjectivesItem)</p>
                </div>

                <div class="space-y-3 md:col-span-2 border-b border-gray-200 pt-2 pb-1">
                    <h2 class="font-sans font-bold text-sm text-[#003B5C] uppercase tracking-wide">2. Methodology</h2>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">2.1 Eligibility Criteria (Item 5)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.EligibilityItem)</p>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">2.2 Information Sources (Item 6)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.SourcesItem)</p>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">2.3 Search Execution (Item 7)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.SearchStrategyItem)</p>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">2.4 Selection Process (Item 8)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.SelectionProcessItem)</p>
                </div>

                <div class="space-y-1 md:col-span-2">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">2.5 Data Collection and Quality Appraisal (Items 9-11)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.BiasAssessmentItem)</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(report.SynthesisMethodsItem))
                {
                    <div class="space-y-1 md:col-span-2">
                        <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">2.6 Synthesis Methods (Item 13d)</span>
                        <p class="text-gray-800">@report.SynthesisMethodsItem</p>
                    </div>
                }

                <div class="space-y-3 md:col-span-2 border-b border-gray-200 pt-2 pb-1">
                    <h2 class="font-sans font-bold text-sm text-[#003B5C] uppercase tracking-wide">3. Data & Collection Metrics</h2>
                </div>

                <div class="md:col-span-2 space-y-2">
                    <p class="text-gray-800 text-xs">@DataParagraph()</p>

                    <p class="text-gray-800 text-xs pt-1">
                        @if (peerReviewOnlyToggle)
                        {
                            <span>The peer-review filter was on for this review: @passedPeerReviewCheck records passed the check and went to screening, while @failedPeerReviewCheck were excluded as un-reviewed preprints or working papers. </span>
                        }
                        else
                        {
                            <span>The peer-review filter was off, so preprints and other un-reviewed records could be included. </span>
                        }
                        <span>In total, @tableRecords.Count papers were included for data extraction.</span>
                    </p>
                </div>

                <div class="md:col-span-2 space-y-4 font-sans pt-2 overflow-visible">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2 border border-gray-200 p-3 bg-white rounded-sm">
                            <span class="text-[11px] font-bold text-gray-800 block border-b border-gray-100 pb-1">Figure 3.1: Included Publications per Year</span>
                            <div class="space-y-2 pt-1">
                                @{ int maxYear = Math.Max(1, publicationsByYear.Values.DefaultIfEmpty(0).Max()); }
                                @foreach (var kvp in publicationsByYear)
                                {
                                    <div class="flex items-center text-[11px]">
                                        <span class="w-10 font-mono text-gray-600 font-bold">@kvp.Key</span>
                                        <div class="flex-1 bg-gray-100 h-3.5 mx-2 border border-gray-200/60 overflow-hidden">
                                            <div class="bg-[#003B5C] h-full transition-all" style="width: @(kvp.Value * 100 / maxYear)%"></div>
                                        </div>
                                        <span class="w-4 font-mono text-right text-gray-900 font-bold">@kvp.Value</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="space-y-2 border border-gray-200 p-3 bg-white rounded-sm">
                            <span class="text-[11px] font-bold text-gray-800 block border-b border-gray-100 pb-1">Figure 3.2: Included Papers by Source</span>
                            <div class="space-y-2 pt-1">
                                @{ int maxPlatform = Math.Max(1, platformShares.Select(p => p.Count).DefaultIfEmpty(0).Max()); }
                                @foreach (var share in platformShares)
                                {
                                    <div class="flex items-center text-[11px] mb-1">
                                        <span class="w-24 truncate text-gray-600 font-medium" title="@share.Label">@share.Label</span>
                                        <div class="flex-1 bg-gray-100 h-3.5 mx-2 border border-gray-200/60 overflow-hidden">
                                            <div class="@share.Color h-full" style="width: @(share.Count * 100 / maxPlatform)%"></div>
                                        </div>
                                        <span class="w-4 font-mono text-right text-gray-900 font-bold">@share.Count</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2 border border-gray-200 p-3 bg-white rounded-sm">
                            <span class="text-[11px] font-bold text-gray-700 block border-b border-gray-100 pb-1">Figure 3.3: Distribution by Publishing Venue Type</span>
                            @{
                                int totalVenues = journalCount + conferenceCount + transactionsCount + proceedingsCount + preprintCount;
                                double jP = totalVenues > 0 ? ((double)journalCount / totalVenues) * 360 : 0;
                                double cP = totalVenues > 0 ? ((double)conferenceCount / totalVenues) * 360 : 0;
                                double tP = totalVenues > 0 ? ((double)transactionsCount / totalVenues) * 360 : 0;
                                double pP = totalVenues > 0 ? ((double)proceedingsCount / totalVenues) * 360 : 0;
                                string v1 = Deg(jP), v2 = Deg(jP + cP), v3 = Deg(jP + cP + tP), v4 = Deg(jP + cP + tP + pP);
                            }
                            <div class="flex items-center gap-6 py-2 px-1">
                                <div class="w-16 h-14 rounded-full border border-gray-300 shadow-sm flex-none"
                                     style="background: conic-gradient(#0284c7 0deg @(v1)deg, #4f46e5 @(v1)deg @(v2)deg, #0d9488 @(v2)deg @(v3)deg, #b45309 @(v3)deg @(v4)deg, #dc2626 @(v4)deg 360deg);">
                                </div>
                                <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-[10px] text-gray-600 font-mono">
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-sky-600 rounded-sm"></div> Journals (@journalCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-indigo-600 rounded-sm"></div> Conferences (@conferenceCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-teal-600 rounded-sm"></div> Transactions (@transactionsCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-amber-700 rounded-sm"></div> Proceedings (@proceedingsCount)</div>
                                    <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 bg-red-600 rounded-sm"></div> Preprints (@preprintCount)</div>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2 border border-gray-200 p-3 bg-white rounded-sm">
                            <span class="text-[11px] font-bold text-gray-700 block border-b border-gray-100 pb-1">Figure 3.4: Journal Quartile and Venue Tier</span>
                            <div class="flex items-end justify-between h-28 pt-2 border-b border-gray-300 px-2">
                                @foreach (var label in new[] { "Q1", "Q2", "Q3", "Q4", "Conf", "Preprint" })
                                {
                                    var inTier = tableRecords.Where(r => InTier(r, label)).ToList();
                                    int totalMax = Math.Max(1, tableRecords.Count);
                                    <div class="flex flex-col items-center w-10">
                                        <div class="w-5 bg-gray-100 border border-gray-300 overflow-hidden flex flex-col justify-end" style="height: @(inTier.Count * 90 / totalMax)px" title="@label: @inTier.Count">
                                            @foreach (var share in platformShares)
                                            {
                                                int n = inTier.Count(r => r.Category == share.Category);
                                                if (n > 0)
                                                {
                                                    <div class="@share.Color" style="height: @(n * 100 / Math.Max(1, inTier.Count))%"></div>
                                                }
                                            }
                                        </div>
                                        <span class="text-[9px] font-mono font-bold mt-1 text-gray-600">@label</span>
                                    </div>
                                }
                            </div>
                            <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[9px] font-mono mt-2 text-gray-500">
                                @foreach (var share in platformShares)
                                {
                                    <div class="flex items-center gap-1"><div class="w-2.5 h-2.5 @share.Color rounded-xs"></div> @share.Label (@share.Count)</div>
                                }
                            </div>
                            <p class="text-[9px] text-gray-400">Quartiles from SCImago Journal Rank (SJR), exact title match only.</p>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2 space-y-2 pt-4 font-sans max-w-full overflow-hidden">
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">Table 3.1: Included Studies</span>
                    <div class="border border-gray-200 bg-white rounded-sm overflow-x-auto">
                        <table class="w-full text-left border-collapse text-[10px] leading-relaxed table-fixed min-w-[700px]">
                            <thead>
                                <tr class="bg-gray-100 border-b border-gray-200 text-gray-700 font-bold font-mono text-[9px] uppercase sticky top-0 z-10">
                                    <th class="p-2 border-r border-gray-200 w-[5%]">Ref.</th>
                                    <th class="p-2 border-r border-gray-200 w-[17%]">Paper Name</th>
                                    <th class="p-2 border-r border-gray-200 w-[22%]">Executive Summary</th>
                                    <th class="p-2 border-r border-gray-200 w-[20%]">Inclusion Rationale</th>
                                    <th class="p-2 border-r border-gray-200 w-[12%] text-center">Source</th>
                                    <th class="p-2 w-[24%]">Citation (APA 7th)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-gray-700 font-sans">
                                @foreach (var paperRow in tableRecords)
                                {
                                    string badgeClass = platformShares.FirstOrDefault(p => p.Category == paperRow.Category)?.Badge ?? "text-gray-800 bg-gray-50";
                                    <tr class="hover:bg-gray-50/40" id="@($"ref-{paperRow.ReferenceNumber}")">
                                        <td class="p-2 font-mono text-[#003B5C] font-bold border-r border-gray-150 align-top">[@paperRow.ReferenceNumber]</td>
                                        <td class="p-2 font-semibold text-gray-900 border-r border-gray-150 align-top break-words">@paperRow.Title</td>
                                        <td class="p-2 text-gray-600 border-r border-gray-150 align-top font-light break-words">@paperRow.Summary</td>
                                        <td class="p-2 text-gray-600 border-r border-gray-150 align-top font-light text-[9.5px] break-words">@paperRow.InclusionRationale</td>
                                        <td class="p-2 border-r border-gray-150 align-top text-center font-mono font-medium text-[9.5px]">
                                            <span class="px-1.5 py-0.5 rounded-xs @badgeClass">@AuBtechReviewAgent.PrismaReviewEngine.CategoryLabel(paperRow.Category)</span>
                                        </td>
                                        <td class="p-2 font-mono text-[9px] text-gray-500 bg-gray-50/20 align-top leading-normal break-all">@paperRow.ApaCitation</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (extractions.Count > 0)
                {
                    <div class="md:col-span-2 space-y-2 pt-2 font-sans max-w-full overflow-hidden">
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">Table 3.2: Extracted Study Data</span>
                        <div class="border border-gray-200 bg-white rounded-sm overflow-x-auto">
                            <table class="w-full text-left border-collapse text-[10px] leading-relaxed table-fixed min-w-[700px]">
                                <thead>
                                    <tr class="bg-gray-100 border-b border-gray-200 text-gray-700 font-bold font-mono text-[9px] uppercase">
                                        <th class="p-2 border-r border-gray-200 w-[5%]">Ref.</th>
                                        <th class="p-2 border-r border-gray-200 w-[15%]">Study type</th>
                                        <th class="p-2 border-r border-gray-200 w-[20%]">Method</th>
                                        <th class="p-2 border-r border-gray-200 w-[15%]">Sample</th>
                                        <th class="p-2 w-[45%]">Key findings</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 text-gray-700">
                                    @foreach (var e in extractions)
                                    {
                                        <tr>
                                            <td class="p-2 font-mono text-[#003B5C] font-bold border-r border-gray-150 align-top">[@e.ReferenceNumber]</td>
                                            @if (e.Error != null)
                                            {
                                                <td colspan="4" class="p-2 text-red-700">Extraction failed for this study.</td>
                                            }
                                            else
                                            {
                                                <td class="p-2 border-r border-gray-150 align-top">@e.StudyType<span class="block text-[9px] text-gray-400">@e.EvidenceBasis</span></td>
                                                <td class="p-2 border-r border-gray-150 align-top">@Evidence(e.Method)</td>
                                                <td class="p-2 border-r border-gray-150 align-top">@Evidence(e.Sample)</td>
                                                <td class="p-2 align-top space-y-1">
                                                    @foreach (var f in e.KeyFindings)
                                                    {
                                                        <div>@Evidence(f)</div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="text-[10px] text-gray-500">Hover over a value to see the quote it was taken from. <span class="text-amber-700">†</span> The quote could not be found in the paper's text, so treat the value with caution.</p>
                    </div>

                    <div class="md:col-span-2 space-y-2 pt-2 font-sans max-w-full overflow-hidden">
                        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">Table 3.3: Quality Appraisal (MMAT 2018)</span>
                        @if (extractions.Any(AuBtechReviewAgent.MethodsSectionWriter.ShowInAppraisalTable))
                        {
                            <div class="border border-gray-200 bg-white rounded-sm overflow-x-auto">
                                <table class="w-full text-left border-collapse text-[10px] min-w-[560px]">
                                    <thead>
                                        <tr class="bg-gray-100 border-b border-gray-200 text-gray-700 font-bold font-mono text-[9px] uppercase">
                                            <th class="p-2 border-r border-gray-200">Ref.</th>
                                            <th class="p-2 border-r border-gray-200">Category</th>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <th class="p-2 border-r border-gray-200 text-center">@i</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 text-gray-700">
                                        @foreach (var e in extractions.Where(AuBtechReviewAgent.MethodsSectionWriter.ShowInAppraisalTable))
                                        {
                                            <tr>
                                                <td class="p-2 font-mono text-[#003B5C] font-bold border-r border-gray-150">[@e.ReferenceNumber]</td>
                                                <td class="p-2 border-r border-gray-150">@AppraisalCategory(e)</td>
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    var a = i < e.Appraisal.Count ? e.Appraisal[i] : null;
                                                    <td class="p-2 border-r border-gray-150 text-center font-mono @(a?.Answer switch { "yes" => "text-green-700", "no" => "text-red-700", _ => "text-gray-400" })"
                                                        title="@(a == null ? "" : $"{a.Id} {a.Criterion}{(string.IsNullOrEmpty(a.Quote) ? "" : $" — \"{a.Quote}\"")}")">
                                                        @(a?.Answer switch { "yes" => "Yes", "no" => "No", null => "–", _ => "?" })
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="text-[10px] text-gray-500">? = can't tell. Hover over an answer to see the criterion and the supporting quote. Appraised by the language model; check before use.</p>
                        }
                        @if (AuBtechReviewAgent.MethodsSectionWriter.NotAppraisedNote(extractions) is { Length: > 0 } notAppraised)
                        {
                            <p class="text-[10px] text-gray-500">@notAppraised</p>
                        }
                    </div>
                }

                <div class="space-y-3 md:col-span-2 border-b border-gray-200 pt-2 pb-1">
                    <h2 class="font-sans font-bold text-sm text-[#003B5C] uppercase tracking-wide">4. Results & Synthesis</h2>
                </div>

                <div class="space-y-1 md:col-span-2">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">4.1 Dataset Characteristics & Synthesis Outcomes (Item 20a)</span>
                    @if (auditChecks.Count > 0)
                    {
                        <p class="font-sans text-[10px] text-gray-400 print:hidden">Click a citation number to see what the automated check found in the cited paper.</p>
                    }
                    @CitedText("synthesisResultsItem", ScrubAnchors(report.SynthesisResultsItem))

                    @for (int k = 0; k < report.SynthesisSections.Count; k++)
                    {
                        var part = report.SynthesisSections[k];
                        <h3 class="font-sans font-bold text-[11px] text-[#003B5C] mt-4">4.@(k + 2) @part.Heading</h3>
                        @CitedText(part.Field, part.Text)
                    }

                    @if (codebook is { Themes.Count: > 0 })
                    {
                        <div class="mt-4 font-sans">
                            <span class="text-[10px] font-bold text-gray-500 uppercase block mb-1">Evidence map: studies by theme</span>
                            <div class="overflow-x-auto">
                                <table class="w-full text-[10px] border border-gray-200">
                                    <thead class="bg-gray-50 text-gray-600">
                                        <tr>
                                            <th class="text-left p-1.5 border-b border-gray-200">Theme</th>
                                            <th class="text-left p-1.5 border-b border-gray-200">Studies</th>
                                            <th class="text-left p-1.5 border-b border-gray-200">Cited in its subsection</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var theme in codebook.Themes)
                                        {
                                            var cov = codebook.Coverage.FirstOrDefault(c => c.ThemeId == theme.Id);
                                            <tr class="border-b border-gray-100 align-top">
                                                <td class="p-1.5"><span class="font-semibold">@theme.Name</span><br /><span class="text-gray-500">@theme.Description</span></td>
                                                <td class="p-1.5 font-mono">@string.Join(", ", theme.Studies.Select(r => $"[{r}]"))</td>
                                                <td class="p-1.5">@(cov == null ? "-" : $"{cov.CitedFinal.Count} of {cov.Studies.Count}")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (codebook.SecondCoding?.Kappa is double kappa)
                            {
                                <p class="text-[10px] text-gray-500 mt-1">Second, independent coding: Cohen's kappa = @kappa.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) over @codebook.SecondCoding.CellsCompared study-theme decisions.</p>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(report.CoverageSummary))
                    {
                        <p class="text-gray-600 text-[11px] italic border-l-2 border-[#003B5C] pl-2 mt-2">@report.CoverageSummary</p>
                    }

                    @if (report.Artifact is { } art)
                    {
                        <div class="mt-5 border border-gray-200 rounded p-3 space-y-2 font-sans">
                            <span class="text-[10px] font-bold text-gray-500 uppercase block">Artifact: @(string.IsNullOrWhiteSpace(art.Title) ? AuBtechReviewAgent.ArtifactKinds.All.FirstOrDefault(k => k.Key == art.Requested).Label : art.Title)</span>
                            @if (art.Error != null)
                            {
                                <p class="text-[11px] text-gray-600 italic">@art.Error</p>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(art.Caption))
                                {
                                    <p class="text-[11px] text-gray-600">@art.Caption</p>
                                }
                                @if (art.IsDiagram && !string.IsNullOrEmpty(mermaidDiagramCode))
                                {
                                    @* Filled by wwwroot/js/mermaid-render.js; Blazor leaves the empty element alone. *@
                                    <div id="mermaid-preview" class="w-full flex flex-col items-center justify-center text-center bg-gray-50 rounded p-3 overflow-x-auto"></div>
                                    @if (art.Nodes.Any(n => AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(n.Label).Count > 0))
                                    {
                                        <span class="text-[10px] font-bold text-gray-500 uppercase block pt-1">Cited boxes in the diagram</span>
                                        @for (int k = 0; k < art.Nodes.Count; k++)
                                        {
                                            if (AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(art.Nodes[k].Label).Count == 0) continue;
                                            @CitedText($"artifact-n{k + 1}", art.Nodes[k].Label)
                                        }
                                    }
                                }
                                else if (art.Kind == AuBtechReviewAgent.ArtifactKinds.Table)
                                {
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-[11px] border border-gray-200 align-top">
                                            <thead class="bg-gray-50 text-gray-600 text-left">
                                                <tr>@foreach (var col in art.Columns) { <th class="p-1.5 border-b border-gray-200">@col</th> }</tr>
                                            </thead>
                                            <tbody>
                                                @for (int r = 0; r < art.Rows.Count; r++)
                                                {
                                                    int row = r;
                                                    <tr class="border-t border-gray-100 align-top">
                                                        @for (int c = 0; c < art.Rows[row].Count; c++)
                                                        {
                                                            <td class="p-1.5">@CitedText($"artifact-r{row + 1}c{c + 1}", art.Rows[row][c])</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <ul class="list-disc pl-5 space-y-1">
                                        @for (int b = 0; b < art.Bullets.Count; b++)
                                        {
                                            <li>@CitedText($"artifact-b{b + 1}", art.Bullets[b])</li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(mermaidDiagramCode))
                    {
                        <div class="mt-4 border border-gray-200 p-4 rounded bg-gray-50 flex flex-col items-center justify-center font-sans print:hidden">
                            <span class="text-[9px] font-bold text-gray-400 block mb-3 uppercase tracking-widest">Diagram</span>
                            @* Older runs: the diagram the report draft wrote. *@
                            <div id="mermaid-preview" class="w-full flex flex-col items-center justify-center text-center"></div>
                        </div>
                    }
                </div>

                <div class="space-y-3 md:col-span-2 border-b border-gray-200 pt-2 pb-1">
                    <h2 class="font-sans font-bold text-sm text-[#003B5C] uppercase tracking-wide">5. Discussion</h2>
                </div>

                <div class="space-y-1 md:col-span-2">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">5.1 General Interpretation & Architectural Analysis (Item 23a)</span>
                    @CitedText("discussionItem", report.DiscussionItem)
                    @if (!string.IsNullOrWhiteSpace(report.CitationCheckSummary))
                    {
                        <p class="text-gray-600 text-[11px] italic border-l-2 border-[#003B5C] pl-2">@report.CitationCheckSummary</p>
                    }
                </div>

                <div class="space-y-3 md:col-span-2 border-b border-gray-200 pt-2 pb-1">
                    <h2 class="font-sans font-bold text-sm text-[#003B5C] uppercase tracking-wide">6. Administrative Declarations</h2>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">6.1 Registration and Protocol (Item 24)</span>
                    <p class="text-gray-800">
                        @(string.IsNullOrWhiteSpace(report.ProtocolItem) ? "No protocol was recorded for this run (it was made before protocols were written)." : report.ProtocolItem)
                        @if (hasProtocol)
                        {
                            <a class="text-[#003B5C] underline ml-1" href="@($"/api/workspace/{State.CurrentSessionId}/protocol.md")" target="_blank">Open protocol.md</a>
                        }
                    </p>
                </div>

                <div class="space-y-1">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">6.2 Support & Funding (Item 25)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.SupportItem)</p>
                </div>

                <div class="space-y-1 md:col-span-2">
                    <span class="font-sans font-bold text-[10px] text-gray-500 uppercase block">6.3 Availability of Data and Code (Item 27)</span>
                    <p class="text-gray-800">@ScrubAnchors(report.AvailabilityItem)</p>
                </div>

            </div>

            <div class="mt-8 pt-4 border-t border-gray-200 text-left overflow-visible">
                <h2 class="font-sans font-bold text-sm text-[#003B5C] uppercase tracking-wide mb-3">References</h2>
                @if (includedCitations.Count == 0)
                {
                    <p class="text-xs italic text-gray-400 font-sans">No sources were included in this run.</p>
                }
                else
                {
                    <ol class="space-y-2 text-xs font-sans text-gray-800">
                        @for (int i = 0; i < includedCitations.Count; i++)
                        {
                            <li class="pl-2 leading-relaxed">
                                <span class="font-mono font-bold text-[#003B5C] mr-1">[@(i + 1)]</span> - @includedCitations[i]
                            </li>
                        }
                    </ol>
                }
            </div>

            <div class="mt-12 pt-4 border-t border-gray-200 text-center font-sans text-[9px] text-gray-400 uppercase tracking-widest">
                OSSYM 2026 - 8th International Open Search Symposium
            </div>

        </article>
    }
</div>

@code {
    [Inject] private UiStateContainer State { get; set; } = default!;

    /// <summary>Set when the page is opened as /spec-matrix/{RunId}, so a report can be reopened from a link.</summary>
    [Parameter] public Guid? RunId { get; set; }

    private PrismaReport report = new PrismaReport();
    private List<string> includedCitations = new();
    private Dictionary<string, int> publicationsByYear = new();
    private List<IncludedPaperMetricRow> tableRecords = new();
    private List<AuBtechReviewAgent.StudyExtraction> extractions = new();
    private List<AuBtechReviewAgent.CitationSupportResult> auditChecks = new();
    private AuBtechReviewAgent.ThematicCodebook? codebook;
    private int journalCount, conferenceCount, transactionsCount, proceedingsCount, preprintCount;

    private sealed record PlatformShare(string Category, string Label, int Count, string Color, string Badge);
    private List<PlatformShare> platformShares = new();

    // Literal class names so the Tailwind build finds them.
    private static readonly string[] BarColors = { "bg-teal-500", "bg-orange-500", "bg-blue-400", "bg-yellow-400", "bg-purple-400", "bg-rose-400", "bg-lime-500", "bg-gray-400" };
    private static readonly string[] BadgeColors = { "text-teal-800 bg-teal-50", "text-orange-800 bg-orange-50", "text-blue-800 bg-blue-50", "text-yellow-800 bg-yellow-50", "text-purple-800 bg-purple-50", "text-rose-800 bg-rose-50", "text-lime-800 bg-lime-50", "text-gray-800 bg-gray-50" };

    private bool peerReviewOnlyToggle;
    private int passedPeerReviewCheck;
    private int failedPeerReviewCheck;
    private bool hasProtocol;
    private bool confirmDelete;
    private bool deleted;

    private string mermaidDiagramCode = "";

    // The citation marker the reader clicked: (field, sentence index, reference number).
    private (string Field, int Sentence, int Reference)? openCitation;

    private bool HasReport => !deleted && report != null && !string.IsNullOrEmpty(report.TitleItem) && report.TitleItem != "Pending...";

    private void TriggerZipArchiveDownload()
    {
        // Full browser navigation to a real HTTP download endpoint - not JS interop pushing a base64
        // payload over the SignalR connection, which silently fails once real source PDFs are included
        // because that connection has a small default max message size.
        Nav.NavigateTo($"/api/workspace/{State.CurrentSessionId}/archive", forceLoad: true);
    }

    private void DeleteRun()
    {
        confirmDelete = false;
        if (ReviewEngine.DeleteRun(State.CurrentSessionId))
        {
            deleted = true;
            State.CurrentSessionId = Guid.Empty;
            report = new PrismaReport();
        }
    }

    private static string ScrubAnchors(string rawText)
    {
        if (string.IsNullOrWhiteSpace(rawText)) return "";
        string clean = Regex.Replace(rawText, @"\[MERMAID_START\].*?\[MERMAID_END\]", "", RegexOptions.Singleline);
        clean = Regex.Replace(clean, @"\[TIKZ_START\].*?\[TIKZ_END\]", "", RegexOptions.Singleline);
        clean = Regex.Replace(clean, @"\[Source Context Anchor \d+.*?\]", "").Trim();
        return AuBtechReviewAgent.MethodsSectionWriter.StripMarkdownEmphasis(clean);
    }

    private static string Deg(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static bool InTier(IncludedPaperMetricRow r, string label) => label switch
    {
        "Conf" => r.VenueType is "Conferences" or "Proceedings",
        "Preprint" => r.VenueType is "Preprints" or "Other",
        _ => (r.Quartile ?? "").Equals(label, StringComparison.OrdinalIgnoreCase),
    };

    private static string AppraisalCategory(AuBtechReviewAgent.StudyExtraction e) =>
        e.Error != null ? "not appraised" :
        e.AppraisalCategory == "not_empirical" ? "not empirical (MMAT does not apply)" :
        e.AppraisalCategory.Replace('_', ' ');

    /// <summary>A one-paragraph description of the included set, built only from the run's own data.</summary>
    private string DataParagraph() => AuBtechReviewAgent.MethodsSectionWriter.IncludedSet(tableRecords);

    /// <summary>The value with its quote as a tooltip; a dagger when the quote was not found in the paper.</summary>
    private RenderFragment Evidence(AuBtechReviewAgent.EvidencedValue v) => __builder =>
    {
        bool notReported = v.Value.Equals("not reported", StringComparison.OrdinalIgnoreCase);
        <span class="@(notReported ? "text-gray-400 italic" : "")" title="@(string.IsNullOrEmpty(v.Quote) ? "" : $"\"{v.Quote}\"")">@v.Value</span>
        @if (!notReported && !v.QuoteVerified)
        {
            <span class="text-amber-700" title="The supporting quote was not found in the paper's text">†</span>
        }
    };

    /// <summary>
    /// Renders text with every [n] as a button. Clicking it opens the citation check's verdict, quote and
    /// location for that sentence and reference. Sentences are split exactly as the check split them.
    /// </summary>
    private RenderFragment CitedText(string field, string text) => __builder =>
    {
        var sentences = AuBtechReviewAgent.CitationSupportChecker.SplitSentences(text);
        int scan = 0;
        <p class="text-gray-800">
            @for (int i = 0; i < sentences.Count; i++)
            {
                int sentenceIndex = i;
                // Keep the model's paragraph breaks: they sit in the whitespace between two sentences.
                int at = (text ?? "").IndexOf(sentences[i], scan, StringComparison.Ordinal);
                if (at > scan && text!.Substring(scan, at - scan).Contains("\n\n"))
                {
                    <br /><br />
                }
                if (at >= 0) scan = at + sentences[i].Length;
                foreach (var (part, isMarker) in AuBtechReviewAgent.CitationSupportChecker.SplitMarkers(sentences[i]))
                {
                    if (!isMarker || auditChecks.Count == 0)
                    {
                        var pieces = AuBtechReviewAgent.MethodsSectionWriter.StripMarkdownEmphasis(part).Split("\n\n");
                        for (int k = 0; k < pieces.Length; k++)
                        {
                            if (k > 0)
                            {
                                <br /><br />
                            }
                            @pieces[k]
                        }
                        continue;
                    }
                    <span>[</span>
                    var refs = AuBtechReviewAgent.CitationSupportChecker.ReferencesIn(part);
                    for (int r = 0; r < refs.Count; r++)
                    {
                        int reference = refs[r];
                        var check = FindCheck(field, sentenceIndex, reference);
                        bool isOpen = openCitation == (field, sentenceIndex, reference);
                        <button type="button" id="@CiteId(field, sentenceIndex, reference)" class="font-mono underline decoration-dotted @VerdictText(check?.Verdict) @(isOpen ? "bg-yellow-100" : "")"
                                title="@(check == null ? "Not checked" : VerdictLabel(check.Verdict))"
                                @onclick="() => ToggleCitation(field, sentenceIndex, reference)">@reference</button>
                        @(r < refs.Count - 1 ? ", " : "")
                    }
                    <span>]</span>
                }
                @(" ")
            }
        </p>
        @if (openCitation is { } open && open.Field == field)
        {
            var check = FindCheck(open.Field, open.Sentence, open.Reference);
            var paper = tableRecords.FirstOrDefault(t => t.ReferenceNumber == open.Reference);
            <div class="font-sans text-[11px] border border-gray-200 bg-gray-50 rounded p-3 mt-2 space-y-1 print:hidden">
                <div class="flex justify-between gap-2">
                    <span class="font-bold text-[#003B5C]">[@open.Reference] @(paper?.Title ?? "Unknown reference")</span>
                    <button type="button" class="text-gray-400 hover:text-gray-700" @onclick="() => openCitation = null">Close</button>
                </div>
                @if (check == null)
                {
                    <p class="text-gray-600">This citation was not part of the automated check.</p>
                }
                else
                {
                    <p><span class="font-semibold @VerdictText(check.Verdict)">@VerdictLabel(check.Verdict)</span> <span class="text-gray-500">(checked against the @check.EvidenceBasis@(string.IsNullOrEmpty(check.EvidenceLocation) ? "" : $", {check.EvidenceLocation}"))</span></p>
                    @if (!string.IsNullOrWhiteSpace(check.AttributedText))
                    {
                        <p class="text-gray-600">Checked part of the sentence: <span class="italic">"@check.AttributedText"</span></p>
                    }
                    @if (!string.IsNullOrWhiteSpace(check.Quote))
                    {
                        <blockquote class="border-l-2 border-gray-300 pl-2 italic text-gray-700">"@check.Quote"</blockquote>
                        <p class="text-[10px] @(check.QuoteVerified ? "text-green-700" : "text-amber-700")">
                            @(check.QuoteVerified ? "The quote was found in the paper's text." : "The quote could not be found in the paper's text.")
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(check.Reason))
                    {
                        <p class="text-gray-600">@check.Reason</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(check.ThemeNote))
                    {
                        <p class="text-amber-700">@check.ThemeNote</p>
                    }
                    @if (check.SecondVerdict != null)
                    {
                        <p class="text-gray-500 text-[10px]">
                            First check: @VerdictLabel(check.FirstVerdict). Second, independent check with more of the paper: @VerdictLabel(check.SecondVerdict).
                            @(check.ResolvedBy == "second check" ? " The second check found a verbatim quote, so its verdict is shown." : "")
                        </p>
                    }
                }
            </div>
        }
    };

    private AuBtechReviewAgent.CitationSupportResult? FindCheck(string field, int sentence, int reference) =>
        auditChecks.FirstOrDefault(c => c.Field == field && c.SentenceIndex == sentence && c.Reference == reference);

    private static string CiteId(string field, int sentence, int reference) => $"cite-{field}-{sentence}-{reference}";

    // Citations that need a reader's attention (partly or not supported), in the order they appear in the report.
    private List<AuBtechReviewAgent.CitationSupportResult> AttentionList => auditChecks
        .Where(c => c.Verdict is AuBtechReviewAgent.CitationSupportChecker.Partial or AuBtechReviewAgent.CitationSupportChecker.NotSupported)
        .OrderBy(c => FieldRank(c.Field)).ThenBy(c => c.SentenceIndex).ThenBy(c => c.Reference).ToList();
    private int attentionIndex = -1;

    private int FieldRank(string field)
    {
        if (field == "synthesisResultsItem") return 0;
        int section = report.SynthesisSections.FindIndex(s => s.Field == field);
        if (section >= 0) return 1 + section;
        if (field.StartsWith("artifact-", StringComparison.Ordinal)) return 1000;
        return field == "discussionItem" ? 2000 : 3000;
    }

    private async Task StepAttention(int delta)
    {
        var list = AttentionList;
        if (list.Count == 0) return;
        attentionIndex = ((attentionIndex < 0 && delta < 0 ? 0 : attentionIndex) + delta + list.Count) % list.Count;
        var c = list[attentionIndex];
        openCitation = (c.Field, c.SentenceIndex, c.Reference);
        StateHasChanged();
        try { await JS.InvokeAsync<bool>("traceableReview.scrollTo", CiteId(c.Field, c.SentenceIndex, c.Reference)); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private void ToggleCitation(string field, int sentence, int reference) =>
        openCitation = openCitation == (field, sentence, reference) ? null : (field, sentence, reference);

    private static string VerdictLabel(string? verdict) => verdict switch
    {
        AuBtechReviewAgent.CitationSupportChecker.Supported => "Supported",
        AuBtechReviewAgent.CitationSupportChecker.Partial => "Partly supported",
        AuBtechReviewAgent.CitationSupportChecker.NotSupported => "Not supported",
        AuBtechReviewAgent.CitationSupportChecker.Unverifiable => "Could not be verified",
        AuBtechReviewAgent.CitationSupportChecker.InsufficientEvidence => "Not enough text to check (abstract only)",
        _ => "Not checked",
    };

    private static string VerdictText(string? verdict) => verdict switch
    {
        AuBtechReviewAgent.CitationSupportChecker.Supported => "text-green-700",
        AuBtechReviewAgent.CitationSupportChecker.Partial => "text-amber-700",
        AuBtechReviewAgent.CitationSupportChecker.NotSupported => "text-red-700",
        AuBtechReviewAgent.CitationSupportChecker.InsufficientEvidence => "text-sky-700",
        _ => "text-gray-500",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(mermaidDiagramCode))
        {
            try
            {
                await JS.InvokeAsync<bool>("traceableMermaid.render", "mermaid-preview", mermaidDiagramCode);
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RunId is Guid id && id != Guid.Empty) State.CurrentSessionId = id;

        report = new PrismaReport();
        includedCitations = new();
        tableRecords = new();
        extractions = new();
        auditChecks = new();
        codebook = null;
        publicationsByYear = new();
        platformShares = new();
        journalCount = conferenceCount = transactionsCount = proceedingsCount = preprintCount = 0;
        peerReviewOnlyToggle = false;
        passedPeerReviewCheck = failedPeerReviewCheck = 0;
        mermaidDiagramCode = "";
        openCitation = null;
        deleted = false;

        string folder = Path.Join(ReviewEngine.WorkspaceRoot, State.CurrentSessionId.ToString("N"));
        string reportPath = Path.Join(folder, "prisma-report.json");
        hasProtocol = File.Exists(Path.Join(folder, "protocol.md"));

        if (File.Exists(reportPath))
        {
            try
            {
                string content = await File.ReadAllTextAsync(reportPath);
                report = JsonSerializer.Deserialize<PrismaReport>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new PrismaReport();
            }
            catch { report = new PrismaReport(); }
        }

        string auditPath = Path.Join(folder, "citation-audit.json");
        if (File.Exists(auditPath))
        {
            try
            {
                using var doc = JsonDocument.Parse(await File.ReadAllTextAsync(auditPath));
                if (doc.RootElement.TryGetProperty("SupportChecks", out var checks))
                    auditChecks = JsonSerializer.Deserialize<List<AuBtechReviewAgent.CitationSupportResult>>(checks.GetRawText()) ?? new();
            }
            catch { auditChecks = new(); }
        }

        var state = ReviewEngine.LoadState(State.CurrentSessionId);
        if (state == null) return;

        peerReviewOnlyToggle = state.PeerReviewOnlyToggle;
        passedPeerReviewCheck = state.Stats.PassedPeerReviewCheck;
        failedPeerReviewCheck = state.Stats.FailedPeerReviewCheck;
        extractions = state.Extractions ?? new();
        codebook = state.ThematicSynthesis;

        // Older runs have ReferenceNumber = 0 everywhere; OrderBy is stable, so they keep their order.
        tableRecords = state.SynthesizedRecords.OrderBy(r => r.ReferenceNumber).ToList();
        includedCitations = tableRecords.Select(r => r.ApaCitation.Trim().TrimEnd('.')).ToList();

        platformShares = tableRecords
            .GroupBy(r => string.IsNullOrWhiteSpace(r.Category) ? "Other" : r.Category)
            .OrderByDescending(g => g.Count()).ThenBy(g => g.Key, StringComparer.Ordinal)
            .Select((g, i) => new PlatformShare(g.Key, AuBtechReviewAgent.PrismaReviewEngine.CategoryLabel(g.Key), g.Count(),
                BarColors[i % BarColors.Length], BadgeColors[i % BadgeColors.Length]))
            .ToList();

        publicationsByYear = tableRecords
            .GroupBy(r => r.Year > 0 ? r.Year.ToString() : "n.d.")
            .OrderBy(g => g.Key == "n.d." ? "9999" : g.Key, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.Count());

        journalCount = tableRecords.Count(r => r.VenueType == "Journals");
        transactionsCount = tableRecords.Count(r => r.VenueType == "Transactions");
        conferenceCount = tableRecords.Count(r => r.VenueType == "Conferences");
        proceedingsCount = tableRecords.Count(r => r.VenueType == "Proceedings");
        preprintCount = tableRecords.Count - journalCount - transactionsCount - conferenceCount - proceedingsCount;

        if (report.Artifact is { IsDiagram: true, Error: null } artifactDiagram)
        {
            mermaidDiagramCode = artifactDiagram.Mermaid;
        }
        else if (!string.IsNullOrEmpty(report.SynthesisResultsItem))
        {
            var mermaidMatch = Regex.Match(report.SynthesisResultsItem, @"\[MERMAID_START\](.*?)\[MERMAID_END\]", RegexOptions.Singleline);
            // Older runs stored the model's diagram unrepaired; clean it here as well.
            if (mermaidMatch.Success) mermaidDiagramCode = AuBtechReviewAgent.MermaidSanitizer.Sanitize(mermaidMatch.Groups[1].Value.Trim());
        }
    }
}
