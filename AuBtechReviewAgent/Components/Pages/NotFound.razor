@page "/not-found"
@layout MainLayout

<SeoHead Title="Page not found" NoIndex="true" />

<SiteHeader />

<main id="main" tabindex="-1" class="flex-1 min-h-0 overflow-y-auto bg-white">
    <div class="ui-container py-20 max-w-2xl">
        <p class="ui-eyebrow">Page not found</p>
        <h1 class="ui-h1 mt-3">This page does not exist.</h1>
        <p class="ui-lead mt-4">The link may be mistyped, or it pointed to a review that has been deleted. Reviews are kept for a few days after they finish.</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/" class="ui-btn-primary">Go to the start page</a>
            <a href="/review" class="ui-btn-secondary">Start a review</a>
        </div>
    </div>
</main>
