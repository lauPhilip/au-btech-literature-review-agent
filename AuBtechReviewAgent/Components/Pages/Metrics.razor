@page "/metrics"
@layout AppLayout
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AuBtechReviewAgent.RunMetricsStore Store
@inject AuBtechReviewAgent.RunQuotaService Quota
@inject ProtectedSessionStorage SessionStorage
@inject ILogger<Metrics> Logger
@inject AuBtechReviewAgent.ReviewModulesOptions ModuleOptions

@if (!Sample)
{
    <SeoHead Title="How well the citations hold up" Path="/metrics" BreadcrumbName="Metrics" ExtraJsonLd="@(baseUrl => AuBtechReviewAgent.SiteSeo.DatasetJsonLd(baseUrl, Store.ReadAll().Count))" Description="How well TraceableAI's citations hold up, run by run: the share of supported, partly supported and unsupported citations in every completed review, with the run data and the figures by app version and settings." />
}

<div class="mx-auto w-full max-w-[1600px] space-y-8 px-[clamp(16px,3vw,40px)] py-6 sm:py-10">
    <header class="max-w-[760px]">
        <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">Metrics</p>
        <h1 class="mt-2 font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">How well the citations hold up</h1>
        <p class="mt-3 text-base leading-relaxed text-muted">
            Every completed review stores its quality figures here, worked out in code from the run's own files. The store holds no research question and
            no paper text, and it outlives the run folders. Runs are grouped by app version and settings, so you can see whether a change made the
            citations better. Each kind of review has its own figures, because the same number means different things in each.
        </p>
    </header>

    @if (ShowGrey)
    {
        <nav aria-label="Kind of review" class="flex gap-1 border-b border-line">
            @foreach (var (key, label) in Kinds)
            {
                bool active = key == Kind;
                <a href="@(key == "systematic" ? "/metrics" : $"/metrics?kind={key}")" aria-current="@(active ? "page" : null)"
                   class="-mb-px flex min-h-[44px] items-center border-b-2 px-3 text-sm @(active ? "border-heading font-semibold text-heading" : "border-transparent text-muted hover:text-heading")">@label</a>
            }
        </nav>
    }

    <p class="max-w-[760px] text-[15px] leading-relaxed text-muted">
        @if (Grey)
        {
            <span>Grey literature reviews: every citation is checked against the text of the cited web page as it was kept when it was read. A citation that could not be judged from the kept text is counted on its own, and so is one that could not be verified, because the page's kept text was missing or had changed, or the quote was not found in it.</span>
        }
        else
        {
            <span>Systematic reviews: every citation is checked against the cited paper. A citation of a paper with only its abstract to go on is counted as abstract only, and one whose check could not be done is counted as could not be verified.</span>
        }
    </p>

    @if (!loaded)
    {
        <p class="text-sm text-muted">Loading…</p>
    }
    else if (overview.Runs.Count == 0)
    {
        <div class="ui-card max-w-[760px] p-6">
            <p class="text-base text-ink">No completed @(Grey ? "grey literature reviews" : "systematic reviews") have been recorded yet. The figures are written at the end of every completed run.</p>
        </div>
    }
    else
    {
        var pooled = overview.Pooled;
        <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            @Figure(AuBtechReviewAgent.MetricsOverview.Percent(pooled.SupportedShare), "of citations supported")
            @Figure(AuBtechReviewAgent.MetricsOverview.Percent(overview.CoverageShare), Grey ? "of kept sources cited" : "of included studies cited")
            @Figure(pooled.Total.ToString("N0", Culture), "citations checked")
            @Figure(overview.Runs.Count.ToString(Culture), overview.Runs.Count == 1 ? "completed review" : "completed reviews")
        </dl>

        <nav aria-label="On this page">
            <ul class="flex flex-wrap items-center gap-x-1 text-sm">
                @foreach (var (id, label) in Sections)
                {
                    var sectionId = id;
                    <li class="flex items-center">
                        @if (sectionId != Sections[0].Id)
                        {
                            <span class="px-1 text-muted" aria-hidden="true">·</span>
                        }
                        <a href="@($"{PageHref}#{sectionId}")" data-jump-to="@sectionId" class="inline-flex min-h-[44px] items-center px-1 text-heading underline decoration-line-field underline-offset-4 hover:decoration-heading">@label</a>
                    </li>
                }
            </ul>
        </nav>

        <section id="chart" aria-labelledby="chart-title" class="ui-card scroll-mt-6 p-5 sm:p-6">
            <h2 id="chart-title" class="font-display text-xl font-semibold tracking-tight text-heading">Citation verdicts per run</h2>
            <p class="mt-1 max-w-[70ch] text-[15px] text-muted">The share of each final verdict in every run, oldest on the left. Point at a bar for its date, version and counts.</p>
            <div class="mt-4"><RunVerdictChart Runs="overview.Runs" Grey="Grey" /></div>
        </section>

        <section id="shares" aria-labelledby="shares-title" class="ui-card scroll-mt-6 p-5 sm:p-6">
            <h2 id="shares-title" class="font-display text-xl font-semibold tracking-tight text-heading">Verdict shares per run</h2>
            <p class="mt-1 max-w-[70ch] text-[15px] text-muted">The chart's figures as a table, newest run first. The total pools every citation of every run. Removed counts the citations the repair took out; they are not in the shares.</p>
            <div class="mt-4 max-h-[70vh] overflow-auto border border-line" tabindex="0" role="region" aria-labelledby="shares-title">
                <table class="w-full border-separate border-spacing-0 text-sm">
                    <thead>
                        <tr>
                            @Th("Run") @Th("Completed (UTC)") @Th("Version") @Th("Citations", true)
                            @ThSwatch("Supported", "bg-supported-chart") @ThSwatch("Partly", "bg-partly-chart") @ThSwatch("Not supported", "bg-not-supported-chart")
                            @ThSwatch(Grey ? "Not judged" : "Abstract only", "bg-abstract-only-chart") @ThSwatch("Not verified", "bg-unverifiable-chart") @ThSwatch("Removed", "bg-heading")
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Newest)
                        {
                            var r = run;
                            var c = r.CitationsFinal;
                            <tr class="hover:bg-soft">
                                @RunCell(r)
                                <td class="@Td font-mono">@AuBtechReviewAgent.MetricsOverview.Completed(r.CompletedUtc)</td>
                                <td class="@Td font-mono">@r.ShortVersion</td>
                                <td class="@TdNum">@c.Total</td>
                                <td class="@TdNum">@Pct(c.SupportedShare)</td>
                                <td class="@TdNum">@Pct(c.PartialShare)</td>
                                <td class="@TdNum">@Pct(c.NotSupportedShare)</td>
                                <td class="@TdNum">@Pct(c.InsufficientShare)</td>
                                <td class="@TdNum">@Pct(c.UnverifiableShare)</td>
                                <td class="@TdNum">@r.Removed</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-soft font-semibold">
                            <th scope="row" class="@Td text-left" colspan="3">All @overview.Runs.Count runs</th>
                            <td class="@TdNum">@pooled.Total</td>
                            <td class="@TdNum">@Pct(pooled.SupportedShare)</td>
                            <td class="@TdNum">@Pct(pooled.PartialShare)</td>
                            <td class="@TdNum">@Pct(pooled.NotSupportedShare)</td>
                            <td class="@TdNum">@Pct(pooled.InsufficientShare)</td>
                            <td class="@TdNum">@Pct(pooled.UnverifiableShare)</td>
                            <td class="@TdNum">@overview.Removed</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <section id="run-data" aria-labelledby="run-data-title" class="ui-card scroll-mt-6 p-5 sm:p-6">
            <h2 id="run-data-title" class="font-display text-xl font-semibold tracking-tight text-heading">Run data</h2>
            <p class="mt-1 max-w-[70ch] text-[15px] text-muted">
                The counts from each run's run-metrics.json, newest first. @(Grey ? "Found is the sources the searches found; kept is those left after the quality check." : "Found is the records the searches found; included is the studies that passed both screenings.")
                Repaired is the citations the repair pass rewrote, and removed those it took out; words count the written results and discussion.
            </p>
            <div class="mt-4 max-h-[70vh] overflow-auto border border-line" tabindex="0" role="region" aria-labelledby="run-data-title">
                <table class="w-full border-separate border-spacing-0 text-sm">
                    <thead>
                        <tr>
                            @Th("Run") @Th("Version") @Th("Found", true) @Th(Grey ? "Kept" : "Included", true) @Th("Cited", true) @Th("Themes", true) @Th("Citations", true)
                            @Th("Supported", true) @Th("Partly", true) @Th("Not supported", true) @Th(Grey ? "Not judged" : "Abstract only", true) @Th("Not verified", true)
                            @Th("Repaired", true) @Th("Removed", true) @Th("Words", true)
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Newest)
                        {
                            var r = run;
                            var c = r.CitationsFinal;
                            <tr class="hover:bg-soft">
                                @RunCell(r)
                                <td class="@Td font-mono">@r.ShortVersion</td>
                                <td class="@TdNum">@r.Identified</td>
                                <td class="@TdNum">@r.Included</td>
                                <td class="@TdNum">@r.StudiesCited</td>
                                <td class="@TdNum" title="@(r.ThematicSynthesisUsed ? null : "The thematic synthesis fell back to one section")">@(r.ThematicSynthesisUsed ? r.Themes.ToString(Culture) : "–")</td>
                                <td class="@TdNum">@c.Total</td>
                                <td class="@TdNum">@c.Supported</td>
                                <td class="@TdNum">@c.PartiallySupported</td>
                                <td class="@TdNum">@c.NotSupported</td>
                                <td class="@TdNum">@c.InsufficientEvidence</td>
                                <td class="@TdNum">@c.Unverifiable</td>
                                <td class="@TdNum">@r.Repaired</td>
                                <td class="@TdNum">@r.Removed</td>
                                <td class="@TdNum">@AuBtechReviewAgent.MetricsOverview.Words(r).ToString("N0", Culture)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-soft font-semibold">
                            <th scope="row" class="@Td text-left" colspan="2">All @overview.Runs.Count runs</th>
                            <td class="@TdNum">@overview.Runs.Sum(r => r.Identified).ToString("N0", Culture)</td>
                            <td class="@TdNum">@overview.Included.ToString("N0", Culture)</td>
                            <td class="@TdNum">@overview.StudiesCited.ToString("N0", Culture)</td>
                            <td class="@TdNum">@overview.Runs.Where(r => r.ThematicSynthesisUsed).Sum(r => r.Themes)</td>
                            <td class="@TdNum">@pooled.Total.ToString("N0", Culture)</td>
                            <td class="@TdNum">@pooled.Supported.ToString("N0", Culture)</td>
                            <td class="@TdNum">@pooled.PartiallySupported.ToString("N0", Culture)</td>
                            <td class="@TdNum">@pooled.NotSupported.ToString("N0", Culture)</td>
                            <td class="@TdNum">@pooled.InsufficientEvidence.ToString("N0", Culture)</td>
                            <td class="@TdNum">@pooled.Unverifiable.ToString("N0", Culture)</td>
                            <td class="@TdNum">@overview.Runs.Sum(r => r.Repaired).ToString("N0", Culture)</td>
                            <td class="@TdNum">@overview.Removed.ToString("N0", Culture)</td>
                            <td class="@TdNum">@overview.Runs.Sum(r => AuBtechReviewAgent.MetricsOverview.Words(r)).ToString("N0", Culture)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <MetricsPools Runs="overview.Runs" />
        <MetricsEffort Runs="overview.Runs" Prices="Store.Prices" />

        <section id="by-version" aria-labelledby="by-version-title" class="ui-card scroll-mt-6 p-5 sm:p-6">
            <h2 id="by-version-title" class="font-display text-xl font-semibold tracking-tight text-heading">By app version and settings</h2>
            <p class="mt-1 max-w-[70ch] text-[15px] text-muted">
                Runs made with the same version and settings, the group with the latest run first. Verdict shares are pooled over every citation in a group.
                Point at a settings code to see the settings. The screening kappa is the mean agreement of the two screenings.
                @(Store.Prices.Enabled ? "Cost per run is the mean estimated cost of the runs that have one, at today's prices." : "")
            </p>
            <div class="mt-4 max-h-[70vh] overflow-auto border border-line" tabindex="0" role="region" aria-labelledby="by-version-title">
                <table class="w-full border-separate border-spacing-0 text-sm">
                    <thead>
                        <tr>
                            @Th("Version") @Th("Settings") @Th("Runs", true) @Th("Supported", true) @Th("Partly", true) @Th("Not supported", true)
                            @Th("Removed", true) @Th("Screening κ", true) @Th("Min / run", true) @if (Store.Prices.Enabled) { @Th("Cost / run", true) }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in overview.Groups)
                        {
                            var g = group;
                            <tr class="hover:bg-soft">
                                <th scope="row" class="@Td text-left font-mono font-normal">@g.Version</th>
                                <td class="@Td font-mono" title="@g.SettingsText">@g.Fingerprint</td>
                                <td class="@TdNum">@g.Runs</td>
                                <td class="@TdNum">@Pct(g.Final.SupportedShare)</td>
                                <td class="@TdNum">@Pct(g.Final.PartialShare)</td>
                                <td class="@TdNum">@Pct(g.Final.NotSupportedShare)</td>
                                <td class="@TdNum">@g.Removed</td>
                                <td class="@TdNum">@AuBtechReviewAgent.MetricsOverview.Kappa(g.ScreeningKappa)</td>
                                <td class="@TdNum">@g.MinutesPerRun.ToString("0.0", Culture)</td>
                                @if (Store.Prices.Enabled) { <td class="@TdNum">@Cost(Store.Prices.MeanCost(g.Members))</td> }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-soft font-semibold">
                            <th scope="row" class="@Td text-left" colspan="2">All versions</th>
                            <td class="@TdNum">@overview.Runs.Count</td>
                            <td class="@TdNum">@Pct(pooled.SupportedShare)</td>
                            <td class="@TdNum">@Pct(pooled.PartialShare)</td>
                            <td class="@TdNum">@Pct(pooled.NotSupportedShare)</td>
                            <td class="@TdNum">@overview.Removed</td>
                            <td class="@TdNum">@AuBtechReviewAgent.MetricsOverview.Kappa(overview.ScreeningKappa)</td>
                            <td class="@TdNum">@overview.MinutesPerRun.ToString("0.0", Culture)</td>
                            @if (Store.Prices.Enabled) { <td class="@TdNum">@Cost(Store.Prices.MeanCost(overview.Runs))</td> }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        <MetricsFiles />

        <p class="text-xs text-muted">
            Every run's own copy of these figures is run-metrics.json in its archive.
            @(allowed ? "Run IDs link to their reports, which only maintainers of this deployment can see here." : "")
        </p>
    }
</div>

@code {
    private static RenderFragment Figure(string value, string label) => __builder =>
    {
        <div class="ui-card flex flex-col-reverse p-4 sm:p-5">
            <dt class="mt-1 text-sm text-muted">@label</dt>
            <dd class="font-display text-[clamp(26px,2.4vw,36px)] font-semibold leading-none tracking-tight text-heading">@value</dd>
        </div>
    };

    private static RenderFragment Th(string label, bool numeric = false) => __builder =>
    {
        <th scope="col" class="@ThClass @(numeric ? "text-right" : "text-left")">@label</th>
    };

    private static RenderFragment ThSwatch(string label, string swatch) => __builder =>
    {
        <th scope="col" class="@ThClass text-right"><span class="mr-1.5 inline-block h-2.5 w-2.5 @swatch" aria-hidden="true"></span>@label</th>
    };

    // The run's short id; maintainers get a link to its report (the multivocal paper for a grey literature run).
    private RenderFragment RunCell(AuBtechReviewAgent.RunMetrics r) => __builder =>
    {
        string id = AuBtechReviewAgent.MetricsOverview.ShortId(r.RunId);
        <th scope="row" class="@Td text-left font-mono font-normal">
            @if (allowed)
            {
                <a class="text-heading underline underline-offset-2" href="@(Grey ? $"/mlr-paper/{r.RunId}" : $"/spec-matrix/{r.RunId}")" title="Open the report of this run">@id</a>
            }
            else
            {
                @id
            }
        </th>
    };
}
