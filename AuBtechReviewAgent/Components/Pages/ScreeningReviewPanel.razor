@* Shown on the dashboard while a run waits for the user to confirm its screening decisions. *@
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine

<div class="flex flex-col min-h-0 h-full">
    <div class="px-4 py-3 border-b border-gray-200 bg-amber-50 flex-none">
        <p class="text-xs font-bold text-amber-900 uppercase tracking-wide">Your turn: check the screening decisions</p>
        <p class="text-[11px] text-amber-900 mt-1 leading-snug">
            The model has screened @rows.Count record(s). Change any decision you disagree with and add a note if you like,
            then continue. Every decision you confirm or change is recorded in the run ledger next to the model's decision.
            @if (rows.Any(r => r.Uncertain))
            {
                <span class="font-semibold">The @rows.Count(r => r.Uncertain) uncertain decision(s) are listed first.</span>
            }
        </p>
        <div class="flex gap-3 mt-2 text-[11px] text-amber-900 font-mono">
            <span>Included: @rows.Count(r => r.Decision == "Included")</span>
            <span>Excluded: @rows.Count(r => r.Decision == "Excluded")</span>
            <span>Changed by you: @rows.Count(r => r.Decision != r.ModelDecision)</span>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto divide-y divide-gray-100">
        @foreach (var row in rows)
        {
            <div class="p-3 text-left @(row.Decision != row.ModelDecision ? "bg-blue-50/50" : "")">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-xs font-semibold text-gray-900 leading-snug">@row.Title</p>
                        <p class="text-[10px] text-gray-500 mt-0.5">@row.Citation</p>
                        <div class="flex flex-wrap gap-1 mt-1">
                            @if (row.Uncertain)
                            {
                                <span class="text-[9px] font-bold uppercase tracking-wide bg-amber-100 text-amber-800 px-1.5 py-0.5 ">Uncertain</span>
                            }
                            @if (row.SecondDecision != null && row.SecondDecision != row.FirstDecision)
                            {
                                <span class="text-[9px] font-bold uppercase tracking-wide bg-purple-100 text-purple-800 px-1.5 py-0.5 " title="The two independent screenings disagreed">Screenings disagree</span>
                            }
                            @if (row.Confidence != null)
                            {
                                <span class="text-[9px] uppercase tracking-wide px-1.5 py-0.5 @(row.Confidence == "low" ? "bg-red-50 text-red-700" : "bg-gray-100 text-gray-600")">Confidence: @row.Confidence</span>
                            }
                            @if (row.Flags.Count > 0)
                            {
                                <span class="text-[9px] font-bold uppercase tracking-wide bg-red-100 text-red-800 px-1.5 py-0.5 "
                                      title="The paper's text contains phrases that look like instructions to the model (@string.Join(", ", row.Flags)). Check that the decision is based on the content.">Possible prompt injection</span>
                            }
                            @if (row.Origin != "database search")
                            {
                                <span class="text-[9px] uppercase tracking-wide bg-blue-50 text-blue-700 px-1.5 py-0.5 ">Found by @row.Origin</span>
                            }
                        </div>
                    </div>
                    <div class="flex-none flex border border-gray-300 overflow-hidden text-[10px] font-bold uppercase">
                        <button type="button" disabled="@submitting" @onclick='() => SetDecision(row, "Included")'
                                class="px-2 py-1 @(row.Decision == "Included" ? "bg-green-600 text-white" : "bg-white text-gray-500")">Include</button>
                        <button type="button" disabled="@submitting" @onclick='() => SetDecision(row, "Excluded")'
                                class="px-2 py-1 @(row.Decision == "Excluded" ? "bg-red-600 text-white" : "bg-white text-gray-500")">Exclude</button>
                    </div>
                </div>
                <p class="text-[11px] text-gray-700 mt-1.5"><span class="font-semibold">Model (@row.ModelDecision):</span> @row.Reasoning</p>
                @if (row.SecondDecision != null && row.SecondDecision != row.FirstDecision)
                {
                    <p class="text-[11px] text-gray-700 mt-1"><span class="font-semibold">Second screening (@row.SecondDecision):</span> @row.SecondReasoning</p>
                }
                @if (!string.IsNullOrWhiteSpace(row.Abstract))
                {
                    <details class="mt-1">
                        <summary class="text-[10px] text-brand cursor-pointer select-none">Show abstract</summary>
                        <p class="text-[11px] text-gray-600 mt-1 leading-snug">@row.Abstract</p>
                    </details>
                }
                <input type="text" placeholder="Optional note (why you changed or confirmed this decision)" @bind="row.Note" disabled="@submitting"
                       class="mt-1.5 w-full p-1.5 text-[11px] bg-gray-50 border border-gray-200 focus:outline-none focus:border-brand" />
            </div>
        }
    </div>

    <div class="p-3 border-t border-gray-200 flex-none flex items-center justify-between gap-3 bg-white">
        <span class="text-[11px] text-red-700">@error</span>
        <button type="button" @onclick="Submit" disabled="@submitting"
                class="ui-btn-primary ui-btn-sm">
            @(submitting ? "Sending..." : "Continue with write-up")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid RunId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<AuBtechReviewAgent.ScreeningLog> Logs { get; set; } = Array.Empty<AuBtechReviewAgent.ScreeningLog>();
    [Parameter] public EventCallback OnSubmitted { get; set; }
    /// <summary>The run's edit key from this browser; without it the engine refuses the review.</summary>
    [Parameter] public string? EditKey { get; set; }

    private List<Row> rows = new();
    private bool submitting;
    private string error = "";
    private Guid loadedFor;

    private class Row
    {
        public string PaperId = "";
        public string Title = "";
        public string Citation = "";
        public string Reasoning = "";
        public string? Abstract;
        public string ModelDecision = "";
        public string Decision = "";
        public string? Note;
        public bool Uncertain;
        public string? Confidence;
        public string FirstDecision = "";
        public string? SecondDecision;
        public string? SecondReasoning;
        public List<string> Flags = new();
        public string Origin = "database search";
    }

    protected override void OnParametersSet()
    {
        // Build the rows once per run, so a progress refresh does not reset the user's choices.
        if (loadedFor == RunId && rows.Count > 0) return;
        loadedFor = RunId;
        rows = Logs
            .Where(l => l.Decision is "Included" or "Excluded")
            .Select(l => new Row
            {
                PaperId = l.PaperId,
                Title = l.Title,
                Citation = l.ApaCitation,
                Reasoning = l.Reasoning,
                Abstract = l.Abstract,
                ModelDecision = l.Decision,
                Decision = l.Decision,
                Uncertain = l.Uncertain,
                Confidence = l.Confidence,
                // When the screenings disagreed the ledger holds "Included"; the reasoning names both decisions.
                FirstDecision = l.SecondDecision != null && l.Reasoning.StartsWith("The two independent screenings disagreed", StringComparison.Ordinal)
                    ? (l.SecondDecision == "Included" ? "Excluded" : "Included") : l.Decision,
                SecondDecision = l.SecondDecision,
                SecondReasoning = l.SecondReasoning,
                Flags = l.InjectionFlags ?? new List<string>(),
                Origin = l.Origin ?? "database search",
            })
            // Uncertain decisions first, so a reviewer with little time looks at those; otherwise ledger order.
            .Select((r, i) => (r, i))
            .OrderBy(x => x.r.Uncertain ? 0 : 1).ThenBy(x => x.i)
            .Select(x => x.r)
            .ToList();
    }

    private static void SetDecision(Row row, string decision) => row.Decision = decision;

    private async Task Submit()
    {
        submitting = true;
        error = "";
        var decisions = rows.Select(r => new AuBtechReviewAgent.ScreeningOverride(r.PaperId, r.Decision, r.Note)).ToList();
        if (ReviewEngine.SubmitScreeningReview(RunId, decisions, EditKey))
        {
            await OnSubmitted.InvokeAsync();
        }
        else
        {
            submitting = false;
            error = "This run is no longer waiting for a review (it may have timed out or the server restarted).";
        }
    }
}
