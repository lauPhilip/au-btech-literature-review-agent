@* Shown on the dashboard while a run waits for the user to confirm its screening decisions. *@
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine

<div class="flex flex-col min-h-0 h-full">
    <div class="px-4 py-3 border-b border-gray-200 bg-amber-50 flex-none">
        <p class="text-xs font-bold text-amber-900 uppercase tracking-wide">Your turn: check the screening decisions</p>
        <p class="text-[11px] text-amber-900 mt-1 leading-snug">
            The model has screened @rows.Count record(s). Change any decision you disagree with and add a note if you like,
            then continue. Every decision you confirm or change is recorded in the run ledger next to the model's decision.
        </p>
        <div class="flex gap-3 mt-2 text-[11px] text-amber-900 font-mono">
            <span>Included: @rows.Count(r => r.Decision == "Included")</span>
            <span>Excluded: @rows.Count(r => r.Decision == "Excluded")</span>
            <span>Changed by you: @rows.Count(r => r.Decision != r.ModelDecision)</span>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto divide-y divide-gray-100">
        @foreach (var row in rows)
        {
            <div class="p-3 text-left @(row.Decision != row.ModelDecision ? "bg-blue-50/50" : "")">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-xs font-semibold text-gray-900 leading-snug">@row.Title</p>
                        <p class="text-[10px] text-gray-500 mt-0.5">@row.Citation</p>
                    </div>
                    <div class="flex-none flex rounded border border-gray-300 overflow-hidden text-[10px] font-bold uppercase">
                        <button type="button" disabled="@submitting" @onclick='() => SetDecision(row, "Included")'
                                class="px-2 py-1 @(row.Decision == "Included" ? "bg-green-600 text-white" : "bg-white text-gray-500")">Include</button>
                        <button type="button" disabled="@submitting" @onclick='() => SetDecision(row, "Excluded")'
                                class="px-2 py-1 @(row.Decision == "Excluded" ? "bg-red-600 text-white" : "bg-white text-gray-500")">Exclude</button>
                    </div>
                </div>
                <p class="text-[11px] text-gray-700 mt-1.5"><span class="font-semibold">Model (@row.ModelDecision):</span> @row.Reasoning</p>
                @if (!string.IsNullOrWhiteSpace(row.Abstract))
                {
                    <details class="mt-1">
                        <summary class="text-[10px] text-[#003B5C] cursor-pointer select-none">Show abstract</summary>
                        <p class="text-[11px] text-gray-600 mt-1 leading-snug">@row.Abstract</p>
                    </details>
                }
                <input type="text" placeholder="Optional note (why you changed or confirmed this decision)" @bind="row.Note" disabled="@submitting"
                       class="mt-1.5 w-full p-1.5 text-[11px] bg-gray-50 border border-gray-200 rounded focus:outline-none focus:border-[#003B5C]" />
            </div>
        }
    </div>

    <div class="p-3 border-t border-gray-200 flex-none flex items-center justify-between gap-3 bg-white">
        <span class="text-[11px] text-red-700">@error</span>
        <button type="button" @onclick="Submit" disabled="@submitting"
                class="py-2 px-4 text-white text-xs font-bold uppercase tracking-wider rounded disabled:opacity-50" style="background-color:#003B5C;">
            @(submitting ? "Sending..." : "Continue with write-up")
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid RunId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<AuBtechReviewAgent.ScreeningLog> Logs { get; set; } = Array.Empty<AuBtechReviewAgent.ScreeningLog>();
    [Parameter] public EventCallback OnSubmitted { get; set; }

    private List<Row> rows = new();
    private bool submitting;
    private string error = "";
    private Guid loadedFor;

    private class Row
    {
        public string PaperId = "";
        public string Title = "";
        public string Citation = "";
        public string Reasoning = "";
        public string? Abstract;
        public string ModelDecision = "";
        public string Decision = "";
        public string? Note;
    }

    protected override void OnParametersSet()
    {
        // Build the rows once per run, so a progress refresh does not reset the user's choices.
        if (loadedFor == RunId && rows.Count > 0) return;
        loadedFor = RunId;
        rows = Logs
            .Where(l => l.Decision is "Included" or "Excluded")
            .Select(l => new Row
            {
                PaperId = l.PaperId,
                Title = l.Title,
                Citation = l.ApaCitation,
                Reasoning = l.Reasoning,
                Abstract = l.Abstract,
                ModelDecision = l.Decision,
                Decision = l.Decision,
            })
            .ToList();
    }

    private static void SetDecision(Row row, string decision) => row.Decision = decision;

    private async Task Submit()
    {
        submitting = true;
        error = "";
        var decisions = rows.Select(r => new AuBtechReviewAgent.ScreeningOverride(r.PaperId, r.Decision, r.Note)).ToList();
        if (ReviewEngine.SubmitScreeningReview(RunId, decisions))
        {
            await OnSubmitted.InvokeAsync();
        }
        else
        {
            submitting = false;
            error = "This run is no longer waiting for a review (it may have timed out or the server restarted).";
        }
    }
}
