@page "/gallery"
@layout AppLayout
@inject AuBtechReviewAgent.GalleryStore Store
@inject AuBtechReviewAgent.ReviewModulesOptions ModuleOptions

@* The catalogue of example reports (Runs/GalleryStore.cs). A plain page without a live connection: the filter and the
   order are links, so the page works without scripts. Every value on a card comes from the run's files and is shown
   as text. A card of a review whose card is not shown on this site is left out (ReviewModulesOptions.Shows). *@

<SeoHead Title="Example reports" Path="/gallery" BreadcrumbName="Gallery"
         Description="Example reports made with TraceableAI, added by the people who ran them: each shown as it prints, with every citation checked against its source." />

<div class="mx-auto w-full max-w-[1200px] space-y-8 px-[clamp(16px,3vw,40px)] py-6 sm:py-10">
    <header class="max-w-[760px]">
        <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">Gallery</p>
        <h1 class="mt-2 font-display text-[clamp(26px,2.4vw,40px)] font-semibold leading-tight tracking-[-0.025em] text-heading">Example reports</h1>
        <p class="mt-3 text-base leading-relaxed text-muted">
            These reports were made with TraceableAI, and the people who ran them chose to share them here. Each one is shown as it
            prints. It is kept after its run is deleted, until its owner withdraws it or a newer run of the same review replaces it.
        </p>
        <p class="mt-2 text-sm leading-relaxed text-muted">@AuBtechReviewAgent.GalleryText.SameReviewRule</p>
    </header>

    @if (Shown.Count == 0)
    {
        <div class="ui-card p-6">
            <p class="font-display text-base font-semibold text-heading">No reports yet</p>
            <p class="mt-1 text-sm text-muted">When a review is finished, the browser that started it can add the report here from its report page.</p>
        </div>
    }
    else
    {
        <nav aria-label="Filter and order" class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
            <ul class="flex flex-wrap gap-2">
                <li><a href="@Href(null, Sort)" aria-current="@(Type == null ? "page" : null)" class="@(Type == null ? "ui-btn-primary" : "ui-btn-secondary") ui-btn-sm min-h-[44px]">All (@Shown.Count)</a></li>
                @foreach (var (card, label, count) in Types)
                {
                    string key = card;
                    <li><a href="@Href(key, Sort)" aria-current="@(Type == key ? "page" : null)" class="@(Type == key ? "ui-btn-primary" : "ui-btn-secondary") ui-btn-sm min-h-[44px]">@label (@count)</a></li>
                }
            </ul>
            <p class="text-sm text-muted">
                Order:
                <a href="@Href(Type, null)" aria-current="@(Sort != "title" ? "page" : null)" class="@(Sort != "title" ? "font-semibold text-heading" : "text-heading underline underline-offset-2")">newest first</a> ·
                <a href="@Href(Type, "title")" aria-current="@(Sort == "title" ? "page" : null)" class="@(Sort == "title" ? "font-semibold text-heading" : "text-heading underline underline-offset-2")">by title</a>
            </p>
        </nav>

        <ul class="grid grid-cols-1 gap-4 md:grid-cols-2" aria-label="Reports">
            @foreach (var entry in Listed)
            {
                var e = entry;
                <li class="ui-card flex flex-col p-5" data-gallery-card>
                    <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">@TypeLabel(e.Card) · @Date(e.CompletedUtc)</p>
                    <h2 class="mt-2 font-display text-lg font-semibold leading-snug text-heading">
                        <a href="@($"/gallery/{e.Id}")" class="hover:underline">@e.Title</a>
                    </h2>
                    @if (e.Questions.Count > 0)
                    {
                        <p class="mt-2 text-sm text-ink">@e.Questions[0]@(e.Questions.Count > 1 ? $" (and {e.Questions.Count - 1} more {(e.Questions.Count == 2 ? "question" : "questions")})" : "")</p>
                    }
                    <p class="mt-2 text-sm text-muted">@AuBtechReviewAgent.GalleryCard.Counts(e)</p>
                    @if (e.Keywords.Count > 0)
                    {
                        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Themes">
                            @foreach (var keyword in e.Keywords)
                            {
                                <li class="ui-chip border-line bg-soft text-ink">@keyword</li>
                            }
                        </ul>
                    }
                    <p class="mt-auto pt-4 text-xs text-muted">@AuBtechReviewAgent.GalleryCard.Provenance(e)</p>
                </li>
            }
        </ul>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }

    private List<AuBtechReviewAgent.GalleryEntry> Shown = new();

    protected override void OnParametersSet()
    {
        Shown = Store.List().Where(e => ModuleOptions.Shows(e.Card)).ToList();
        if (Type != null && !Shown.Any(e => e.Card == Type)) Type = null;
    }

    private IEnumerable<AuBtechReviewAgent.GalleryEntry> Listed =>
        (Type == null ? Shown : Shown.Where(e => e.Card == Type)) is var list && Sort == "title"
            ? list.OrderBy(e => e.Title, StringComparer.CurrentCultureIgnoreCase)
            : list.OrderByDescending(e => e.LastChangedUtc);

    private IEnumerable<(string Card, string Label, int Count)> Types =>
        Shown.GroupBy(e => e.Card).OrderBy(g => g.Key, StringComparer.Ordinal).Select(g => (g.Key, TypeLabel(g.Key), g.Count()));

    private static string TypeLabel(string card) => AuBtechReviewAgent.GalleryCard.TypeLabel(card);

    private static string Date(DateTime utc) => AuBtechReviewAgent.GalleryCard.Date(utc);

    private static string Href(string? type, string? sort)
    {
        var query = new List<string>();
        if (type != null) query.Add("type=" + Uri.EscapeDataString(type));
        if (sort != null) query.Add("sort=" + Uri.EscapeDataString(sort));
        return "/gallery" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
    }
}
