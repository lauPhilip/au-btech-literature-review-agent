@page "/start"

@* The first step of a new review: choose the kind of review. Every kind shares the same core (every claim grounded
   in a quote from a source); each card names the reporting standard it follows. Kinds the engine does not run yet
   are shown as "coming soon" from the same list (ReviewMethods), so switching one on later is a setting. *@

<SeoHead Title="Start a review" Path="/start"
         Description="Choose the kind of literature review: a PRISMA 2020 systematic review today, with multivocal and scoping reviews coming soon." />

<SiteHeader />

<main id="main" tabindex="-1" class="flex-1 min-h-0 overflow-y-auto bg-gray-50 text-gray-900 font-sans">
    <div class="ui-container py-14 lg:py-20 max-w-5xl">
        <div class="text-center max-w-2xl mx-auto">
            <p class="ui-eyebrow">Start a review</p>
            <h1 class="ui-h1 mt-3">What kind of review?</h1>
            <p class="ui-lead mt-4">
                Each kind follows its own published method. In all of them, every statement in the report is traced
                to a quote from the source it cites.
            </p>
        </div>

        <ul class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-5" aria-label="Kinds of review">
            @foreach (var method in AuBtechReviewAgent.ReviewMethods.All)
            {
                var m = method;
                string titleId = $"method-{m.Key}";
                <li class="ui-card p-6 flex flex-col @(m.Available ? "border-brand" : "bg-white/60")">
                    <div class="flex items-start justify-between gap-3">
                        <h2 id="@titleId" class="text-lg font-semibold leading-snug @(m.Available ? "text-gray-950" : "text-gray-600")">@m.Name</h2>
                        @if (!m.Available)
                        {
                            <span class="ui-chip border-gray-200 bg-gray-50 text-gray-600 whitespace-nowrap">Coming soon</span>
                        }
                    </div>
                    <p class="mt-1 text-xs font-medium @(m.Available ? "text-brand" : "text-gray-500")">
                        Follows <a href="@m.StandardUrl" target="_blank" rel="noopener" class="underline underline-offset-2" title="@m.StandardReference">@m.Standard</a>
                    </p>
                    <p class="mt-4 text-sm leading-relaxed @(m.Available ? "text-gray-700" : "text-gray-600")">@m.Summary</p>
                    <ul class="mt-4 space-y-1.5 text-sm @(m.Available ? "text-gray-700" : "text-gray-600")">
                        @foreach (var highlight in m.Highlights)
                        {
                            <li class="flex gap-2">
                                <svg class="w-4 h-4 mt-0.5 flex-none @(m.Available ? "text-verdict-ok" : "text-gray-400")" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                                <span>@highlight</span>
                            </li>
                        }
                    </ul>
                    <div class="mt-auto pt-6">
                        @if (m.Available)
                        {
                            <a href="@($"/review?method={m.Key}")" class="ui-btn-primary w-full" aria-describedby="@titleId">
                                Start this review
                                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10.3 4.3a1 1 0 011.4 0l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4l3.3-3.3H4a1 1 0 110-2h9.6l-3.3-3.3a1 1 0 010-1.4z" clip-rule="evenodd" /></svg>
                            </a>
                        }
                        else
                        {
                            <p class="text-xs text-gray-500">Not available yet. Follow the project on
                                <a href="@AuBtechReviewAgent.SiteSeo.RepositoryUrl" class="text-brand underline underline-offset-2">GitHub</a> to hear when it is.</p>
                        }
                    </div>
                </li>
            }
        </ul>

        <p class="ui-muted mt-10 text-center">
            Not sure? A systematic review answers a focused question from peer-reviewed studies; the
            <a href="/glossary" class="text-brand underline underline-offset-2">glossary</a> explains the terms.
        </p>
    </div>
    <SiteFooter />
</main>
