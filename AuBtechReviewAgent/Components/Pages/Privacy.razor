@page "/privacy"
@inject AuBtechReviewAgent.RunsOptions RunsOptions
@inject AuBtechReviewAgent.CacheOptions CacheOptions
@inject AuBtechReviewAgent.QuotaOptions QuotaOptions
@inject AuBtechReviewAgent.ReviewModulesOptions ModuleOptions

@* Everything on this page describes what the code does (RunQuotaService, ReviewCache, SessionCleanupWorker,
   RunMetricsStore, the key dialog, and for grey literature MultivocalPages, PageFetcher and RobotsRules); the numbers
   come from the running configuration. Update it with the code. *@

<SeoHead Title="Privacy" Path="/privacy"
         Description="@(Grey ? "What TraceableAI stores, for how long, what it sends to the language model, the scholarly databases and the grey literature sites, and how it keeps the web pages a review cites. No accounts, no tracking." : "What TraceableAI stores, for how long, and what it sends to the language model and the scholarly databases. No accounts, no tracking.")" />

<SiteHeader />

<main id="main" tabindex="-1" class="flex-1 min-h-0 overflow-y-auto bg-white text-gray-900 font-sans">
    <div class="ui-container py-14 lg:py-20 max-w-3xl">
        <p class="ui-eyebrow">Privacy</p>
        <h1 class="ui-h1 mt-3">What happens to your data</h1>
        <p class="ui-lead mt-5">
            There are no accounts, no advertising and no tracking. TraceableAI keeps what it needs to run your review and
            show it to you, for a limited time, and nothing else.
        </p>

        <div class="mt-10 ui-card p-6 grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
            @foreach (var (title, text) in Summary)
            {
                <div>
                    <p class="font-semibold text-gray-900">@title</p>
                    <p class="text-gray-600 mt-1 leading-relaxed">@text</p>
                </div>
            }
        </div>

        @foreach (var (id, heading, paragraphs) in Sections.Where(x => Grey || x.Id != "web-pages"))
        {
            <section class="mt-12" aria-labelledby="@id">
                <h2 id="@id" class="ui-h2">@heading</h2>
                @foreach (var paragraph in paragraphs)
                {
                    <p class="mt-4 text-gray-700 leading-relaxed">@paragraph</p>
                }
            </section>
        }

        <section class="mt-12" aria-labelledby="third-parties">
            <h2 id="third-parties" class="ui-h2">Who else receives what</h2>
            <div class="mt-5 ui-card overflow-hidden">
                <table class="w-full text-sm">
                    <caption class="sr-only">Services that receive data during a review</caption>
                    <thead class="bg-gray-50 text-left text-gray-600">
                        <tr><th scope="col" class="px-4 py-3 font-medium">Service</th><th scope="col" class="px-4 py-3 font-medium">What it receives</th></tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-gray-700">
                        @foreach (var (service, receives) in Grey ? ThirdParties.Concat(GreyThirdParties) : ThirdParties)
                        {
                            <tr><th scope="row" class="px-4 py-3 text-left font-medium text-gray-900 align-top">@service</th><td class="px-4 py-3">@receives</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="mt-4 text-gray-700 leading-relaxed">Each of these services has its own privacy policy. None of them receives your network address from TraceableAI; they see the server's.</p>
        </section>

        <section class="mt-12" aria-labelledby="choices">
            <h2 id="choices" class="ui-h2">Your choices</h2>
            <p class="mt-4 text-gray-700 leading-relaxed">
                You can delete a run and all its files at any time from its dashboard or report page. You can use your own
                Mistral key, or run TraceableAI on your own computer with a local model, so that nothing leaves your machine
                except the database searches. Questions about this page go to the
                <a href="@($"{AuBtechReviewAgent.SiteSeo.RepositoryUrl}/issues")" class="text-brand underline underline-offset-2">issues on GitHub</a>.
            </p>
            <p class="mt-4 text-sm text-gray-500">Last updated October 2026. The page is generated from the app's own settings, so the periods above are the ones this server uses.</p>
        </section>
    </div>
    <SiteFooter />
</main>

@code {
    /// <summary>Whether the grey literature review is described: its card is on, or its module is in preview.</summary>
    private bool Grey => ModuleOptions.Shows("grey");

    private (string Title, string Text)[] Summary => new[]
    {
        ("No account, no tracking", "No sign-up, no analytics, no advertising cookies."),
        ("Your network address", $"Only used to count free runs, stored as a keyed fingerprint, and forgotten after two days."),
        ("Your review", $"Kept on this server for {RunsOptions.RetentionDays} days, then deleted. You can delete it sooner."),
        ("Your API keys", "Kept encrypted in this browser tab only, and gone when you close it."),
    };

    private (string Id, string Heading, string[] Paragraphs)[] Sections => new[]
    {
        ("cookies", "Cookies and tracking", new[]
        {
            "TraceableAI uses no analytics, advertising or tracking cookies, and loads no scripts, fonts or images from other sites. " +
            "The only cookie is a technical one the web framework sets to protect forms against requests from other sites; it identifies no one.",
        }),
        ("address", "Your network address", new[]
        {
            $"Free runs are limited to {QuotaOptions.FreeRunsPerDay} per day per network address. To count them, your address is replaced " +
            "by a keyed fingerprint (HMAC-SHA-256 with a secret that exists only on this server) before anything is stored, so the stored value " +
            "cannot be turned back into an address. Counts older than two days are deleted.",
            "Like any web server, the hosting provider may keep standard access logs (address, time, page) for operating and securing the server.",
        }),
        ("review", "Your review", new[]
        {
            "What you type in the review form (search query, objective, criteria, artifact instruction) is saved with the run, together with " +
            "everything the run produces: the protocol, the search results, every screening decision, the downloaded open-access papers, the " +
            "report and a record of every model call. This is what makes the review checkable." + (Grey ? " A grey literature review saves its " +
            "plan the same way: the need for the review, its research questions, search strings, criteria and quality threshold." : ""),
            $"A run is kept for {RunsOptions.RetentionDays} days after it is created and then deleted automatically, files and all. Anyone who has " +
            "the link to a run can read it, but only the browser that started it can change or delete it; the links contain a random identifier that cannot be guessed, and they are not listed anywhere or shown to search engines.",
        }),
        ("keys", "Your API keys", new[]
        {
            "Keys you enter under API keys are kept encrypted in your browser tab's session storage. The server uses them only to make the " +
            "calls of your run; it does not write them to disk or to its logs. They are gone when you close the tab, or when you press Clear session.",
        }),
        ("browser", "What your browser keeps", new[]
        {
            "While you fill in the review form, an unfinished draft (the question, criteria and options, never your keys) is kept in your browser's " +
            "local storage, so closing the tab does not lose it. It stays on your device until you start the review or press Start empty, and is " +
            "ignored after 30 days. If you ask to be notified when a review is ready, your browser shows the notification; nothing is sent anywhere else.",
            "When you start a review, your browser also keeps a random edit key for that run. Only the browser that has it can delete the run, " +
            "change its screening, check a citation again or write notes; anyone else with the link can only read it. The server stores only a " +
            "fingerprint of the key, and the key is dropped from your browser after 30 days.",
        }),
        ("web-pages", "Web pages a grey literature review reads", new[]
        {
            "A grey literature review cites web pages, such as blog posts, documentation, forum answers and reports, so it keeps a " +
            "snapshot of each page it reads. The server fetches only pages that the review's own searches found. Before it fetches anything from a " +
            $"site it reads the site's robots.txt for its name, {AuBtechReviewAgent.RobotsRules.ProductToken}, and fetches nothing the site disallows " +
            "(nothing at all when the site has a robots.txt that cannot be read, as RFC 9309 asks). It sends at most one request a second to a site, or slower when the site asks for it, " +
            "never signs in, skips pages behind a sign-in and stops at 10 MB. Its requests name TraceableAI and link to this project.",
            $"The main text of each page is kept with the run, on this server, for the run's lifetime of {RunsOptions.RetentionDays} days, so that the " +
            "citation check can be repeated against the same text, and it is deleted with the run. It is not part of the run's archive and is not " +
            "shared: the archive holds the page's address, the date it was read, a fingerprint (SHA-256) of its text, the short passages the review " +
            "quotes and a link to the Wayback Machine's nearest capture. TraceableAI only builds that link; it does not ask the Internet Archive to " +
            "make a capture. A page may name its authors or the people who answered on a forum; they are kept only as they appear on the page and in " +
            "the reference to it.",
        }),
        ("reuse", "What is kept longer", new[]
        {
            $"To save time and cost, a database's answer to a search is reused for {CacheOptions.SearchResponseHours} hours, and a screening " +
            $"decision for the same paper, criteria and model is reused for {CacheOptions.ScreeningDecisionDays} days. They are filed under a " +
            "fingerprint of the request and contain the papers' metadata and the decision, not who asked." + (Grey ? " A grey literature review " +
            $"reuses its model decisions the same way, also for {CacheOptions.ScreeningDecisionDays} days: the screening, the quality points, the " +
            "extracted values and the checks of values and citations, each with the short quotes it rests on but not the page's text." : ""),
            "For the public Metrics page, every finished run leaves a line of quality figures: how many citations were supported, coverage, " +
            "time and cost. It contains no research question, criteria or paper text, and no network address.",
        }),
    };

    private static readonly (string Service, string Receives)[] ThirdParties =
    {
        ("Mistral AI (the language model)", "Your question, objective and criteria, and titles, abstracts and text of the papers, to screen, extract, write and check. Runs with your own key go through your own Mistral account."),
        ("arXiv, OpenAlex, Semantic Scholar, Crossref", "Your search query and its extra phrasings, and the identifiers of included papers for citation chaining."),
        ("Scopus, ScienceDirect, IEEE Xplore", "Your search query, only when a key for them is set."),
        ("Unpaywall, Zenodo and publishers' open-access servers", "The DOI or link of an included paper, to download a legal open-access copy."),
    };

    /// <summary>The services a grey literature review adds; listed while it is described (<see cref="Grey"/>).</summary>
    private static readonly (string Service, string Receives)[] GreyThirdParties =
    {
        ("Stack Exchange, GitHub, Hacker News (Algolia), OpenAlex and Zenodo", "In a grey literature review: the review's grey search strings, to find practitioner posts, repositories, discussions, reports and theses."),
        ("The sites of the sources found", "In a grey literature review: a request for robots.txt and for the page of a source the searches found, from the server, naming TraceableAI."),
    };
}
