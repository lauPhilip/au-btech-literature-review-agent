@using System.Text.RegularExpressions
@* Sections 1 and 2 of the report page: the introduction, and the methods with the PRISMA flow figure (Figure 2.1). The page passes itself as Page; its state stays there. *@

<section id="@AuBtechReviewAgent.ReportOutline.IntroductionId" data-report-section class="scroll-mt-20 space-y-5">
    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">1. Introduction</h2>

<div class="space-y-2">
    <h3 class="font-display text-base font-semibold text-heading">1.1 Rationale (Item 3)</h3>
    @Page.CitedText("rationaleItem", SpecMatrix.ScrubAnchors(Page.report.RationaleItem))
</div>

<div class="space-y-2">
    <h3 class="font-display text-base font-semibold text-heading">1.2 Objectives (Item 4)</h3>
    <p class="text-ink">@SpecMatrix.ScrubAnchors(Page.report.ObjectivesItem)</p>
    @if (Page.researchQuestions.Count > 0)
    {
        <ol class="space-y-1 pt-1">
            @for (int i = 0; i < Page.researchQuestions.Count; i++)
            {
                <li class="text-ink"><span class="font-bold">RQ@(i + 1).</span> @Page.researchQuestions[i]</li>
            }
        </ol>
    }
</div>

</section>

<section id="@AuBtechReviewAgent.ReportOutline.MethodologyId" data-report-section class="scroll-mt-20 space-y-5">
    <h2 class="font-display text-xl font-semibold tracking-tight text-heading">2. Methodology</h2>

<div class="space-y-2">
    <h3 class="font-display text-base font-semibold text-heading">2.1 Eligibility Criteria (Item 5)</h3>
    <p class="text-ink">@SpecMatrix.ScrubAnchors(Page.report.EligibilityItem)</p>
</div>

<div class="space-y-2">
    <h3 class="font-display text-base font-semibold text-heading">2.2 Information Sources (Item 6)</h3>
    <p class="text-ink">@SpecMatrix.ScrubAnchors(Page.report.SourcesItem)</p>
</div>

<div class="space-y-2">
    <h3 class="font-display text-base font-semibold text-heading">2.3 Search Execution (Item 7)</h3>
    <p class="text-ink">@SpecMatrix.ScrubAnchors(Page.report.SearchStrategyItem)</p>
</div>

<div class="space-y-2">
    <h3 class="font-display text-base font-semibold text-heading">2.4 Selection Process (Item 8)</h3>
    <p class="text-ink">@SpecMatrix.ScrubAnchors(Page.report.SelectionProcessItem)</p>
</div>

@if (Page.flow != null)
{
    @FlowFigure(Page.flow)
}

<div class="space-y-2">
    <h3 class="font-display text-base font-semibold text-heading">2.5 Data Collection and Quality Appraisal (Items 9-11)</h3>
    <p class="text-ink">@SpecMatrix.ScrubAnchors(Page.report.BiasAssessmentItem)</p>
</div>

@if (!string.IsNullOrWhiteSpace(Page.report.SynthesisMethodsItem))
{
    <div class="space-y-2">
        <h3 class="font-display text-base font-semibold text-heading">2.6 Synthesis Methods (Item 13d)</h3>
        <p class="text-ink">@Page.report.SynthesisMethodsItem</p>
    </div>
}

@* The citation check is a method, so it is written here and not in the interpretation (issue #679). *@
@if (!string.IsNullOrWhiteSpace(Page.report.CitationCheckSummary))
{
    <div class="space-y-2">
        <h3 class="font-display text-base font-semibold text-heading">2.@(string.IsNullOrWhiteSpace(Page.report.SynthesisMethodsItem) ? 6 : 7) Automated Citation Check</h3>
        <p class="text-ink">@Page.report.CitationCheckSummary</p>
    </div>
}

</section>

@code {
    [Parameter, EditorRequired] public SpecMatrix Page { get; set; } = default!;

    /// <summary>
    /// Figure 2.1: the PRISMA 2020 flow of records, from the run's own counts (PrismaFlowCounts, the same numbers as
    /// the diagram in main.tex). Every identified record ends in exactly one box. The screening kappa sits under it.
    /// </summary>
    private RenderFragment FlowFigure(AuBtechReviewAgent.PrismaFlowCounts c) => __builder =>
    {
        int removed = c.DuplicatesRemoved + c.OutsideDateRange + c.CappedBeyondMax + c.ScreeningErrors;
        int excluded = c.ExcludedPeerReview + c.ExcludedAtScreening;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var bySource = c.IdentifiedBySource.Select(x => $"{x.Source} {x.Count}").ToList();
        if (c.IdentifiedViaCitations > 0) bySource.Add($"citation chaining {c.IdentifiedViaCitations}");
        string identifiedDetail = string.Join(" · ", bySource);
        var removals = new List<string>();
        if (c.DuplicatesRemoved > 0) removals.Add($"duplicates {c.DuplicatesRemoved}");
        if (c.OutsideDateRange > 0) removals.Add($"outside the years {c.OutsideDateRange}");
        if (c.CappedBeyondMax > 0) removals.Add($"over the cap per source {c.CappedBeyondMax}");
        if (c.ScreeningErrors > 0) removals.Add($"could not be screened {c.ScreeningErrors}");
        string removedDetail = string.Join(" · ", removals);
        var reasons = c.ExcludedByReason.Select(x => $"{x.Reason} {x.Count}").ToList();
        if (c.ExcludedPeerReview > 0) reasons.Add($"not peer reviewed {c.ExcludedPeerReview}");
        string excludedDetail = string.Join(" · ", reasons);
        string screenedLabel = Page.stats is { DualScreened: > 0 } ? "Screened twice, independently" : "Screened";
        <figure class="ui-figure print-keep" aria-labelledby="flow-caption">
            <ol class="space-y-2 text-[15px] leading-snug">
                @(FlowRow("Identified", c.Identified, identifiedDetail, "Removed before screening", removed, removedDetail))
                @(FlowRow(screenedLabel, c.Screened, "Title and abstract", "Excluded", excluded, excludedDetail))
                @(FlowRow("Included", c.Included, $"full text read {c.FullTextRetrieved} · abstract only {c.AbstractOnly}", null, 0, ""))
            </ol>
            @if (Page.stats is { DualScreened: > 0 } st)
            {
                <p class="mt-3 text-sm text-muted">
                    The two screenings agreed on @(st.DualScreened - st.ScreeningDisagreements) of @st.DualScreened records@(st.ScreeningKappa is double k ? $" (Cohen's kappa = {k.ToString("0.00", inv)})" : "").
                    Disagreements were included and flagged.
                    @AuBtechReviewAgent.MethodsSectionWriter.KappaNote(st.DualScreened - st.ScreeningDisagreements, st.DualScreened, st.ScreeningKappa)
                </p>
            }
            @if (!c.IsConsistent)
            {
                <p class="mt-2 text-sm text-partly">These counts do not add up for this run (it may predate the current counting); see transparent-process.json.</p>
            }
            <figcaption id="flow-caption" class="ui-caption">Figure 2.1: Flow of records through the review (PRISMA 2020)</figcaption>
        </figure>
    };

    private static RenderFragment FlowRow(string label, int count, string detail, string? sideLabel, int sideCount, string sideDetail) => __builder =>
    {
        <li class="grid grid-cols-1 gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div class="border border-line-field bg-page p-3">
                <span class="flex items-baseline justify-between gap-2"><span class="font-semibold text-ink">@label</span><span class="font-mono font-semibold text-heading">@count</span></span>
                @if (detail.Length > 0)
                {
                    <span class="mt-0.5 block text-sm text-muted">@detail</span>
                }
            </div>
            @if (sideLabel != null)
            {
                <div class="border border-dashed border-line-field p-3">
                    <span class="flex items-baseline justify-between gap-2"><span class="text-ink">@sideLabel</span><span class="font-mono text-muted">@sideCount</span></span>
                    @if (sideDetail.Length > 0)
                    {
                        <span class="mt-0.5 block text-sm text-muted">@sideDetail</span>
                    }
                </div>
            }
        </li>
    };
}
