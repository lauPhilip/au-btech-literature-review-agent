            || synthesisTargetDirective == AuBtechReviewAgent.ArtifactKinds.DefaultInstruction(previous);
        if (untouched) synthesisTargetDirective = AuBtechReviewAgent.ArtifactKinds.DefaultInstruction(State.ArtifactKind);
    }

