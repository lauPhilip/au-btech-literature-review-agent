@page "/review"
@page "/review/{RunId:guid}"
@rendermode InteractiveServer
@implements IDisposable

@using System.IO
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine
@inject ProtectedSessionStorage SessionStorage
@inject IJSRuntime JS
@inject AuBtechReviewAgent.RunQuotaService Quota
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

<header class="bg-[#003B5C] text-white flex-none shrink-0 z-50 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center space-x-3 hover:opacity-90 transition-opacity min-w-0 shrink">
            <span class="font-bold tracking-tight text-xs sm:text-sm whitespace-nowrap">AARHUS UNIVERSITY</span>
            <span class="text-white/40 font-light hidden lg:inline">|</span>
            <span class="text-xs tracking-wider font-medium opacity-90 uppercase hidden lg:inline">au-btech-literature-review-agent</span>
        </a>
        <nav class="flex items-center gap-3 sm:gap-6 text-[10px] sm:text-xs font-semibold uppercase tracking-wider whitespace-nowrap shrink-0">
            <a href="/" class="text-white/70 hover:text-white transition-colors py-4">Overview</a>
            <a href="@(hasRun ? $"/review/{currentSessionId}" : "/review")" class="text-white border-b-2 border-white py-4">Dashboard</a>
            <a href="@(hasRun ? $"/spec-matrix/{currentSessionId}" : "/spec-matrix")" class="text-white/70 hover:text-white transition-colors py-4">Review Output</a>
        </nav>
    </div>
</header>

<div class="flex-1 flex flex-col min-h-0 overflow-y-auto lg:overflow-hidden max-w-7xl w-full mx-auto p-4 lg:p-6 gap-4">
    
    <div class="w-full text-center flex-none shrink-0 space-y-1">
        <h1 class="text-2xl lg:text-3xl font-light text-gray-900 tracking-tight">Literature Review Agent</h1>
        <p class="text-xs font-mono tracking-widest text-[#003B5C] uppercase font-bold">Traceable PRISMA Reviews</p>
    </div>

    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-4 lg:flex-1 lg:min-h-0">
        
        <div class="lg:col-span-5 flex flex-col gap-4 min-w-0 lg:min-h-0 lg:overflow-y-auto lg:pr-1">
            <div class="bg-white border border-gray-200 rounded-lg p-4 flex flex-col shadow-sm flex-none">
                <div class="flex justify-between items-center mb-2 flex-none">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400 block">Execution Configuration</span>
                    <button @onclick="OpenKeyModal" class="text-[10px] bg-gray-100 hover:bg-gray-200 border border-gray-300 text-gray-700 px-2 py-0.5 rounded transition-all flex items-center gap-1">
                        <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                        <span>API Credentials</span>
                    </button>
                </div>

                <div class="mb-3 flex-none">
                    @{
                        string badgeColor = quotaStatus.Tier switch
                        {
                            AuBtechReviewAgent.QuotaTier.Developer => "blue",
                            AuBtechReviewAgent.QuotaTier.OwnKey => "green",
                            _ => quotaStatus.Allowed ? "amber" : "red"
                        };
                        string tierLabel = quotaStatus.Tier switch
                        {
                            AuBtechReviewAgent.QuotaTier.Developer => "Developer access",
                            AuBtechReviewAgent.QuotaTier.OwnKey => "Own Mistral key",
                            _ => "Free tier"
                        };
                        string counter = quotaStatus.Limit == int.MaxValue ? "unlimited"
                            : quotaStatus.Tier == AuBtechReviewAgent.QuotaTier.OwnKey ? $"{quotaStatus.Remaining} / {quotaStatus.Limit} this hour"
                            : $"{quotaStatus.Remaining} / {quotaStatus.Limit} left today";
                    }
                    <div class="bg-@(badgeColor)-50 border border-@(badgeColor)-200 rounded p-2 text-[11px] text-@(badgeColor)-800 flex items-center justify-between font-sans">
                        <span class="font-medium flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-@(badgeColor)-500"></span>
                            @tierLabel
                        </span>
                        <span class="font-mono text-[10px] bg-@(badgeColor)-100 text-@(badgeColor)-800 px-1 rounded">@counter</span>
                    </div>
                    @if (!string.IsNullOrEmpty(quotaNotice))
                    {
                        <p class="mt-1 text-[11px] text-red-700">@quotaNotice</p>
                    }
                </div>
                
                <div class="space-y-3 text-left">
                    <div>
                        <label class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Search Query</label>
                        <input type="text" @bind="searchQuery" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner transition-all" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Review Objective</label>
                        <textarea @bind="reviewObjective" rows="2" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner resize-none transition-all"></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Date From</label>
                            <input type="date" @bind="dateFrom" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner transition-all" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Date To</label>
                            <input type="date" @bind="dateTo" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner transition-all" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Inclusion Criteria</label>
                        <textarea @bind="inclusionCriteria" rows="2" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner resize-none transition-all"></textarea>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Exclusion Criteria</label>
                        <textarea @bind="exclusionCriteria" rows="2" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner resize-none transition-all"></textarea>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Artifact Target</label>
                        <select @onchange="HandlePresetArtifactSelection" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner transition-all mb-1.5 font-sans">
                            <option value="Custom">Custom Target Directive...</option>
                            <option value="LoopModel" selected>Conceptual Architectural Loop Diagram (Mermaid / TikZ)</option>
                            <option value="Patterns">Bullet-Point System Safety Design Patterns Spec</option>
                            <option value="Matrix">Comparative Multi-Agent Architectural Trade-off Matrix</option>
                        </select>
                        <textarea @bind="synthesisTargetDirective" rows="2" class="w-full p-2 bg-gray-50 border border-gray-300 rounded focus:outline-none focus:border-[#003B5C] text-xs shadow-inner resize-none transition-all font-mono" placeholder="Provide instructions on what the engine should create in section 4 based on the retrieved data facts..."></textarea>
                    </div>

                    <div class="pt-1 grid grid-cols-2 gap-2 items-center">
                        <label class="relative flex items-center cursor-pointer select-none text-xs text-gray-700 font-semibold gap-2">
                            <input type="checkbox" @bind="requirePeerReview" class="w-4 h-4 text-[#003B5C] bg-gray-50 border-gray-300 rounded focus:ring-[#003B5C] focus:ring-2 transition-all accent-[#003B5C]" />
                            <span>Peer-Reviewed Only</span>
                        </label>
                        
                        <div>
                            <label class="block text-[10px] font-bold uppercase text-gray-500 mb-0.5">Max Results of Each Source</label>
                            <input type="number" min="1" max="@maxResultsCeiling" @bind="maxResults" class="w-full p-1 bg-gray-50 border border-gray-300 rounded text-xs text-center font-mono focus:outline-none focus:border-[#003B5C]" />
                            @if (quotaStatus.Tier == AuBtechReviewAgent.QuotaTier.Free)
                            {
                                <span class="block text-[9px] text-gray-400 mt-0.5">Free tier: at most @maxResultsCeiling</span>
                            }
                        </div>
                    </div>

                    <fieldset>
                        <legend class="block text-[11px] font-bold uppercase text-gray-600 mb-1">Sources</legend>
                        <div class="grid grid-cols-2 gap-x-3 gap-y-1">
                            @foreach (var source in AuBtechReviewAgent.SourceCatalog.All)
                            {
                                bool available = sourceAvailability.TryGetValue(source.Key, out var ok) && ok;
                                <label class="flex items-center gap-2 text-xs select-none @(available ? "text-gray-700 cursor-pointer" : "text-gray-400 cursor-not-allowed")"
                                       title="@(available ? "" : $"Needs an {source.KeyLabel}. Add one under API Credentials.")">
                                    <input type="checkbox" class="w-4 h-4 rounded accent-[#003B5C]"
                                           checked="@(available && State.SelectedSources.Contains(source.Key))"
                                           disabled="@(!available || isSearching)"
                                           @onchange="e => ToggleSource(source.Key, e)" />
                                    <span>@source.DisplayName</span>
                                    @if (!available)
                                    {
                                        <span class="text-[9px] uppercase tracking-wide">(needs key)</span>
                                    }
                                </label>
                            }
                        </div>
                        @if (SelectedAvailableSources().Count == 0)
                        {
                            <p class="text-[11px] text-red-700 mt-1">Select at least one source.</p>
                        }
                    </fieldset>

                    <label class="flex items-start gap-2 text-xs text-gray-700 font-semibold cursor-pointer select-none">
                        <input type="checkbox" @bind="State.ReviewScreeningFirst" disabled="@isSearching" class="w-4 h-4 mt-0.5 rounded accent-[#003B5C]" />
                        <span>Let me check the screening decisions before the write-up
                            <span class="block font-normal text-[10px] text-gray-500">The run pauses after screening so you can include or exclude papers yourself. Your decisions are recorded in the ledger.</span>
                        </span>
                    </label>
                </div>

                <div class="pt-3 flex-none">
                    <button @onclick="StartReviewProcess" disabled="@(isSearching || !quotaStatus.Allowed || SelectedAvailableSources().Count == 0)" class="w-full py-2.5 px-4 text-white text-xs font-bold uppercase tracking-wider rounded transition-all hover:bg-opacity-95 disabled:opacity-50 shadow-sm" style="background-color: #003B5C;">
                        @if (isSearching)
                        {
                            <span class="flex items-center justify-center gap-2">
                                <span class="animate-spin inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full"></span>
                                <span>PARSING ENGINE...</span>
                            </span>
                        }
                        else
                        {
                            <span>Execute Search</span>
                        }
                    </button>
                </div>
            </div>

            @if (hasRun)
            {
                <div class="bg-white border border-gray-200 rounded-lg p-3 shadow-sm flex-none text-left space-y-1">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Run status</span>
                        <span class="text-[11px] font-semibold @(StageColor())">@StageLabel()</span>
                    </div>
                    @if (!string.IsNullOrEmpty(failureMessage))
                    {
                        <p class="text-[11px] text-red-700">@failureMessage</p>
                    }
                    <p class="text-[10px] text-gray-500 leading-snug">
                        Link to this run: <a class="text-[#003B5C] underline break-all" href="@($"/review/{currentSessionId}")">@($"/review/{currentSessionId}")</a>.
                        Anyone with the link can open it. Results are kept for @RunsOptions.RetentionDays days@(completedUtc.HasValue ? $" (until {completedUtc.Value.AddDays(RunsOptions.RetentionDays):yyyy-MM-dd} UTC)" : "").
                    </p>
                </div>
            }

            <PrismaFunnel Stats="State.Stats" Removed="State.RemovedBeforeScreening" Running="isSearching" />
        </div>

        <div class="lg:col-span-7 flex flex-col min-w-0 h-[32rem] lg:h-auto lg:min-h-0 border border-gray-200 rounded-lg bg-white shadow-sm overflow-hidden">
            @if (awaitingReview && reviewLogs != null)
            {
                <ScreeningReviewPanel RunId="currentSessionId" Logs="reviewLogs" OnSubmitted="OnScreeningReviewSubmitted" />
            }
            else
            {
                <div class="bg-gray-800 text-white px-4 py-2.5 text-xs font-mono flex justify-between items-center flex-none">
                    <span>JSON output</span>
                    <span class="text-[9px] opacity-50 uppercase tracking-widest font-bold">Mistral LLM</span>
                </div>
                <div class="flex-1 min-h-0 bg-gray-950 p-4 font-mono text-xs text-green-400 overflow-y-auto whitespace-pre-wrap break-words leading-relaxed">
                    @rawJsonLogs
                </div>
            }
        </div>

    </div>
</div>

@if (showKeyModal)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-[100] p-4 font-sans animate-fadeIn">
        <div class="bg-white border border-gray-200 w-full max-w-md rounded-lg shadow-2xl overflow-hidden flex flex-col text-left">
            <div class="bg-[#003B5C] text-white p-4 flex justify-between items-center">
                <div>
                    <h3 class="text-sm font-bold tracking-tight uppercase">Credential Vault Config</h3>
                    <p class="text-[10px] opacity-70 font-mono mt-0.5">Isolate Custom Session Keys via SignalR Enclave</p>
                </div>
                <button @onclick="CloseKeyModal" class="text-white/60 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="p-4 space-y-3 overflow-y-auto text-xs text-gray-700">
                <div class="bg-blue-50 border border-blue-100 text-blue-800 p-2.5 rounded text-[11px] leading-normal font-light">
                    <strong>Browser Encryption Notice:</strong> Keys entered here are encrypted and stored purely inside your browser's local tab session. They never touch public logs, are never saved on server disks, and vanish completely when the tab is closed. With your own Mistral key the free-tier daily limit does not apply.
                </div>
                <div>
                    <label class="block font-bold text-gray-600 mb-1 uppercase text-[10px]">Mistral AI Large API Key</label>
                    <input type="password" placeholder="Defaults to server standard key if blank..." @bind="modalMistral" class="w-full p-2 border border-gray-300 rounded font-mono focus:outline-none focus:border-[#003B5C]" />
                </div>
                <div>
                    <label class="block font-bold text-gray-600 mb-1 uppercase text-[10px]">Elsevier / Scopus Scopus Key</label>
                    <input type="password" placeholder="Defaults to server standard key if blank..." @bind="modalElsevier" class="w-full p-2 border border-gray-300 rounded font-mono focus:outline-none focus:border-[#003B5C]" />
                </div>
                <div>
                    <label class="block font-bold text-gray-600 mb-1 uppercase text-[10px]">IEEE Xplore Gateway Key</label>
                    <input type="password" placeholder="Optional..." @bind="modalIeee" class="w-full p-2 border border-gray-300 rounded font-mono focus:outline-none focus:border-[#003B5C]" />
                </div>
                <div>
                    <label class="block font-bold text-gray-600 mb-1 uppercase text-[10px]">SerpApi Key (Google Scholar / ResearchGate)</label>
                    <input type="password" placeholder="Optional..." @bind="modalScholar" class="w-full p-2 border border-gray-300 rounded font-mono focus:outline-none focus:border-[#003B5C]" />
                </div>
                <div class="pt-2 border-t border-gray-100">
                    <label class="block font-bold text-gray-600 mb-1 uppercase text-[10px]">Developer Access Token</label>
                    <input type="password" placeholder="Only for the maintainers of this deployment" @bind="modalAdminToken" class="w-full p-2 border border-gray-300 rounded font-mono focus:outline-none focus:border-[#003B5C]" />
                    <p class="text-[10px] text-gray-400 mt-1">Removes the daily run limit. Set with Quota:AdminToken on the server.</p>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 border-t border-gray-200 flex justify-end gap-2">
                <button @onclick="ClearVault" class="px-3 py-1.5 text-xs text-red-600 hover:text-red-800 transition-colors uppercase font-semibold">Clear Session</button>
                <button @onclick="SaveSessionKeys" class="px-4 py-1.5 text-xs text-white font-bold bg-[#003B5C] rounded shadow hover:bg-opacity-95 uppercase tracking-wide transition-all">Apply to Session</button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private UiStateContainer State { get; set; } = default!;

    private string searchQuery { get => State.SearchQuery; set => State.SearchQuery = value; }
    private string reviewObjective { get => State.ReviewObjective; set => State.ReviewObjective = value; }
    private string inclusionCriteria { get => State.InclusionCriteria; set => State.InclusionCriteria = value; }
    private string exclusionCriteria { get => State.ExclusionCriteria; set => State.ExclusionCriteria = value; }
    private DateTime dateFrom { get => State.DateFrom; set => State.DateFrom = value; }
    private DateTime dateTo { get => State.DateTo; set => State.DateTo = value; }
    private bool requirePeerReview { get => State.RequirePeerReview; set => State.RequirePeerReview = value; }
    private string synthesisTargetDirective { get => State.SynthesisTargetDirective; set => State.SynthesisTargetDirective = value; }

    private string rawJsonLogs { get => State.RawJsonLogs; set => State.RawJsonLogs = value; }
    private int totalIdentified { get => State.TotalIdentified; set => State.TotalIdentified = value; }
    private int screenedCount { get => State.ScreenedCount; set => State.ScreenedCount = value; }
    private int excludedCount { get => State.ExcludedCount; set => State.ExcludedCount = value; }
    private int includedCount { get => State.IncludedCount; set => State.IncludedCount = value; }
    private bool isSearching { get => State.IsSearching; set => State.IsSearching = value; }

    private int maxResults { get; set; } = 5;

    private bool showKeyModal = false;
    private AuBtechReviewAgent.UserApiKeys? sessionKeys = null;

    // Run quota: the client's address is read once when the component starts (from the HTTP request
    // behind the prerender or the SignalR connection) and used as the quota key for this session.
    private string clientAddress = "unknown";

    // Captured during prerendering (a normal HTTP request, so the address is reliable) and carried into
    // the interactive circuit through persisted component state, which Blazor Server protects with Data
    // Protection so the browser cannot change it. The HttpContextAccessor value is only a fallback.
    [PersistentState]
    public string? PrerenderClientAddress { get; set; }
    private string adminToken = "";
    private string modalAdminToken = "";
    private string quotaNotice = "";
    private AuBtechReviewAgent.QuotaStatus quotaStatus = new(AuBtechReviewAgent.QuotaTier.Free, true, 0, 0, "");
    private IReadOnlyDictionary<string, bool> sourceAvailability = new Dictionary<string, bool>();

    private bool hasOwnMistralKey => !string.IsNullOrWhiteSpace(sessionKeys?.MistralApiKey);
    private AuBtechReviewAgent.QuotaTier currentTier => Quota.ResolveTier(hasOwnMistralKey, adminToken);
    private int maxResultsCeiling => Quota.MaxResultsFor(currentTier, 50);

    private void RefreshQuotaAndSources()
    {
        quotaStatus = Quota.GetStatus(clientAddress, currentTier);
        sourceAvailability = ReviewEngine.GetSourceAvailability(sessionKeys);
        if (maxResults > maxResultsCeiling) maxResults = maxResultsCeiling;
    }

    private List<string> SelectedAvailableSources() =>
        State.SelectedSources.Where(k => sourceAvailability.TryGetValue(k, out var ok) && ok).ToList();

    private void ToggleSource(string key, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked) State.SelectedSources.Add(key);
        else State.SelectedSources.Remove(key);
    }

    private string modalMistral = "";
    private string modalElsevier = "";
    private string modalIeee = "";
    private string modalScholar = "";

    [Inject] private AuBtechReviewAgent.RunsOptions RunsOptions { get; set; } = default!;

    /// <summary>Set when the page is opened as /review/{RunId}: shows that run (and resumes following it if it is still going).</summary>
    [Parameter] public Guid? RunId { get; set; }

    private Guid currentSessionId
    {
        get => State.CurrentSessionId;
        set => State.CurrentSessionId = value;
    }
    private bool hasRun => State.CurrentSessionId != Guid.Empty;

    private string stage = "";
    private int queuePosition;
    private string? failureMessage;
    private DateTime? completedUtc;
    private bool awaitingReview;
    private IReadOnlyList<AuBtechReviewAgent.ScreeningLog>? reviewLogs;
    private CancellationTokenSource? monitorCts;
    private bool subscribed;

    protected override void OnInitialized()
    {
        PrerenderClientAddress ??= AuBtechReviewAgent.RunQuotaService.NormalizeClientAddress(HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress);
        clientAddress = PrerenderClientAddress;
        RefreshQuotaAndSources();
    }

    protected override void OnParametersSet()
    {
        // Opening /review/{id} (after a reload, from a bookmark, or from another device) attaches this page to
        // that run. Opening plain /review keeps whatever run this tab already shows.
        if (RunId is Guid id && id != Guid.Empty && (id != currentSessionId || !subscribed))
        {
            AttachToRun(id);
        }
        else if (hasRun && !subscribed)
        {
            AttachToRun(currentSessionId);
        }
    }

    private void AttachToRun(Guid id)
    {
        currentSessionId = id;
        var state = ReviewEngine.LoadState(id);
        if (state == null)
        {
            stage = "";
            failureMessage = "This run could not be found. It may have expired and been deleted.";
            isSearching = false;
            return;
        }

        ApplyState(state, File.Exists(StatePath(id)) ? SafeRead(StatePath(id)) : null);
        isSearching = ReviewEngine.IsRunActive(id);
        if (isSearching)
        {
            Subscribe();
            StartLogMonitoringLoop();
        }
    }

    private string StatePath(Guid id) =>
        Path.Combine(ReviewEngine.WorkspaceRoot, id.ToString("N"), "transparent-process.json");

    private static string? SafeRead(string path)
    {
        try
        {
            using var fileStream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
            using var reader = new StreamReader(fileStream);
            return reader.ReadToEnd();
        }
        catch { return null; }
    }

    private void ApplyState(AuBtechReviewAgent.ReviewState state, string? rawJson)
    {
        var s = state.Stats;
        State.Stats = s;
        State.RemovedBeforeScreening = state.RemovedBeforeScreening;
        totalIdentified = s.TotalIdentified;
        screenedCount = s.Screened;
        excludedCount = s.Excluded + s.FailedPeerReviewCheck;
        includedCount = s.Included;
        State.PassedPeerReviewCount = s.PassedPeerReviewCheck;
        State.FailedPeerReviewCount = s.FailedPeerReviewCheck;
        stage = s.ProcessingStage;
        queuePosition = s.QueuePosition;
        failureMessage = state.FailureMessage;
        completedUtc = state.CompletedUtc;
        awaitingReview = stage == AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview && ReviewEngine.IsAwaitingScreeningReview(currentSessionId);
        if (awaitingReview) reviewLogs ??= state.Phases.Screening.ToList();
        else reviewLogs = null;
        if (rawJson != null) rawJsonLogs = rawJson;
    }

    private string StageLabel() => stage switch
    {
        AuBtechReviewAgent.PrismaReviewEngine.StageQueued => queuePosition > 0 ? $"Waiting in line (position {queuePosition})" : "Waiting for a free slot",
        AuBtechReviewAgent.PrismaReviewEngine.StageScreening => "Searching and screening",
        AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview => "Waiting for your screening review",
        AuBtechReviewAgent.PrismaReviewEngine.StageSynthesizing => "Writing and checking the review",
        AuBtechReviewAgent.PrismaReviewEngine.StageComplete => "Complete",
        AuBtechReviewAgent.PrismaReviewEngine.StageFailed => "Failed",
        AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted => "Interrupted",
        "" => "Not found",
        _ => stage
    };

    private string StageColor() => stage switch
    {
        AuBtechReviewAgent.PrismaReviewEngine.StageComplete => "text-green-700",
        AuBtechReviewAgent.PrismaReviewEngine.StageFailed or AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted or "" => "text-red-700",
        AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview => "text-amber-700",
        _ => "text-[#003B5C]"
    };

    private void Subscribe()
    {
        if (subscribed) return;
        ReviewEngine.OnProgressUpdated += HandleEngineProgress;
        subscribed = true;
    }

    private void Unsubscribe()
    {
        if (!subscribed) return;
        ReviewEngine.OnProgressUpdated -= HandleEngineProgress;
        subscribed = false;
    }

    private void OnScreeningReviewSubmitted()
    {
        awaitingReview = false;
        reviewLogs = null;
        stage = AuBtechReviewAgent.PrismaReviewEngine.StageSynthesizing;
        StateHasChanged();
    }

    public void Dispose()
    {
        // The engine is a singleton: an event handler left behind would keep this page alive forever.
        Unsubscribe();
        monitorCts?.Cancel();
        monitorCts?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tokenResult = await SessionStorage.GetAsync<string>("developer_access_token");
                if (tokenResult.Success && !string.IsNullOrWhiteSpace(tokenResult.Value))
                {
                    adminToken = modalAdminToken = tokenResult.Value;
                }

                var result = await SessionStorage.GetAsync<string>("encrypted_byok_payload");
                if (result.Success && !string.IsNullOrWhiteSpace(result.Value))
                {
                    sessionKeys = JsonSerializer.Deserialize<AuBtechReviewAgent.UserApiKeys>(result.Value);
                    
                    if (sessionKeys != null)
                    {
                        modalMistral = sessionKeys.MistralApiKey ?? "";
                        modalElsevier = sessionKeys.ElsevierApiKey ?? "";
                        modalIeee = sessionKeys.IeeeApiKey ?? "";
                        modalScholar = sessionKeys.ScholarApiKey ?? "";
                    }
                }
                RefreshQuotaAndSources();
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }
    }

    private void OpenKeyModal() => showKeyModal = true;
    private void CloseKeyModal() => showKeyModal = false;

    private async Task SaveSessionKeys()
    {
        string sMistral = AuBtechReviewAgent.SecurityUtility.SanitizeInput(modalMistral);
        string sElsevier = AuBtechReviewAgent.SecurityUtility.SanitizeInput(modalElsevier);
        string sIeee = AuBtechReviewAgent.SecurityUtility.SanitizeInput(modalIeee);
        string sScholar = AuBtechReviewAgent.SecurityUtility.SanitizeInput(modalScholar);

        sessionKeys = new AuBtechReviewAgent.UserApiKeys(sMistral, sElsevier, sIeee, sScholar);

        string jsonPayload = JsonSerializer.Serialize(sessionKeys);
        await SessionStorage.SetAsync("encrypted_byok_payload", jsonPayload);

        adminToken = modalAdminToken.Trim();
        if (string.IsNullOrEmpty(adminToken)) await SessionStorage.DeleteAsync("developer_access_token");
        else await SessionStorage.SetAsync("developer_access_token", adminToken);
        quotaNotice = !string.IsNullOrEmpty(adminToken) && !Quota.IsValidAdminToken(adminToken)
            ? "The developer access token was not recognised." : "";

        RefreshQuotaAndSources();
        showKeyModal = false;
        StateHasChanged();
    }

    private async Task ClearVault()
    {
        modalMistral = modalElsevier = modalIeee = modalScholar = modalAdminToken = adminToken = "";
        sessionKeys = null;
        await SessionStorage.DeleteAsync("encrypted_byok_payload");
        await SessionStorage.DeleteAsync("developer_access_token");
        quotaNotice = "";
        RefreshQuotaAndSources();
        showKeyModal = false;
        StateHasChanged();
    }

    private void HandlePresetArtifactSelection(ChangeEventArgs e)
    {
        string chosen = e.Value?.ToString() ?? "Custom";
        synthesisTargetDirective = chosen switch
        {
            "LoopModel" => "Conceptual Architectural Loop Diagram detailing fault-tolerance gating mechanisms.",
            "Patterns" => "Create a complete numbered layout list of software design patterns for runtime safeguards and error containment.",
            "Matrix" => "Create a detailed text table matrix comparing the specific tool-use security trade-offs of the reviewed engines.",
            _ => synthesisTargetDirective
        };
    }

    private async Task StartReviewProcess()
    {
        if (isSearching) return;

        // Count the run before it starts. The check happens here on the server, so it cannot be skipped
        // from the browser, and a double click cannot start two runs on one remaining slot.
        var tier = currentTier;
        if (!Quota.TryReserve(clientAddress, tier, out var reservedStatus, out var lease))
        {
            quotaStatus = reservedStatus;
            quotaNotice = reservedStatus.Message;
            return;
        }
        quotaStatus = reservedStatus;
        quotaNotice = "";

        var runSources = SelectedAvailableSources();
        if (runSources.Count == 0)
        {
            if (lease != null) Quota.Refund(lease);
            RefreshQuotaAndSources();
            quotaNotice = "Select at least one source.";
            return;
        }
        int runMaxResults = Quota.MaxResultsFor(tier, maxResults);
        maxResults = runMaxResults;
        int yearFrom = dateFrom.Year;
        int yearTo = dateTo.Year;

        string cleanQuery = AuBtechReviewAgent.SecurityUtility.SanitizeInput(searchQuery);
        string cleanObjective = AuBtechReviewAgent.SecurityUtility.SanitizeInput(reviewObjective);
        string cleanInclusion = AuBtechReviewAgent.SecurityUtility.SanitizeInput(inclusionCriteria);
        string cleanExclusion = AuBtechReviewAgent.SecurityUtility.SanitizeInput(exclusionCriteria);
        string cleanDirective = AuBtechReviewAgent.SecurityUtility.SanitizeInput(synthesisTargetDirective);

        State.Stats = new ReviewStats();
        State.RemovedBeforeScreening = new();
        totalIdentified = 0;
        screenedCount = 0;
        excludedCount = 0;
        includedCount = 0;
        State.PassedPeerReviewCount = 0;
        State.FailedPeerReviewCount = 0;
        failureMessage = null;
        completedUtc = null;
        awaitingReview = false;
        reviewLogs = null;
        stage = AuBtechReviewAgent.PrismaReviewEngine.StageQueued;
        isSearching = true;
        rawJsonLogs = "{\n  \"status\": \"Starting run...\"\n}";

        var runId = Guid.NewGuid();
        currentSessionId = runId;
        var request = new AuBtechReviewAgent.ReviewRequest(
            cleanQuery, cleanObjective, cleanInclusion, cleanExclusion, runMaxResults,
            requirePeerReview, cleanDirective, sessionKeys, runSources, yearFrom, yearTo, State.ReviewScreeningFirst);

        Subscribe();

        _ = Task.Run(async () =>
        {
            try
            {
                await ReviewEngine.RunReviewAsync(runId, request);
            }
            catch (Exception ex)
            {
                // The run failed: give the quota slot back. The reason is stored in the run's ledger.
                if (lease != null) Quota.Refund(lease);
                Console.WriteLine($"[Run {runId:N}] failed: {ex.Message}");
            }
            finally
            {
                if (runId == currentSessionId)
                {
                    await InvokeAsync(() =>
                    {
                        isSearching = false;
                        var final = ReviewEngine.LoadState(runId);
                        if (final != null) ApplyState(final, SafeRead(StatePath(runId)));
                        RefreshQuotaAndSources();
                        StateHasChanged();
                    });
                }
            }
        });

        // Put the run in the address bar so a reload, a bookmark or another device can find it again.
        Nav.NavigateTo($"/review/{runId}", replace: true);
        StartLogMonitoringLoop();
    }

    private void StartLogMonitoringLoop()
    {
        monitorCts?.Cancel();
        monitorCts = new CancellationTokenSource();
        var token = monitorCts.Token;
        Guid runId = currentSessionId;

        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested && isSearching && runId == currentSessionId)
            {
                try { await Task.Delay(1000, token); } catch (TaskCanceledException) { break; }
                string? raw = SafeRead(StatePath(runId));
                if (raw == null) continue;
                try
                {
                    var state = JsonSerializer.Deserialize<AuBtechReviewAgent.ReviewState>(raw);
                    if (state == null) continue;
                    await InvokeAsync(() =>
                    {
                        if (runId != currentSessionId) return;
                        ApplyState(state, raw);
                        StateHasChanged();
                    });
                }
                catch { /* the ledger was mid-write; try again next tick */ }
            }
        });
    }

    private void HandleEngineProgress(Guid runSessionId, ReviewStats updatedStats)
    {
        // The engine is shared by all users; only react to this dashboard's own run.
        if (runSessionId != currentSessionId) return;

        InvokeAsync(() =>
        {
            State.Stats = updatedStats;
            totalIdentified = updatedStats.TotalIdentified;
            screenedCount = updatedStats.Screened;
            excludedCount = updatedStats.Excluded;
            includedCount = updatedStats.Included;
            
            State.PassedPeerReviewCount = updatedStats.PassedPeerReviewCheck;
            State.FailedPeerReviewCount = updatedStats.FailedPeerReviewCheck;
            
            stage = updatedStats.ProcessingStage;
            queuePosition = updatedStats.QueuePosition;
            excludedCount = updatedStats.Excluded + updatedStats.FailedPeerReviewCheck;
            if (stage == AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview && !awaitingReview)
            {
                var state = ReviewEngine.LoadState(currentSessionId);
                if (state != null) ApplyState(state, null);
            }
            if (AuBtechReviewAgent.PrismaReviewEngine.IsFinishedStage(stage))
            {
                isSearching = false;
            }
            
            StateHasChanged();
        });
    }
}