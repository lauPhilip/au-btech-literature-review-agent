    /// <summary>Why the review cannot start yet, or null when it can. Shown next to the button, not after a click.</summary>
    private string? StartBlocker()
    {
        if (!quotaStatus.Allowed) return string.IsNullOrWhiteSpace(quotaStatus.Message) ? "No runs left for now." : quotaStatus.Message;
        if (string.IsNullOrWhiteSpace(searchQuery)) return "Add a search query (step 1).";
        if (string.IsNullOrWhiteSpace(inclusionCriteria)) return "Say which studies to include (step 2).";
        if (SelectedAvailableSources().Count == 0) return "Select at least one source (step 3).";
        return null;
    }

    private string SettingsLine()
    {
        int sources = SelectedAvailableSources().Count;
        var parts = new List<string> { $"{sources} source{(sources == 1 ? "" : "s")}", $"{yearFrom}–{yearTo}", $"up to {maxResults} records each" };
        if (State.DualScreening) parts.Add("dual screening");
        if (State.CitationChaining) parts.Add("citation chaining");
        if (State.ArtifactKind != AuBtechReviewAgent.ArtifactKinds.None) parts.Add(ArtifactLabel()!.ToLowerInvariant());
        return string.Join(" · ", parts);
    }

