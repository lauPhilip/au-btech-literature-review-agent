@page "/review"
@page "/review/{RunId:guid}"
@layout AppLayout
@rendermode InteractiveServer
@implements IDisposable

@using System.IO
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AuBtechReviewAgent.PrismaReviewEngine ReviewEngine
@inject AuBtechReviewAgent.RunStore Runs
@inject ProtectedSessionStorage SessionStorage
@inject IJSRuntime JS
@inject AuBtechReviewAgent.RunQuotaService Quota
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@inject ILogger<Home> Logger

<SeoHead Title="@TabTitle()" Path="/review" NoIndex="@(RunId != null)" Description="Start a PRISMA 2020 literature review: give your question and criteria, and TraceableAI searches, screens, writes and checks every citation against the paper." />

@if (Composing)
{
    @* Ask (redesign step 6): the composer in a centred column of at most 760 px and the criteria beside it from
       1024 px (380 px wide, 440 px from 1600 px), below it on smaller screens. Running and Done keep the older
       two-column view below until redesign step 7. *@
    <div class="mx-auto w-full max-w-[1600px] px-[clamp(16px,3vw,40px)] py-4 sm:py-10">
        @if (!string.IsNullOrEmpty(quotaNotice))
        {
            <p class="mx-auto mb-4 max-w-[760px] text-xs text-not-supported" role="alert">@quotaNotice</p>
        }
        <div class="grid grid-cols-1 items-start gap-4 sm:gap-6 lg:grid-cols-[minmax(0,760px)_380px] lg:justify-center xl:gap-10 min-[1600px]:grid-cols-[minmax(0,760px)_440px]">
            <ReviewComposer Method="ReviewMethod" Quota="quotaStatus" InputCheck="inputCheck" Busy="isSearching"
                            OnChanged="FormChanged" OnStart="StartOrShowProblem" OnLoadExample="LoadExample" OnOpenKeys="OpenKeyModal">
                <Notice>
                    @if (prefillNotice != null)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-2 rounded-field border border-abstract-only-border bg-abstract-only-fill p-2 text-xs text-abstract-only">
                            <span>@prefillNotice</span>
                            @if (showStartEmpty)
                            {
                                <button type="button" @onclick="StartEmpty" class="ui-btn ui-btn-sm py-1 text-abstract-only hover:bg-abstract-only-fill">Start empty</button>
                            }
                        </div>
                    }
                </Notice>
                <Problems>
                    @if (inputCheck is { IsValid: false } failedCheck)
                    {
                        <div class="space-y-0.5 rounded-field border border-not-supported-border bg-not-supported-fill p-2 text-xs text-not-supported" role="alert">
                            @foreach (var error in failedCheck.Errors)
                            {
                                <p>@error</p>
                            }
                        </div>
                    }
                    else if (pendingFlagSignature != null && inputCheck != null)
                    {
                        <div class="space-y-1 rounded-field border border-partly-border bg-partly-fill p-2 text-xs text-partly" role="alert">
                            <p class="font-semibold">Some of your text reads like instructions to the language model:</p>
                            <ul class="list-disc space-y-0.5 pl-4">
                                @foreach (var flag in inputCheck.Flags)
                                {
                                    <li>@flag.ToString()</li>
                                }
                            </ul>
                            <p>The model is told to treat your fields only as the topic and criteria, so this usually changes nothing. If it is what you meant, start anyway; the warning is written to the protocol.</p>
                            <button type="button" @onclick="ConfirmFlaggedInput" class="ui-btn ui-btn-sm bg-partly text-page hover:opacity-90">Start anyway</button>
                        </div>
                    }
                    @* "Start review" is never silently disabled: the reason sits above it and takes you to the field. *@
                    @if (StartBlocker() is { } blocker)
                    {
                        <div class="space-y-2">
                            @if (BlockerTarget() != null)
                            {
                                <button type="button" @onclick="GoToProblem" class="block min-h-[24px] text-left text-sm text-partly underline decoration-dotted underline-offset-2 hover:text-partly">@blocker</button>
                            }
                            else
                            {
                                <p class="text-sm text-partly">@blocker</p>
                                @if (!quotaStatus.Allowed && quotaStatus.Tier == AuBtechReviewAgent.QuotaTier.Free)
                                {
                                    <button type="button" @onclick="OpenKeyModal" class="ui-btn-secondary ui-btn-sm">Add your own Mistral key</button>
                                }
                            }
                        </div>
                    }
                </Problems>
            </ReviewComposer>

            <div class="mx-auto w-full max-w-[760px] min-w-0 lg:max-w-none">
                <CriteriaPanel @bind-Open="criteriaOpen" MethodName="@ReviewMethod.Name" SourceAvailability="sourceAvailability"
                               InputCheck="inputCheck" Busy="isSearching" OnChanged="FormChanged">
                    <MoreOptions>
                        <div class="space-y-3">

                    <details class="group rounded-field border border-line" open="@(reviewedSearchStrings != null)">
                        <summary class="flex min-h-[44px] cursor-pointer select-none items-center justify-between px-3 py-2 text-sm text-ink">
                            <span>Search strings</span>
                            <span class="text-[11px] text-muted">@(reviewedSearchStrings == null ? "chosen by the model" : $"{reviewedSearchStrings.Count + 1} reviewed")</span>
                        </summary>
                        <fieldset id="f-strings" class="px-3 pb-3 pt-3" tabindex="-1" aria-describedby="h-strings">
                            <legend class="@LabelClass">Search strings <Term Key="search-strings" Icon="true" /></legend>
                            @if (reviewedSearchStrings == null)
                            {
                                <p id="h-strings" class="text-xs text-muted leading-snug">The model adds up to three other phrasings of your query during the run. Preview them to check and edit them before anything is searched.</p>
                                <button type="button" @onclick="PreviewSearchStrings" disabled="@(previewingStrings || string.IsNullOrWhiteSpace(searchQuery) || previewsLeft <= 0)"
                                        class="ui-btn ui-btn-sm mt-2 border border-line-field text-ink hover:border-heading disabled:opacity-50">
                                    @(previewingStrings ? "Asking the model…" : "Preview search strings")
                                </button>
                            }
                            else
                            {
                                <p id="h-strings" class="text-xs text-muted leading-snug">These are searched as they are, after your query; the report records that you approved them.</p>
                                <ol class="mt-2 space-y-1.5">
                                    <li class="flex items-center gap-2 text-sm text-ink"><span class="w-4 text-right text-xs text-muted">1</span><span class="truncate" title="@searchQuery">@searchQuery</span><span class="text-[10px] text-muted whitespace-nowrap">(your query)</span></li>
                                    @for (int i = 0; i < reviewedSearchStrings.Count; i++)
                                    {
                                        int index = i;
                                        <li class="flex items-center gap-2">
                                            <span class="w-4 text-right text-xs text-muted">@(index + 2)</span>
                                            <input type="text" aria-label="@($"Search string {index + 2}")" maxlength="@AuBtechReviewAgent.ReviewInputGuard.MaxSearchString"
                                                   value="@reviewedSearchStrings[index]" @onchange="e => reviewedSearchStrings[index] = e.Value?.ToString() ?? string.Empty" class="@InputClass py-1" />
                                            <button type="button" @onclick="() => reviewedSearchStrings.RemoveAt(index)" class="ui-btn ui-btn-sm px-2 text-muted hover:text-not-supported" aria-label="@($"Remove search string {index + 2}")">✕</button>
                                        </li>
                                    }
                                </ol>
                                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                                    @if (reviewedSearchStrings.Count < AuBtechReviewAgent.ReviewInputGuard.MaxSearchStrings)
                                    {
                                        <button type="button" @onclick="() => reviewedSearchStrings.Add(string.Empty)" class="text-heading font-medium hover:underline">Add a search string</button>
                                    }
                                    <button type="button" @onclick="() => reviewedSearchStrings = null" class="text-muted hover:underline">Let the model choose during the run</button>
                                </div>
                                @if (previewQuery != null && !string.Equals(previewQuery, searchQuery?.Trim(), StringComparison.OrdinalIgnoreCase))
                                {
                                    <p class="mt-1.5 text-[11px] text-partly">Your query changed after the preview. Check that these still fit.</p>
                                }
                            }
                            @if (previewError != null)
                            {
                                <p class="mt-1.5 text-[11px] text-not-supported" role="alert">@previewError</p>
                            }
                        </fieldset>
                    </details>
                    <details class="group rounded-field border border-line">
                        <summary class="flex min-h-[44px] cursor-pointer select-none items-center justify-between px-3 py-2 text-sm text-ink">
                            <span>Advanced options</span>
                            <span class="text-[11px] text-muted">@AdvancedSummary()</span>
                        </summary>
                        <div class="px-3 pb-3 space-y-3 border-t border-line pt-3">
                            @Option("o-dual", "dual-screening", "Screen every record twice", "Two independent screening prompts; disagreements are kept and flagged, and the agreement (Cohen's kappa) is reported.", State.DualScreening, v => State.DualScreening = v)
                            @Option("o-chaining", "citation-chaining", "Citation chaining", "Also screen the papers the included studies cite and the papers citing them (one round, via OpenAlex).", State.CitationChaining, v => State.CitationChaining = v)
                            @Option("o-check", "screening", "Let me check the screening decisions", "The run pauses after screening so you can include or exclude papers yourself.", State.ReviewScreeningFirst, v => State.ReviewScreeningFirst = v)
                            @Option("o-peer", null, "Peer-reviewed only", "Leave out preprints and working papers before screening.", requirePeerReview, v => requirePeerReview = v)
                            <div class="flex items-center justify-between gap-3">
                                <label for="f-max" class="text-sm text-ink">Records per source
                                    <span class="block text-xs text-muted">@(quotaStatus.Tier == AuBtechReviewAgent.QuotaTier.Free ? $"Free tier: at most {maxResultsCeiling}." : "More records take longer.")</span>
                                </label>
                                <input id="f-max" type="number" min="1" max="@maxResultsCeiling" @bind="maxResults" class="@InputClass w-20 text-center" />
                            </div>
                        </div>
                    </details>
                        </div>
                    </MoreOptions>
                </CriteriaPanel>
            </div>
        </div>
    </div>
}
else
{
    @* Running and Done (redesign step 7): RunProgressPanel shows a run that is going, waiting or stopped, and
       RunSummaryCard a finished one, each in the same centred column as the composer with a side column beside it.
       The page adds what only it knows: the reason a run stopped, the browser notification, the human screening
       check, the live log, the PRISMA funnel, and the run's own card with its link, settings, Delete and New review. *@
    @* Screen readers hear the step changes and the end of the run, not every percent (WCAG 4.1.3). *@
    <p class="sr-only" role="status" aria-live="polite">@Announcement()</p>
    @if (!string.IsNullOrEmpty(quotaNotice))
    {
        <p class="mx-auto mt-4 max-w-[760px] px-4 text-xs text-not-supported" role="alert">@quotaNotice</p>
    }
    @if (stage == AuBtechReviewAgent.PrismaReviewEngine.StageComplete)
    {
        <RunSummaryCard Stats="State.Stats" RunId="currentSessionId" Objective="@ObjectiveShown()">
            <Main>@LogPanel()</Main>
            <Side>@RunCard()</Side>
        </RunSummaryCard>
    }
    else
    {
        <RunProgressPanel Stats="State.Stats" Stage="@stage" Running="isSearching" QueuePosition="queuePosition" CompletedUtc="completedUtc"
                          Objective="@ObjectiveShown()" SourceCount="SourcesShown().Count" LogShown="showLog" OnShowLog="ToggleLog">
            <Notice>
                @if (!string.IsNullOrEmpty(failureMessage))
                {
                    <div class="mt-4 rounded-field border border-not-supported-border bg-not-supported-fill p-3 text-sm text-not-supported" role="alert">
                        <p>@failureMessage</p>
                        @if (stage is AuBtechReviewAgent.PrismaReviewEngine.StageFailed or AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted)
                        {
                            <p class="mt-1.5 text-xs">
                                Run <span class="font-mono select-all">@currentSessionId</span> · version @AppVersionShort ·
                                <a href="@AuBtechReviewAgent.SiteSeo.ProblemReportUrl(currentSessionId, AppVersionShort, stage)" target="_blank" rel="noopener" class="font-semibold underline underline-offset-2">Report this problem</a>
                                (the report includes the run ID and version, not your question)
                            </p>
                        }
                    </div>
                }
            </Notice>
            <Notify>
                @if (isSearching && notifyPermission is "default" or "granted")
                {
                    @* Runs take minutes; people switch tabs. The tab title shows the progress, and this asks the browser to say when it is done. *@
                    @if (notifyPermission == "granted")
                    {
                        <p class="mt-2 text-sm text-muted">You will get a browser notification when the review is ready, if this tab is in the background.</p>
                    }
                    else
                    {
                        <button type="button" @onclick="AskForNotification" class="ui-btn-secondary mt-3 min-h-[44px] w-full">Notify me when it is ready</button>
                    }
                }
            </Notify>
            <Main>
                @if (awaitingReview && reviewLogs != null)
                {
                    @if (canEdit)
                    {
                        <div class="ui-card mt-4 flex h-[70vh] flex-col overflow-hidden">
                            <ScreeningReviewPanel RunId="currentSessionId" EditKey="@editKey" Logs="reviewLogs" OnSubmitted="OnScreeningReviewSubmitted" />
                        </div>
                    }
                    else
                    {
                        <p class="ui-card mt-4 p-4 text-sm text-ink">This run is waiting for the person who started it to check the screening decisions. Only the browser that started a run can do that.</p>
                    }
                }
                @LogPanel()
                <details class="ui-card mt-4 p-4 max-sm:hidden sm:p-5" open>
                    <summary class="flex min-h-[44px] cursor-pointer items-center font-display text-sm font-semibold text-heading">Records so far</summary>
                    <div class="mt-2">
                        <PrismaFunnel Stats="State.Stats" Removed="State.RemovedBeforeScreening" Running="isSearching"
                                      Yields="State.SearchStringYields" ExclusionGroups="State.ExclusionGroups" />
                    </div>
                </details>
            </Main>
            <Side>@RunCard()</Side>
        </RunProgressPanel>
    }
}

@if (showKeyModal)
{
    @* A modal dialog: Escape closes it, Tab stays inside it, and focus returns to the "API keys" button. *@
    <div class="fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-[100] p-4 font-sans animate-fadeIn" @onkeydown="KeyDialogKeyDown">
        <div id="key-dialog" role="dialog" aria-modal="true" aria-labelledby="key-dialog-title" aria-describedby="key-dialog-note"
             class="bg-page border border-line w-full max-w-md shadow-lift overflow-hidden flex flex-col text-left">
            <div class="bg-primary text-primary-on px-5 py-4 flex justify-between items-center">
                <div>
                    <h2 id="key-dialog-title" class="text-base font-semibold">API keys</h2>
                    <p class="text-xs text-primary-on/75 mt-0.5">Kept only in this browser tab</p>
                </div>
                <button type="button" @onclick="CloseKeyModal" aria-label="Close" class="ui-btn ui-btn-sm text-primary-on/80 hover:text-primary-on hover:bg-primary-on/10 px-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="p-5 space-y-4 overflow-y-auto text-sm text-ink">
                <p id="key-dialog-note" class="bg-active border border-line-field text-ink p-3 text-xs leading-relaxed">
                    Your keys are kept encrypted in this browser tab only. They are not written to the server's disk or logs, and they are gone when you close the tab. With your own Mistral key the free-tier daily limit does not apply.
                </p>
                <div>
                    <label for="k-mistral" class="ui-label text-xs">Mistral API key</label>
                    <input id="k-mistral" type="password" autocomplete="off" placeholder="Uses the server key when empty" @bind="modalMistral" class="ui-input font-mono text-xs" />
                </div>
                <div>
                    <label for="k-elsevier" class="ui-label text-xs">Elsevier (Scopus / ScienceDirect) API key</label>
                    <input id="k-elsevier" type="password" autocomplete="off" placeholder="Uses the server key when empty" @bind="modalElsevier" class="ui-input font-mono text-xs" />
                </div>
                <div>
                    <label for="k-ieee" class="ui-label text-xs">IEEE Xplore API key</label>
                    <input id="k-ieee" type="password" autocomplete="off" placeholder="Optional" @bind="modalIeee" class="ui-input font-mono text-xs" />
                </div>
                <div>
                    <label for="k-scholar" class="ui-label text-xs">Semantic Scholar API key</label>
                    <input id="k-scholar" type="password" autocomplete="off" placeholder="Optional" @bind="modalScholar" class="ui-input font-mono text-xs" />
                </div>
                <div class="pt-3 border-t border-line">
                    <label for="k-admin" class="ui-label text-xs">Developer access token</label>
                    <input id="k-admin" type="password" autocomplete="off" aria-describedby="k-admin-help" placeholder="Only for the maintainers of this deployment" @bind="modalAdminToken" class="ui-input font-mono text-xs" />
                    <p id="k-admin-help" class="text-xs text-muted mt-1">Removes the daily run limit. Set with Quota:AdminToken on the server.</p>
                </div>
            </div>
            <div class="bg-soft px-5 py-3 border-t border-line flex justify-end gap-2">
                <button type="button" @onclick="ClearVault" class="ui-btn ui-btn-sm text-not-supported hover:bg-not-supported-fill">Clear session</button>
                <button type="button" @onclick="SaveSessionKeys" class="ui-btn-primary ui-btn-sm">Apply to session</button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private UiStateContainer State { get; set; } = default!;

    private string searchQuery { get => State.SearchQuery; set => State.SearchQuery = value; }
    private string reviewObjective { get => State.ReviewObjective; set => State.ReviewObjective = value; }
    // The research questions as typed, one per line; ReviewInputGuard.ResearchQuestionLines splits them.
    private string researchQuestionsText { get => State.ResearchQuestions; set => State.ResearchQuestions = value; }
    private string inclusionCriteria { get => State.InclusionCriteria; set => State.InclusionCriteria = value; }
    private string exclusionCriteria { get => State.ExclusionCriteria; set => State.ExclusionCriteria = value; }
    private bool requirePeerReview { get => State.RequirePeerReview; set => State.RequirePeerReview = value; }
    private string synthesisTargetDirective { get => State.SynthesisTargetDirective; set => State.SynthesisTargetDirective = value; }

    private string rawJsonLogs { get => State.RawJsonLogs; set => State.RawJsonLogs = value; }
    private int totalIdentified { get => State.TotalIdentified; set => State.TotalIdentified = value; }
    private int screenedCount { get => State.ScreenedCount; set => State.ScreenedCount = value; }
    private int excludedCount { get => State.ExcludedCount; set => State.ExcludedCount = value; }
    private int includedCount { get => State.IncludedCount; set => State.IncludedCount = value; }
    private bool isSearching { get => State.IsSearching; set => State.IsSearching = value; }

    private int maxResults { get; set; } = 5;

    private bool showKeyModal = false;
    private AuBtechReviewAgent.UserApiKeys? sessionKeys = null;

    // Search-string preview: null until the reviewer previews (the model then chooses during the run).
    private List<string>? reviewedSearchStrings;
    private string? previewQuery;
    private string? previewError;
    private bool previewingStrings;
    private int previewsLeft = 5; // each preview is one model call; a page gets a few

    private async Task PreviewSearchStrings()
    {
        if (previewingStrings || previewsLeft <= 0 || string.IsNullOrWhiteSpace(searchQuery)) return;
        previewingStrings = true;
        previewError = null;
        previewsLeft--;
        try
        {
            var strings = await ReviewEngine.PreviewSearchStringsAsync(searchQuery, reviewObjective, inclusionCriteria, sessionKeys);
            reviewedSearchStrings = strings.Take(AuBtechReviewAgent.ReviewInputGuard.MaxSearchStrings).ToList();
            previewQuery = searchQuery.Trim();
            if (reviewedSearchStrings.Count == 0)
                previewError = "The model did not propose other phrasings. Add your own, or let the model try again during the run.";
        }
        catch (Exception ex)
        {
            Logger.LogInformation("Search-string preview failed: {Error}", ex.GetType().Name);
            previewError = "The preview did not work just now. The model will propose the search strings during the run instead.";
        }
        finally
        {
            previewingStrings = false;
        }
    }

    // Run quota: the client's address is read once when the component starts (from the HTTP request
    // behind the prerender or the SignalR connection) and used as the quota key for this session.
    private string clientAddress = "unknown";

    // Captured during prerendering (a normal HTTP request, so the address is reliable) and carried into
    // the interactive circuit through persisted component state, which Blazor Server protects with Data
    // Protection so the browser cannot change it. The HttpContextAccessor value is only a fallback.
    [PersistentState]
    public string? PrerenderClientAddress { get; set; }
    private string adminToken = "";
    private string modalAdminToken = "";

    // Result of ReviewInputGuard for the last "Start review" click, and the flags the user confirmed.
    private AuBtechReviewAgent.InputCheck? inputCheck;
    private string? pendingFlagSignature;
    private string? confirmedFlagSignature;

    private async Task ConfirmFlaggedInput()
    {
        confirmedFlagSignature = pendingFlagSignature;
        await StartReviewProcess();
    }
    private string quotaNotice = "";
    private AuBtechReviewAgent.QuotaStatus quotaStatus = new(AuBtechReviewAgent.QuotaTier.Free, true, 0, 0, "");
    private IReadOnlyDictionary<string, bool> sourceAvailability = new Dictionary<string, bool>();

    private bool hasOwnMistralKey => !string.IsNullOrWhiteSpace(sessionKeys?.MistralApiKey);
    private AuBtechReviewAgent.QuotaTier currentTier => Quota.ResolveTier(hasOwnMistralKey, adminToken);
    private int maxResultsCeiling => Quota.MaxResultsFor(currentTier, 50);

    private void RefreshQuotaAndSources()
    {
        quotaStatus = Quota.GetStatus(clientAddress, currentTier);
        sourceAvailability = ReviewEngine.GetSourceAvailability(sessionKeys);
        if (maxResults > maxResultsCeiling) maxResults = maxResultsCeiling;
    }

    private List<string> SelectedAvailableSources() =>
        State.SelectedSources.Where(k => sourceAvailability.TryGetValue(k, out var ok) && ok).ToList();

    private string modalMistral = "";
    private string modalElsevier = "";
    private string modalIeee = "";
    private string modalScholar = "";

    [Inject] private AuBtechReviewAgent.RunsOptions RunsOptions { get; set; } = default!;

    /// <summary>Set when the page is opened as /review/{RunId}: shows that run (and resumes following it if it is still going).</summary>
    [Parameter] public Guid? RunId { get; set; }

    /// <summary>/review?from={runId}: start a new review with the settings of an earlier run.</summary>
    [SupplyParameterFromQuery(Name = "from")] public Guid? From { get; set; }

    /// <summary>The kind of review chosen on the start page (/start); unknown or not-yet-available kinds fall back to the systematic review.</summary>
    [SupplyParameterFromQuery(Name = "method")] public string? MethodKey { get; set; }
    private AuBtechReviewAgent.ReviewMethod ReviewMethod => AuBtechReviewAgent.ReviewMethods.AvailableOrDefault(MethodKey);
    private Guid? prefilledFrom;
    private string? prefillNotice;

    // The form is shown while composing (no run on this page, or "New review" pressed); otherwise a compact
    // summary of what was asked, so the run itself gets the attention.
    private bool editingNew;
    private bool Composing => !hasRun || editingNew;
    // The criteria panel: null until the reviewer folds or opens it (then open from 1024 px only).
    private bool? criteriaOpen;
    private AuBtechReviewAgent.ReviewState? runInfo;

    private const string LabelClass = "ui-label";
    private const string InputClass = "ui-input";

    private int yearFrom
    {
        get => State.DateFrom.Year;
        set => State.DateFrom = new DateTime(Math.Clamp(value, 1900, DateTime.UtcNow.Year), 1, 1);
    }
    private int yearTo
    {
        get => State.DateTo.Year;
        set => State.DateTo = new DateTime(Math.Clamp(value, 1900, DateTime.UtcNow.Year), 12, 31);
    }

    private void SetYears(int from)
    {
        yearFrom = from;
        yearTo = DateTime.UtcNow.Year;
    }

    /// <summary>Why the review cannot start yet, or null when it can. Shown next to the button, not after a click.</summary>
    private string? StartBlocker()
    {
        if (!quotaStatus.Allowed) return string.IsNullOrWhiteSpace(quotaStatus.Message) ? "No runs left for now." : quotaStatus.Message;
        if (string.IsNullOrWhiteSpace(searchQuery)) return "Add a search query.";
        if (string.IsNullOrWhiteSpace(inclusionCriteria)) return "Say which studies to include, under Criteria.";
        if (SelectedAvailableSources().Count == 0) return "Select at least one database, under Criteria.";
        return null;
    }

    /// <summary>The field to go to for the current blocker, or null when no field can fix it (quota).</summary>
    private string? BlockerTarget()
    {
        if (!quotaStatus.Allowed) return null;
        if (string.IsNullOrWhiteSpace(searchQuery)) return "f-query";
        if (string.IsNullOrWhiteSpace(inclusionCriteria)) return "f-inclusion";
        if (SelectedAvailableSources().Count == 0) return "f-sources";
        return null;
    }

    // Field to focus after the next render (a field in the criteria panel needs the panel open first).
    private string? pendingFocus;

    /// <summary>The fields that live in the criteria panel rather than in the composer.</summary>
    private static readonly HashSet<string> CriteriaFields = new() { "f-inclusion", "f-exclusion", "f-sources", "f-directive" };

    private void FocusField(string fieldId)
    {
        if (CriteriaFields.Contains(fieldId)) criteriaOpen = true;
        pendingFocus = fieldId;
    }

    private void GoToProblem()
    {
        if (BlockerTarget() is { } fieldId) FocusField(fieldId);
    }

    /// <summary>Called by the composer and the criteria panel on every change, so the page re-checks what is missing and saves the draft.</summary>
    private void FormChanged() { }

    /// <summary>"Start review" is never silently disabled: when something is missing it takes you there instead.</summary>
    private async Task StartOrShowProblem()
    {
        if (StartBlocker() != null)
        {
            GoToProblem();
            return;
        }
        await StartReviewProcess();
    }

    // The input guard names fields by these labels; this is where each one lives in the form.
    private static readonly (string Name, string FieldId)[] FieldsByName =
    {
        ("Search query", "f-query"), ("Review objective", "f-objective"), ("Research question", "f-questions"),
        ("Inclusion criteria", "f-inclusion"), ("Exclusion criteria", "f-exclusion"), ("Artifact target", "f-directive"),
    };

    private void FocusFirstInvalidField()
    {
        if (inputCheck is not { IsValid: false }) return;
        foreach (var error in inputCheck.Errors)
        {
            var field = FieldsByName.FirstOrDefault(f => error.StartsWith(f.Name, StringComparison.Ordinal));
            if (field.FieldId != null)
            {
                FocusField(field.FieldId);
                return;
            }
        }
    }

    private string AdvancedSummary()
    {
        var on = new List<string>();
        if (State.DualScreening) on.Add("dual screening");
        if (State.CitationChaining) on.Add("chaining");
        if (State.ReviewScreeningFirst) on.Add("your check");
        if (requirePeerReview) on.Add("peer-reviewed");
        return on.Count == 0 ? $"{maxResults} per source" : $"{string.Join(", ", on)} · {maxResults} per source";
    }

