}

@code {
    [Inject] private UiStateContainer State { get; set; } = default!;

    private string searchQuery { get => State.SearchQuery; set => State.SearchQuery = value; }
    private string reviewObjective { get => State.ReviewObjective; set => State.ReviewObjective = value; }
    private string inclusionCriteria { get => State.InclusionCriteria; set => State.InclusionCriteria = value; }
    private string exclusionCriteria { get => State.ExclusionCriteria; set => State.ExclusionCriteria = value; }
    private bool requirePeerReview { get => State.RequirePeerReview; set => State.RequirePeerReview = value; }
    private string synthesisTargetDirective { get => State.SynthesisTargetDirective; set => State.SynthesisTargetDirective = value; }

    private string rawJsonLogs { get => State.RawJsonLogs; set => State.RawJsonLogs = value; }
    private int totalIdentified { get => State.TotalIdentified; set => State.TotalIdentified = value; }
    private int screenedCount { get => State.ScreenedCount; set => State.ScreenedCount = value; }
    private int excludedCount { get => State.ExcludedCount; set => State.ExcludedCount = value; }
    private int includedCount { get => State.IncludedCount; set => State.IncludedCount = value; }
    private bool isSearching { get => State.IsSearching; set => State.IsSearching = value; }

    private int maxResults { get; set; } = 5;

    private bool showKeyModal = false;
    private AuBtechReviewAgent.UserApiKeys? sessionKeys = null;

    // Search-string preview: null until the reviewer previews (the model then chooses during the run).
    private List<string>? reviewedSearchStrings;
    private string? previewQuery;
    private string? previewError;
    private bool previewingStrings;
    private int previewsLeft = 5; // each preview is one model call; a page gets a few

    private async Task PreviewSearchStrings()
    {
        if (previewingStrings || previewsLeft <= 0 || string.IsNullOrWhiteSpace(searchQuery)) return;
        previewingStrings = true;
        previewError = null;
        previewsLeft--;
        try
        {
            var strings = await ReviewEngine.PreviewSearchStringsAsync(searchQuery, reviewObjective, inclusionCriteria, sessionKeys);
            reviewedSearchStrings = strings.Take(AuBtechReviewAgent.ReviewInputGuard.MaxSearchStrings).ToList();
            previewQuery = searchQuery.Trim();
            if (reviewedSearchStrings.Count == 0)
                previewError = "The model did not propose other phrasings. Add your own, or let the model try again during the run.";
        }
        catch (Exception ex)
        {
            Logger.LogInformation("Search-string preview failed: {Error}", ex.GetType().Name);
            previewError = "The preview did not work just now. The model will propose the search strings during the run instead.";
        }
        finally
        {
            previewingStrings = false;
        }
    }

    // Run quota: the client's address is read once when the component starts (from the HTTP request
    // behind the prerender or the SignalR connection) and used as the quota key for this session.
    private string clientAddress = "unknown";

    // Captured during prerendering (a normal HTTP request, so the address is reliable) and carried into
    // the interactive circuit through persisted component state, which Blazor Server protects with Data
    // Protection so the browser cannot change it. The HttpContextAccessor value is only a fallback.
    [PersistentState]
    public string? PrerenderClientAddress { get; set; }
    private string adminToken = "";
    private string modalAdminToken = "";

    // Result of ReviewInputGuard for the last "Start review" click, and the flags the user confirmed.
    private AuBtechReviewAgent.InputCheck? inputCheck;
    private string? pendingFlagSignature;
    private string? confirmedFlagSignature;

    private async Task ConfirmFlaggedInput()
    {
        confirmedFlagSignature = pendingFlagSignature;
        await StartReviewProcess();
    }
    private string quotaNotice = "";
    private AuBtechReviewAgent.QuotaStatus quotaStatus = new(AuBtechReviewAgent.QuotaTier.Free, true, 0, 0, "");
    private IReadOnlyDictionary<string, bool> sourceAvailability = new Dictionary<string, bool>();

    private bool hasOwnMistralKey => !string.IsNullOrWhiteSpace(sessionKeys?.MistralApiKey);
    private AuBtechReviewAgent.QuotaTier currentTier => Quota.ResolveTier(hasOwnMistralKey, adminToken);
    private int maxResultsCeiling => Quota.MaxResultsFor(currentTier, 50);

    private void RefreshQuotaAndSources()
    {
        quotaStatus = Quota.GetStatus(clientAddress, currentTier);
        sourceAvailability = ReviewEngine.GetSourceAvailability(sessionKeys);
        if (maxResults > maxResultsCeiling) maxResults = maxResultsCeiling;
    }

    private List<string> SelectedAvailableSources() =>
        State.SelectedSources.Where(k => sourceAvailability.TryGetValue(k, out var ok) && ok).ToList();

    private void ToggleSource(string key, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked) State.SelectedSources.Add(key);
        else State.SelectedSources.Remove(key);
    }

    private string modalMistral = "";
    private string modalElsevier = "";
    private string modalIeee = "";
    private string modalScholar = "";

    [Inject] private AuBtechReviewAgent.RunsOptions RunsOptions { get; set; } = default!;

    /// <summary>Set when the page is opened as /review/{RunId}: shows that run (and resumes following it if it is still going).</summary>
    [Parameter] public Guid? RunId { get; set; }

    /// <summary>/review?from={runId}: start a new review with the settings of an earlier run.</summary>
    [SupplyParameterFromQuery(Name = "from")] public Guid? From { get; set; }
    private Guid? prefilledFrom;
    private string? prefillNotice;
    private string panelTab = "overview";

    // The form is shown while composing (no run on this page, or "New review" pressed); otherwise a compact
    // summary of what was asked, so the run itself gets the attention.
    private bool editingNew;
    private bool Composing => !hasRun || editingNew;
    private int formStep = 1;
    private AuBtechReviewAgent.ReviewState? runInfo;

    private static readonly (int Number, string Title)[] Steps = { (1, "Question"), (2, "Criteria"), (3, "Output") };

    private const string LabelClass = "ui-label";
    private const string InputClass = "ui-input";

    private int yearFrom
    {
        get => State.DateFrom.Year;
        set => State.DateFrom = new DateTime(Math.Clamp(value, 1900, DateTime.UtcNow.Year), 1, 1);
    }
    private int yearTo
    {
        get => State.DateTo.Year;
        set => State.DateTo = new DateTime(Math.Clamp(value, 1900, DateTime.UtcNow.Year), 12, 31);
    }

    private static readonly (string Label, int From)[] YearPresets =
        { ("Last 5 years", DateTime.UtcNow.Year - 5), ("Since 2015", 2015), ("Since 2000", 2000) };

    private void SetYears(int from)
    {
        yearFrom = from;
        yearTo = DateTime.UtcNow.Year;
    }

    private bool StepDone(int number) => number switch
    {
        1 => !string.IsNullOrWhiteSpace(searchQuery),
        2 => !string.IsNullOrWhiteSpace(inclusionCriteria),
        _ => SelectedAvailableSources().Count > 0,
    };

    /// <summary>Why the review cannot start yet, or null when it can. Shown next to the button, not after a click.</summary>
    private string? StartBlocker()
    {
        if (!quotaStatus.Allowed) return string.IsNullOrWhiteSpace(quotaStatus.Message) ? "No runs left for now." : quotaStatus.Message;
        if (string.IsNullOrWhiteSpace(searchQuery)) return "Add a search query (step 1).";
        if (string.IsNullOrWhiteSpace(inclusionCriteria)) return "Say which studies to include (step 2).";
        if (SelectedAvailableSources().Count == 0) return "Select at least one source (step 3).";
        return null;
    }

    /// <summary>The form step and field to go to for the current blocker, or null when no field can fix it (quota).</summary>
    private (int Step, string FieldId)? BlockerTarget()
    {
        if (!quotaStatus.Allowed) return null;
        if (string.IsNullOrWhiteSpace(searchQuery)) return (1, "f-query");
        if (string.IsNullOrWhiteSpace(inclusionCriteria)) return (2, "f-inclusion");
        if (SelectedAvailableSources().Count == 0) return (3, "f-sources");
        return null;
    }

    // Field to focus after the next render (the step it is on has to be shown first).
    private string? pendingFocus;

    private void FocusField(int step, string fieldId)
    {
        formStep = step;
        pendingFocus = fieldId;
    }

    private void GoToProblem()
    {
        if (BlockerTarget() is { } target) FocusField(target.Step, target.FieldId);
    }

    /// <summary>"Start review" is never silently disabled: when something is missing it takes you there instead.</summary>
    private async Task StartOrShowProblem()
    {
        if (StartBlocker() != null)
        {
            GoToProblem();
            return;
        }
        await StartReviewProcess();
    }

    /// <summary>"true" when the last start attempt reported a problem with this field (for aria-invalid).</summary>
    private string? Invalid(string fieldName) =>
        inputCheck is { IsValid: false } && inputCheck.Errors.Any(e => e.StartsWith(fieldName, StringComparison.Ordinal)) ? "true" : null;

    // The input guard names fields by these labels; this is where each one lives in the form.
    private static readonly (string Name, int Step, string FieldId)[] FieldsByName =
    {
        ("Search query", 1, "f-query"), ("Review objective", 1, "f-objective"),
        ("Inclusion criteria", 2, "f-inclusion"), ("Exclusion criteria", 2, "f-exclusion"),
        ("Artifact target", 3, "f-directive"),
    };

    private void FocusFirstInvalidField()
    {
        if (inputCheck is not { IsValid: false }) return;
        foreach (var error in inputCheck.Errors)
        {
            var field = FieldsByName.FirstOrDefault(f => error.StartsWith(f.Name, StringComparison.Ordinal));
            if (field.FieldId != null)
            {
                FocusField(field.Step, field.FieldId);
                return;
            }
        }
    }

    private string SettingsLine()
    {
        int sources = SelectedAvailableSources().Count;
        var parts = new List<string> { $"{sources} source{(sources == 1 ? "" : "s")}", $"{yearFrom}–{yearTo}", $"up to {maxResults} records each" };
        if (State.DualScreening) parts.Add("dual screening");
        if (State.CitationChaining) parts.Add("citation chaining");
        if (State.ArtifactKind != AuBtechReviewAgent.ArtifactKinds.None) parts.Add(ArtifactLabel()!.ToLowerInvariant());
        return string.Join(" · ", parts);
    }

    private string AdvancedSummary()
    {
        var on = new List<string>();
        if (State.DualScreening) on.Add("dual screening");
        if (State.CitationChaining) on.Add("chaining");
        if (State.ReviewScreeningFirst) on.Add("your check");
        if (requirePeerReview) on.Add("peer-reviewed");
        return on.Count == 0 ? $"{maxResults} per source" : $"{string.Join(", ", on)} · {maxResults} per source";
    }

    private string? ArtifactLabel() => State.ArtifactKind == AuBtechReviewAgent.ArtifactKinds.None
        ? null : AuBtechReviewAgent.ArtifactKinds.All.FirstOrDefault(k => k.Key == State.ArtifactKind).Label;

    // ── Tab title, notifications and the remembered draft (speed and feel) ─────────────────────────────

    // Set when a run finished while this page was open, so the tab title says so until the next run.
    private bool finishedWhileOpen;
    private string notifyPermission = "unsupported";

    /// <summary>The browser tab's title: the progress while running, "✓ Review ready" when it finished here.</summary>
    private string TabTitle()
    {
        if (!Composing && isSearching) return $"{AuBtechReviewAgent.RunProgress.Percent(State.Stats)}% · Your review";
        if (!Composing && finishedWhileOpen && stage == AuBtechReviewAgent.PrismaReviewEngine.StageComplete) return "✓ Review ready";
        if (!Composing && finishedWhileOpen && AuBtechReviewAgent.PrismaReviewEngine.IsFinishedStage(stage)) return "Run stopped · Your review";
        return RunId != null && !Composing ? "Your review" : "Start a review";
    }

    private void OnRunFinished()
    {
        finishedWhileOpen = true;
        bool ok = stage == AuBtechReviewAgent.PrismaReviewEngine.StageComplete;
        _ = NotifyAsync(ok ? "Your review is ready" : "Your review stopped",
            ok ? "The report and its checked citations are ready in TraceableAI." : "Open TraceableAI to see what happened.");
    }

    private async Task NotifyAsync(string title, string body)
    {
        try { await JS.InvokeAsync<bool>("traceableReview.notifyDone", title, body); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not show the browser notification: {Message}", ex.Message);
        }
    }

    private async Task AskForNotification()
    {
        try { notifyPermission = await JS.InvokeAsync<string>("traceableReview.requestNotify"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not ask for notification permission: {Message}", ex.Message);
        }
    }

    /// <summary>The review form as kept in this browser between visits. Never holds API keys.</summary>
    private sealed record Draft(
        string Query, string Objective, string Inclusion, string Exclusion, int YearFrom, int YearTo,
        string ArtifactKind, string Directive, List<string> Sources, bool Dual, bool Chaining, bool Check, bool PeerReviewed,
        int MaxResults, DateTime SavedUtc, List<string>? SearchStrings = null);

    private string lastSavedDraft = "";
    private bool draftRestored;

    private bool FormIsEmpty() =>
        string.IsNullOrWhiteSpace(searchQuery) && string.IsNullOrWhiteSpace(reviewObjective)
        && string.IsNullOrWhiteSpace(inclusionCriteria) && string.IsNullOrWhiteSpace(exclusionCriteria);

    private Draft CurrentDraft() => new(searchQuery, reviewObjective, inclusionCriteria, exclusionCriteria,
        yearFrom, yearTo, State.ArtifactKind, synthesisTargetDirective, State.SelectedSources.OrderBy(x => x, StringComparer.Ordinal).ToList(),
        State.DualScreening, State.CitationChaining, State.ReviewScreeningFirst, requirePeerReview, maxResults, DateTime.MinValue,
        reviewedSearchStrings?.ToList());

    // The draft without its timestamp, to tell whether anything changed since the last save.
    private string DraftFingerprint() => JsonSerializer.Serialize(CurrentDraft());

    /// <summary>Saves the form to this browser after a change, so a closed tab or a crash does not lose it.</summary>
    private async Task SaveDraftAsync()
    {
        if (!Composing || isSearching || !draftRestored) return;
        string fingerprint = DraftFingerprint();
        if (fingerprint == lastSavedDraft) return;
        lastSavedDraft = fingerprint;
        try
        {
            if (FormIsEmpty()) await JS.InvokeAsync<bool>("traceableReview.clearDraft");
            else await JS.InvokeAsync<bool>("traceableReview.saveDraft", JsonSerializer.Serialize(CurrentDraft() with { SavedUtc = DateTime.UtcNow }));
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not save the form draft: {Message}", ex.Message);
        }
    }

    /// <summary>On a fresh, empty form, brings back the draft this browser kept (at most 30 days old).</summary>
    private async Task RestoreDraftAsync()
    {
        try
        {
            if (!Composing || hasRun || From != null || !FormIsEmpty()) return;
            string? json = await JS.InvokeAsync<string?>("traceableReview.loadDraft");
            if (string.IsNullOrWhiteSpace(json)) return;
            var draft = JsonSerializer.Deserialize<Draft>(json);
            if (draft == null || draft.SavedUtc < DateTime.UtcNow.AddDays(-30)) return;
            searchQuery = draft.Query; reviewObjective = draft.Objective;
            inclusionCriteria = draft.Inclusion; exclusionCriteria = draft.Exclusion;
            if (draft.YearFrom > 0) yearFrom = draft.YearFrom;
            if (draft.YearTo > 0) yearTo = draft.YearTo;
            State.ArtifactKind = AuBtechReviewAgent.ArtifactKinds.Normalize(draft.ArtifactKind);
            synthesisTargetDirective = draft.Directive;
            if (draft.Sources.Count > 0) State.SelectedSources = new HashSet<string>(draft.Sources, StringComparer.OrdinalIgnoreCase);
            State.DualScreening = draft.Dual; State.CitationChaining = draft.Chaining; State.ReviewScreeningFirst = draft.Check;
            requirePeerReview = draft.PeerReviewed;
            if (draft.MaxResults > 0) maxResults = Math.Min(draft.MaxResults, maxResultsCeiling);
            reviewedSearchStrings = draft.SearchStrings?.Take(AuBtechReviewAgent.ReviewInputGuard.MaxSearchStrings).ToList();
            prefillNotice = $"Your unfinished review from {draft.SavedUtc:d MMM} was brought back. It is kept in this browser only.";
            showStartEmpty = true;
        }
        catch (Exception ex) when (ex is JSException or JsonException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not restore the form draft: {Message}", ex.Message);
        }
        finally
        {
            draftRestored = true;
            lastSavedDraft = DraftFingerprint();
        }
    }

    // Shown next to the "brought back" notice: start with an empty form instead.
    private bool showStartEmpty;

    private async Task StartEmpty()
    {
        searchQuery = reviewObjective = inclusionCriteria = exclusionCriteria = "";
        reviewedSearchStrings = null;
        synthesisTargetDirective = AuBtechReviewAgent.ArtifactKinds.DefaultInstruction(State.ArtifactKind);
        prefillNotice = null;
        showStartEmpty = false;
        formStep = 1;
        await ClearDraftAsync();
    }

    private async Task ClearDraftAsync()
    {
        lastSavedDraft = "";
        try { await JS.InvokeAsync<bool>("traceableReview.clearDraft"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not clear the form draft: {Message}", ex.Message);
        }
    }

    /// <summary>One short sentence for the live region: changes only when the step or the outcome changes.</summary>
    private string Announcement()
    {
        if (Composing || !hasRun) return "";
        if (stage == AuBtechReviewAgent.PrismaReviewEngine.StageComplete) return "The review is complete. The report is ready.";
        if (stage == AuBtechReviewAgent.PrismaReviewEngine.StageFailed) return "The run failed. " + (failureMessage ?? "");
        if (stage == AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted) return "The run was interrupted.";
        if (awaitingReview) return "The run is waiting for you to check the screening decisions.";
        if (stage == AuBtechReviewAgent.PrismaReviewEngine.StageQueued) return "The run is waiting for a free slot.";
        return AuBtechReviewAgent.RunProgress.Steps.TryGetValue(State.Stats.ProgressStep, out var step) ? $"Now: {step.Label}." : "The run has started.";
    }

    private string PanelTitle() =>
        Composing ? "Preview"
        : stage == AuBtechReviewAgent.PrismaReviewEngine.StageComplete ? "Result"
        : awaitingReview ? "Your screening check"
        : isSearching ? "Progress"
        : StageLabel();

    /// <summary>Fills the form with a worked example, so a first-time visitor sees what good input looks like.</summary>
    private void LoadExample()
    {
        searchQuery = "agentic AI software frameworks";
        reviewObjective = "Which safety and fault-tolerance mechanisms do agentic AI frameworks use, and how are they evaluated?";
        inclusionCriteria = "Studies that describe or evaluate an agent framework or orchestration loop, with some form of evaluation.";
        exclusionCriteria = "Studies about agriculture or marketing; opinion pieces without evidence.";
        SetYears(2020);
        prefillNotice = "An example review was filled in. Change anything you like, or start it as it is.";
    }

    /// <summary>Opens the form for a new review, prefilled with the current settings; the shown run stays at its own link.</summary>
    private void StartNewDraft()
    {
        editingNew = true;
        formStep = 1;
        panelTab = "overview";
        confirmDelete = false;
    }

    private Guid currentSessionId
    {
        get => State.CurrentSessionId;
        set => State.CurrentSessionId = value;
    }
    private bool hasRun => State.CurrentSessionId != Guid.Empty;

    private string stage = "";
    private int queuePosition;
    private string? failureMessage;
    private DateTime? completedUtc;
    private static string AppVersionShort => AuBtechReviewAgent.RecordingChatCompletionService.AppVersion.Split('+')[0];
    private bool awaitingReview;
    private bool confirmDelete;
    private IReadOnlyList<AuBtechReviewAgent.ScreeningLog>? reviewLogs;
    private CancellationTokenSource? monitorCts;
    private bool subscribed;

    protected override void OnInitialized()
    {
        PrerenderClientAddress ??= AuBtechReviewAgent.RunQuotaService.NormalizeClientAddress(HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress);
        clientAddress = PrerenderClientAddress;
        RefreshQuotaAndSources();
    }

    protected override void OnParametersSet()
    {
        if (From is Guid from && from != Guid.Empty && from != prefilledFrom && !isSearching)
        {
            prefilledFrom = from;
            PrefillFrom(from);
            return;
        }
        // Opening /review/{id} (after a reload, from a bookmark, or from another device) attaches this page to
        // that run. Opening plain /review keeps whatever run this tab already shows.
        if (RunId is Guid id && id != Guid.Empty && (id != currentSessionId || !subscribed))
        {
            AttachToRun(id);
        }
        else if (hasRun && !subscribed)
        {
            AttachToRun(currentSessionId);
        }
    }

    /// <summary>Fills the form with an earlier run's settings (the reviewer still presses Start review).</summary>
    private void PrefillFrom(Guid id)
    {
        var old = ReviewEngine.LoadState(id);
        if (old == null)
        {
            prefillNotice = "That run could not be found, so the form was not changed. Runs are deleted after a few days.";
            return;
        }
        currentSessionId = Guid.Empty; // the form starts a new run; the old one stays available at its own link
        stage = "";
        runInfo = null;
        editingNew = true;
        formStep = 1;
        searchQuery = old.SearchQuery;
        if (!string.IsNullOrWhiteSpace(old.ReviewObjective)) reviewObjective = old.ReviewObjective;
        if (!string.IsNullOrWhiteSpace(old.InclusionCriteria)) inclusionCriteria = old.InclusionCriteria;
        if (!string.IsNullOrWhiteSpace(old.ExclusionCriteria)) exclusionCriteria = old.ExclusionCriteria;
        if (!string.IsNullOrWhiteSpace(old.ArtifactKind)) State.ArtifactKind = AuBtechReviewAgent.ArtifactKinds.Normalize(old.ArtifactKind);
        synthesisTargetDirective = old.SynthesisTargetDirective ?? "";
        if (old.YearFrom > 0) yearFrom = old.YearFrom;
        if (old.YearTo > 0) yearTo = old.YearTo;
        requirePeerReview = old.PeerReviewOnlyToggle;
        State.DualScreening = old.DualScreeningRequested;
        State.CitationChaining = old.CitationChainingRequested;
        State.ReviewScreeningFirst = old.HumanScreeningReviewRequested;
        if (old.SelectedSources.Count > 0) State.SelectedSources = new HashSet<string>(old.SelectedSources, StringComparer.OrdinalIgnoreCase);
        if (old.MaxResultsPerSource > 0) maxResults = old.MaxResultsPerSource;
        prefillNotice = string.IsNullOrWhiteSpace(old.ReviewObjective)
            ? "The query and options were copied from the earlier run. Runs made before this feature did not store the objective and criteria; copy them from that run's protocol."
            : "The settings of the earlier run were copied. Check them, change what you like, and press Start review.";
    }

    private void AttachToRun(Guid id)
    {
        if (id != currentSessionId) editingNew = false;
        currentSessionId = id;
        var state = ReviewEngine.LoadState(id);
        if (state == null)
        {
            stage = "";
            failureMessage = "This run could not be found. It may have expired and been deleted.";
            isSearching = false;
            return;
        }

        ApplyState(state, File.Exists(StatePath(id)) ? SafeRead(StatePath(id)) : null);
        isSearching = ReviewEngine.IsRunActive(id);
        if (isSearching)
        {
            Subscribe();
            StartLogMonitoringLoop();
        }
    }

    private string StatePath(Guid id) =>
        Path.Join(ReviewEngine.WorkspaceRoot, id.ToString("N"), "transparent-process.json");

    private static string? SafeRead(string path)
    {
        try
        {
            using var fileStream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
            using var reader = new StreamReader(fileStream);
            return reader.ReadToEnd();
        }
        catch { return null; }
    }

    private void ApplyState(AuBtechReviewAgent.ReviewState state, string? rawJson)
    {
        // The saved ledger can be a little behind the live events; never let the progress bar move back.
        var s = AuBtechReviewAgent.RunProgress.KeepFurthest(State.Stats, state.Stats);
        State.Stats = s;
        State.RemovedBeforeScreening = state.RemovedBeforeScreening;
        State.SearchStringYields = state.SearchStringYields;
        State.ExclusionGroups = AuBtechReviewAgent.ExclusionReasons.Count(state.Phases.Screening);
        runInfo = state;
        totalIdentified = s.TotalIdentified;
        screenedCount = s.Screened;
        excludedCount = s.Excluded + s.FailedPeerReviewCheck;
        includedCount = s.Included;
        State.PassedPeerReviewCount = s.PassedPeerReviewCheck;
        State.FailedPeerReviewCount = s.FailedPeerReviewCheck;
        stage = s.ProcessingStage;
        queuePosition = s.QueuePosition;
        failureMessage = state.FailureMessage;
        completedUtc = state.CompletedUtc;
        awaitingReview = stage == AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview && ReviewEngine.IsAwaitingScreeningReview(currentSessionId);
        if (awaitingReview) reviewLogs ??= state.Phases.Screening.ToList();
        else reviewLogs = null;
        if (rawJson != null) rawJsonLogs = rawJson;
    }

    private string StageLabel() => stage switch
    {
        AuBtechReviewAgent.PrismaReviewEngine.StageQueued => queuePosition > 0 ? $"Waiting in line (position {queuePosition})" : "Waiting for a free slot",
        AuBtechReviewAgent.PrismaReviewEngine.StageScreening => "Searching and screening",
        AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview => "Waiting for your screening review",
        AuBtechReviewAgent.PrismaReviewEngine.StageSynthesizing => "Writing and checking the review",
        AuBtechReviewAgent.PrismaReviewEngine.StageComplete => "Complete",
        AuBtechReviewAgent.PrismaReviewEngine.StageFailed => "Failed",
        AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted => "Interrupted",
        "" => "Not found",
        _ => stage
    };

    private string StageColor() => stage switch
    {
        AuBtechReviewAgent.PrismaReviewEngine.StageComplete => "text-green-700",
        AuBtechReviewAgent.PrismaReviewEngine.StageFailed or AuBtechReviewAgent.PrismaReviewEngine.StageInterrupted or "" => "text-red-700",
        AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview => "text-amber-700",
        _ => "text-brand"
    };

    private void Subscribe()
    {
        if (subscribed) return;
        ReviewEngine.OnProgressUpdated += HandleEngineProgress;
        subscribed = true;
    }

    private void Unsubscribe()
    {
        if (!subscribed) return;
        ReviewEngine.OnProgressUpdated -= HandleEngineProgress;
        subscribed = false;
    }

    private void OnScreeningReviewSubmitted()
    {
        awaitingReview = false;
        reviewLogs = null;
        stage = AuBtechReviewAgent.PrismaReviewEngine.StageSynthesizing;
        StateHasChanged();
    }

    public void Dispose()
    {
        // The engine is a singleton: an event handler left behind would keep this page alive forever.
        Unsubscribe();
        monitorCts?.Cancel();
        monitorCts?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SaveDraftAsync();
        if (pendingFocus is { } fieldId)
        {
            pendingFocus = null;
            try { await JS.InvokeVoidAsync("traceableReview.focus", fieldId); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
            {
                Logger.LogDebug("Could not move focus to {Field}: {Message}", fieldId, ex.Message);
            }
        }
        if (keyModalJustOpened)
        {
            keyModalJustOpened = false;
            try { await JS.InvokeVoidAsync("traceableReview.trapFocus", "key-dialog"); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
            {
                Logger.LogDebug("Could not move focus into the key dialog: {Message}", ex.Message);
            }
        }
        if (firstRender)
        {
            try
            {
                var tokenResult = await SessionStorage.GetAsync<string>("developer_access_token");
                if (tokenResult.Success && !string.IsNullOrWhiteSpace(tokenResult.Value))
                {
                    adminToken = modalAdminToken = tokenResult.Value;
                }

                var result = await SessionStorage.GetAsync<string>("encrypted_byok_payload");
                if (result.Success && !string.IsNullOrWhiteSpace(result.Value))
                {
                    sessionKeys = JsonSerializer.Deserialize<AuBtechReviewAgent.UserApiKeys>(result.Value);
                    
                    if (sessionKeys != null)
                    {
                        modalMistral = sessionKeys.MistralApiKey ?? "";
                        modalElsevier = sessionKeys.ElsevierApiKey ?? "";
                        modalIeee = sessionKeys.IeeeApiKey ?? "";
                        modalScholar = sessionKeys.ScholarApiKey ?? "";
                    }
                }
                RefreshQuotaAndSources();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                // Browser storage can be unavailable (private window, blocked storage); the page works without saved keys.
                Logger.LogDebug("Could not restore saved keys from browser storage: {Message}", ex.Message.Replace("\r", " ").Replace("\n", " "));
            }

            // Independent of the keys above: the form draft and whether notifications are possible.
            await RestoreDraftAsync();
            try { notifyPermission = await JS.InvokeAsync<string>("traceableReview.notifyPermission"); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
            {
                Logger.LogDebug("Could not read the notification permission: {Message}", ex.Message);
            }
            StateHasChanged();
        }
    }

    // Set when the dialog opens, so the next render moves focus into it (OnAfterRenderAsync).
    private bool keyModalJustOpened;

    private void OpenKeyModal()
    {
        showKeyModal = true;
        keyModalJustOpened = true;
    }

    private async Task CloseKeyModal()
    {
        showKeyModal = false;
        await ReturnFocusFromDialog();
    }

    private async Task KeyDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseKeyModal();
    }

    private async Task ReturnFocusFromDialog()
    {
        try { await JS.InvokeVoidAsync("traceableReview.releaseFocus"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not return focus after the key dialog: {Message}", ex.Message);
        }
    }

    private async Task SaveSessionKeys()
    {
        string sMistral = AuBtechReviewAgent.SecurityUtility.SanitizeApiKey(modalMistral);
        string sElsevier = AuBtechReviewAgent.SecurityUtility.SanitizeApiKey(modalElsevier);
        string sIeee = AuBtechReviewAgent.SecurityUtility.SanitizeApiKey(modalIeee);
        string sScholar = AuBtechReviewAgent.SecurityUtility.SanitizeApiKey(modalScholar);

        sessionKeys = new AuBtechReviewAgent.UserApiKeys(sMistral, sElsevier, sIeee, sScholar);

        string jsonPayload = JsonSerializer.Serialize(sessionKeys);
        await SessionStorage.SetAsync("encrypted_byok_payload", jsonPayload);

        adminToken = modalAdminToken.Trim();
        if (string.IsNullOrEmpty(adminToken)) await SessionStorage.DeleteAsync("developer_access_token");
        else await SessionStorage.SetAsync("developer_access_token", adminToken);
        quotaNotice = !string.IsNullOrEmpty(adminToken) && !Quota.IsValidAdminToken(adminToken)
            ? "The developer access token was not recognised." : "";

        RefreshQuotaAndSources();
        showKeyModal = false;
        await ReturnFocusFromDialog();
        StateHasChanged();
    }

    private async Task ClearVault()
    {
        modalMistral = modalElsevier = modalIeee = modalScholar = modalAdminToken = adminToken = "";
        sessionKeys = null;
        await SessionStorage.DeleteAsync("encrypted_byok_payload");
        await SessionStorage.DeleteAsync("developer_access_token");
        quotaNotice = "";
        RefreshQuotaAndSources();
        showKeyModal = false;
        await ReturnFocusFromDialog();
        StateHasChanged();
    }

    /// <summary>Deletes the finished run shown on this page (its folder, report and downloaded papers).</summary>
    private void DeleteRun()
    {
        confirmDelete = false;
        var id = currentSessionId;
        if (!ReviewEngine.DeleteRun(id))
        {
            failureMessage = "The run could not be deleted (it may still be running or already be gone).";
            return;
        }
        Unsubscribe();
        currentSessionId = Guid.Empty;
        State.Stats = new ReviewStats();
        State.RemovedBeforeScreening = new();
        State.SearchStringYields = new();
        State.ExclusionGroups = new();
        rawJsonLogs = "{\n  \"status\": \"Run deleted.\"\n}";
        stage = "";
        failureMessage = null;
        runInfo = null;
        formStep = 1;
        Nav.NavigateTo("/review", replace: true);
    }

    /// <summary>Choosing a kind fills in its default instruction, unless the reviewer wrote their own.</summary>
    private void HandleArtifactKind(ChangeEventArgs e)
    {
        string previous = State.ArtifactKind;
        State.ArtifactKind = AuBtechReviewAgent.ArtifactKinds.Normalize(e.Value?.ToString());
        bool untouched = string.IsNullOrWhiteSpace(synthesisTargetDirective)
            || synthesisTargetDirective == AuBtechReviewAgent.ArtifactKinds.DefaultInstruction(previous);
        if (untouched) synthesisTargetDirective = AuBtechReviewAgent.ArtifactKinds.DefaultInstruction(State.ArtifactKind);
    }

    /// <summary>
    /// A short help line under a field; the character count only appears when the text gets near the limit.
    /// The id is what the field's aria-describedby points to, so screen readers read the help with the field.
    /// </summary>
    private RenderFragment Help(string id, string help, string? value, int max) => __builder =>
    {
        int length = value?.Length ?? 0;
        <div id="@id" class="flex justify-between gap-2 mt-1 text-xs leading-snug">
            <span class="text-gray-500">@help</span>
            @if (length > max * 0.8)
            {
                <span class="font-mono shrink-0 @(length > max * 0.95 ? "text-red-700" : "text-amber-700")">@length / @max</span>
            }
        </div>
    };

    /// <summary>One switch in the advanced options: label, one line of help, and the checkbox.</summary>
    /// <summary>
    /// One switch in the advanced options: the checkbox, its label, a "?" with the glossary explanation (outside
    /// the label, so it does not toggle the box) and one line of help that screen readers read with the box.
    /// </summary>
    private RenderFragment Option(string id, string? glossaryKey, string label, string help, bool value, Action<bool> set) => __builder =>
    {
        <div class="flex items-start gap-3">
            <input id="@id" type="checkbox" checked="@value" disabled="@isSearching" aria-describedby="@($"{id}-help")"
                   @onchange="e => set(e.Value is true)" class="w-4 h-4 mt-0.5 accent-brand cursor-pointer" />
            <div class="text-sm text-gray-800">
                <label for="@id" class="cursor-pointer select-none">@label</label>
                @if (glossaryKey != null)
                {
                    <Term Key="@glossaryKey" Icon="true" />
                }
                <span id="@($"{id}-help")" class="block text-xs text-gray-500">@help</span>
            </div>
        </div>
    };

    private static RenderFragment SettingRow(string label, string? value) => __builder =>
    {
        <div class="grid grid-cols-[5.5rem_1fr] gap-2">
            <dt class="text-gray-500">@label</dt>
            <dd class="text-gray-900 break-words">@(string.IsNullOrWhiteSpace(value) ? "–" : value)</dd>
        </div>
    };

    private async Task StartReviewProcess()
    {
        if (isSearching) return;

        // Check the text fields before anything is reserved or spent: too-long fields are errors, and
        // instruction-like phrases must be confirmed once (they are then recorded in the protocol).
        var draft = new AuBtechReviewAgent.ReviewRequest(searchQuery, reviewObjective, inclusionCriteria, exclusionCriteria, maxResults,
            SynthesisDirective: synthesisTargetDirective, ArtifactKind: State.ArtifactKind, SearchStrings: reviewedSearchStrings);
        inputCheck = AuBtechReviewAgent.ReviewInputGuard.Check(draft);
        if (!inputCheck.IsValid)
        {
            FocusFirstInvalidField();
            return;
        }
        string flagSignature = string.Join("|", inputCheck.Flags.Select(f => f.ToString()));
        if (inputCheck.Flags.Count > 0 && confirmedFlagSignature != flagSignature)
        {
            pendingFlagSignature = flagSignature;
            return;
        }

        // Count the run before it starts. The check happens here on the server, so it cannot be skipped
        // from the browser, and a double click cannot start two runs on one remaining slot.
        var tier = currentTier;
        if (!Quota.TryReserve(clientAddress, tier, out var reservedStatus, out var lease))
        {
            quotaStatus = reservedStatus;
            quotaNotice = reservedStatus.Message;
            return;
        }
        quotaStatus = reservedStatus;
        quotaNotice = "";

        var runSources = SelectedAvailableSources();
        if (runSources.Count == 0)
        {
            if (lease != null) Quota.Refund(lease);
            RefreshQuotaAndSources();
            quotaNotice = "Select at least one source.";
            return;
        }
        int runMaxResults = Quota.MaxResultsFor(tier, maxResults);
        maxResults = runMaxResults;
        // The engine runs the same check again; these are the normalised fields.
        panelTab = "overview";
        prefillNotice = null;
        string cleanQuery = inputCheck.Request.Query;
        string cleanObjective = inputCheck.Request.Objective;
        string cleanInclusion = inputCheck.Request.Inclusion;
        string cleanExclusion = inputCheck.Request.Exclusion;
        string cleanDirective = inputCheck.Request.SynthesisDirective;
        pendingFlagSignature = null;

        State.Stats = new ReviewStats();
        State.RemovedBeforeScreening = new();
        State.SearchStringYields = new();
        State.ExclusionGroups = new();
        totalIdentified = 0;
        screenedCount = 0;
        excludedCount = 0;
        includedCount = 0;
        State.PassedPeerReviewCount = 0;
        State.FailedPeerReviewCount = 0;
        failureMessage = null;
        completedUtc = null;
        awaitingReview = false;
        reviewLogs = null;
        stage = AuBtechReviewAgent.PrismaReviewEngine.StageQueued;
        isSearching = true;
        rawJsonLogs = "{\n  \"status\": \"Starting run...\"\n}";

        var runId = Guid.NewGuid();
        currentSessionId = runId;
        await ClearDraftAsync();
        editingNew = false;
        formStep = 1;
        runInfo = null;
        var request = new AuBtechReviewAgent.ReviewRequest(
            cleanQuery, cleanObjective, cleanInclusion, cleanExclusion, runMaxResults,
            requirePeerReview, cleanDirective, sessionKeys, runSources, yearFrom, yearTo, State.ReviewScreeningFirst,
            DualScreening: State.DualScreening, CitationChaining: State.CitationChaining, ArtifactKind: State.ArtifactKind,
            SearchStrings: inputCheck.Request.SearchStrings);

        Subscribe();

        _ = Task.Run(async () =>
        {
            try
            {
                await ReviewEngine.RunReviewAsync(runId, request);
            }
            catch (Exception ex)
            {
                // The run failed: give the quota slot back. The reason is stored in the run's ledger, and the
                // engine has logged the error with the run ID.
                if (lease != null) Quota.Refund(lease);
                Logger.LogDebug("Run {RunId} ended with {Error}", runId, ex.GetType().Name);
            }
            finally
            {
                if (runId == currentSessionId)
                {
                    await InvokeAsync(() =>
                    {
                        if (isSearching) OnRunFinished();
                        isSearching = false;
                        var final = ReviewEngine.LoadState(runId);
                        if (final != null) ApplyState(final, SafeRead(StatePath(runId)));
                        RefreshQuotaAndSources();
                        StateHasChanged();
                    });
                }
            }
        });

        // Put the run in the address bar so a reload, a bookmark or another device can find it again.
        Nav.NavigateTo($"/review/{runId}", replace: true);
        StartLogMonitoringLoop();

        // On a phone the run panel is below the form: bring it into view so the click visibly did something.
        try { await JS.InvokeVoidAsync("traceableReview.revealOnSmallScreens", "run-panel"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug("Could not scroll to the run panel: {Message}", ex.Message);
        }
    }

    private void StartLogMonitoringLoop()
    {
        monitorCts?.Cancel();
        monitorCts = new CancellationTokenSource();
        var token = monitorCts.Token;
        Guid runId = currentSessionId;

        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested && isSearching && runId == currentSessionId)
            {
                try { await Task.Delay(1000, token); } catch (TaskCanceledException) { break; }
                string? raw = SafeRead(StatePath(runId));
                if (raw == null) continue;
                try
                {
                    var state = JsonSerializer.Deserialize<AuBtechReviewAgent.ReviewState>(raw);
                    if (state == null) continue;
                    await InvokeAsync(() =>
                    {
                        if (runId != currentSessionId) return;
                        ApplyState(state, raw);
                        StateHasChanged();
                    });
                }
                catch { /* the ledger was mid-write; try again next tick */ }
            }
        });
    }

    private void HandleEngineProgress(Guid runSessionId, ReviewStats updatedStats)
    {
        // The engine is shared by all users; only react to this dashboard's own run.
        if (runSessionId != currentSessionId) return;

        InvokeAsync(() =>
        {
            State.Stats = updatedStats;
            totalIdentified = updatedStats.TotalIdentified;
            screenedCount = updatedStats.Screened;
            excludedCount = updatedStats.Excluded;
            includedCount = updatedStats.Included;
            
            State.PassedPeerReviewCount = updatedStats.PassedPeerReviewCheck;
            State.FailedPeerReviewCount = updatedStats.FailedPeerReviewCheck;
            
            stage = updatedStats.ProcessingStage;
            queuePosition = updatedStats.QueuePosition;
            excludedCount = updatedStats.Excluded + updatedStats.FailedPeerReviewCheck;
            if (stage == AuBtechReviewAgent.PrismaReviewEngine.StageAwaitingReview && !awaitingReview)
            {
                var state = ReviewEngine.LoadState(currentSessionId);
                if (state != null) ApplyState(state, null);
            }
            if (AuBtechReviewAgent.PrismaReviewEngine.IsFinishedStage(stage))
            {
                if (isSearching) OnRunFinished();
                isSearching = false;
            }
            
            StateHasChanged();
        });
    }
}