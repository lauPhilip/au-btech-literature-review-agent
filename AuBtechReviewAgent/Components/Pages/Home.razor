                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="p-5 space-y-4 overflow-y-auto text-sm text-gray-700">
                <p id="key-dialog-note" class="bg-brand-50 border border-brand-100 text-gray-700 p-3 text-xs leading-relaxed">
                    Your keys are kept encrypted in this browser tab only. They are not written to the server's disk or logs, and they are gone when you close the tab. With your own Mistral key the free-tier daily limit does not apply.
                </p>
                <div>
                    <label for="k-mistral" class="ui-label text-xs">Mistral API key</label>
                    <input id="k-mistral" type="password" autocomplete="off" placeholder="Uses the server key when empty" @bind="modalMistral" class="ui-input font-mono text-xs" />
                </div>
                <div>
                    <label for="k-elsevier" class="ui-label text-xs">Elsevier (Scopus / ScienceDirect) API key</label>
                    <input id="k-elsevier" type="password" autocomplete="off" placeholder="Uses the server key when empty" @bind="modalElsevier" class="ui-input font-mono text-xs" />
                </div>
                <div>
                    <label for="k-ieee" class="ui-label text-xs">IEEE Xplore API key</label>
                    <input id="k-ieee" type="password" autocomplete="off" placeholder="Optional" @bind="modalIeee" class="ui-input font-mono text-xs" />
                </div>
                <div>
                    <label for="k-scholar" class="ui-label text-xs">Semantic Scholar API key</label>
                    <input id="k-scholar" type="password" autocomplete="off" placeholder="Optional" @bind="modalScholar" class="ui-input font-mono text-xs" />
                </div>
                <div class="pt-3 border-t border-gray-100">
                    <label for="k-admin" class="ui-label text-xs">Developer access token</label>
                    <input id="k-admin" type="password" autocomplete="off" aria-describedby="k-admin-help" placeholder="Only for the maintainers of this deployment" @bind="modalAdminToken" class="ui-input font-mono text-xs" />
                    <p id="k-admin-help" class="text-xs text-gray-500 mt-1">Removes the daily run limit. Set with Quota:AdminToken on the server.</p>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3 border-t border-gray-200 flex justify-end gap-2">
                <button type="button" @onclick="ClearVault" class="ui-btn ui-btn-sm text-red-700 hover:bg-red-50">Clear session</button>
                <button type="button" @onclick="SaveSessionKeys" class="ui-btn-primary ui-btn-sm">Apply to session</button>
            </div>
        </div>
