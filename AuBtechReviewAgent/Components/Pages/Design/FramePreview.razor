@page "/design/frame"
@layout AppLayout
@using Microsoft.Extensions.Hosting
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@inject NavigationManager Navigation
@* A page that exists only in development: AppLayout with sample content long enough to scroll, so the frame can
   be checked in a browser and by the accessibility job in CI (tools/a11y), which also takes its screenshots
   here, before the real pages move onto the layout. Anywhere else it answers "not found". *@

<SeoHead Title="Frame preview" NoIndex="true" />

@if (Environment.IsDevelopment())
{
    <div class="mx-auto w-full max-w-[1600px] px-[clamp(16px,3vw,40px)] py-8">
        <div class="mx-auto max-w-[760px]">
            <p class="text-sm font-semibold text-muted">Development only</p>
            <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-heading">The app frame</h1>
            <p class="mt-3 text-muted">The header and the footer stay where they are; only this area scrolls. Below 640 px the places fold into a menu and the scroll bar is hidden.</p>
            @for (int i = 1; i <= 6; i++)
            {
                int number = i;
                <section class="mt-6 rounded-card border border-line bg-page p-6">
                    <h2 class="font-display text-lg font-semibold text-heading">Sample section @number</h2>
                    <p class="mt-2 leading-relaxed text-ink">Every cited statement in a TraceableAI review can be traced to the passage it came from. This sample text only fills the page, so the content area is taller than the screen and has to scroll between the fixed header and footer.</p>
                </section>
            }
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (!Environment.IsDevelopment()) Navigation.NotFound();
    }
}
