@page "/"
@layout LandingLayout
@using AuBtechReviewAgent.Components.Landing

<SeoHead Title="TraceableAI · Literature reviews where every citation is checked" Path="/" StructuredData="true" />

@* One screen, as Coursebot's: the hero in the left half and the looping citation example in the right half from
   1024 px. The example is hidden under 640 px, so on a phone the page fits 390 × 844 without scrolling. No
   statistics and no how-it-works section: the numbers are on Metrics and the method on About. Every colour is a
   theme token, so the page takes the dark theme (the only page that does until redesign step 12). *@
<div class="mx-auto flex w-full max-w-[1600px] flex-1 items-center px-[clamp(16px,3vw,40px)] py-6 sm:py-10">
    <div class="grid w-full grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-12 xl:gap-20">
        <div class="mx-auto flex max-w-[36rem] flex-col items-center text-center">
            <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-muted">Made at Aarhus University</p>
            <h1 class="mt-4 font-display text-[clamp(40px,4.6vw,64px)] font-bold leading-[1.05] tracking-[-0.025em] text-heading">
                Literature reviews where every citation is checked
            </h1>
            <p class="mt-5 text-lg leading-relaxed text-muted sm:text-xl">Every claim shows the passage it came from.</p>
            <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center">
                <a href="/start" class="ui-btn min-h-[52px] bg-primary px-7 text-base text-primary-on hover:bg-primary/90 dark:focus-visible:outline-primary">
                    Start a review
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M10.3 4.3a1 1 0 011.4 0l5 5a1 1 0 010 1.4l-5 5a1 1 0 01-1.4-1.4l3.3-3.3H4a1 1 0 110-2h9.6l-3.3-3.3a1 1 0 010-1.4z" clip-rule="evenodd" /></svg>
                </a>
                <a href="/about" class="ui-btn min-h-[52px] border border-line-field bg-page px-7 text-base text-heading hover:bg-active dark:focus-visible:outline-primary">How it works</a>
            </div>
            <p class="mt-6 text-sm text-muted">A few free reviews a day · Open source, Apache 2.0</p>
        </div>

        <CitationLoop />
    </div>
</div>
