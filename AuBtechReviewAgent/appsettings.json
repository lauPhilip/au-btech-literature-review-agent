{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MISTRAL_API_KEY": "YOUR_MISTRAL_API_KEY_PLACEHOLDER",
  "ELSEVIER_API_KEY": "YOUR_ELSEVIER_API_KEY_PLACEHOLDER",
  "IEEE_API_KEY": "YOUR_IEEE_API_KEY_PLACEHOLDER",
  "Quota": {
    "FreeRunsPerDay": 3,
    "GlobalFreeRunsPerDay": 50,
    "OwnKeyRunsPerHour": 10,
    "FreeTierMaxResults": 5,
    "UnlimitedInDevelopment": true,
    "AdminToken": ""
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Report": {
    "SupportStatement": "This review was carried out at the Department of Business Development and Technology (BTECH), Aarhus University, which supported the work. The department had no role in choosing the studies, extracting their data or writing up the findings."
  },
  "Site": {
    "PublicUrl": "https://au-btech-literature-review-agent.dk"
  },
  "Runs": {
    "MaxConcurrentRuns": 3,
    "RetentionDays": 7,
    "ScreeningReviewTimeoutHours": 24
  },
  "Llm": {
    "Provider": "Mistral",
    "Model": "mistral-large-latest",
    "FastModel": "mistral-small-latest",
    "FastReasoningEffort": "none",
    "BaseUrl": "",
    "ApiKey": "",
    "QualityParallelism": 8,
    "FastParallelism": 16
  },
  "Cache": {
    "Enabled": true,
    "SearchResponseHours": 24,
    "ScreeningDecisionDays": 90,
    "Folder": "App_Data/cache"
  },
  "Synthesis": {
    "ThematicSynthesis": true,
    "DualCoding": true,
    "RepairCitations": true,
    "SecondCitationCheck": true,
    "MaxThemes": 8,
    "CodingBatchSize": 6
  },
  "Metrics": {
    "Enabled": true,
    "Folder": "App_Data/metrics"
  },
  "OpenSources": {
    "ContactEmail": "",
    "SemanticScholarApiKey": "",
    "ChainingPerPaper": 5
  }
}
